double DrlPolicy(const double &o[])
{
   double z[5]; for (int j = 0; j < 5; j++) z[j] = MathMax(-10.0, MathMin(10.0, (o[j] - DRL_MU[j]) / DRL_SD[j]));
   double h1[64], h2[64];
   for (int r = 0; r < 64; r++) { double s = DRL_B0[r]; for (int c = 0; c < 5; c++) s += DRL_W0[r * 5 + c] * z[c]; h1[r] = MathTanh(s); }
   for (int r = 0; r < 64; r++) { double s = DRL_B1[r]; for (int c = 0; c < 64; c++) s += DRL_W1[r * 64 + c] * h1[c]; h2[r] = MathTanh(s); }
   double a = DRL_B2[0]; for (int c = 0; c < 64; c++) a += DRL_W2[c] * h2[c];
   a = MathMax(-1.0, MathMin(1.0, a));
   return 1.0 + a;                       // lot multiplier 0..2
}
