double DrlPolicy(const double &o[])
{
   double z[5]; for (int j = 0; j < 5; j++) z[j] = MathMax(-10.0, MathMin(10.0, (o[j] - DRL_MU[j]) / DRL_SD[j]));
   double h1[64], h2[64];
