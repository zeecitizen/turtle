//+------------------------------------------------------------------+
//| VSISA.mq5 as a 2nd scout for bread_winner (another timeframe)     |
//| GENERATED by build_bws_vsisa2.py: names prefixed W_, TF = W_InpTF.|
//+------------------------------------------------------------------+
input group "=== VSISA #2 scout (another timeframe) ==="
input ENUM_TIMEFRAMES W_InpTF = PERIOD_M3;   // W_InpTF — this engine's candles
CTrade W_trade;

//--- money -----------------------------------------------------------------
// 0.15 LOTS - SHIPPED 2026-09-16 on Zee's call ("ok 0.15 lot adjustment"), and it is
// spending the headroom LAW 13 just created, not adding new risk on top of the old.
//
// v1.14 turned on the fake break, which cut drawdown from $905 to $586 - 5.9% of the $10k
// funded account he is heading for - while halving the income to $3,998. Raising the lot
// takes some of that income back inside the same 10% breach line:
//        0.10 lots   net $3,999   DD $586    5.9%
//        0.15 lots   net $5,999   DD $879    8.8%   <- HERE
//        0.20 lots   net $7,998   DD $1,172 11.7%   breaches
//
// THE HARD CEILING IS 0.17 LOTS on $10k. Drawdown scales linearly with size and nothing
// in the risk machinery changes it - that was settled in v1.12, where a tighter stop, a
// concurrency cap, a risk cap and a daily loss limit were all tested and none moved it.
// The 9-loss worst streak is unchanged; at 0.15 lots that run costs about $780.
// 0.28 LOTS - SHIPPED 2026-09-16 WITH THE RATCHET, on Zee's call. The two belong together
// and must not be separated: the ratchet cut drawdown from $1,232 to $660 at 0.15 lots, and
// this spends exactly that headroom back. Turning the ratchet OFF while leaving 0.28 here
// would roughly DOUBLE the drawdown to ~$2,300.
//
// Matched-risk comparison, Jan-Sep, both at $1,232 maximum drawdown:
//     no ratchet, 0.15 lots   +$5,571   30% WR   worst streak 13
//     ratchet 2.0, 0.28 lots  +$7,918   51% WR   worst streak  7
//
// ON A FUNDED ACCOUNT THIS IS 12.3% OF $10,000 AND WOULD BREACH A 10% RULE. Zee chose it
// knowing that; it matches the drawdown he was already carrying. For a 10% limit the size
// is ~0.22 lots (about $968).
input double W_InpLots        = 0.01;   // W_InpLots — lot size per ticket
// FIXED-FRACTIONAL RISK (v1.25, 2026-10-09). Zee: "Transitioning from a static fixed lot
// (0.28) to a Fixed Fractional Risk Model (e.g., risking strictly 0.5% or 1.0% of account
// equity per W_trade)". 0 = OFF (fixed W_InpLots, the tested behaviour). >0 = size every
// decision so that a full stop (plus commission) loses this % of CURRENT equity, split
// across W_InpTickets. For scale: 0.28 lots on $25k averaged a $134 loss = ~0.54% risk.
input double W_InpRiskPct     = 0.0;    // W_InpRiskPct — % of equity risked per decision (0 = fixed lots)
input double W_InpRiskMaxLots = 5.0;    // W_InpRiskMaxLots — hard cap per ticket when sizing by risk
// EQUITY-PROPORTIONAL LOTS (v1.26, 2026-10-09). The v1.25 test showed equal-risk sizing LOSES
// to fixed lots (0.5%: PF 2.27 vs 2.55) because fixed lots put more money on the wide-stop
// setups, which are the better ones. This compounds WITHOUT re-weighting: lots =
// W_InpLots x equity / W_InpCompoundBase, so 0.28 lots at $25k becomes 0.34 at $30k.
// 0 = OFF (fixed W_InpLots). Ignored when W_InpRiskPct > 0.
// KEPT OFF IN v1.28 - THE SHIP TEST CHANGED THE ANSWER (2026-10-10). Zee approved "fade 0.65/5
// + compounding at 25000", but the pre-ship run with BOTH as defaults read +$19,390 at 6.63% DD
// against +$17,745 at 4.08% for the same fade on fixed lots - 9% more money for 70% more
// drawdown, because lots had grown to 0.49 by the weak late months. (On the old 0.60/4 fade it
// was +$19,291 at 3.85% vs +$17,014 at 3.8%.) Set this to YOUR account's starting equity to
// compound; 0 keeps the tested fixed-lot behaviour.
input double W_InpCompoundBase = 0.0;    // W_InpCompoundBase — equity that W_InpLots is sized for (0 = no compounding)
input int    W_InpTickets     = 1;      // W_InpTickets — tickets per decision (basket)
input int    W_InpMagicNumber = 88395;  // W_InpMagicNumber — VSISA
// MAX OPEN / COOLDOWN LIFTED (2026-09-12). Zee: "remove the W_InpMaxOpen = 1 and
// cooldown for now." The funnel is why: over seven months 236 setups passed EVERY law
// and only 124 fired — 47% were thrown away while a W_trade was already running, refused
// by plumbing rather than by anything the strategy believes.
//
// TIGHTENED TO 2 — SHIPPED 2026-09-16 ON ZEE'S CALL ("ok ship W_InpMaxOpen=2").
// Detection runs once per CLOSED M5 bar and fires at most one decision per bar, so the rate
// limit is one entry per 5 minutes whatever this says; the ceiling only bounds how much can
// be open AT ONCE. At 10 that is ~$450 exposed if every position is open and wrong together;
// at 2 it is ~$90.
//
// THE PROFIT EVIDENCE IS THIN AND THIS SHIPPED ON RISK, NOT ON RETURN. Walk-forward:
//   Apr-Jun   +$4,004 DD $898   -- IDENTICAL to maxOpen=10; the cap never binds
//   Jul-Sep   +$4,192 DD $905   against +$4,004 DD $950, from removing FOUR trades
// One half is untouched and the other moves on four trades, so +$188 is not a result worth
// defending. What IS solid is that the cap costs nothing measurable in either half while
// cutting worst-case concurrent exposure five-fold — and on a funded account with a hard
// breach line, a free reduction in tail exposure is worth taking.
//
// Measured, the EA rarely holds more than three positions anyway: maxOpen 10, 5 and 3 return
// BYTE-IDENTICAL results over Apr-Sep. This binds only in the crowded moments, which are
// exactly the moments a breach line cares about.
input int    W_InpMaxOpen     = 2;      // W_InpMaxOpen — max concurrent decisions
// DAILY LOSS LIMIT (Zee, 2026-09-16: "if we use flat 0.2 .. can't we reduce the drawdown
// from 19%?"). Measured, the drawdown is not caused by concurrency — maxOpen 10, 5 and 3
// return IDENTICAL results, so the EA rarely holds more than three — nor by a few oversized
// stops. It is a RUN OF BAD DAYS: the worst drawdown at 0.20 lots is $1,587 spread over
// five sessions, 22-29 July, with single days of -$635, -$590, -$483 and -$477.
//
// A daily limit is the tool aimed at exactly that, and a funded account imposes one anyway
// (typically 5% = $500 on $10k). Stop opening new trades once the day's realised loss on
// this magic passes the line; open positions keep their own stops.
input double W_InpDayLossStop = 0.00;   // W_InpDayLossStop — stop opening for the day after this loss (0 = off)

//--- LAW 4: the 2-bar setup ----------------------------------------------------
// HOW LONG IS THE SETUP? HE COUNTS NOTHING — HE WAITS (2026-09-13).
// "we wait until the red reds keep appearing.. we wait until the reaction candle
// becomes bullish (blue).. IT COULD BE THREE OR MORE REDS". So the run is not a fixed
// 2 or 3; it is however many same-direction bars precede the turn. W_InpSetupBars is now
// only the fallback when auto is off.
//
// NOTE THIS REINSTATES DIRECTION. A run "until the reds stop" is meaningless unless the
// bars are reds, so auto mode requires each setup bar to close its own way regardless of
// W_InpStrictDir. His document defines the setup that way; removing direction earlier made
// the pattern something he never drew.
input bool   W_InpSetupAuto   = true;   // W_InpSetupAuto — count the run until the turn, don't fix it
input int    W_InpSetupMin    = 2;      // W_InpSetupMin — at least this many bars in the run
input int    W_InpSetupMax    = 10;     // W_InpSetupMax — stop counting back at this many
input int    W_InpSetupBars   = 2;      // W_InpSetupBars — fixed length, used only when auto is off
// THE BACKGROUND CAMPAIGN NEED NOT BE CONSECUTIVE (Zee, 2026-09-16):
// "the initial bullish/bearish candles need not be all consecutive to form the background
// campaign (yes we call it that).. several bullish candles with a single red candle in
// between them for example breaking the consecutive nature, again followed by a larger
// spread low volume engulfing reaction candle .. can be an entry"
//
// The run-counter broke at the FIRST bar closing the wrong way, so one contrary candle
// inside a campaign voided the whole thing — and the same rule then re-checked every bar
// and refused the setup outright. A campaign is an accumulation of effort over a stretch
// of bars, not an unbroken ribbon of one colour. This is the budget for odd bars inside
// it; the bar touching the reaction must still be ours, and the run may not end on one.
input int    W_InpSetupGaps   = 0;      // W_InpSetupGaps — contrary bars tolerated inside the campaign
// "the THIRD red candle with EVEN HIGHER VOLUME than previous two means: people are
// buying even more". Read literally that is "the bar nearest the turn is the loudest of
// the run" — which is what this requires. Not strict monotonicity: that would be a
// harder rule than he states and would break on one noisy bar mid-run.
// OFF — BIG IS THE RULE, RISING IS NOT (2026-09-14). Zee: "big volumes show increased
// transactions, i don't think we need in specific 'increasing' volumes, they can just be
// big (not incrementally increasing).." His diagram1 text describes a run that happened
// to rise (150, 200) but the REQUIREMENT is only that the volume is big — increased
// transactions means somebody is absorbing, whatever order the bars arrive in. Requiring
// a rising sequence was me reading a description as a rule; it refused 136 setups in
// September alone. Kept as an input so the stricter reading stays testable.
input bool   W_InpRisingVol   = false;  // W_InpRisingVol — require the bar nearest the turn to be loudest
// STRICT DIRECTION LIFTED (2026-09-12, Zee: "remove this condition"). It was the
// widest gate in the whole EA — 46,266 of 81,061 candidates, 57%, died here because
// BOTH 2-bar setup bars had to close the same way. His own 2-bar setup describes the
// SHAPE ("red down bars on big volume"), and demanding two perfect closes turns a
// description into a straitjacket: one bar closing a tick the wrong way voided the
// whole setup no matter how the volume looked.
input bool   W_InpStrictDir   = true;   // W_InpStrictDir — every setup bar must close its own way

//--- THE FEED (2026-09-11) -------------------------------------------------
// Zee, 2026-09-06: "we donot wish to use broker volume, we want to completely
// transition to OANDA volume taken from tradingview. any broker volume trades waste
// our time." VSISA v1.00 shipped reading BROKER TICK COUNT because the bridge was
// never wired in — an omission, not a decision. This is the Diamond's proven reader,
// ported verbatim.
//
// DEFAULT 0 ON PURPOSE, FOR NOW. All seven months of VSISA's receipts were earned on
// broker tick volume; OANDA coverage only begins 2026-08-05 (23 trading days), so the
// two cannot yet be compared over the same evidence. Flip this once the court says so.
input int    W_InpOandaVolume = 0;      // W_InpOandaVolume — 1 = judge on OANDA (TradingView) volume
input bool   W_InpOandaStrict = true;   // W_InpOandaStrict — a missing OANDA minute = no W_trade, never broker

//--- LAW 5: what "big" means, relative to recent bars -----------------------
// LOOKBACK IS A PLATEAU, NOT A PEAK. Over seven months: 30->$3284, 45->$3385,
// 60->$3377, 75->$3050, 90->$3196, 105->$2948. Adjacent settings swing ~$300, so the
// $249 by which 60 beats 100 is noise, not signal. With net indistinguishable the
// choice falls to the standing goal (project_goal_winrate: fewer losing trades at
// FIXED geometry) — and 100 delivers 34% WR / PF 1.94 / 120 trades against 60's
// 31% / 1.83 / 153, on identical geometry. Change this line to 60 for ~7% more net
// and three points less win rate; both are validated.
// TEN BARS, NOT A HUNDRED (2026-09-12). Zee: "the 100-bar maximum.. that's alot of
// bars to check from.. we can just check the last 10 bars." It also matches what he
// actually does by eye — he compares a candle to the handful around it, not to eight
// hours of history. Smaller window = smaller maximum = the loudness test is far easier
// to satisfy, so this loosens the EA considerably on its own.
// 24 HOURS, BECAUSE HE SAYS 24 HOURS (2026-09-13). LAWS_VSISA.md, "Three bar
// formation": "Ultra high volume -> is this volume abnormal? compare it to let's say
// 24 hour volume". On M5 that is 288 bars. It had been 10 (fifty minutes), which let a
// bar qualify as the session's climax for being the loudest of the last three-quarters
// of an hour — the term "ultra high volume" stopped meaning anything.
// THE YARDSTICK IS THE CURRENT SWING (2026-09-13). Zee: "i think the 24 hour was for
// 1D chart.. on 5 min chart we can just see the current swing." That is how the eye
// actually does it — is this the loudest bar of THIS leg? — and it is self-scaling: a
// fast leg gets a short window, a slow grind a long one, with no magic bar count.
//
// The swing is measured back to the last pivot AGAINST the setup: for a buy (the setup
// bars are falling) that is the most recent swing HIGH, i.e. where this down-leg began.
// W_InpVolLookback survives as the cap and as the fallback when window mode is 0.
input int    W_InpVolWindow   = 1;      // W_InpVolWindow — 0 = fixed bar count · 1 = the current swing
input int    W_InpSwingPivot  = 3;      // W_InpSwingPivot — bars each side that define a pivot
input int    W_InpSwingMin    = 5;     // W_InpSwingMin — never judge on fewer bars than this
input int    W_InpVolLookback = 200;    // W_InpVolLookback — fixed count, and the cap on a swing
input int    W_InpBigMode     = 1;      // W_InpBigMode — 0 EVERY 2-bar setup bar loud · 1 only the loudest
input double W_InpBigPct      = 0.60;   // W_InpBigPct — 2-bar setup volume >= this x lookback max
input double W_InpBigAvg      = 1.00;   // W_InpBigAvg — ...and >= this x lookback average

//--- LAW 3: the low-volume reaction. THE TRIGGER. --------------------------
input int    W_InpQuietRef    = 0;      // W_InpQuietRef — 0 quiet vs the SETUP · 1 quiet vs lookback AVERAGE
input double W_InpLowVolPct   = 1.00;   // W_InpLowVolPct — reaction volume <= this x the reference
input double W_InpMinVolPct   = 0.00;   // W_InpMinVolPct — reaction volume >= this x the reference (0 = no floor)
input double W_InpBodyFrac    = 0.25;   // W_InpBodyFrac — reaction body >= this x its own range
// "a LARGER SPREAD low volume engulfing reaction candle" — the reaction that ends a gapped
// campaign is described as a big one, not merely a bar that closed the other way.
input double W_InpReactSpread = 0.00;   // W_InpReactSpread — reaction range >= this x avg range (0 = off)
// POSITION SIZING BY REACTION SPREAD (Zee, 2026-09-16: "yes let's let it do position
// sizing. test"). W_InpReactSpread as a GATE halves the W_trade count and takes net from
// $8,010 to $4,363 — the wide reactions are worth more per W_trade but there are not enough
// of them to live on. Sizing keeps every setup and pays attention to the good ones.
//
// The grading, measured per W_trade and CONSISTENT IN BOTH walk-forward halves:
//   spread < 1.20x avg   $23.66 / $26.24   (the ordinary setups)
//   spread >= 1.20x      $26.12 / $30.61
//   spread >= 1.60x      $43.16 / $33.41   (on 26 and 36 trades - thin)
// Tier 0 exists so risk can be TAKEN OFF the ordinary setups instead of only added to the
// good ones; on a funded account that is the difference between a bigger edge and a breach.
input bool   W_InpSizeBySpread = false; // W_InpSizeBySpread — scale lots by the reaction's spread
input double W_InpSizeT1      = 1.20;   // W_InpSizeT1 — spread x avg for tier 1
input double W_InpSizeT2      = 1.60;   // W_InpSizeT2 — spread x avg for tier 2
input double W_InpSizeM0      = 1.00;   // W_InpSizeM0 — lot multiplier below tier 1
input double W_InpSizeM1      = 1.50;   // W_InpSizeM1 — lot multiplier at tier 1
input double W_InpSizeM2      = 2.00;   // W_InpSizeM2 — lot multiplier at tier 2
// MODE 2 (Zee, 2026-09-16): "what if the no-supply is itself a reaction candle?"
// He is right, and it answers my objection that the test cannot filter the entry. Mode 1
// waits for a CONFIRMING bar after the test, which costs two bars of drift and was measured
// at $18.63 a W_trade against the base setup's $24.88. If the quiet test bar is itself the
// reaction — a low-volume bar closing against the move — then it IS the entry bar, and the
// W_trade is taken at its close, at a better price, with no bar wasted waiting.
input int    W_InpConfirmMode = 0;      // W_InpConfirmMode — 0 enter on reaction · 1 TEST + confirm bar · 2 enter ON the test
input double W_InpTestVolPct  = 0.90;   // W_InpTestVolPct — the test bar's volume <= this x the LAW 3 reference
// DIAGRAM 11 is explicit that the test bar CLOSES AGAINST the W_trade: "the next bar is
// again red (after the blue surprisingly) -> this is testing -> WE CALL IT THE NO SUPPLY
// TEST". The first cut only required the bar not to break the setup extreme, so a bar
// closing UP could serve as the "test" of a buy — which is not a test of supply at all.
input bool   W_InpTestRed     = false;  // W_InpTestRed — the test bar must close AGAINST the W_trade
// THE NO-SUPPLY TEST AS AN ADDED CONFIRMATION, NOT A GATE (Zee, 2026-09-15):
// "maybe the no-supply test is not working as a gate, but its something that acts as a
// strong confirmation right? so can we test it as an addition?"
//
// He is right that W_InpConfirmMode was the wrong use of it. That mode DELAYS the entry two
// bars and so replaces the W_trade rather than confirming it. But the test cannot filter the
// entry either, because it happens AFTER it — at entry time the test bar does not exist.
//
// What it CAN do is judge a W_trade already open, which is his law used forwards:
// "if in case on no supply test it were big volume it would mean sustained buying" — for a
// BUY, a loud bar closing back down means the supply never left, so the setup has failed
// and there is no reason to wait for the stop. That is a strictly post-entry decision and
// it is what this tests.
// LAW 10 — THE RETRACEMENT, at last (Zee, 2026-09-15):
// "if we miss such a breakout on low volume, then we wait for a retracement to the same low
// where we initially got to when the red candle's happened giving way to bullish move. that
// retracement low when it touches the low line of the missed setup is also a valid setup ..
// infact sometimes it can touch several times (increasing the strength of the upcoming move)"
//
// His document has said this from the start — "Never chase the market. Always catch the
// market on a retracement" — and the audit has carried it as NOT IMPLEMENTED since day one.
// This is it: every setup the detector sees leaves a LEVEL behind at the low the move began
// from, and a later touch of that level is its own entry, with the stop hung off the level
// rather than off a fresh candle.
input bool   W_InpRetrace     = false;  // W_InpRetrace — re-enter when price returns to a past setup's level
input int    W_InpRetraceBars = 60;     // W_InpRetraceBars — how long a level stays live
input int    W_InpRetraceTol  = 30;     // W_InpRetraceTol — points either side that count as a touch
input int    W_InpRetraceMin  = 1;      // W_InpRetraceMin — touches required before entering (his "several times")
input int    W_InpRetraceMax  = 2;      // W_InpRetraceMax — entries allowed per level
// THE TOUCH MUST ARRIVE ON NO SUPPLY. The first cut entered on price alone — it touched
// the line, it closed back, we bought — and that is not this method at all: every other
// entry in this EA is a VOLUME judgement, and a price-only re-entry throws away the one
// thing the strategy reads. Measured, that version lost $9.46 a W_trade over 409 trades
// while the base setups made $13.35. This asks the retest to be QUIET, which is the same
// question Law 3 asks of the reaction: if supply had really gone, the retest is cheap.
input double W_InpRetraceQuiet = 0.00;  // W_InpRetraceQuiet — touch bar volume <= this x avg (0 = no volume test)
input double W_InpTestExit    = 0.00;   // W_InpTestExit — close if the TEST bar is louder than this x avg (0 = off)
input int    W_InpTestWindow  = 3;      // W_InpTestWindow — only watch this many bars after entry
input int    W_InpTestAvgBars = 20;     // W_InpTestAvgBars — bars in the volume average the test is judged against
input bool   W_InpEngulf      = false;  // W_InpEngulf — reaction must engulf the last 2-bar setup bar

//--- LAW 8: geometry -------------------------------------------------------
// WHICH CANDLE THE STOP HANGS FROM (2026-09-12). His LAWS_VSISA.md is explicit:
// "Stop loss 2-3 pips below the bullish blue candle" — the REACTION candle, the blue
// one we enter on. The EA had been measuring from the lowest low of ALL THREE bars, and
// since the setup bars ARE the down-move their lows sit far below, every stop came out
// systematically too wide: the two live trades risked 526 and 876 points. That single
// reference error changed the R multiple of every W_trade in every test.
// Mode 0 is his specification. Mode 1 is the old behaviour, kept only so the two can be
// compared honestly rather than swapped on faith.
input int    W_InpStopRef     = 0;      // W_InpStopRef — 0 = below the REACTION candle (his spec) · 1 = whole setup
// 80 POINTS = 8 GOLD PIPS (2026-09-15). Zee, reading the charts: "some trades could have
// been saved if the stop loss was a bit more relaxed". Measured, and he was right — going
// from 30 to 180 removes 17 losing trades in Apr-Jun and 10 in Jul-Sep, and EVERY buffer
// value beat 30 on both halves. 80 is chosen rather than the maximum because the halves
// disagree about the best value (Apr-Jun wants 180, Jul-Sep wants 80), which is noise;
// what they agree on is that 30 is too tight. It is also defensible as HIS number: the
// teacher gives "3 to 8 pips" in Part 10, and Axi gold spread is ~9 points, so a 30-point
// stop sat barely 3x the spread where ordinary noise reaches it.
// 120 POINTS = 12 GOLD PIPS (2026-09-15). Zee: "i want you to try a still wider stop
// than 8 pips.. see what it does" - and 120 is a genuine INTERIOR peak, better than 80
// in BOTH halves (+$3,621/+$1,741 vs +$2,471/+$1,651) with 160 and 200 both worse.
// Past 200 it collapses: Jul-Sep turns negative at 250 and 350, because the target moves
// out with the stop (2.0R) so a wider stop needs a proportionally bigger move to win,
// and fewer setups clear the 900-point risk cap at all.
// Still defensible against his "3 to 8 pips": that is FX majors with ~1-point spreads,
// and Axi gold spreads ~9 points, so 12 pips here is proportionally tighter than 8 there.
input int    W_InpSlBufPts    = 120;    // W_InpSlBufPts — points beyond the reaction candle (12 pips)
input int    W_InpMinSlPts    = 60;     // W_InpMinSlPts — floor, so spread cannot eat the stop
input int    W_InpMaxSlPts    = 900;    // W_InpMaxSlPts — refuse setups whose risk is absurd
// OTHER MARKETS (v1.27, 2026-10-09). Zee: "let's aggressively find more trades". Every
// point input above was tuned on gold, where 120 points = $1.20 ~ a third of an M5 candle.
// On EURUSD 120 points is 12 pips (two candles); on an index it can be a fraction of a tick
// of movement. W_InpPtsScale multiplies EVERY point input (buffer, floor, cap, fixed target,
// retrace tolerance) so a market can be run at gold's proportions:
//    scale = that market's average M5 range in points / gold's average M5 range in points
// 1.0 = gold, and leaves every gold result byte-identical.
input double W_InpPtsScale    = 1.0;    // W_InpPtsScale — multiplier on every point input (1 = gold)
double W_Pt() { return _Point * W_InpPtsScale; }
// 5.0R — SHIPPED 2026-09-15 ON ZEE'S CALL. "SL should not be tied to TP. SL can be below
// the first reaction candle's low .. and TP can be very high up until 1:7 .. can you test
// this?" Then, on the result: "ship 5.0".
//
// I HAD THIS WRONG, and the error is worth keeping. I swept the R ladder only to 2.5R,
// found it worse than 2.0R, and called 2.0R the optimum. 2.0R is a LOCAL peak: the curve
// dips at 2.5R and climbs to a second, higher one.
//
//     2.0R  43% WR  +$5,502  DD $946     <- the old default
//     3.0R  32% WR  +$4,624              <- the dip that fooled me
//     4.0R  27% WR  +$6,374  DD $1,014   breaches a 10% funded limit
//     5.0R  25% WR  +$8,153  DD $950     <- HERE
//     6.0R  22% WR  +$8,744  DD $1,322   breaches
//
// +48% profit for IDENTICAL drawdown, and the only rung under a 10% limit. It walks
// forward better than anything else tested: Apr-Jun +$4,022, Jul-Sep +$3,988 — the two
// halves within 1% of each other, beating the old default on BOTH and doubling the unseen
// one (+$3,621 / +$1,741).
//
// NOTHING ABOUT THE RISK CHANGED. Same 322 setups, same structural stop, same average loss
// (-$57.35 at every rung). Only the winners run: avg win +$279.62 against 2.0R's +$114.99.
// That is what decoupling the target from the stop actually buys.
//
// THE COST, so no future session mistakes it for free: win rate 43% -> 25%, and the worst
// losing streak goes 11 -> 15. Targets below 0.75R were tested too and every one buys win
// rate with money: 0.20R reaches 82% and LOSES at every stop width, because at 0.2:1
// break-even needs 83.3%. The H1 trend filter does NOT rescue the win rate here — at 5.0R
// it halves the profit and leaves WR at 24%; its benefit was specific to 2.0R.
input double W_InpTargetR     = 10.0;    // W_InpTargetR — TP as a multiple of risk
// TARGET DECOUPLED FROM STOP (Zee, 2026-09-15). He asked whether a wider stop would have
// saved the 14 Sep 04:10 W_trade. It would not — because at a fixed R multiple the target
// travels outward with the stop, so widening moves the finish line away exactly as fast
// as it moves the stop. That W_trade needed a 361pt buffer to survive and its 2R target
// then sat at 4358.80, above the 4355.51 high of the next 24 hours. Holding the target
// STILL rescued it (400pt buffer, original target, hit at 1.37R).
//
// So the target gets its own rule:
//   mode 0  R multiple of the stop            — the coupled original
//   mode 1  a fixed distance in points        — same target whatever the stop does
//   mode 2  the swing origin, i.e. the level the leg came FROM — structural, and the
//           one the method actually implies: a retracement is finished when price is
//           back where the move began.
input int    W_InpTargetMode  = 0;      // W_InpTargetMode — 0 R-multiple · 1 fixed points · 2 swing origin
input int    W_InpTargetPts   = 300;    // W_InpTargetPts — TP distance for mode 1
input double W_InpTgtMinR     = 0.50;   // W_InpTgtMinR — refuse if the target is nearer than this in R
input double W_InpTgtMaxR     = 0.00;   // W_InpTgtMaxR — cap the target at this R (0 = uncapped)
// BREAKEVEN OFF (2026-09-15). It was CUTTING WINNERS: price reaches 1R, the stop jumps
// to entry, price dips back to entry and closes flat - then runs on to 2R without us.
// Measured at 2.0R with the corrected stop: OFF gives +$2,471/+$1,651 against ON at
// +$962/+$1,199, nearly double AND a higher win rate (44% vs 31%), consistent in both
// halves. Note this REVERSES an earlier finding made on the old build, where the stop
// was measured from the whole setup and breakeven did help - the correction changed it.
input double W_InpBreakEvenR  = 0.0;    // W_InpBreakEvenR — >0: move stop to entry at this R
// THE RATCHET (Zee, 2026-09-16): "if 0.75R is reached we breakeven to 0.75R / if 1R is
// reached we breakeven to 1R / if 2R is reached we breakeven to 2R / if XR is reached we
// breakeven to XR".
//
// This is NOT W_InpBreakEvenR. That one moves the stop to ENTRY and then stops caring, so a
// W_trade that reaches 4R and reverses still closes at zero. This climbs with the W_trade and
// never gives the level back: reach 2R and 2R is banked, whatever happens after.
//
// WHY IT IS WORTH TESTING AT 5.0R. Of the 65 losing trades Jan-Sep, FOUR ran past 4R before
// being stopped for a full loss - 20 May peaked 4.80R, 11 Sep 4.77R, 3 Jun 4.61R, 17 Mar
// 4.02R - and another three passed 3R. At 2.0R the old breakeven was measured as actively
// destructive (+$962/+$1,199 with it on against +$2,471/+$1,651 off) because it cut winners
// early. The journey to 5R is far longer, so the same test has to be run again here.
//
// The ladder is start, start+step, start+2*step ... and the stop locks to the highest rung
// price has actually reached. It never moves backwards.
input double W_InpRatchetStart = 2.00;  // W_InpRatchetStart — first R rung that gets locked (0 = off)
input double W_InpRatchetStep  = 8.00;  // W_InpRatchetStep — spacing of the rungs above it

//--- LAW 6: the wick override (default OFF) --------------------------------
// "since the fourth bullish blue candle has still somewhat bigger volume .. if there
// were no lower wick we wouldn't buy immediately, we would wait .. and here we see a
// lower wick". The wick is how he judges a reaction that is NOT quiet enough — mode 2.
input int    W_InpWickMode    = 0;      // W_InpWickMode — 0 off · 1 require · 2 override big volume
input double W_InpWickFrac    = 0.35;   // W_InpWickFrac — wick >= this x the bar's range

//--- LAW 7: anomaly, tiny spread on huge volume (default OFF) --------------
input bool   W_InpAnomaly     = false;  // W_InpAnomaly — 2-bar setup's last bar must be a spread anomaly
input double W_InpAnomalyMax  = 0.70;   // W_InpAnomalyMax — its range <= this x recent average range
// THE CAP BAR (LAWS_VSISA diagrams 4, 6, 7 — added 2026-09-15). This is the Base Case
// Example A finally written down, and Zee states it four separate times:
//   d4 (buy):  "small candle with big volume shows that big demand came that caps the
//              market and not letting the market going down"
//   d6 (sell): "next candle is small blue with a large volume -> supply was hit -> this
//              small candle means agressive selling happened which didnot let the price move"
//   d7 (sell): "next blue candle has low height / spread but volume is bigger .. this
//              shows end of rising market -> supply orders hit -> price capped"
// The signature is BOTH ON THE SAME BAR: huge effort, no result. W_InpAnomaly already had
// the small-spread half; this is the big-volume half, which was missing entirely —
// and with W_InpBigMode=1 only ONE bar of the run had to be loud, so the capped bar
// itself could be quiet and the pattern he draws would never be required.
input double W_InpCapVol      = 0.00;   // W_InpCapVol — the last setup bar's volume >= this x avg (0 = off)
// THE REACTION MUST CLOSE AT ITS EXTREME (diagrams 7 and 8).
//   d7: "closing of reaction candle's body is strong bearish -> so we will sell"
//   d8: "top wick on reaction candle + strong bearish closing (on the low the closing
//        of candle happened)"
// W_InpBodyFrac only asks that the BODY is large; it cannot tell a bar that closed on its
// low from one that closed mid-range with a long wick each side. This asks where the
// close actually sits in the bar's range, which is what he points at.
input double W_InpCloseLoc    = 0.00;   // W_InpCloseLoc — reaction close in this top/bottom fraction (0 = off)
// EFFORT PER UNIT OF RESULT (LAWS_VSISA diagram 9 — added 2026-09-15). This is the Base
// Case stated properly at last. Zee picks TWO CANDLES OF THE SAME SPREAD and reads the
// difference in their volume: "let's take the forth blue candle, and the seventh blue
// candle -> both has same spread (height of candle body). 4th -> volume low -> low
// supply. 7th -> supply hit so a big volume."
//
// Holding spread constant and comparing volume IS volume-per-range. That is why the
// v1.03 cap bar failed: W_InpAnomaly demands a small ABSOLUTE range, which is rare and
// throws away every large bar that is also working hard. Normalising by range keeps
// them, and asks the only question he actually asks — how much volume did this bar
// spend for the distance it travelled?
input double W_InpEffortMin   = 0.00;   // W_InpEffortMin — last setup bar's vol/range >= this x avg (0 = off)

//--- LAW 13: fake break of a recent extreme -- ON, SHIPPED 2026-09-16 -------
// Zee's own tier-3 case, from his document: "case 3. 2 bar setup + fake break of this
// support + forms a wick + closing again inside support .. (strongest)". It was built
// early, tested OFF on the OLD build, and never re-examined after the stop and swing
// corrections. Re-tested at the 1:5 geometry it is THE BEST FILTER ON THIS PROJECT.
//
// Walk-forward, per W_trade -- and note it holds at EVERY sweep length, which is a plateau,
// not a spike. Every filter that failed this year (cap bar, volume floor, close location,
// effort-per-range, quiet retracement) was good at ONE setting and worthless at its
// neighbours. This is the opposite:
//        off       25% WR $23.66  |  24% WR $28.21
//        20 bars   33%    $45.40  |  31%    $51.46
//        30 bars   34%    $48.76  |  32%    $54.50   <- SHIPPED
//        50 bars   38%    $57.65  |  31%    $59.39
//
// WHAT IT BUYS: win rate 25% -> 33%, and the worst losing streak 15 -> 9. Drawdown falls
// from $905 to $586. Zee turned it on for the streak: "its hard to psychologically bear
// losses."
//
// WHAT IT COSTS, and this is not free: it refuses 75% of setups (318 -> 78), so at 0.10
// lots the net falls from $8,196 to $3,991. Per unit of drawdown it is WORSE than leaving
// it off (6.81 against 9.06) -- a bigger lot with the filter off earns more for the same
// risk. It is a deliberate W_trade of income for bearability, not an upgrade.
input bool   W_InpFakeBreak   = true;   // W_InpFakeBreak — 2-bar setup must sweep a recent extreme
input int    W_InpSweepLook   = 30;     // W_InpSweepLook — bars defining that extreme

//--- LAW 14: THE FADE — Zee's own eye, 2026-09-17 ---------------------------------
// He took a W_trade the EA refused (16 Sep 22:33 broker, +$858 on 1 lot) and described how
// he read it: "i filtered out the red candles: saw that reds are ultra highs .. then tried
// to find a green reaction candle.. i saw that the green's had reduced alot from one green
// to another green. so it meant that now buyers have to apply less force to bring the price
// up.."
//
// That is NOT the shipped setup, and no loosening of it reaches his W_trade — gaps up to 3
// still fire nothing that night. Two things differ:
//
//   1. THE BACKGROUND IS NOT ADJACENT. He reads the red bars of the whole recent leg, not a
//      run touching the reaction. At his entry there was no red run at all — the bar before
//      was green.
//   2. THE COMPARISON IS GREEN-TO-GREEN. The EA asks "is the reaction quieter than the reds
//      behind it". He asks "is each green quieter than the LAST GREEN" — falling effort for
//      the same result, which is the Base Case read forwards.
//
// Measured on the bars he was looking at: greens 2719, 2690, 2409, 2395, 2431, 2401, 2238
// against reds of 2786, 2757, 2699, 2622, 2600, 2512.
//
// This is a SECOND ENTRY PATH, tried only when the ordinary one refuses, so it can only
// ever ADD trades. SHIPPED ON 2026-09-17 at fade<=0.60 over a 4-bar leg.
//
// TWO THINGS HAD TO BE LEARNED BEFORE IT WORKED, and both are worth keeping:
//
//   1. HIS EYE DID MORE THAN HIS WORDS. Built exactly as described - greens fading over
//      loud reds - it fired 1,455 to 5,558 times over 8.5 months at 0.03-1.46 net per $1
//      of drawdown, against the shipped 9.16. He was also looking at A LOW THAT HAD JUST
//      BEEN MADE. Applying LAW 13's sweep to this path too doubled every variant.
//   2. IT HAD TO SURVIVE THE SPIKE TEST. 0.60/look4 first showed up between neighbours of
//      5.39 and 6.40 - the shape refused all week. The fine grid made it a RIDGE, not a
//      cell: the 0.60 column wins at every lookback (6.26 / 15.75 / 12.99 at look 3/4/5).
//
//      fade<=   look3   look4   look5
//      0.55      5.19    6.58    5.62
//      0.60      6.26   15.75   12.99
//      0.65      6.00    9.58    8.36
//
// Against v1.20: net +$8,019 -> +$10,400, trades 66 -> 121, drawdown $875 -> $661, worst
// streak 5 -> 4, ratio 9.16 -> 15.75, and better in BOTH walk-forward halves
// (2.06/11.15 -> 4.16/12.43). The cost is win rate, 59% -> 51%.
input int    W_InpFadeMode    = 1;      // W_InpFadeMode — 1 = also take the green-fade entry
// LOOSENED TO 0.65 / 5 BARS - SHIPPED v1.28 (2026-10-10, Zee: "ok ship it") after he asked
// for "as many setups as possible within a single day". Axi real ticks Jan 1 - Oct 8, $25k,
// 0.28 fixed lots, random delay - the whole neighbourhood is profitable (trades, net):
//      fade<=   look4          look5          look6
//      0.60     163 +$17.5k    195 +$15.5k    229 +$15.4k
//      0.65     230 +$17.2k    288 +$19.4k    339 +$14.0k
//      0.70     345 +$11.8k    437 +$18.4k    505 +$16.3k
//      0.75     493 +$14.1k    636 +$15.5k    728 +$13.4k
// 0.65/5 against the old 0.60/4: trades 163 -> 288, days with a W_trade 104 -> 141, net
// +$17,486 -> +$19,417, better in BOTH halves (Jan-Apr +$2.3k -> +$3.4k, May-Oct +$15.1k ->
// +$16.0k), every month green. The price: drawdown 2.65% -> 4.1%, PF 2.60 -> 1.96.
input int    W_InpFadeLook    = 5;      // W_InpFadeLook — bars of leg the fade is read over
input double W_InpFadePct     = 0.65;   // W_InpFadePct — this green <= that x the previous green
input double W_InpFadeBigPct  = 0.80;   // W_InpFadeBigPct — loudest opposite bar >= this x swing max

//--- LAW 9: higher-timeframe trend (default OFF) ---------------------------
// H1 TREND FILTER OFF (2026-09-12, Zee: "remove"). Worth recording what this costs,
// because the seven-month court liked it: with it ON the EA made the SAME money on
// HALF the trades and seven more points of win rate (34% vs 27%). Off, it trades far
// more and wins less often for about the same net. His call; the receipt stands.
// M30 + CAMEL HUMPS - SHIPPED 2026-09-16 on Zee's call ("ok ship M30").
//
// Full window Jan-Sep at 0.28 lots, net per $1 of drawdown, and HIS reading beats the slope
// at EVERY timeframe - swing structure carries what a 20-bar slope does not:
//        slope M15 0.77   M30 3.29   H1 8.76   H4 7.55
//        camel M15 5.55   M30 9.16   H1 9.36   H4 8.35
//
// Against the shipped filter-less build (+$7,918, 94 trades, 51% WR, DD $1,232, streak 7),
// camel M30 returns +$8,019 on 66 trades at 59% WR, DD $875, streak 5 - more money, more
// win rate, 29% less drawdown, shorter streak.
//
// WHY M30 AND NOT H1. Full window they are tied ($8,019 vs $8,096 - under 1%, noise). They
// separate on the HALVES, and M30 owns the harder one: 2.06 against 1.27 in Jan-mid-May,
// and 50% win rate against 43%. That half contains March's 0-for-7, so it is the honest
// half to weight. H1 is better in the kinder second half (12.53 vs 11.15) and is the
// timeframe the teacher names - "That setup comes on H1, and we take entry on M5" - so the
// case for it was never numeric. Zee chose the conservative read.
//
// This is the rare filter that improved win rate, drawdown, streak AND risk-adjusted return
// in BOTH walk-forward halves. Nothing else tested this year did all four.
input int    W_InpTrendTF     = 30;     // W_InpTrendTF — 0 off · 15 M15 · 30 M30 · 60 H1 · 240 H4 · 1440 D1
input int    W_InpTrendBars   = 20;     // W_InpTrendBars — bars of slope on that timeframe
// TWO WAYS TO READ THE TREND (Zee, 2026-09-16: "test all timeframes for the trend and their
// impact on us ... also TEST the trend detector (camel humps) from our previous UHV strategy
// onto this strategy VSISA as a trend checker -- maybe it works?").
//
// Mode 0 is the SLOPE the EA already had: close now against close N bars back. Crude - a
// single spike at either end decides it.
//
// Mode 1 is the CAMEL HUMPS, his own definition from LAWS.md: "we identify trend by drawing
// camel humps .. price goes upwards in a lightning shape fashion .. so we call it an uptrend
// if we're breaking above previous highs. and forming new higher lows." That is swing
// structure, not slope, and it is the reading trend_eyes.py was built around for the UHV
// work - fractal pivots, K bars clear on each side, then HH+HL for up and LH+LL for down.
// Anything mixed is a RANGE and returns 0, which passes everything through.
input int    W_InpTrendMode   = 1;      // W_InpTrendMode — 0 slope · 1 camel humps (HH/HL structure)
input int    W_InpCamelPivot  = 2;      // W_InpCamelPivot — bars each side that define a swing
input int    W_InpCamelLook   = 120;    // W_InpCamelLook — bars of that timeframe to scan

//--- LAW 11: session (default open) ----------------------------------------
input int    W_InpSessFrom    = 0;      // W_InpSessFrom — broker hour, inclusive
input int    W_InpSessTo      = 24;     // W_InpSessTo — broker hour, exclusive

//--- housekeeping ----------------------------------------------------------
input int    W_InpCoolBars    = 0;      // W_InpCoolBars — bars to wait after a decision (0 = none)
input bool   W_InpBuys        = true;   // W_InpBuys — allow long setups
input bool   W_InpSells       = true;   // W_InpSells — allow short setups
input group "=== Machine learning (v1.29: meta-label + regime + exhaustion ON; report.md section 28) ==="
input bool   W_InpMlLog       = false;  // W_InpMlLog — log features / outcomes / open positions / regime features (training data)
input int    W_InpMlTag       = 1;      // W_InpMlTag — log file number vml_<n>_*.csv (one per rig/run)
input int    W_InpMetaMode    = 0;      // W_InpMetaMode — 1 = skip when the compiled meta-label model's score < W_InpMetaThr
input double W_InpMetaThr     = 0.4;    // W_InpMetaThr — classifier: probability · regression: predicted $
input int    W_InpRegimeMode  = 0;      // W_InpRegimeMode — 1 = compiled GMM regime filter
input int    W_InpRegSkipMask = 4;      // W_InpRegSkipMask — skip entries in these regimes (bit 0 = cluster 0, bit 1 = cluster 1, bit 2 = cluster 2)
input int    W_InpExhMode     = 0;      // W_InpExhMode — 1 = close a profitable position when the exhaustion model says P >= W_InpExhThr
input double W_InpExhThr      = 0.75;   // W_InpExhThr
input int    W_InpDrlMode     = 0;      // W_InpDrlMode — 1 = PPO lot multiplier (0..2) · 2 = constant W_InpDrlConst
input double W_InpDrlConst    = 1.0;    // W_InpDrlConst
input bool   W_InpDashboard   = false;   // W_InpDashboard — live status panel + the candle being checked, on the chart
input bool   W_InpVerbose     = false;   // W_InpVerbose — print every fire line

//--- state -----------------------------------------------------------------
datetime W_g_last_bar = 0;
datetime W_g_last_fire = 0;
int      W_g_cool     = 0;
int      W_g_fires    = 0;

// THE FUNNEL. v1.00 fired zero trades over five days of real M5 ticks and the report
// could not say why — "no trades" looks identical whether the 2-bar setup never formed or
// the reaction was never quiet enough. These count the bar at which each candidate
// died, and W_OnDeinit prints them, so a tightening can be aimed instead of guessed.
int W_g_seen = 0, W_g_rej_dir = 0, W_g_rej_loud = 0, W_g_rej_rise = 0, W_g_rej_anom = 0;
int W_g_rej_fake = 0, W_g_rej_react = 0, W_g_rej_body = 0, W_g_rej_quiet = 0, W_g_rej_trend = 0;
int W_g_rej_test = 0;
double W_g_swing_px = 0.0;  // price the leg STARTED from - the structural target (mode 2)
double W_g_eff_avg = 0.0;   // average volume-per-point-of-range over the swing (diagram 9)
double W_g_react_ratio = 0.0;  // the reaction bar's range / average range - drives sizing
#define W_VSISA_MAXLVL 64
double   W_g_lvl_px[W_VSISA_MAXLVL];      // LAW 10: the low a past setup turned from
int      W_g_lvl_side[W_VSISA_MAXLVL];
datetime W_g_lvl_t[W_VSISA_MAXLVL];
int      W_g_lvl_touch[W_VSISA_MAXLVL];
int      W_g_lvl_fired[W_VSISA_MAXLVL];
int      W_g_lvl_n = 0;
int      W_g_retrace_fires = 0;
int W_g_rej_tgt = 0;        // candidates refused because the structural target was too near
int W_g_rej_cap = 0;        // refused: the last setup bar was not the capped, loud one
int W_g_rej_loc = 0;        // refused: the reaction did not close at its own extreme
int W_g_last_span = 0;      // bars in the yardstick on the last judgement, for the log
long W_g_rv_hit = 0, W_g_rv_miss = 0, W_g_ov_hit = 0;

// HOW CLOSE DID WE GET. A funnel says which gate rejected; these say by how much, which
// is the difference between "loosen this threshold a little" and "this law never
// happens on M5 gold at all". Also proves the volume feed is populated — a max of 0
// would mean iRealVolume is empty and every ratio in this file is meaningless.
long   W_g_vmax_seen = 0;
double W_g_best_loud = 0;    // best (weakest 2-bar setup bar / lookback max) reached
double W_g_best_quiet = 999; // lowest (reaction vol / 2-bar setup vol) reached

//+------------------------------------------------------------------+
//| Bar accessors                                                     |
//+------------------------------------------------------------------+
double W_bHigh(int k)  { return iHigh (_Symbol, W_InpTF, k); }
double W_bLow(int k)   { return iLow  (_Symbol, W_InpTF, k); }
double W_bOpen(int k)  { return iOpen (_Symbol, W_InpTF, k); }
double W_bClose(int k) { return iClose(_Symbol, W_InpTF, k); }
double W_bRange(int k) { return W_bHigh(k) - W_bLow(k); }
double W_bBody(int k)  { return MathAbs(W_bClose(k) - W_bOpen(k)); }
bool   W_bUp(int k)    { return W_bClose(k) > W_bOpen(k); }
bool   W_bDown(int k)  { return W_bClose(k) < W_bOpen(k); }

datetime W_g_ov_t[];
long     W_g_ov_v[];
int      W_g_ov_n = 0;
int      W_g_ov_miss = 0;          // lookups that fell back to broker volume
datetime W_g_ov_miss_bar = 0;      // last bar already reported, so one line per bar
datetime W_g_ov_newest = 0;        // newest minute in the table (freshness telemetry)

void W_LoadOandaVol() {
   W_g_ov_n = 0;
   // RETRY (2026-08-21): the writer swaps this file atomically every 60 s, and a
   // read landing inside that swap failed outright — one bar silently on broker
   // volume, logged at 21:46:02. Five quick attempts cover the swap window.
   int h = INVALID_HANDLE;
   for (int _try = 0; _try < 5 && h == INVALID_HANDLE; _try++) {
      h = FileOpen("oanda_vol.csv", FILE_READ | FILE_TXT | FILE_ANSI | FILE_COMMON |
                                FILE_SHARE_READ | FILE_SHARE_WRITE);
      if (h == INVALID_HANDLE && !MQLInfoInteger(MQL_TESTER)) Sleep(40);
   }
   if (h == INVALID_HANDLE) {
      Print("[VSISA] OANDA volume requested but oanda_vol.csv not found — using broker volume");
      return;
   }
   ArrayResize(W_g_ov_t, 8192); ArrayResize(W_g_ov_v, 8192);
   while (!FileIsEnding(h)) {
      string ln = FileReadString(h);
      int c = StringFind(ln, ",");
      if (c <= 0) continue;
      datetime t = StringToTime(StringSubstr(ln, 0, c));
      long v = (long)StringToInteger(StringSubstr(ln, c + 1));
      if (t <= 0) continue;
      if (W_g_ov_n >= ArraySize(W_g_ov_t)) {
         ArrayResize(W_g_ov_t, W_g_ov_n + 4096); ArrayResize(W_g_ov_v, W_g_ov_n + 4096);
      }
      W_g_ov_t[W_g_ov_n] = t; W_g_ov_v[W_g_ov_n] = v; W_g_ov_n++;
   }
   FileClose(h);
   W_g_ov_newest = (W_g_ov_n > 0) ? W_g_ov_t[W_g_ov_n - 1] : 0;
   PrintFormat("[VSISA] OANDA volume table loaded: %d minutes (newest %s)",
               W_g_ov_n, TimeToString(W_g_ov_newest, TIME_DATE | TIME_MINUTES));
}

long W_OandaVolAt(datetime t) {          // binary search the sorted table
   int lo = 0, hi = W_g_ov_n - 1;
   while (lo <= hi) {
      int mid = (lo + hi) / 2;
      if (W_g_ov_t[mid] == t) return W_g_ov_v[mid];
      if (W_g_ov_t[mid] < t) lo = mid + 1; else hi = mid - 1;
   }
   return -1;
}

// ── THE TABLE IS PER-MINUTE; THE CHART NEED NOT BE (2026-09-08) ──────────────────
// Zee: "what if we test our EA on the OANDA, on the 5 minute timeframe instead of 1
// minute. maybe that one is much better due to having a stable trend."
//
// oanda_vol.csv holds ONE ROW PER MINUTE. W_OandaVolAt(iTime(...)) therefore returns the
// volume of the bar's FIRST MINUTE ONLY. On M1 that is the whole bar and correct; on M5
// it is about a fifth of it — and since every UHV test is a comparison BETWEEN bars,
// each reading a different fifth, the entire ranking would be wrong while every number
// still looked plausible. An M5 court run on that would have answered his question with
// noise.
//
// A bar's volume is the SUM of the minutes it spans. Under strict mode a single missing
// minute voids the whole bar: half a candle of his volume is not his candle.
long W_OandaVolSpan(datetime t, int mins) {
   if (mins <= 1) return W_OandaVolAt(t);
   long sum = 0;
   for (int m = 0; m < mins; m++) {
      long v = W_OandaVolAt(t + m * 60);
      if (v <= 0) {
         if (W_InpOandaStrict) return -1;   // an incomplete candle is not his candle
         continue;
      }
      sum += v;
   }
   return (sum > 0) ? sum : -1;
}


// iRealVolume, NOT iVolume. See the header — in the tester iVolume is a constant and
// every ratio in this file would silently become 1.0.
long W_BarVolume(int k) {
   if (W_InpOandaVolume == 1 && W_g_ov_n > 0) {
      long ov = W_OandaVolSpan(iTime(_Symbol, W_InpTF, k),
                             (int)(PeriodSeconds(W_InpTF) / 60));
      if (ov > 0) { W_g_ov_hit++; return ov; }
   }
   // NO SILENT FALLBACK UNDER STRICT MODE. Reaching here with OANDA requested means the
   // table lacks this bar; handing back the broker's number would decide a setup on a
   // feed Zee does not read. -1 propagates and VolWhole() refuses the setup outright.
   if (W_InpOandaVolume == 1 && W_InpOandaStrict) return -1;

   long rv = iRealVolume(_Symbol, W_InpTF, k);
   if (rv > 0) { W_g_rv_hit++; return rv; }
   // WHICH NUMBER IS ACTUALLY BEING JUDGED. On an exchange-traded symbol iRealVolume is
   // contracts; on a CFD the broker often publishes none and this line quietly hands
   // back the TICK COUNT instead. Both are defensible proxies — the teacher reads his
   // own terminal's tick volume — but they are not the same number, and a strategy
   // built on "volume" must be able to say which one it saw. W_OnDeinit prints the split.
   W_g_rv_miss++;
   return iVolume(_Symbol, W_InpTF, k);
}

//+------------------------------------------------------------------+
//| LAW 5 — "big" is relative to the recent past, never a band        |
//|                                                                   |
//| Part 1: "these bands are misleading... compare with the big volumes|
//| of the previous two or three days". So the yardstick is a rolling  |
//| window, and a bar is loud when it stands up against BOTH the peak  |
//| and the average of that window — peak alone lets a merely-average  |
//| bar through on a quiet stretch, average alone lets a mid-sized bar |
//| through next to a genuine climax.                                  |
//+------------------------------------------------------------------+
// How many bars back does the CURRENT SWING run? Walks back from `from` looking for the
// pivot that started this leg — a bar whose high (buy) or low (sell) stands clear of
// W_InpSwingPivot bars on each side. Clamped so a missing pivot cannot return 3 bars or
// the whole chart.
int W_SwingLen(int from, int side) {
   int cap = MathMax(W_InpSwingMin + 1, W_InpVolLookback);
   for (int k = from + W_InpSwingPivot; k < from + cap; k++) {
      bool piv = true;
      for (int q = 1; q <= W_InpSwingPivot && piv; q++) {
         if (side > 0) {                       // buy: the leg began at a swing HIGH
            if (W_bHigh(k) <= W_bHigh(k - q) || W_bHigh(k) <= W_bHigh(k + q)) piv = false;
         } else {                              // sell: at a swing LOW
            if (W_bLow(k) >= W_bLow(k - q) || W_bLow(k) >= W_bLow(k + q)) piv = false;
         }
      }
      if (!piv) continue;
      int len = k - from + 1;
      if (len < W_InpSwingMin) continue;         // too short to judge anything by
      return len;
   }
   return cap;                                  // no pivot found — fall back to the cap
}

bool W_VolStats(int from, long &vmax, double &vavg, double &ravg, int side) {
   vmax = 0; vavg = 0; ravg = 0;
   int span = (W_InpVolWindow == 1) ? W_SwingLen(from, side) : W_InpVolLookback;
   W_g_last_span = span;
   int n = 0;
   // THE LEG ORIGIN. This loop already walks back to the pivot that began the move, so
   // the extreme it passes IS the level price retraced from - mode 2's target.
   W_g_swing_px = (side > 0) ? -1.0 : 1e18;
   double eff = 0.0; int neff = 0;
   for (int k = from; k < from + span; k++) {
      long v = W_BarVolume(k);
      double r = W_bRange(k);
      if (side > 0) { if (W_bHigh(k) > W_g_swing_px) W_g_swing_px = W_bHigh(k); }
      else          { if (W_bLow(k)  < W_g_swing_px) W_g_swing_px = W_bLow(k);  }
      if (v <= 0) continue;
      if (r > 0) { eff += (double)v / r; neff++; }
      if (v > vmax) vmax = v;
      vavg += (double)v;
      ravg += r;
      n++;
   }
   // Half the window is enough to judge by; less than that and we are at the very
   // start of the data with no "recent past" to compare against, so stand down.
   // UNDER STRICT OANDA THE WINDOW MUST BE WHOLE. Skipping absent minutes would quietly
   // shrink the yardstick every setup is measured against — the same feed-mixing one
   // level down that W_InpOandaStrict exists to prevent.
   if (W_InpOandaVolume == 1 && W_InpOandaStrict && n < span) return false;
   if (n < span / 2 || n < 5 || vmax <= 0) return false;
   vavg /= n;
   ravg /= n;
   W_g_eff_avg = (neff > 0) ? eff / neff : 0.0;
   return true;
}

//+------------------------------------------------------------------+
//| LAW 9 — higher-timeframe trend, OFF by default                    |
//| Returns +1 up, -1 down, 0 flat/unknown.                           |
//+------------------------------------------------------------------+
ENUM_TIMEFRAMES W_TrendTf() {
   switch (W_InpTrendTF) {
      case 1:    return PERIOD_M1;
      case 5:    return PERIOD_M5;
      case 15:   return PERIOD_M15;
      case 30:   return PERIOD_M30;
      case 60:   return PERIOD_H1;
      case 240:  return PERIOD_H4;
      case 1440: return PERIOD_D1;
   }
   return PERIOD_H1;
}

//+------------------------------------------------------------------+
//| CAMEL HUMPS — higher highs AND higher lows, or the mirror.        |
//| Zee, LAWS.md: "we call it an uptrend if we're breaking above      |
//| previous highs. and forming new higher lows."                     |
//| Returns +1 up, -1 down, 0 RANGE (which gates nothing).            |
//+------------------------------------------------------------------+
int W_CamelDir(ENUM_TIMEFRAMES tf) {
   int K = MathMax(1, W_InpCamelPivot);
   int look = MathMax(4 * K + 4, W_InpCamelLook);
   double hi[4], lo[4];
   int nh = 0, nl = 0;

   // newest first: a swing high is the highest high of K bars each side
   for (int k = 1 + K; k < look && (nh < 2 || nl < 2); k++) {
      if (nh < 2) {
         bool ph = true;
         double h0 = iHigh(_Symbol, tf, k);
         for (int q = 1; q <= K && ph; q++)
            if (h0 <= iHigh(_Symbol, tf, k - q) || h0 <= iHigh(_Symbol, tf, k + q)) ph = false;
         if (ph) { hi[nh++] = h0; }
      }
      if (nl < 2) {
         bool pl = true;
         double l0 = iLow(_Symbol, tf, k);
         for (int q = 1; q <= K && pl; q++)
            if (l0 >= iLow(_Symbol, tf, k - q) || l0 >= iLow(_Symbol, tf, k + q)) pl = false;
         if (pl) { lo[nl++] = l0; }
      }
   }
   if (nh < 2 || nl < 2) return 0;            // not enough structure to judge

   bool up   = (hi[0] > hi[1]) && (lo[0] > lo[1]);
   bool down = (hi[0] < hi[1]) && (lo[0] < lo[1]);
   if (up)   return  1;
   if (down) return -1;
   return 0;                                   // mixed = range = no opinion
}

int W_TrendDir() {
   if (W_InpTrendTF <= 0) return 0;
   ENUM_TIMEFRAMES tf = W_TrendTf();
   if (W_InpTrendMode == 1) return W_CamelDir(tf);
   int n = MathMax(3, W_InpTrendBars);
   double now  = iClose(_Symbol, tf, 1);
   double then = iClose(_Symbol, tf, n);
   if (now == 0 || then == 0) return 0;
   if (now > then) return 1;
   if (now < then) return -1;
   return 0;
}

bool W_InSession() {
   MqlDateTime t;
   TimeToStruct(TimeCurrent(), t);
   if (W_InpSessFrom <= W_InpSessTo) return (t.hour >= W_InpSessFrom && t.hour < W_InpSessTo);
   return (t.hour >= W_InpSessFrom || t.hour < W_InpSessTo);   // window wrapping midnight
}

int W_OpenDecisions() {
   int n = 0;
   for (int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong tk = PositionGetTicket(i);
      if (tk == 0 || !PositionSelectByTicket(tk)) continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if (PositionGetInteger(POSITION_MAGIC) == W_InpMagicNumber) n++;
   }
   return n;
}

//+------------------------------------------------------------------+
//| The setup.  side = +1 buy, -1 sell.                               |
//|                                                                   |
//| Bar indices are set by W_InpConfirmMode (see below); the 2-bar setup sits |
//| behind the reaction, oldest last. The whole judgement is made on    |
//| CLOSED bars only — a forming bar's volume is a fraction of what it |
//| will end as, and comparing it to a finished bar is the classic way |
//| to invent a signal that evaporates on the next tick.               |
//+------------------------------------------------------------------+
bool W_Detect(int side, double &sl_level, string &why) {
   int nb = MathMax(2, MathMin(3, W_InpSetupBars));

   // THE RUN, COUNTED NOT ASSUMED. He waits for the turn: "it could be three or more
   // reds". So walk back from the bar before the reaction while the bars keep closing
   // the setup's way, and let THAT be the setup. Direction is mandatory here — a run
   // "until the reds stop" has no meaning if the bars need not be red.
   int rr = (W_InpConfirmMode == 1) ? 3 : ((W_InpConfirmMode == 2) ? 2 : 1);
   if (W_InpSetupAuto) {
      int run = 0, gaps = 0, lastOurs = 0;
      for (int k = rr + 1; k <= rr + MathMax(W_InpSetupMin, W_InpSetupMax); k++) {
         bool ours = (side > 0) ? W_bDown(k) : W_bUp(k);
         if (!ours) {
            // The bar touching the reaction must be ours, and the budget is finite.
            if (k == rr + 1 || gaps >= W_InpSetupGaps) break;
            gaps++;
            run++;
            continue;
         }
         run++;
         lastOurs = run;                 // never let the campaign END on a contrary bar
      }
      run = lastOurs;
      if (run < MathMax(2, W_InpSetupMin)) { W_g_rej_dir++; return false; }
      nb = run;
   }

   // WHERE THE REACTION BAR SITS.
   // Mode 0 is his aggressive entry — Part 9: "I take an aggressive entry, my entry is
   // right here" — the reaction bar IS the entry bar, so it is bar 1.
   // Mode 1 is his confirmed entry — Part 9: "after this they did a testing, we call it
   // a NO SUPPLY TEST... if the test has small volume you should wait for the next bar
   // to be bullish, then the setup is confirmed." That costs two bars, so the reaction
   // sits at bar 3 with the test at bar 2 and the confirming bar at bar 1.
   int r = (W_InpConfirmMode == 1) ? 3 : ((W_InpConfirmMode == 2) ? 2 : 1);  // the REACTION bar
   int c0 = r + 1;                              // index of the newest 2-BAR SETUP bar
   int need = c0 + nb + W_InpVolLookback + 2;
   if (Bars(_Symbol, W_InpTF) < need + W_InpVolLookback) return false;

   long vmax; double vavg, ravg;
   if (!W_VolStats(c0 + nb, vmax, vavg, ravg, side)) return false;
   W_g_seen++;
   if (vmax > W_g_vmax_seen) W_g_vmax_seen = vmax;

   //--- LAW 4: the 2-bar setup runs AGAINST the W_trade we are about to take.
   // Buying needs the effort to have been on the way DOWN (bars closing down);
   // that is where the absorbed selling sits.
   long vsum = 0, vmin_setup = 0;
   double worst_loud = 1.0, best_loud_bar = 0.0;
   double ext = (side > 0) ? W_bLow(c0) : W_bHigh(c0);
   int dirGaps = 0;
   for (int q = 0; q < nb; q++) {
      int k = c0 + q;
      if (W_InpStrictDir || W_InpSetupAuto) {
         bool ours = (side > 0) ? W_bDown(k) : W_bUp(k);
         if (!ours) {
            // Spend the same gap budget the run-counter used, instead of refusing outright.
            if (dirGaps >= W_InpSetupGaps) { W_g_rej_dir++; return false; }
            dirGaps++;
         }
      }
      long v = W_BarVolume(k);
      if (v <= 0) return false;

      // LAW 5, two readings of the same sentence. Zee wrote "these volumes will be
      // that SESSION'S HIGHEST VOLUMES" (plural — mode 0, every bar stands up against
      // the rolling peak). Part 8 says "the BIGGEST volume is here", singular — mode 1,
      // one standout bar carries the 2-bar setup while the rest need only beat the average.
      // Mode 0 is the literal reading and is tested first; mode 1 exists because three
      // consecutive bars each at 70% of a rolling maximum may simply never happen.
      double loud = (double)v / (double)vmax;
      if (q == 0 || loud < worst_loud) worst_loud = loud;
      if (loud > best_loud_bar) best_loud_bar = loud;
      if (W_InpBigMode == 0 && (double)v < W_InpBigPct * (double)vmax) {
         if (worst_loud > W_g_best_loud) W_g_best_loud = worst_loud;
         W_g_rej_loud++; return false;
      }
      if ((double)v < W_InpBigAvg * vavg) { W_g_rej_loud++; return false; }

      // LAW 4 — optional: the effort must ESCALATE. Part 4: the second bar's volume
      // higher than the first, the third "even higher than the previous two".
      // HIS SENSE OF RISING: the bar nearest the turn (q == 0, index c0) must be the
      // loudest of the whole run — "the third red candle with even higher volume than
      // previous two".
      if (W_InpRisingVol && q > 0 && v >= W_BarVolume(c0)) { W_g_rej_rise++; return false; }
      vsum += v;
      if (vmin_setup == 0 || v < vmin_setup) vmin_setup = v;
      if (side > 0) ext = MathMin(ext, W_bLow(k));
      else          ext = MathMax(ext, W_bHigh(k));
   }
   double vsetup = (double)vsum / nb;
   if (W_InpBigMode == 1 && best_loud_bar < W_InpBigPct) {
      if (best_loud_bar > W_g_best_loud) W_g_best_loud = best_loud_bar;
      W_g_rej_loud++; return false;
   }
   double reach = (W_InpBigMode == 1) ? best_loud_bar : worst_loud;
   if (reach > W_g_best_loud) W_g_best_loud = reach;

   //--- LAW 7: anomaly — the last 2-bar setup bar spends huge volume for tiny spread.
   if (W_InpAnomaly) {
      if (ravg <= 0) return false;
      if (W_bRange(c0) > W_InpAnomalyMax * ravg) { W_g_rej_anom++; return false; }
   }
   // ...and the other half of the same candle: the effort that bought nothing.
   if (W_InpCapVol > 0.0) {
      if (vavg <= 0) return false;
      if ((double)W_BarVolume(c0) < W_InpCapVol * vavg) { W_g_rej_cap++; return false; }
   }

   // DIAGRAM 9: the same bar judged the way he judges it - volume against distance.
   if (W_InpEffortMin > 0.0) {
      double rc = W_bRange(c0);
      if (rc <= 0 || W_g_eff_avg <= 0) return false;
      if (((double)W_BarVolume(c0) / rc) < W_InpEffortMin * W_g_eff_avg) { W_g_rej_cap++; return false; }
   }

   //--- LAW 13: the fake break. The 2-bar setup must take out a recent extreme, and the
   // reaction must close back INSIDE it — Zee's tier-3 "strongest" case.
   if (W_InpFakeBreak) {
      double lvl = (side > 0) ? W_bLow(c0 + nb) : W_bHigh(c0 + nb);
      for (int k = c0 + nb; k < c0 + nb + W_InpSweepLook; k++) {
         if (side > 0) lvl = MathMin(lvl, W_bLow(k));
         else          lvl = MathMax(lvl, W_bHigh(k));
      }
      if (side > 0) {
         if (ext >= lvl)       { W_g_rej_fake++; return false; }  // never swept the low
         if (W_bClose(r) <= lvl) { W_g_rej_fake++; return false; }  // no close back inside
      } else {
         if (ext <= lvl)       { W_g_rej_fake++; return false; }
         if (W_bClose(r) >= lvl) { W_g_rej_fake++; return false; }
      }
   }

   //--- LAW 2: the reaction names the side.
   if (side > 0 && !W_bUp(r))   { W_g_rej_react++; return false; }
   if (side < 0 && !W_bDown(r)) { W_g_rej_react++; return false; }

   // Part 15: "its closing is strongly bullish". A doji that happens to close a tick
   // up is not a reaction, so the body has to carry the bar.
   double rng1 = W_bRange(r);
   if (rng1 <= 0) return false;
   if (W_bBody(r) < W_InpBodyFrac * rng1) { W_g_rej_body++; return false; }

   W_g_react_ratio = (ravg > 0) ? (rng1 / ravg) : 0.0;

   // "a LARGER SPREAD low volume engulfing reaction candle"
   if (W_InpReactSpread > 0.0) {
      if (ravg <= 0) return false;
      if (rng1 < W_InpReactSpread * ravg) { W_g_rej_body++; return false; }
   }

   // WHERE the close sits, not just how big the body is.
   if (W_InpCloseLoc > 0.0) {
      double loc = (side > 0) ? (W_bClose(r) - W_bLow(r)) / rng1
                              : (W_bHigh(r) - W_bClose(r)) / rng1;
      if (loc < W_InpCloseLoc) { W_g_rej_loc++; return false; }
   }

   if (W_InpEngulf) {
      if (side > 0 && W_bClose(r) <= W_bHigh(c0)) return false;
      if (side < 0 && W_bClose(r) >= W_bLow(c0))  return false;
   }

   //--- LAW 3: THE TRIGGER. The reaction must arrive on LOW volume.
   // Part 15: "the lower the volume on it, the stronger the signal. If a big volume
   // comes, SKIP it, wait more." So this is a veto, not a score.
   long v1 = W_BarVolume(r);
   if (v1 <= 0) return false;
   // WHICH "LOW" DOES HE MEAN? Mode 0 reads it as low RELATIVE TO THE CLIMAX just
   // seen — the collapse he draws on the chart. Mode 1 reads it as low for this market
   // generally, i.e. below the recent average. Volume is strongly autocorrelated, so
   // the bar right after three loud bars is itself usually loud: the two-day probe
   // never got below 0.83x 2-bar setup. Mode 1 exists because if that holds over a month,
   // mode 0 is not a strict rule — it is an impossible one, and the distinction is
   // worth a receipt rather than a guess.
   double vref = (W_InpQuietRef == 1) ? vavg : vsetup;
   double qr = (double)v1 / MathMax(1.0, vref);
   if (qr < W_g_best_quiet) W_g_best_quiet = qr;
   bool quiet = ((double)v1 <= W_InpLowVolPct * vref);

   //--- THE FLOOR (Zee, 2026-09-15). He asked whether a reaction sitting too CLOSE to
   // the selling volume is what fails. Measured over 305 joined fires it is not: the
   // winners' median ratio is 0.856 and the losers' 0.865 — no separation. What the
   // same data does show, in BOTH walk-forward halves independently, is the opposite
   // end: the quietest fifth (below 0.76x) is the WORST group on the book — 36% WR and
   // $6.40 a W_trade against $27 in the middle band. A reaction that dead is not a
   // stronger imbalance, it is nobody turning up, and the move does not follow through.
   // So the shape is a BAND, not a ceiling. This is the floor; it is OFF by default
   // until it survives out-of-sample.
   if (W_InpMinVolPct > 0.0 && (double)v1 < W_InpMinVolPct * vref) { W_g_rej_quiet++; return false; }

   //--- LAW 6: the wick. On a big-volume bar a wick against the move says the volume
   // was aggression that WON, not absorption that is still sitting there — which is
   // the one case the teacher says not to wait on.
   double upper = W_bHigh(r) - MathMax(W_bOpen(r), W_bClose(r));
   double lower = MathMin(W_bOpen(r), W_bClose(r)) - W_bLow(r);
   bool wick = (side > 0) ? (lower >= W_InpWickFrac * rng1)
                          : (upper >= W_InpWickFrac * rng1);

   if (W_InpWickMode == 1 && !wick) { W_g_rej_quiet++; return false; }  // require outright
   if (!quiet) {
      // Part 6: "in the case of aggressive selling, even if a big volume comes, you
      // don't wait — you enter here." Mode 2 is that exception, and ONLY that.
      if (!(W_InpWickMode == 2 && wick)) { W_g_rej_quiet++; return false; }
   }

   //--- THE NO-SUPPLY TEST (W_InpConfirmMode = 1).
   // Part 9: "after this they did a testing — we call it a NO SUPPLY TEST. If the test
   // has a small volume you should wait for the next bar to be bullish, then the setup
   // is confirmed. A big volume on the test would have meant sustained buying."
   //
   // So the test bar must (a) probe BACK toward the 2-bar setup, (b) do it on volume lower
   // than the reaction's, and (c) FAIL to take out the setup extreme — a test that
   // breaks the low is not a test, it is the setup being wrong. Then the bar after it
   // has to close our way, which is the actual entry bar.
   if (W_InpConfirmMode == 1 || W_InpConfirmMode == 2) {
      int tb = (W_InpConfirmMode == 1) ? 2 : 1;      // the TEST bar
      long vt = W_BarVolume(tb);
      if (vt <= 0) { W_g_rej_test++; return false; }
      // MEASURED AGAINST THE CLIMAX, NOT AGAINST THE REACTION. The first cut of this
      // compared the test bar to the reaction bar — but LAW 3 has already forced the
      // reaction to be quiet, so that asked the test to be quieter than something
      // already quiet. It rejected 100% of setups: 48 sweep passes over seven months
      // fired ZERO trades. Every "small volume" the teacher names is small next to the
      // effort that came before it, so the test uses the same reference as LAW 3.
      if ((double)vt > W_InpTestVolPct * vref) { W_g_rej_test++; return false; }
      if (W_InpTestRed) {
         bool against = (side > 0) ? W_bDown(tb) : W_bUp(tb);
         if (!against) { W_g_rej_test++; return false; }
      }
      // A test that BREAKS the setup extreme is not a test, it is the setup being wrong.
      if (side > 0) { if (W_bLow(tb)  <= ext) { W_g_rej_test++; return false; } }
      else          { if (W_bHigh(tb) >= ext) { W_g_rej_test++; return false; } }

      // Mode 1 alone waits for the bar AFTER the test to close our way. Mode 2 treats the
      // test as the reaction itself and enters on it, so there is nothing further to wait for.
      if (W_InpConfirmMode == 1) {
         if (side > 0) {
            if (!W_bUp(1))                { W_g_rej_test++; return false; }
            if (W_bClose(1) <= W_bClose(2)) { W_g_rej_test++; return false; }
         } else {
            if (!W_bDown(1))              { W_g_rej_test++; return false; }
            if (W_bClose(1) >= W_bClose(2)) { W_g_rej_test++; return false; }
         }
      }
   }

   //--- LAW 9 (off by default)
   int td = W_TrendDir();
   if (td != 0 && td != side) { W_g_rej_trend++; return false; }

   //--- LAW 8: the stop. `ext` above is the SETUP's extreme and is still what the
   // fake-break and no-supply tests need, so the stop gets its own reference.
   double sref;
   if (W_InpStopRef == 0)
      sref = (side > 0) ? W_bLow(r) : W_bHigh(r);          // his spec: the reaction candle
   else
      sref = (side > 0) ? MathMin(ext, W_bLow(r))        // the old, wider behaviour
                        : MathMax(ext, W_bHigh(r));
   if (W_InpConfirmMode == 1 || W_InpConfirmMode == 2) {
      // whatever happened after the reaction, the stop has to sit outside everything the
      // setup has already defended - mode 1 has test+confirm, mode 2 has the test alone
      int deep = (W_InpConfirmMode == 1) ? 2 : 1;
      for (int k = 1; k <= deep; k++) {
         if (side > 0) sref = MathMin(sref, W_bLow(k));
         else          sref = MathMax(sref, W_bHigh(k));
      }
   }
   double buf = W_InpSlBufPts * W_Pt();
   sl_level = (side > 0) ? sref - buf : sref + buf;

   why = StringFormat("setup %d bars vol %.0f | swing %d bars (max %d avg %.0f) | "
                      "reaction vol %d = %.2fx%s%s",
                      nb, vsetup, W_g_last_span, (int)vmax, vavg, (int)v1,
                      (double)v1 / MathMax(1.0, vsetup),
                      quiet ? " QUIET" : " LOUD",
                      wick ? " +wick" : "");

   // LAW 10: leave the level behind. The "low line" is the lowest point the pattern
   // reached before it turned - the setup's own extreme or the reaction's, whichever is
   // further - because that is the line he draws and retraces back to.
   if (W_InpRetrace) {
      double line = (side > 0) ? MathMin(ext, W_bLow(r)) : MathMax(ext, W_bHigh(r));
      W_AddLevel(side, line);
   }
   return true;
}

//+------------------------------------------------------------------+
//| W_Fire                                                              |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| LAW 14 — the FADE. Loud opposite bars behind, and each bar our    |
//| way quieter than the last one our way. Tried only after the       |
//| ordinary setup has refused, so it only ever ADDS trades.          |
//+------------------------------------------------------------------+
bool W_DetectFade(int side, double &sl_level, string &why) {
   if (W_InpFadeMode != 1) return false;
   int r = 1;                                   // the reaction is the bar just closed
   if (side > 0 && !W_bUp(r))   return false;
   if (side < 0 && !W_bDown(r)) return false;

   double rng = W_bRange(r);
   if (rng <= 0) return false;
   if (W_bBody(r) < W_InpBodyFrac * rng) return false;

   long v1 = W_BarVolume(r);
   if (v1 <= 0) return false;

   // THE PREVIOUS BAR OUR WAY — the one his eye compares against.
   int prev = -1;
   for (int k = r + 1; k <= r + W_InpFadeLook; k++) {
      bool same = (side > 0) ? W_bUp(k) : W_bDown(k);
      if (same) { prev = k; break; }
   }
   if (prev < 0) return false;
   long vp = W_BarVolume(prev);
   if (vp <= 0) return false;
   if ((double)v1 > W_InpFadePct * vp) return false;      // "reduced alot from one green to another"

   long vmax; double vavg, ravg;
   if (!W_VolStats(r + 1, vmax, vavg, ravg, side)) return false;

   // "the reds are ultra highs" — the loudest bar AGAINST us in the leg.
   long oppMax = 0;
   for (int k = r + 1; k <= r + W_InpFadeLook; k++) {
      bool opp = (side > 0) ? W_bDown(k) : W_bUp(k);
      if (opp) { long v = W_BarVolume(k); if (v > oppMax) oppMax = v; }
   }
   if (oppMax <= 0 || vmax <= 0) return false;
   if ((double)oppMax < W_InpFadeBigPct * (double)vmax) return false;

   // LAW 13 APPLIES HERE TOO. The first cut of this let the fade in without a sweep and
   // it fired 1,455-5,558 times over 8 months - six times worse per unit of drawdown than
   // the shipped setup. His eye was doing more than "greens fading over loud reds": he was
   // looking at a LOW THAT HAD JUST BEEN MADE. That is the fake break, and it is the
   // strongest filter on this project, so the fade has to pass it as well.
   if (W_InpFakeBreak) {
      double lvl = (side > 0) ? W_bLow(r + 1) : W_bHigh(r + 1);
      for (int k = r + 1; k < r + 1 + W_InpSweepLook; k++) {
         if (side > 0) lvl = MathMin(lvl, W_bLow(k));
         else          lvl = MathMax(lvl, W_bHigh(k));
      }
      double legExt = (side > 0) ? W_bLow(r) : W_bHigh(r);
      for (int k = r; k <= r + W_InpFadeLook; k++) {
         if (side > 0) legExt = MathMin(legExt, W_bLow(k));
         else          legExt = MathMax(legExt, W_bHigh(k));
      }
      if (side > 0) {
         if (legExt > lvl)     { W_g_rej_fake++; return false; }
         if (W_bClose(r) <= lvl) { W_g_rej_fake++; return false; }
      } else {
         if (legExt < lvl)     { W_g_rej_fake++; return false; }
         if (W_bClose(r) >= lvl) { W_g_rej_fake++; return false; }
      }
   }

   // the stop hangs off the reaction, exactly as everywhere else
   double sref = (side > 0) ? W_bLow(r) : W_bHigh(r);
   double buf  = W_InpSlBufPts * W_Pt();
   sl_level = (side > 0) ? sref - buf : sref + buf;

   why = StringFormat("FADE %s %d -> %d (%.2fx) | loudest opposite %d = %.2fx swing max %d",
                      (side > 0) ? "greens" : "reds", (int)vp, (int)v1,
                      (double)v1 / vp, (int)oppMax, (double)oppMax / vmax, (int)vmax);
   return true;
}

//--- v1.30 live dashboard ------------------------------------------------------------
double   W_g_dMeta = -1; datetime W_g_dMetaT = 0; double W_g_dExh = -1; ulong W_g_dExhPos = 0;
string   W_g_dState = "starting - waiting for the first candle to close";
string   W_g_dBuy = "-", W_g_dSell = "-", W_g_dFade = "";
datetime W_g_dCandle = 0;
int      W_g_dDay = -1, W_g_dChecked = 0, W_g_dSetups = 0, W_g_dVeto = 0, W_g_dTrades = 0;
int      W_g_dRej[14];
string   W_g_dRejName[14] = {"setup bars not all closing one way", "no loud (high-volume) setup bar", "volume not rising into the turn",
                           "setup bar not a spread anomaly", "no fake break (no sweep of a recent extreme)", "no reaction candle",
                           "reaction body too small", "reaction not quiet enough", "against the higher-timeframe trend",
                           "test / confirmation failed", "target too near", "last setup bar not the capped loud one",
                           "reaction did not close at its extreme", "no setup run before the turn"};
void W_DashSnap(int &v[])
{
   ArrayResize(v, 13);
   v[0] = W_g_rej_dir; v[1] = W_g_rej_loud; v[2] = W_g_rej_rise; v[3] = W_g_rej_anom; v[4] = W_g_rej_fake; v[5] = W_g_rej_react; v[6] = W_g_rej_body;
   v[7] = W_g_rej_quiet; v[8] = W_g_rej_trend; v[9] = W_g_rej_test; v[10] = W_g_rej_tgt; v[11] = W_g_rej_cap; v[12] = W_g_rej_loc;
}
// what one W_Detect() call concluded, from which rejection counter moved
string W_DashWhy(const int &a[], const int &b[], bool found)
{
   if (found) return "SETUP FOUND";
   for (int i = 0; i < 13; i++) if (b[i] > a[i]) { W_g_dRej[i]++; return "rejected: " + W_g_dRejName[i]; }
   W_g_dRej[13]++;
   return "no setup: " + W_g_dRejName[13];
}
void W_DashNewDay() { MqlDateTime d; TimeToStruct(TimeCurrent(), d); if (d.day_of_year != W_g_dDay) { W_g_dDay = d.day_of_year; W_g_dChecked = W_g_dSetups = W_g_dVeto = W_g_dTrades = 0; ArrayInitialize(W_g_dRej, 0); } }
void W_DashLabel(string name, int x, int y, string text, color c, int size)
{
   if (ObjectFind(0, name) < 0) { ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0); ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER); ObjectSetString(0, name, OBJPROP_FONT, "Consolas"); ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false); }
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x); ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetString(0, name, OBJPROP_TEXT, text); ObjectSetInteger(0, name, OBJPROP_COLOR, c); ObjectSetInteger(0, name, OBJPROP_FONTSIZE, size);
}
void W_DashDraw()
{
   if (!W_InpDashboard || (MQLInfoInteger(MQL_TESTER) && !MQLInfoInteger(MQL_VISUAL_MODE))) return;
   string L[]; color C[]; int n = 0;
   #define DL(txt, col) { ArrayResize(L, n + 1); ArrayResize(C, n + 1); L[n] = txt; C[n] = col; n++; }
   int left = (int)(iTime(_Symbol, W_InpTF, 0) + PeriodSeconds(W_InpTF) - TimeCurrent());
   DL(StringFormat("VSISA v1.30  %s M%d  magic %d  lots %.2f", _Symbol, PeriodSeconds(W_InpTF) / 60, W_InpMagicNumber, W_InpLots), clrGold);
   DL(StringFormat("ML: meta %s  regime %s  exhaustion %s", W_InpMetaMode > 0 ? StringFormat("ON (skip < %.2f)", W_InpMetaThr) : "off",
                   W_InpRegimeMode > 0 ? "ON" : "off", W_InpExhMode > 0 ? StringFormat("ON (close at P >= %.2f)", W_InpExhThr) : "off"), clrSilver);
   DL("STATE: " + W_g_dState, clrWhite);
   DL(StringFormat("next candle check in %d:%02d", MathMax(0, left) / 60, MathMax(0, left) % 60), clrSilver);
   int td = W_TrendDir();
   string rg = W_g_mlRegime < 0 ? "-" : StringFormat("cluster %d%s", W_g_mlRegime, ((W_InpRegSkipMask >> W_g_mlRegime) & 1) == 1 && W_InpRegimeMode > 0 ? " (HIGH VOL: entries paused)" : "");
   DL(StringFormat("trend (M%d): %s   regime: %s", W_InpTrendTF, td > 0 ? "UP" : td < 0 ? "DOWN" : "flat/none", rg), clrSilver);
   DL("--- last candle checked: " + (W_g_dCandle > 0 ? TimeToString(W_g_dCandle, TIME_DATE | TIME_MINUTES) : "-") + " ---", clrGoldenrod);
   DL("BUY : " + W_g_dBuy, StringFind(W_g_dBuy, "FOUND") >= 0 ? clrLime : clrWhiteSmoke);
   DL("SELL: " + W_g_dSell, StringFind(W_g_dSell, "FOUND") >= 0 ? clrLime : clrWhiteSmoke);
   if (W_g_dFade != "") DL("FADE: " + W_g_dFade, clrWhiteSmoke);
   if (W_g_dMetaT > 0) DL(StringFormat("last meta-label score %.2f at %s", W_g_dMeta, TimeToString(W_g_dMetaT, TIME_MINUTES)), clrSilver);
   DL("--- open trades ---", clrGoldenrod);
   int open = 0;
   for (int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong tk = PositionGetTicket(i);
      if (tk == 0 || PositionGetInteger(POSITION_MAGIC) != W_InpMagicNumber || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      open++;
      int sd = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? 1 : -1;
      double en = PositionGetDouble(POSITION_PRICE_OPEN), sl = PositionGetDouble(POSITION_SL), tp = PositionGetDouble(POSITION_TP);
      double px = sd > 0 ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double r = sl > 0 && MathAbs(en - sl) > 0 ? sd * (px - en) / MathAbs(en - sl) : 0;
      double flt = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
      ulong pid = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
      DL(StringFormat("%s %.2f @ %.2f  SL %.2f  TP %.2f  |  %s$%.2f  (%.2f R)%s", sd > 0 ? "BUY" : "SELL", PositionGetDouble(POSITION_VOLUME), en, sl, tp,
                      flt >= 0 ? "+" : "-", MathAbs(flt), r, (W_g_dExhPos == pid && W_g_dExh >= 0) ? StringFormat("  exhaustion %.2f", W_g_dExh) : ""), flt >= 0 ? clrLime : clrSalmon);
   }
   if (open == 0) DL("none", clrSilver);
   DL(StringFormat("--- today: %d candles checked, %d setups, %d vetoed by ML, %d trades ---", W_g_dChecked, W_g_dSetups, W_g_dVeto, W_g_dTrades), clrGoldenrod);
   int idx[3] = {-1, -1, -1};
   for (int k = 0; k < 3; k++) { int best = -1; for (int i = 0; i < 14; i++) { bool used = false; for (int j = 0; j < k; j++) if (idx[j] == i) used = true; if (!used && W_g_dRej[i] > 0 && (best < 0 || W_g_dRej[i] > W_g_dRej[best])) best = i; } idx[k] = best; }
   for (int k = 0; k < 3; k++) if (idx[k] >= 0) DL(StringFormat("  %3d x %s", W_g_dRej[idx[k]], W_g_dRejName[idx[k]]), clrSilver);
   // panel
   TextSetFont("Consolas", -90); uint mw = 0, lh = 0;
   for (int i = 0; i < n; i++) { uint w, h; TextGetSize(L[i], w, h); mw = MathMax(mw, w); lh = MathMax(lh, h); }
   lh += 3;
   if (ObjectFind(0, "VSD_bg") < 0) { ObjectCreate(0, "VSD_bg", OBJ_RECTANGLE_LABEL, 0, 0, 0); ObjectSetInteger(0, "VSD_bg", OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, "VSD_bg", OBJPROP_BGCOLOR, C'16,22,36'); ObjectSetInteger(0, "VSD_bg", OBJPROP_BORDER_COLOR, clrGoldenrod); }
   ObjectSetInteger(0, "VSD_bg", OBJPROP_XDISTANCE, 8); ObjectSetInteger(0, "VSD_bg", OBJPROP_YDISTANCE, 22);
   ObjectSetInteger(0, "VSD_bg", OBJPROP_XSIZE, (int)mw + 24); ObjectSetInteger(0, "VSD_bg", OBJPROP_YSIZE, n * (int)lh + 14);
   for (int i = 0; i < n; i++) W_DashLabel("VSD_l" + IntegerToString(i), 18, 29 + i * (int)lh, L[i], C[i], 9);
   for (int i = n; i < 40; i++) ObjectDelete(0, "VSD_l" + IntegerToString(i));
   // the candle being checked: a box + its verdict above it
   if (W_g_dCandle > 0) {
      int sh = iBarShift(_Symbol, W_InpTF, W_g_dCandle);
      double hi = iHigh(_Symbol, W_InpTF, sh), lo = iLow(_Symbol, W_InpTF, sh);
      if (ObjectFind(0, "VSD_box") < 0) { ObjectCreate(0, "VSD_box", OBJ_RECTANGLE, 0, 0, 0, 0, 0); ObjectSetInteger(0, "VSD_box", OBJPROP_SELECTABLE, false); ObjectSetInteger(0, "VSD_box", OBJPROP_FILL, false); ObjectSetInteger(0, "VSD_box", OBJPROP_WIDTH, 2); }
      ObjectSetInteger(0, "VSD_box", OBJPROP_TIME, 0, W_g_dCandle); ObjectSetDouble(0, "VSD_box", OBJPROP_PRICE, 0, hi);
      ObjectSetInteger(0, "VSD_box", OBJPROP_TIME, 1, W_g_dCandle + PeriodSeconds(W_InpTF)); ObjectSetDouble(0, "VSD_box", OBJPROP_PRICE, 1, lo);
      bool any = StringFind(W_g_dBuy + W_g_dSell, "FOUND") >= 0;
      ObjectSetInteger(0, "VSD_box", OBJPROP_COLOR, any ? clrLime : clrGold);
      if (ObjectFind(0, "VSD_tag") < 0) { ObjectCreate(0, "VSD_tag", OBJ_TEXT, 0, 0, 0); ObjectSetInteger(0, "VSD_tag", OBJPROP_SELECTABLE, false); ObjectSetString(0, "VSD_tag", OBJPROP_FONT, "Consolas"); ObjectSetInteger(0, "VSD_tag", OBJPROP_FONTSIZE, 8); ObjectSetInteger(0, "VSD_tag", OBJPROP_ANCHOR, ANCHOR_LEFT_LOWER); }
      double pad = (iHigh(_Symbol, W_InpTF, iHighest(_Symbol, W_InpTF, MODE_HIGH, 20, 0)) - iLow(_Symbol, W_InpTF, iLowest(_Symbol, W_InpTF, MODE_LOW, 20, 0))) * 0.06;
      double top = iHigh(_Symbol, W_InpTF, iHighest(_Symbol, W_InpTF, MODE_HIGH, MathMax(1, sh + 1), 0));
      ObjectSetInteger(0, "VSD_tag", OBJPROP_TIME, 0, W_g_dCandle); ObjectSetDouble(0, "VSD_tag", OBJPROP_PRICE, 0, top + pad);
      ObjectSetString(0, "VSD_tag", OBJPROP_TEXT, any ? "VSISA: SETUP on this candle" : "VSISA checked: " + (StringFind(W_g_dBuy, "no setup") == 0 && StringFind(W_g_dSell, "no setup") == 0 ? "no setup" : "rejected"));
      ObjectSetInteger(0, "VSD_tag", OBJPROP_COLOR, any ? clrLime : clrGold);
   }
   ChartRedraw();
}

//--- machine-learning hooks -----------------------------------------------------
int W_g_mlAtr = INVALID_HANDLE, W_g_mlAtr200 = INVALID_HANDLE, W_g_mlE9 = INVALID_HANDLE, W_g_mlE50 = INVALID_HANDLE;
int W_g_mlRegime = -1, W_g_mlMetaVeto = 0, W_g_mlRegVeto = 0, W_g_mlExh = 0, W_g_mlDrlVeto = 0; double W_g_mlDrlSum = 0; int W_g_mlDrlN = 0;
ulong W_g_mlOpen[];          // positions seen open last tick (to log their outcome when they close)
double W_MlBuf(int h, int s) { double v[1]; return (h != INVALID_HANDLE && CopyBuffer(h, 0, s, 1, v) == 1) ? v[0] : 0.0; }
string W_MlFile(string kind) { return StringFormat("vml_%d_%s.csv", W_InpMlTag, kind); }
void W_MlAppend(string kind, string header, string row)
{
   int h = FileOpen(W_MlFile(kind), FILE_READ | FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_SHARE_READ | FILE_ANSI);
   if (h == INVALID_HANDLE) return;
   if (FileSize(h) == 0) FileWriteString(h, header + "\r\n");
   FileSeek(h, 0, SEEK_END); FileWriteString(h, row + "\r\n"); FileClose(h);
}
double W_MlEr(int n) { double net = MathAbs(W_bClose(1) - W_bClose(n + 1)), path = 0; for (int i = 1; i <= n; i++) path += MathAbs(W_bClose(i) - W_bClose(i + 1)); return path > 0 ? net / path : 0; }
double W_MlRvol(int n) { double r[], m = 0; ArrayResize(r, n); for (int i = 0; i < n; i++) { double a = W_bClose(i + 1), b = W_bClose(i + 2); r[i] = (a > 0 && b > 0) ? MathLog(a / b) : 0; m += r[i]; } m /= n; double v = 0; for (int i = 0; i < n; i++) v += (r[i] - m) * (r[i] - m); return MathSqrt(v / (n - 1)); }
// entry features: order MUST match V_META_NAMES in the trainers
void W_MlFeatures(int side, double entry, double sl, double tp, string why, double &f[])
{
   ArrayResize(f, V_META_NF);
   double atr = MathMax(W_MlBuf(W_g_mlAtr, 1), _Point), atr200 = W_MlBuf(W_g_mlAtr200, 1), risk = MathAbs(entry - sl);
   double c1 = W_bClose(1), e9 = W_MlBuf(W_g_mlE9, 1), e50 = W_MlBuf(W_g_mlE50, 1), e50b = W_MlBuf(W_g_mlE50, 6);
   MqlDateTime dt; TimeToStruct(TimeCurrent(), dt);
   f[0] = side; f[1] = risk / atr; f[2] = (tp > 0 && risk > 0) ? MathMin(MathAbs(tp - entry) / risk, 20) : 0;
   f[3] = W_MlEr(14); f[4] = atr200 > 0 ? atr / atr200 : 1; f[5] = side * (c1 - e50) / atr; f[6] = side * (c1 - e9) / atr;
   f[7] = side * (e50 - e50b) / atr; f[8] = dt.hour; f[9] = dt.day_of_week;
   f[10] = (SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID)) / _Point;
   f[11] = W_g_react_ratio; f[12] = StringFind(why, "FADE") == 0 ? 1 : 0; f[13] = W_TrendDir() * side; f[14] = W_bRange(1) / atr;
}
string W_MlRow(ulong pos, const double &f[], double score, int veto)
{
   string r = StringFormat("%I64u,%s", pos, TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS));
   for (int i = 0; i < V_META_NF; i++) r += StringFormat(",%.8f", f[i]);
   return r + StringFormat(",%.8f,%d", score, veto);
}
string W_MlHeader() { string h = "pos_id,time"; for (int i = 0; i < V_META_NF; i++) h += "," + V_META_NAMES[i]; return h + ",score,veto"; }
// regime features of the candle that just closed: [ER14, ATR14/ATR200, realized vol 14]
bool W_MlRegFeat(double &x[]) { ArrayResize(x, 3); double atr = W_MlBuf(W_g_mlAtr, 1), a2 = W_MlBuf(W_g_mlAtr200, 1); if (atr <= 0 || a2 <= 0) return false; x[0] = W_MlEr(14); x[1] = atr / a2; x[2] = W_MlRvol(14); return true; }
// once per tick: positions that disappeared -> their final net
void W_MlTick()
{
   if (!W_InpMlLog) return;
   ulong now[]; int n = 0;
   for (int i = PositionsTotal() - 1; i >= 0; i--) { ulong t = PositionGetTicket(i); if (t > 0 && PositionGetInteger(POSITION_MAGIC) == W_InpMagicNumber && PositionGetString(POSITION_SYMBOL) == _Symbol) { ArrayResize(now, n + 1); now[n++] = (ulong)PositionGetInteger(POSITION_IDENTIFIER); } }
   for (int k = 0; k < ArraySize(W_g_mlOpen); k++) {
      bool still = false; for (int j = 0; j < n; j++) if (now[j] == W_g_mlOpen[k]) { still = true; break; }
      if (still || !HistorySelectByPosition(W_g_mlOpen[k])) continue;
      double prof = 0, comm = 0, swp = 0, vin = 0;
      for (int d = 0; d < HistoryDealsTotal(); d++) { ulong dl = HistoryDealGetTicket(d); comm += HistoryDealGetDouble(dl, DEAL_COMMISSION);
         if (HistoryDealGetInteger(dl, DEAL_ENTRY) == DEAL_ENTRY_IN) { vin += HistoryDealGetDouble(dl, DEAL_VOLUME); continue; }
         prof += HistoryDealGetDouble(dl, DEAL_PROFIT); swp += HistoryDealGetDouble(dl, DEAL_SWAP); }
      if (comm == 0) comm = -4.0 * vin;
      W_MlAppend("out", "pos_id,profit,commission,swap,net,lots", StringFormat("%I64u,%.2f,%.2f,%.2f,%.2f,%.2f", W_g_mlOpen[k], prof, comm, swp, prof + comm + swp, vin));
   }
   ArrayResize(W_g_mlOpen, n); for (int j = 0; j < n; j++) W_g_mlOpen[j] = now[j];
}
// once per new candle: regime, logs of open positions, exhaustion exit
void W_MlBar()
{
   double x[];
   if ((W_InpRegimeMode > 0 || W_InpMlLog) && W_MlRegFeat(x)) {
      W_g_mlRegime = W_InpRegimeMode > 0 ? V_RegimeOf(x) : -1;
      if (W_InpMlLog) W_MlAppend("reg", "time,kaufman_er,atr_ratio,realized_vol", StringFormat("%s,%.8f,%.8f,%.10f", TimeToString(iTime(_Symbol, W_InpTF, 1), TIME_DATE | TIME_MINUTES), x[0], x[1], x[2]));
   }
   if (W_InpExhMode <= 0 && !W_InpMlLog) return;
   double atr = MathMax(W_MlBuf(W_g_mlAtr, 1), _Point), a2 = W_MlBuf(W_g_mlAtr200, 1);
   for (int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong t = PositionGetTicket(i);
      if (t == 0 || PositionGetInteger(POSITION_MAGIC) != W_InpMagicNumber || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      datetime ot = (datetime)PositionGetInteger(POSITION_TIME);
      if (ot >= iTime(_Symbol, W_InpTF, 0)) continue;
      int side = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? 1 : -1;
      double en = PositionGetDouble(POSITION_PRICE_OPEN), sl = PositionGetDouble(POSITION_SL);
      double px = side > 0 ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double risk = sl > 0 ? MathAbs(en - sl) : atr; if (risk <= 0) risk = atr;
      int bars = iBarShift(_Symbol, W_InpTF, ot);
      double best = side > 0 ? iHigh(_Symbol, W_InpTF, iHighest(_Symbol, W_InpTF, MODE_HIGH, MathMax(1, bars), 1)) : iLow(_Symbol, W_InpTF, iLowest(_Symbol, W_InpTF, MODE_LOW, MathMax(1, bars), 1));
      double e[]; ArrayResize(e, V_EXH_NF);
      double fr = side * (px - en) / risk, mr = MathMax(fr, side * (best - en) / risk);
      MqlDateTime dt; TimeToStruct(TimeCurrent(), dt);
      e[0] = side; e[1] = bars; e[2] = fr; e[3] = mr; e[4] = mr - fr; e[5] = W_MlEr(14); e[6] = side * (W_bClose(1) - W_MlBuf(W_g_mlE50, 1)) / atr;
      e[7] = side * (W_bClose(1) - W_MlBuf(W_g_mlE9, 1)) / atr; e[8] = a2 > 0 ? atr / a2 : 1; e[9] = sl > 0 ? side * (px - sl) / risk : 0;
      e[10] = side * (W_bClose(1) - W_bOpen(1)) / atr; e[11] = dt.hour; e[12] = PositionGetDouble(POSITION_TP) > 0 ? side * (PositionGetDouble(POSITION_TP) - px) / risk : 0;
      double flt = PositionGetDouble(POSITION_PROFIT), p = -1; int closed = 0;
      if (W_InpExhMode == 1 && flt > 0) { p = V_ExhModelProb(e); W_g_dExh = p; W_g_dExhPos = (ulong)PositionGetInteger(POSITION_IDENTIFIER); if (p >= W_InpExhThr && W_trade.PositionClose(t)) { W_g_mlExh++; closed = 1; } }
      if (W_InpMlLog) {
         string r = StringFormat("%I64u,%s", (ulong)PositionGetInteger(POSITION_IDENTIFIER), TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS));
         for (int k = 0; k < V_EXH_NF; k++) r += StringFormat(",%.8f", e[k]);
         string h = "pos_id,time"; for (int k = 0; k < V_EXH_NF; k++) h += "," + V_EXH_NAMES[k];
         W_MlAppend("exh", h + ",float_usd,realized_usd,prob,closed", r + StringFormat(",%.2f,0,%.8f,%d", flt, p, closed));
      }
   }
}

void W_Fire(int side, double sl_level, string why) {
   if (BwVs2Hook(side, sl_level)) return;
   if (W_InpRegimeMode > 0 && W_g_mlRegime >= 0 && ((W_InpRegSkipMask >> W_g_mlRegime) & 1) == 1) { W_g_mlRegVeto++; return; }
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double entry = (side > 0) ? ask : bid;
   double risk  = MathAbs(entry - sl_level);

   // The floor exists because his 2-3 pips are FX pips on a pair whose spread is a
   // fraction of gold's. A stop narrower than the spread is not a tight stop, it is a
   // guaranteed loss on entry.
   double minr = W_InpMinSlPts * W_Pt();
   double maxr = W_InpMaxSlPts * W_Pt();
   if (risk < minr) {
      risk = minr;
      sl_level = (side > 0) ? entry - risk : entry + risk;
   }
   if (risk > maxr) {
      if (W_InpVerbose)
         PrintFormat("[VSISA] refused: risk %.0f pts > cap %d", risk / W_Pt(), W_InpMaxSlPts);
      return;
   }

   double tp = 0.0;
   if (W_InpTargetMode == 1) {
      double d = W_InpTargetPts * W_Pt();
      tp = (side > 0) ? entry + d : entry - d;
   } else if (W_InpTargetMode == 2) {
      tp = W_g_swing_px;                       // the level the leg came FROM
   } else if (W_InpTargetR > 0) {
      tp = (side > 0) ? entry + W_InpTargetR * risk : entry - W_InpTargetR * risk;
   }

   // GUARDS for the decoupled modes. Once the target stops being a multiple of the
   // stop it can land anywhere - on the wrong side of entry, or so close that the
   // spread eats it. Reward is measured in R purely so the two bounds read in the same
   // unit as everything else; it does not re-couple the target to the stop.
   if (tp > 0.0 && W_InpTargetMode != 0) {
      double reward = (side > 0) ? (tp - entry) : (entry - tp);
      if (reward <= 0.0 || reward < W_InpTgtMinR * risk) {
         W_g_rej_tgt++;
         if (W_InpVerbose)
            PrintFormat("[VSISA] refused: target %.2f is %.2fR from entry %.2f (min %.2fR)",
                        tp, reward / MathMax(risk, _Point), entry, W_InpTgtMinR);
         return;
      }
      if (W_InpTgtMaxR > 0.0 && reward > W_InpTgtMaxR * risk) {
         reward = W_InpTgtMaxR * risk;
         tp = (side > 0) ? entry + reward : entry - reward;
      }
   }

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   sl_level = NormalizeDouble(sl_level, dg);
   if (tp > 0) tp = NormalizeDouble(tp, dg);

   // SIZE BY THE GRADE OF THE REACTION, not by conviction in general.
   double lots = W_InpLots;
   if (W_InpRiskPct <= 0.0 && W_InpCompoundBase > 0.0) {
      lots = W_InpLots * AccountInfoDouble(ACCOUNT_EQUITY) / W_InpCompoundBase;
      double m1 = 0.0;
      if (OrderCalcMargin(side > 0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL, _Symbol, 1.0, entry, m1) && m1 > 0)
         lots = MathMin(lots, 0.8 * AccountInfoDouble(ACCOUNT_MARGIN_FREE) / m1 / MathMax(1, W_InpTickets));
      lots = MathMin(lots, W_InpRiskMaxLots);
      double st = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      double lo = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      if (st > 0) lots = MathFloor(lots / st) * st;             // round DOWN
      if (lots < lo) {
         if (W_InpVerbose) PrintFormat("[VSISA] refused: compounding gives %.3f lots, below the minimum %.2f", lots, lo);
         return;
      }
   }
   if (W_InpRiskPct > 0.0) {
      // Money lost on ONE lot if the stop is hit, measured by the terminal itself so
      // contract size, tick value and account currency are all handled.
      double loss1 = 0.0;
      if (!OrderCalcProfit(side > 0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL, _Symbol, 1.0,
                           entry, sl_level, loss1) || loss1 >= 0.0) {
         if (W_InpVerbose) Print("[VSISA] refused: could not price the stop for risk sizing");
         return;
      }
      double budget = AccountInfoDouble(ACCOUNT_EQUITY) * W_InpRiskPct / 100.0;
      double comm1  = 1.12 / 0.28;           // Axi commission per lot ($1.12 per 0.28-lot entry, measured 2026-10-09)
      lots = budget / (MathAbs(loss1) + comm1) / MathMax(1, W_InpTickets);
      // never ask for more margin than is free (the 0.28-lot "not enough money" lesson)
      double m1 = 0.0;
      if (OrderCalcMargin(side > 0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL, _Symbol, 1.0, entry, m1) && m1 > 0)
         lots = MathMin(lots, 0.8 * AccountInfoDouble(ACCOUNT_MARGIN_FREE) / m1 / MathMax(1, W_InpTickets));
      lots = MathMin(lots, W_InpRiskMaxLots);
      double st = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      double lo = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      if (st > 0) lots = MathFloor(lots / st) * st;             // round DOWN: never over-risk
      if (lots < lo) {
         if (W_InpVerbose) PrintFormat("[VSISA] refused: %.1f%% risk buys %.3f lots, below the minimum %.2f",
                                     W_InpRiskPct, lots, lo);
         return;
      }
   }
   if (W_InpSizeBySpread) {
      double m = W_InpSizeM0;
      if      (W_g_react_ratio >= W_InpSizeT2) m = W_InpSizeM2;
      else if (W_g_react_ratio >= W_InpSizeT1) m = W_InpSizeM1;
      lots = W_InpLots * m;
      double st = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      double lo = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      double hi = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
      if (st > 0) lots = MathFloor(lots / st + 0.5) * st;
      if (lo > 0) lots = MathMax(lo, lots);
      if (hi > 0) lots = MathMin(hi, lots);
   }
   // v1.27: every market has its own lot step (gold 0.01, US30 0.1). A fixed W_InpLots that is
   // not a multiple of it is refused by the server ("10014 invalid volume") on EVERY W_trade,
   // which is how the first US30 run fired zero. Snap to the nearest step; gold is unchanged.
   {
      double st = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      double lo = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      if (st > 0) lots = MathRound(lots / st) * st;
      if (lo > 0) lots = MathMax(lo, lots);
      lots = NormalizeDouble(lots, 2);
   }

   // ML: features, meta-label gate, DRL sizing (the EA's own entry/stop/target, computed above)
   double mlf[]; double mlscore = -1;
   bool mlOn = W_InpMlLog || W_InpMetaMode > 0 || W_InpDrlMode > 0;
   if (mlOn) W_MlFeatures(side, entry, sl_level, tp, why, mlf);
   if (W_InpMetaMode > 0) {
      mlscore = V_MetaModelScore(mlf); W_g_dMeta = mlscore; W_g_dMetaT = TimeCurrent();
      if (mlscore < W_InpMetaThr) { W_g_mlMetaVeto++; if (W_InpMlLog) W_MlAppend("feat", W_MlHeader(), W_MlRow(0, mlf, mlscore, 1)); return; }
   }
   if (W_InpDrlMode > 0) {
      double rx[]; double mult = W_InpDrlConst;
      if (W_InpDrlMode == 1 && W_MlRegFeat(rx)) { double o[5]; o[0] = rx[0]; o[1] = rx[1]; o[2] = rx[2]; o[3] = mlf[5]; o[4] = side; mult = MathMax(0.0, MathMin(2.0, V_DrlPolicy(o))); }
      if (mult < 0.1) { W_g_mlDrlVeto++; return; }
      double st = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP), lo = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      lots = NormalizeDouble(MathMax(lo, MathRound(lots * mult / st) * st), 2);
      W_g_mlDrlSum += mult; W_g_mlDrlN++;
   }
   int n = MathMax(1, W_InpTickets);
   int placed = 0;
   for (int i = 0; i < n; i++) {
      string tag = StringFormat("vsisa_%d_%d", W_g_fires, i);
      bool ok = (side > 0) ? W_trade.Buy (lots, _Symbol, 0, sl_level, tp, tag)
                           : W_trade.Sell(lots, _Symbol, 0, sl_level, tp, tag);
      if (ok) placed++;
      if (ok && W_InpMlLog) { ulong pid = W_trade.ResultOrder(); if (HistoryDealSelect(W_trade.ResultDeal())) pid = (ulong)HistoryDealGetInteger(W_trade.ResultDeal(), DEAL_POSITION_ID); W_MlAppend("feat", W_MlHeader(), W_MlRow(pid, mlf, mlscore, 0)); }
   }
   if (placed == 0) {
      if (W_InpVerbose) PrintFormat("[VSISA] send failed: %d %s", W_trade.ResultRetcode(),
                                  W_trade.ResultRetcodeDescription());
      return;
   }
   W_g_fires++;
   W_g_cool = W_InpCoolBars;
   W_g_last_fire = iTime(_Symbol, W_InpTF, 0);

   if (W_InpVerbose)
      PrintFormat("[VSISA] #%d %s %.2f lots @ %.2f SL %.2f (%.0f pts) TP %.2f (%.1fR) | spread %.2fx | %s",
                  W_g_fires, (side > 0) ? "BUY" : "SELL", lots, entry, sl_level,
                  risk / _Point, tp,
                  (tp > 0 ? MathAbs(tp - entry) / MathMax(risk, _Point) : 0.0),
                  W_g_react_ratio, why);
}

//+------------------------------------------------------------------+
//| Breakeven — LAW 8's optional half                                 |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| THE RATCHET — lock the highest R rung the W_trade has reached.       |
//+------------------------------------------------------------------+
void W_RatchetCheck() {
   if (W_InpRatchetStart <= 0.0 || W_InpRatchetStep <= 0.0) return;
   for (int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong tk = PositionGetTicket(i);
      if (tk == 0 || !PositionSelectByTicket(tk)) continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if (PositionGetInteger(POSITION_MAGIC) != W_InpMagicNumber) continue;

      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl   = PositionGetDouble(POSITION_SL);
      double tp   = PositionGetDouble(POSITION_TP);
      long   type = PositionGetInteger(POSITION_TYPE);

      // The ORIGINAL risk, which the ratchet has usually already eaten into, so it is
      // rebuilt from the target rather than from the live stop.
      double risk = 0.0;
      if (tp > 0 && W_InpTargetR > 0)
         risk = MathAbs(tp - open) / W_InpTargetR;
      if (risk <= 0.0 && sl > 0) risk = MathAbs(open - sl);
      if (risk <= 0.0) continue;

      double px = (type == POSITION_TYPE_BUY)
                ? SymbolInfoDouble(_Symbol, SYMBOL_BID)
                : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double gained = ((type == POSITION_TYPE_BUY) ? (px - open) : (open - px)) / risk;
      if (gained < W_InpRatchetStart) continue;

      // highest rung actually reached
      double rungs = MathFloor((gained - W_InpRatchetStart) / W_InpRatchetStep);
      double lock  = W_InpRatchetStart + rungs * W_InpRatchetStep;
      if (lock <= 0.0) continue;

      double want = (type == POSITION_TYPE_BUY) ? open + lock * risk
                                                : open - lock * risk;
      want = NormalizeDouble(want, _Digits);
      // never backwards, and never through the market
      if (type == POSITION_TYPE_BUY  && (want <= sl || want >= px)) continue;
      if (type == POSITION_TYPE_SELL && (want >= sl || want <= px)) continue;
      W_trade.PositionModify(tk, want, tp);
   }
}

void W_BreakEvenCheck() {
   if (W_InpBreakEvenR <= 0) return;
   for (int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong tk = PositionGetTicket(i);
      if (tk == 0 || !PositionSelectByTicket(tk)) continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if (PositionGetInteger(POSITION_MAGIC) != W_InpMagicNumber) continue;

      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl   = PositionGetDouble(POSITION_SL);
      double tp   = PositionGetDouble(POSITION_TP);
      if (sl == 0) continue;
      long   type = PositionGetInteger(POSITION_TYPE);
      double risk = MathAbs(open - sl);
      if (risk <= 0) continue;

      double px = (type == POSITION_TYPE_BUY)
                ? SymbolInfoDouble(_Symbol, SYMBOL_BID)
                : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double gained = (type == POSITION_TYPE_BUY) ? (px - open) : (open - px);
      if (gained < W_InpBreakEvenR * risk) continue;

      // already at or past breakeven — nothing to do
      if (type == POSITION_TYPE_BUY  && sl >= open) continue;
      if (type == POSITION_TYPE_SELL && sl <= open) continue;
      W_trade.PositionModify(tk, NormalizeDouble(open, _Digits), tp);
   }
}

//+------------------------------------------------------------------+
int W_OnInit() {
   EventSetTimer(1);
   W_g_mlAtr = iATR(_Symbol, W_InpTF, 14); W_g_mlAtr200 = iATR(_Symbol, W_InpTF, 200);
   W_g_mlE9 = iMA(_Symbol, W_InpTF, 9, 0, MODE_EMA, PRICE_CLOSE); W_g_mlE50 = iMA(_Symbol, W_InpTF, 50, 0, MODE_EMA, PRICE_CLOSE);
   if (W_InpMlLog && MQLInfoInteger(MQL_TESTER)) { string k[] = {"feat", "out", "exh", "reg"}; for (int i = 0; i < 4; i++) FileDelete(W_MlFile(k[i]), FILE_COMMON); }
   if (W_InpOandaVolume == 1) W_LoadOandaVol();
   W_trade.SetExpertMagicNumber(W_InpMagicNumber);
   W_trade.SetTypeFillingBySymbol(_Symbol);
   W_trade.SetDeviationInPoints(30);
   // KEEP THIS STRING IN STEP WITH #property version — the Diamond's banner said
   // v1.14 for nine versions and nobody could tell from a log which build was live.
   // THE BANNER MUST DESCRIBE THE BUILD THAT IS RUNNING. It was still announcing
   // "2-bar setup 2 bars" after the run became self-counting, and said nothing about
   // the swing window or which candle the stop hangs from - the three things that
   // actually changed. A banner that misreports the build is worse than no banner.
   PrintFormat("[VSISA] v1.30 (ML: meta %d thr %.2f, regime skip %d, exhaustion %d thr %.2f) - setup %s | vol vs %s | big>=%.2fxmax/%.2fxavg | "
               "reaction<=%.2fx %s | stop %s +%dpts (floor %d cap %d) | TP %.1fR BE %.1fR "
               "| trendTF %d wick %d confirm %d anomaly %d fake %d | feed %s "
               "| %s x%d | magic %d",
               W_InpMetaMode, W_InpMetaThr, W_InpRegimeMode > 0 ? W_InpRegSkipMask : 0, W_InpExhMode, W_InpExhThr,
               W_InpSetupAuto ? StringFormat("AUTO %d-%d bars", W_InpSetupMin, W_InpSetupMax)
                            : StringFormat("fixed %d bars", W_InpSetupBars),
               (W_InpVolWindow == 1) ? StringFormat("SWING (pivot %d min %d cap %d)",
                                                  W_InpSwingPivot, W_InpSwingMin, W_InpVolLookback)
                                   : StringFormat("last %d bars", W_InpVolLookback),
               W_InpBigPct, W_InpBigAvg,
               W_InpLowVolPct, (W_InpQuietRef == 1) ? "avg" : "setup",
               (W_InpStopRef == 0) ? "under REACTION candle" : "under whole setup",
               W_InpSlBufPts, W_InpMinSlPts, W_InpMaxSlPts,
               W_InpTargetR, W_InpBreakEvenR,
               W_InpTrendTF, W_InpWickMode, W_InpConfirmMode, (int)W_InpAnomaly, (int)W_InpFakeBreak,
               (W_InpOandaVolume == 1) ? (W_InpOandaStrict ? "OANDA-STRICT" : "OANDA")
                                     : "BROKER-TICKS",
               (W_InpRiskPct > 0 ? StringFormat("RISK %.2f%% of equity (cap %.2f lots)", W_InpRiskPct, W_InpRiskMaxLots)
                               : (W_InpCompoundBase > 0 ? StringFormat("%.2f lots per $%.0f equity (compounding)", W_InpLots, W_InpCompoundBase)
                                                    : StringFormat("%.2f lots", W_InpLots))),
               W_InpTickets, W_InpMagicNumber);

   // WHICH NUMBER IS THIS BROKER ACTUALLY GIVING US (2026-09-12).
   // Zee moved VSISA to Axi because "AXI volume happens to be more accurate on the
   // VSISA strategy". Whether that is true is a FACT ABOUT THE FEED, and it is knowable
   // in one line at startup instead of guessed: on Blueberry iRealVolume returned 0 for
   // gold CFD on every one of 8,006,496 reads, so the strategy silently ran on tick
   // count. This says out loud which one Axi hands back, on the symbol actually attached.
   {
      long rv = 0, tv = 0; int probed = 0;
      for (int k = 1; k <= 20; k++) {
         long r = iRealVolume(_Symbol, W_InpTF, k);
         long t = iVolume(_Symbol, W_InpTF, k);
         if (t > 0) { rv += r; tv += t; probed++; }
      }
      if (probed == 0)
         Print("[VSISA] FEED PROBE: no bars yet — check again once history loads");
      else if (rv > 0)
         PrintFormat("[VSISA] FEED PROBE on %s: REAL VOLUME available (%d bars: real %I64d "
                     "vs tick %I64d). W_BarVolume() will judge on REAL volume.",
                     _Symbol, probed, rv, tv);
      else
         PrintFormat("[VSISA] FEED PROBE on %s: no real volume (%d bars, tick total "
                     "%I64d). W_BarVolume() falls back to TICK COUNT, same as Blueberry.",
                     _Symbol, probed, tv);
   }

   return INIT_SUCCEEDED;
}

void W_OnDeinit(const int reason) {
   EventKillTimer(); ObjectsDeleteAll(0, "VSD_");
   PrintFormat("[VSISA-ML] meta vetoed %d | regime vetoed %d | exhaustion closes %d | DRL avg x%.3f over %d, skipped %d", W_g_mlMetaVeto, W_g_mlRegVeto, W_g_mlExh, W_g_mlDrlN > 0 ? W_g_mlDrlSum / W_g_mlDrlN : 0, W_g_mlDrlN, W_g_mlDrlVeto);
   PrintFormat("[VSISA] stopped, %d decisions taken", W_g_fires);
   // The funnel, widest gate first. Whichever line eats the candidates is the law to
   // aim a variant at — guessing which one is what cost the first five-day run.
   PrintFormat("[VSISA] FUNNEL candidates %d | dir %d | not loud %d | not rising %d | "
               "anomaly %d | fake %d | reaction %d | body %d | not quiet %d | test %d "
               "| trend %d | FIRED %d",
               W_g_seen, W_g_rej_dir, W_g_rej_loud, W_g_rej_rise, W_g_rej_anom, W_g_rej_fake,
               W_g_rej_react, W_g_rej_body, W_g_rej_quiet, W_g_rej_test, W_g_rej_trend, W_g_fires);
   PrintFormat("[VSISA] FUNNEL target-too-near %d | cap-bar %d | close-loc %d",
               W_g_rej_tgt, W_g_rej_cap, W_g_rej_loc);
   PrintFormat("[VSISA] VOLUME SOURCE OANDA %I64d | iRealVolume %I64d | broker tick "
               "count %I64d — %s", W_g_ov_hit, W_g_rv_hit, W_g_rv_miss,
               (W_g_ov_hit > 0 && W_g_rv_miss == 0 && W_g_rv_hit == 0)
                   ? "ALL OANDA (his feed)"
                   : ((W_g_ov_hit == 0 && W_g_rv_hit == 0)
                      ? "EVERY judgement used BROKER TICK COUNT" : "MIXED"));
   PrintFormat("[VSISA] REACH loudest lookback max %d | best 2-bar setup/max %.2f "
               "(need %.2f) | best reaction/2-bar setup %.2f (need %.2f)",
               (int)W_g_vmax_seen, W_g_best_loud, W_InpBigPct,
               (W_g_best_quiet > 900 ? -1.0 : W_g_best_quiet), W_InpLowVolPct);
}

void W_AddLevel(int side, double px) {
   if (W_g_lvl_n >= W_VSISA_MAXLVL) {           // drop the oldest to make room
      for (int k = 1; k < W_g_lvl_n; k++) {
         W_g_lvl_px[k-1] = W_g_lvl_px[k];   W_g_lvl_side[k-1]  = W_g_lvl_side[k];
         W_g_lvl_t[k-1]  = W_g_lvl_t[k];    W_g_lvl_touch[k-1] = W_g_lvl_touch[k];
         W_g_lvl_fired[k-1] = W_g_lvl_fired[k];
      }
      W_g_lvl_n--;
   }
   W_g_lvl_px[W_g_lvl_n]    = px;
   W_g_lvl_side[W_g_lvl_n]  = side;
   W_g_lvl_t[W_g_lvl_n]     = iTime(_Symbol, W_InpTF, 0);
   W_g_lvl_touch[W_g_lvl_n] = 0;
   W_g_lvl_fired[W_g_lvl_n] = 0;
   W_g_lvl_n++;
}

void W_DropLevel(int i) {
   for (int k = i + 1; k < W_g_lvl_n; k++) {
      W_g_lvl_px[k-1] = W_g_lvl_px[k];   W_g_lvl_side[k-1]  = W_g_lvl_side[k];
      W_g_lvl_t[k-1]  = W_g_lvl_t[k];    W_g_lvl_touch[k-1] = W_g_lvl_touch[k];
      W_g_lvl_fired[k-1] = W_g_lvl_fired[k];
   }
   W_g_lvl_n--;
}

//+------------------------------------------------------------------+
//| LAW 10 — price comes back to a level a setup already turned from. |
//| A touch that CLOSES BACK on the right side is the entry; touches  |
//| accumulate, so W_InpRetraceMin can demand the "several times" he    |
//| says makes the move stronger.                                     |
//+------------------------------------------------------------------+
void W_RetraceCheck() {
   if (!W_InpRetrace || W_g_lvl_n == 0) return;
   datetime now = iTime(_Symbol, W_InpTF, 0);
   int ps = (int)PeriodSeconds(W_InpTF);
   if (ps <= 0) return;
   double tol = W_InpRetraceTol * W_Pt();
   double buf = W_InpSlBufPts * W_Pt();

   for (int i = W_g_lvl_n - 1; i >= 0; i--) {
      int age = (int)((now - W_g_lvl_t[i]) / ps);
      if (age > W_InpRetraceBars || W_g_lvl_fired[i] >= W_InpRetraceMax) { W_DropLevel(i); continue; }
      if (age < 1) continue;                       // not the setup's own bar

      double lvl = W_g_lvl_px[i];
      bool touched, held;
      if (W_g_lvl_side[i] > 0) { touched = (W_bLow(1)  <= lvl + tol); held = (W_bClose(1) > lvl); }
      else                   { touched = (W_bHigh(1) >= lvl - tol); held = (W_bClose(1) < lvl); }
      if (!touched) continue;

      W_g_lvl_touch[i]++;                            // count it even if it did not hold
      if (!held || W_g_lvl_touch[i] < W_InpRetraceMin) continue;

      // No supply on the retest, or it is just a price touch.
      if (W_InpRetraceQuiet > 0.0) {
         double av = W_AvgVolN(W_InpTestAvgBars);
         long   vt = W_BarVolume(1);
         if (av <= 0 || vt <= 0) continue;
         if ((double)vt > W_InpRetraceQuiet * av) continue;
      }
      if (W_OpenDecisions() >= W_InpMaxOpen) continue;

      double sl = (W_g_lvl_side[i] > 0) ? lvl - buf : lvl + buf;
      W_g_retrace_fires++;
      W_g_react_ratio = 0.0;       // a level touch has no reaction bar to grade
      W_Fire(W_g_lvl_side[i], sl,
           StringFormat("RETRACE touch %d of level %.2f (set %d bars ago)",
                        W_g_lvl_touch[i], lvl, age));
      W_g_lvl_fired[i]++;
   }
}

double W_AvgVolN(int n) {
   double a = 0; int c = 0;
   for (int k = 1; k <= n; k++) {
      long v = W_BarVolume(k);
      if (v > 0) { a += (double)v; c++; }
   }
   return (c > 0) ? a / c : 0.0;
}

//+------------------------------------------------------------------+
//| The no-supply test, applied to a W_trade that is ALREADY OPEN.      |
//| Runs once per closed bar. Called from the new-bar block.          |
//+------------------------------------------------------------------+
void W_TestExitCheck() {
   if (W_InpTestExit <= 0.0) return;
   double av = W_AvgVolN(W_InpTestAvgBars);
   if (av <= 0) return;
   long v1 = W_BarVolume(1);
   if (v1 <= 0) return;
   if ((double)v1 < W_InpTestExit * av) return;      // not a loud test - nothing to say

   datetime now = iTime(_Symbol, W_InpTF, 0);
   int      ps  = (int)PeriodSeconds(W_InpTF);
   for (int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong tk = PositionGetTicket(i);
      if (tk == 0 || !PositionSelectByTicket(tk)) continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if (PositionGetInteger(POSITION_MAGIC) != W_InpMagicNumber) continue;

      long type = PositionGetInteger(POSITION_TYPE);
      // The test closes AGAINST the W_trade - that is what makes it a test of supply.
      bool against = (type == POSITION_TYPE_BUY) ? W_bDown(1) : W_bUp(1);
      if (!against) continue;

      datetime ot = (datetime)PositionGetInteger(POSITION_TIME);
      if (ps <= 0) continue;
      int bars = (int)((now - ot) / ps);
      if (bars < 1 || bars > W_InpTestWindow) continue;

      if (W_trade.PositionClose(tk) && W_InpVerbose)
         PrintFormat("[VSISA] no-supply test FAILED %d bar(s) in: test vol %I64d >= %.2fx avg %.0f - closing #%I64u",
                     bars, v1, W_InpTestExit, av, tk);
   }
}

//+------------------------------------------------------------------+
//| Has today's realised loss on this magic passed the line?           |
//+------------------------------------------------------------------+
bool W_DayLossHit() {
   if (W_InpDayLossStop <= 0.0) return false;
   datetime now = TimeCurrent();
   MqlDateTime dt;
   TimeToStruct(now, dt);
   dt.hour = 0; dt.min = 0; dt.sec = 0;
   datetime d0 = StructToTime(dt);
   if (!HistorySelect(d0, now + 60)) return false;

   double p = 0.0;
   int nd = HistoryDealsTotal();
   for (int i = 0; i < nd; i++) {
      ulong tk = HistoryDealGetTicket(i);
      if (tk == 0) continue;
      if (HistoryDealGetString(tk, DEAL_SYMBOL) != _Symbol) continue;
      if (HistoryDealGetInteger(tk, DEAL_MAGIC) != W_InpMagicNumber) continue;
      if (HistoryDealGetInteger(tk, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;
      p += HistoryDealGetDouble(tk, DEAL_PROFIT)
         + HistoryDealGetDouble(tk, DEAL_COMMISSION)
         + HistoryDealGetDouble(tk, DEAL_SWAP);
   }
   return (p <= -W_InpDayLossStop);
}

void W_OnTick() {
   W_MlTick();
   W_BreakEvenCheck();
   W_RatchetCheck();

   // One decision per closed bar. Everything this EA judges is a finished bar, so
   // running the detector on every tick would only re-answer the same question.
   datetime t = iTime(_Symbol, W_InpTF, 0);
   if (t == W_g_last_bar) { static uint lastDraw = 0; if (GetTickCount() - lastDraw > 1000) { W_DashDraw(); lastDraw = GetTickCount(); } return; }
   W_g_last_bar = t;
   W_MlBar();
   W_DashNewDay();

   W_TestExitCheck();
   W_RetraceCheck();

   W_g_dCandle = iTime(_Symbol, W_InpTF, 1); W_g_dFade = "";
   if (W_DayLossHit()) { W_g_dState = "daily loss limit hit - no new trades today"; W_g_dBuy = W_g_dSell = "not checked"; W_DashDraw(); return; }
   if (W_g_cool > 0) { W_g_cool--; W_g_dState = StringFormat("cooling down after a W_trade: %d more candle(s)", W_g_cool); W_g_dBuy = W_g_dSell = "not checked"; W_DashDraw(); return; }
   if (!W_InSession()) { W_g_dState = StringFormat("outside trading hours (%02d:00-%02d:00 broker time)", W_InpSessFrom, W_InpSessTo); W_g_dBuy = W_g_dSell = "not checked"; W_DashDraw(); return; }
   if (W_OpenDecisions() >= W_InpMaxOpen) { W_g_dState = StringFormat("managing %d open W_trade(s) - limit reached, no new setups", W_OpenDecisions()); W_g_dBuy = W_g_dSell = "not checked"; W_DashDraw(); return; }

   double sl = 0;
   string why = "";
   W_g_dChecked++;
   W_g_dState = W_OpenDecisions() > 0 ? "managing open W_trade(s) + watching each candle for a new setup" : "waiting for a setup - checking every closed candle";
   int a[], b[]; bool got;
   int fires0 = W_g_fires, veto0 = W_g_mlMetaVeto + W_g_mlRegVeto;
   W_DashSnap(a); got = W_InpBuys && W_Detect(+1, sl, why); W_DashSnap(b); W_g_dBuy = W_InpBuys ? W_DashWhy(a, b, got) : "buys disabled";
   if (got) { W_g_dSetups++; W_Fire(+1, sl, why); W_DashAfterFire(fires0, veto0, +1); return; }
   W_DashSnap(a); got = W_InpSells && W_Detect(-1, sl, why); W_DashSnap(b); W_g_dSell = W_InpSells ? W_DashWhy(a, b, got) : "sells disabled";
   if (got) { W_g_dSetups++; W_Fire(-1, sl, why); W_DashAfterFire(fires0, veto0, -1); return; }
   // LAW 14 only gets a look once the ordinary setup has said no.
   if (W_InpBuys  && W_DetectFade(+1, sl, why)) { W_g_dFade = "BUY fade setup FOUND"; W_g_dSetups++; W_Fire(+1, sl, why); W_DashAfterFire(fires0, veto0, +1); return; }
   if (W_InpSells && W_DetectFade(-1, sl, why)) { W_g_dFade = "SELL fade setup FOUND"; W_g_dSetups++; W_Fire(-1, sl, why); W_DashAfterFire(fires0, veto0, -1); return; }
   W_DashDraw();
}
void W_DashAfterFire(int fires0, int veto0, int side)
{
   string sd = side > 0 ? "BUY" : "SELL";
   if (W_g_fires > fires0) { W_g_dTrades++; W_g_dState = sd + " W_trade OPENED on this candle"; }
   else if (W_g_mlMetaVeto + W_g_mlRegVeto > veto0) { W_g_dVeto++; W_g_dState = sd + StringFormat(" setup VETOED by the ML filter (%s)", W_g_mlRegVeto > 0 && W_g_mlMetaVeto == 0 ? "regime" : StringFormat("meta score %.2f < %.2f", W_g_dMeta, W_InpMetaThr)); }
   else W_g_dState = sd + " setup found but refused (risk too big / target too near / order failed)";
   W_DashDraw();
}
//+------------------------------------------------------------------+
void W_OnTimer() { W_DashDraw(); }   // v1.30: keep the panel and the countdown live between ticks
