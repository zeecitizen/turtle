//@version=5
// =====================================================================================
//  VSISA VOLUME - the campaign, coloured on the volume bars themselves
//
//  Zee, 2026-09-19: "can we highlight the volumes which are 2+ one way by either
//  coloring the volume bar or marking it with an arrow?"
//
//  TradingView's built-in volume lives in its own pane and an overlay script cannot
//  recolour it, so this REPLACES it: same histogram, coloured by what the run is doing.
//  Put VSISA Setups on the price chart and this underneath it.
//
//  THREE COLOURS, AND ONLY THREE:
//    RED      a selling campaign - EVERY bar of the run, including its first
//    TEAL     a buying campaign
//    YELLOW   the reaction - labelled QUIET or WICK so the reason is on the bar
//    dim grey everything else - not part of anything he trades
//
//  Words, not symbols. Zee: "instead of diamonds can u write labels.. because its hard
//  to track so many colors / diamonds etc". A shape has to be remembered; a word does
//  not, and in a fast session that difference is the whole point of the display.
//
//  Heavy is measured the same two ways as the setups script, because they are different
//  tests and the choice matters: AVERAGE of the last N, or PEAK (the run's loudest bar
//  against the loudest of the last N - what VSISA the EA actually demands at 0.70x).
//
//  TradingView convention throughout: a bar is buying when close > open. MT5 colours
//  volume by comparison with the PREVIOUS bar, which says nothing about direction.
// =====================================================================================
indicator("VSISA Volume", overlay = false, format = format.volume, precision = 0, max_labels_count = 500)

//  SYNCED WITH VSISA_Setups.pine, 2026-09-21. These had drifted badly: this pane was
//  still on PEAK / 0.85 / 0.25 from the day it was written, while the setups script moved
//  to AVERAGE / 1.20 / 0.70 / 0.15 and a per-direction minimum. So the coloured volume
//  bars were answering a DIFFERENT question from the labels above them - a run could show
//  grey here and be a perfectly good campaign there. Zee hit exactly that on 18 Sep 14:10:
//  "campaign before is marked grey due to low volume so this is never considered a setup".
//  Two scripts on one chart must agree about what a campaign is, or the chart argues with
//  itself and there is no way to tell which half is right.
minRun = input.int(2,    "Minimum bars to call it a run (BUY setups)", minval = 1)
minRunSell = input.int(3, "...and for SELL setups", minval = 1)
//  MIRRORS VSISA_Setups.pine's sellSoft. Zee, 2026-09-25: "yes make them agree".
//  The campaign colouring here used minRun for BOTH directions while the setups script
//  used minRunSell for the sell side. With sellSoft ON the two happen to agree, because
//  it admits sells at the buy-side minimum too - but switch sellSoft off over there and
//  this pane would go on colouring 2-bar rises that the labels above had stopped
//  accepting. Same class of drift the two scripts were re-synced for on 2026-09-21, and
//  the reason it matters is that Zee reads them together: a grey bar has to mean the
//  same thing in both panes or neither can be trusted.
//  KEEP THIS EQUAL TO sellSoft IN THE SETUPS SCRIPT. There is no way for one Pine script
//  to read another's inputs, so this is a hand-kept pair - which is exactly why it is
//  written down here rather than left as a matching default.
sellSoft = input.bool(true, "Colour shorter SELL campaigns too (match Setups)")
maxRun = input.int(8,    "Most bars to count back",        minval = 2)
method = input.string("AVERAGE of last N", "Heavy measured against", options = ["AVERAGE of last N", "PEAK (like the EA)"])
lookN  = input.int(20,   "N bars for that yardstick", minval = 5)
avgX   = input.float(1.20, "AVERAGE: run avg >= x average", step = 0.05)
pkX    = input.float(0.70, "PEAK: run's loudest >= x peak",  step = 0.05)
quietRef = input.string("LAST bar of the campaign", "Low volume measured against", options = ["LAST bar of the campaign", "campaign AVERAGE", "campaign PEAK"])
relX   = input.float(0.70, "Reaction: volume <= x that reference", step = 0.05)
wickX  = input.float(0.15, "...OR a rejection wick >= x of range", step = 0.05)
showAvg = input.bool(true, "Draw the average line")

dir = close > open ? 1 : close < open ? -1 : 0

// --- how long is the run ENDING ON THIS BAR, and how loud
runLen  = 0
runVol  = 0.0
runPeak = 0.0
if dir != 0
    for k = 0 to maxRun - 1
        d = close[k] > open[k] ? 1 : close[k] < open[k] ? -1 : 0
        if d != dir
            break
        runLen  += 1
        runVol  += volume[k]
        runPeak := math.max(runPeak, volume[k])
campAvg = runLen > 0 ? runVol / runLen : 0.0

volAvgN  = ta.sma(volume, lookN)
volPeakN = ta.highest(volume, lookN)
heavy = method == "AVERAGE of last N" ? campAvg >= volAvgN[runLen] * avgX : runPeak >= volPeakN[runLen] * pkX
//  ONE MINIMUM PER DIRECTION, the same arithmetic as the setups script. dir > 0 is a
//  BUYING run, so the setup that would follow it is a SELL - and that is the side
//  minRunSell governs. See the sellSoft note above.
minRunSellAdmit = sellSoft ? math.min(minRun, minRunSell) : minRunSell
minRunHere = dir > 0 ? minRunSellAdmit : minRun
inRun      = runLen >= minRunHere
isCampaign = inRun and heavy

// --- the reaction: this bar goes the other way to the run behind it, and shows absorption
prevDir  = dir[1]
pLen = 0
pVol = 0.0
pPeak = 0.0
if dir != 0 and prevDir != 0 and dir != prevDir
    for k = 1 to maxRun
        d = close[k] > open[k] ? 1 : close[k] < open[k] ? -1 : 0
        if d != prevDir
            break
        pLen  += 1
        pVol  += volume[k]
        pPeak := math.max(pPeak, volume[k])
pAvg = pLen > 0 ? pVol / pLen : 0.0
pHeavy = method == "AVERAGE of last N" ? pAvg >= volAvgN[pLen + 1] * avgX : pPeak >= volPeakN[pLen + 1] * pkX
rng   = high - low
wick  = prevDir < 0 ? (math.min(open, close) - low) : (high - math.max(open, close))
qBase = quietRef == "LAST bar of the campaign" ? volume[1] : quietRef == "campaign PEAK" ? pPeak : pAvg
quiet = qBase > 0 and volume <= qBase * relX
wickd = rng > 0 and (wick / rng) >= wickX
//  same per-direction minimum as the setups script: prevDir > 0 is a BUYING campaign,
//  so the reaction after it is a SELL, and that is the side needing the longer run.
//  ...and the same softening, so the YELLOW reaction bar appears under exactly the sells
//  the setups script is willing to label. Without this the pane would withhold the yellow
//  bar beneath a WEAK SELL SETUP - the label would say "here" and the volume would say
//  "nothing here".
pMin = prevDir > 0 ? minRunSellAdmit : minRun
isReaction = pLen >= pMin and pHeavy and (quiet or wickd)

// --- THREE COLOURS, AND ONLY THREE.
//  Zee: "it should have just three colors: red campaign / green campaign / reaction
//  volume colored.. its hard to understand what the yellow/amber volume colors mean".
//  The amber was "in a run but not heavy enough" - a state with no decision attached to
//  it, so it cost attention and paid nothing back. Everything that is not one of the
//  three things he trades is now simply dim.
campCol = dir < 0 ? color.new(color.red, 0) : color.new(color.teal, 0)
col = isReaction ? color.new(color.yellow, 0) : isCampaign ? campCol : color.new(color.gray, 75)

plot(volume, style = plot.style_columns, color = col, title = "volume")
plot(showAvg ? volAvgN : na, color = color.new(color.silver, 40), title = "average")

// --- PAINTING THE BARS THE MAIN PLOT CANNOT REACH.
//  Zee: "couldn't we just color the volume bars instead of having a box? the colored
//  volume bars looked fine.. they only skipped one bar". Right, and the box was solving
//  it the hard way. The skip is a causality problem: a run is measured from the bar it
//  ENDS on, so at the first bar of a run there is nothing yet to say it is a run - and
//  Pine cannot repaint a bar once drawn.
//  What Pine CAN do is draw a column at a negative offset. So when a run is recognised
//  as a campaign, these plots reach back and paint the bars that were still anonymous
//  when they printed. Three of them, which covers runs up to four bars; longer runs get
//  their later bars from the main plot anyway.
fixCol = color.new(campCol, 0)
plot(isCampaign and runLen >= 2 ? volume[1] : na, style = plot.style_columns, color = fixCol, offset = -1, title = "campaign bar -1")
plot(isCampaign and runLen >= 3 ? volume[2] : na, style = plot.style_columns, color = fixCol, offset = -2, title = "campaign bar -2")
plot(isCampaign and runLen >= 4 ? volume[3] : na, style = plot.style_columns, color = fixCol, offset = -3, title = "campaign bar -3")

if isReaction
    labCol = quiet ? color.new(color.yellow, 10) : color.new(color.orange, 10)
    label.new(bar_index, volume, quiet ? "QUIET" : "WICK", style = label.style_label_down, color = labCol, textcolor = color.black, size = size.small)
