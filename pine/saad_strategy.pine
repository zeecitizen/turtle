//@version=5
// ═══════════════════════════════════════════════════════════════════════════
// Saad Strategy — visual guide to mt5/Saad_strategy.mq5 v3.20 (2026-10-11)
// Rules: mt5/RULES_EMA_SAAD.md. Drawn so Saad bhai can SEE what the EA does.
// The SETTINGS are grouped by the rules' own steps ① to ⑥, and every rule can be
// TIGHTENED or RELAXED there. Defaults = the EA's tested v3.20 settings.
// Bar-close approximation of the EA: the MT5 Strategy Tester is the judge.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Saad Strategy v3.20 — EMA 9/50 pin & marubozu", "Saad", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// SETTINGS — one section per rule ──────────────────────────────────────────
g1 = "① SETUP CANDLE — pin bar (thumb pin) or marubozu"
iWick   = input.float(0.60, 'Pin: long wick at least this share of the candle   (higher = stricter)', minval = 0.3, maxval = 0.95, step = 0.05, group = g1)
iBody   = input.float(0.30, 'Pin: body at most this share of the candle   (lower = stricter)', minval = 0.05, maxval = 0.6, step = 0.05, group = g1)
iNose   = input.float(0.25, 'Pin: short wick at most this share   (lower = stricter)', minval = 0.0, maxval = 0.5, step = 0.05, group = g1)
iPinDir = input.bool(true, 'Pin must point the trade way (thumb down for LONG, up for SHORT)   OFF = any pin, the EMA decides', group = g1)
iMaru   = input.bool(true, 'Accept a marubozu too', group = g1)
iMaruB  = input.float(0.80, 'Marubozu: body at least this share of the candle   (higher = stricter)', minval = 0.5, maxval = 1.0, step = 0.05, group = g1)
iMinAtr = input.float(0.50, 'Candle at least this × an average candle (ATR 14)   (0 = any size; higher = only big candles)', minval = 0.0, step = 0.1, group = g1)

g1b = "① ...MADE ON THE EMA"
iFast   = input.int(9,  'Fast EMA length', minval = 1, group = g1b)
iSlow   = input.int(50, 'Slow EMA length', minval = 1, group = g1b)
iLongLn = input.string("9 EMA",  'LONG setups must be on', options = ["9 EMA", "50 EMA", "Either EMA"], group = g1b)
iShrtLn = input.string("50 EMA", 'SHORT setups must be on', options = ["50 EMA", "9 EMA", "Either EMA"], group = g1b)
iTouch  = input.string("Candle touches the EMA", '"On the EMA" means', options = ["Candle touches the EMA", "Wick touches, body stays on the trade side"], group = g1b)
iTouchP = input.float(0.0, 'Touch tolerance in pips   (0 = must really touch; higher = near-misses count)', minval = 0.0, step = 1.0, group = g1b)
iL50Up  = input.bool(true, 'LONG only when its EXIT EMA is above the candle (so the exit is a profit; 50 EMA in the rules, 9 EMA in the inverse)', group = g1b)

g2 = "② WAIT FOR THE BREAK — next or next-to-next candle"
iBreak  = input.int(2, 'Candles allowed to break the high / low   (rule = 2; 1 = stricter)', minval = 1, maxval = 10, group = g2)
iBrkP   = input.float(0.0, 'Break must clear the high / low by at least this many pips   (0 = any break)', minval = 0.0, step = 1.0, group = g2)
iBrkC   = input.bool(false, 'Break must be a candle CLOSE beyond it (stricter; entry at that close)', group = g2)

g3 = "③ ENTRY"
iBuys   = input.bool(true, 'Allow LONG trades', group = g3)
iSells  = input.bool(true, 'Allow SHORT trades', group = g3)

g4 = "④ STOP LOSS"
iSlUsd  = input.float(3.0, 'Stop this many $ beyond the pin / marubozu   ($1 = 10 pips; rules $2; EA tested best $2.50–3.00)', minval = 0.1, step = 0.1, group = g4)

g5 = "⑤ TAKE PROFIT"
iLTp    = input.string("Candle touches the 50 EMA", 'LONG exit', options = ["Candle touches the 50 EMA", "Candle CLOSES at / beyond the 50 EMA"], group = g5,
     tooltip = "'50 EMA' here means the long's EXIT EMA: the 50 EMA for the rules' longs, the 9 EMA for inverse longs (⑧ LONG rule).")
iLTpP   = input.float(0.0, 'LONG: take profit this many pips before the exit EMA   (0 = at the line)', minval = 0.0, step = 1.0, group = g5)
iPivot  = input.int(3, 'SHORT "last support" = a swing low with this many candles each side   (higher = bigger, further levels)', minval = 1, maxval = 10, group = g5)
iSTpP   = input.float(0.0, 'SHORT: take profit this many pips before the support   (0 = at the level)', minval = 0.0, step = 1.0, group = g5)

g6 = "⑥ BREAKEVEN — the rules' \"test if profit above 3 USD\""
iBeUsd  = input.float(0.0, 'Move the stop to entry once profit passes this many $   (0 = off; rules test 3)', minval = 0.0, step = 0.5, group = g6)
iBeMode = input.string("Price moved $X", 'Measure the $ as', options = ["Price moved $X", "Profit $X at the chosen lots"], group = g6)

gX = "✖ SKIP FILTERS (added after testing; not in the rules)"
iEr     = input.float(0.20, 'Skip choppy markets: efficiency ratio below this   (0 = off; higher = stricter)', minval = 0.0, maxval = 0.9, step = 0.05, group = gX)
iErLen  = input.int(14, 'Efficiency ratio length (candles)', minval = 2, group = gX)
iSess   = input.bool(true, 'Only trade between these hours', group = gX)
iFrom   = input.int(8, 'From hour (Axi server time; 8 = 10 AM Pakistan)', minval = 0, maxval = 23, group = gX)
iTo     = input.int(17, 'To hour (17 = 7 PM Pakistan)', minval = 1, maxval = 24, group = gX)
iTz     = input.string("GMT+3", 'Server timezone', group = gX)

gV = "🎨 DISPLAY"
iLots   = input.float(1.0, 'Lots for the $ figures', step = 0.01, group = gV)
iCs     = input.float(100,  'Contract size ($ per $1 move per lot)', group = gV)
iShowSk = input.bool(true, 'Show skipped setups', group = gV)
iShowPn = input.bool(true, 'Show stats panel', group = gV)
iShowRules = input.bool(true, 'Show the numbered rules box', group = gV)

g7 = "⑦ TRAILING STOP (test — not in the rules)"
iTrail   = input.bool(false, 'Use a trailing stop', group = g7)
iTrSide  = input.string("LONG only", 'Apply it to', options = ["LONG only", "SHORT only", "Both"], group = g7)
iTrRide  = input.bool(true, 'Let winners run: when the TP is reached, start trailing instead of exiting', group = g7)
iTrMode  = input.string("Low / high of the last N candles", 'Trail the stop by', options = ["Low / high of the last N candles", "X pips behind the best price", "ATR multiple behind the best price"], group = g7)
iTrN     = input.int(3, 'N candles   (more = looser)', minval = 1, maxval = 20, group = g7)
iTrPips  = input.float(30, 'X pips   (more = looser)', minval = 1, step = 1, group = g7)
iTrAtr   = input.float(1.5, 'ATR multiple   (more = looser)', minval = 0.1, step = 0.1, group = g7)
iTrStart = input.float(0, 'Without "let winners run": start trailing after this many pips of profit   (0 = at once)', minval = 0, step = 1, group = g7)

g8 = "⑧ LONG RULE — which EMA is the setup, which is the exit"
iLRule   = input.string("9 EMA setup → exit at 50 EMA", 'LONG rule', options = ["9 EMA setup → exit at 50 EMA", "50 EMA setup → exit at 9 EMA", "Both"], group = g8,
     tooltip = "The rules: a bullish pin / marubozu ON the 9 EMA, exit when a candle touches the 50 EMA.\nThe inverse: ON the 50 EMA, exit when a candle touches the 9 EMA.\n'Both' takes either; each trade exits at the OTHER EMA.\nIn the inverse and Both modes this replaces 'LONG setups must be on'; 'LONG only when the exit EMA is above' still applies.")

g9 = "⑨ HAMMERS — accept them as setup candles too"
iHammer  = input.bool(false, 'Also accept hammers (LONG) and shooting stars (SHORT)', group = g9,
     tooltip = "Hammer: long LOWER wick at least N × the body, little or no upper wick, any colour.\nShooting star: the mirror (long UPPER wick) for SHORT setups.\nA pin bar needs its wick to be 60% of the whole candle; a hammer only needs it to be N × the body, so hammers with a bigger body now count.")
iHamRatio = input.float(2.0, 'Hammer: long wick at least this × the body   (higher = stricter; classic = 2)', minval = 1.0, step = 0.5, group = g9)
iHamNose  = input.float(0.10, 'Hammer: opposite wick at most this share of the candle   (lower = stricter)', minval = 0.0, maxval = 0.5, step = 0.05, group = g9)

gLog = "🧾 AUDIT LOG"
iLog = input.bool(false, 'Write every setup / entry / stop move / exit to the Pine Logs (for checking)', group = gLog)
ts(t) => str.format_time(t, "yyyy-MM-dd HH:mm", "UTC")
var string pDesc = ""      // the waiting setup, described for the log
iJPage = input.int(0, 'Trade journal page (40 trades per page; 0 = hidden)', minval = 0, group = gLog)
var array<string> jRows = array.new<string>()   // one finished trade per row

g10 = "⑩ ACCURACY & COSTS (so the panel matches what a broker would do)"
iIntra   = input.bool(true, 'Decide stop vs target minute by minute inside each candle (1-minute data)', group = g10,
     tooltip = "Without it, a candle that touches both the stop and the target is guessed (stop first), and the entry candle itself is never checked.")
iRideLock = input.string("TP level", 'When the TP is reached and the trade rides, lock the stop at', options = ["TP level", "Entry (breakeven)", "Don't lock", "Trail from the TP price"], group = g10,
     tooltip = "TP level: a trade that reached its target can no longer end below it.\nWithout a lock, the trailing stop could sit on the wrong side of the entry and turn a reached target into a loss.")
iLockBuf = input.float(2, 'Lock this many pips short of the TP (room for spread; 0 = exactly at the TP)', minval = 0, step = 1, group = g10)
iMaxRisk = input.float(9.0, 'Skip a setup whose stop is more than this many $ from the entry   (0 = no limit; the EA uses 9)', minval = 0, step = 0.5, group = g10)
iSpread  = input.float(0.20, 'Spread cost per trade, $ of price   (PrimeXBT gold ≈ 0.19, Axi ≈ 0.13)', minval = 0, step = 0.01, group = g10)
iComm    = input.float(0.0, 'Commission per lot per round trip, $', minval = 0, step = 0.5, group = g10)

gPC = "🔌 PINECONNECTOR ALERTS"
iPC      = input.bool(false, 'Send PineConnector alert messages (create ONE alert: condition = this indicator, "Any alert() function call")', group = gPC)
iPCLic   = input.string("", 'PineConnector license ID', group = gPC)
iPCSym   = input.string("XAUUSD", 'Symbol name at the broker', group = gPC,
     tooltip = "Messages: buy / sell with sl= (and tp= for SHORTs that do not ride) and risk=lots; closelong / closeshort on every exit; newsltplong / newsltpshort when the stop is locked, trailed or moved to breakeven.\nSet the PineConnector EA to read sl / tp as PRICES and risk as LOTS.")
// (added last so the saved positions of every earlier input stay the same)
iGapSkip = input.bool(true, 'Cancel a waiting setup across the daily close / weekend gap', group = g10,
     tooltip = "The market reopens with a wide spread and a jump; a setup from before the close is stale.")
iMinTp   = input.float(5, 'TP at least this many pips from the entry   (SHORT: look further down for support; LONG: no TP, trail instead)', minval = 0, step = 1, group = g10,
     tooltip = "A target a few cents away cannot beat the spread: the lock 'short of the TP' would sit below the entry.")
iDayTgt  = input.float(0, 'Stop for the day once today made this many $ (at the lots above; 0 = off; the EA uses 150)', minval = 0, step = 10, group = g10)
iClean   = input.bool(true, 'Clean labels: short BUY / SELL / EXIT tags, the explanation is in the tooltip (hover a label)   OFF = long explanations', group = gV)
iTradeLn = input.bool(true, 'Dotted line from each entry to its exit (like MT5)', group = gV)
iBuyCol  = #2196f3      // BUY tag: blue, never a candle colour
iSellCol = #e040fb      // SELL tag: magenta
iWinCol  = #00e676      // winning exit
iLossCol = #ff5252      // losing exit
iDrawTo  = input.time(0, 'Draw labels only up to this time (0 = all; for screenshots of old trades — TradingView keeps only the newest 500 labels)', group = gV)
vis = iDrawTo == 0 or time <= iDrawTo
g11 = "⑪ SEVERAL TRADES AT ONCE (test — not in the rules)"
iMaxOpen = input.int(1, 'Max open trades at the same time   (1 = one at a time, as before)', minval = 1, maxval = 10, group = g11,
     tooltip = "A new setup is taken while other trades are still open, up to this many.\nEach trade keeps its own stop, target and trailing stop.\nPineConnector alerts are switched OFF above 1: its close / move-stop messages act on ALL longs or ALL shorts at once, so they would move or close the wrong trade.")
iSameDir = input.bool(true, 'Allow two trades in the same direction (OFF = at most one LONG and one SHORT)', group = g11)
T(string clean, string full) => iClean ? clean : full
fp(float v) => str.tostring(v, "#.##")
// a skipped setup: a small grey tag (clean) or the full reason
skipTag(float y, bool above, string why) =>
    if vis
        label.new(bar_index, y, T("✖ skip", "✖ SKIP: " + why), style = above ? label.style_label_down : label.style_label_up,
         color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny, tooltip = "SKIPPED: " + why)
cTag = color.new(#363a45, 10)    // dark tag background: never the colour of a candle

// lower-timeframe highs / lows of THIS candle, oldest first; falls back to the whole candle
[mH, mL] = request.security_lower_tf(syminfo.tickerid, "1", [high, low])
useM   = iIntra and array.size(mH) > 0
nSteps = useM ? array.size(mH) : 1
mHi(int k) => useM ? array.get(mH, k) : high
mLo(int k) => useM ? array.get(mL, k) : low
// PineConnector: each message at most once per candle, only on live candles
varip array<string> pcSent = array.new<string>()
varip array<int>    pcBarA = array.new<int>(1, -1)
pcSend(string msg) =>
    if iPC and iMaxOpen == 1 and barstate.isrealtime and iPCLic != ""
        if array.get(pcBarA, 0) != bar_index
            array.set(pcBarA, 0, bar_index)
            array.clear(pcSent)
        if not array.includes(pcSent, msg)
            array.push(pcSent, msg)
            alert(msg, alert.freq_all)

// LINES ────────────────────────────────────────────────────────────────────
e9  = ta.ema(close, iFast)
e50 = ta.ema(close, iSlow)
plot(e9,  "EMA fast", color = color.new(color.orange, 0), linewidth = 2)
plot(e50, "EMA slow", color = color.new(#2962ff, 0), linewidth = 2)
atr = ta.atr(14)
pip = 0.10
usd(d) => d * iLots * iCs
exitVal(int which) => which == 9 ? e9 : e50

// ① SHAPE: +1 bullish, -1 bearish, 2 = a pin whose direction the EMA decides ─
rng  = high - low
body = math.abs(close - open)
up   = high - math.max(open, close)
lo   = math.min(open, close) - low
bigEnough = rng > 0 and (iMinAtr <= 0 or rng >= iMinAtr * atr)
pinBull = bigEnough and body <= iBody * rng and lo >= iWick * rng and up <= iNose * rng
pinBear = bigEnough and body <= iBody * rng and up >= iWick * rng and lo <= iNose * rng
hamBull = bigEnough and iHammer and not pinBull and not pinBear and lo >= iHamRatio * body and lo > 0 and up <= iHamNose * rng
hamBear = bigEnough and iHammer and not pinBull and not pinBear and up >= iHamRatio * body and up > 0 and lo <= iHamNose * rng
maru    = bigEnough and iMaru and body >= iMaruB * rng and not pinBull and not pinBear and not hamBull and not hamBear
shape   = (pinBull or pinBear) and not iPinDir ? 2 : pinBull ? 1 : pinBear ? -1 : hamBull ? 1 : hamBear ? -1 : maru ? (close > open ? 1 : -1) : 0
kind    = pinBull or pinBear ? "PIN BAR" : hamBull ? "HAMMER" : hamBear ? "SHOOTING STAR" : "MARUBOZU"

// ① ON THE EMA ─────────────────────────────────────────────────────────────
tol = iTouchP * pip
onLine(float e, int side) =>
    bool r = false
    if iTouch == "Candle touches the EMA"
        r := low - tol <= e and high + tol >= e
    else
        // wick reaches the line, body stays on the trade's side of it
        r := side > 0 ? (low - tol <= e and math.min(open, close) >= e) : (high + tol >= e and math.max(open, close) <= e)
    r
lineFor(string which, int side) =>
    which == "9 EMA" ? onLine(e9, side) : which == "50 EMA" ? onLine(e50, side) : (onLine(e9, side) or onLine(e50, side))
lineName(string which, int side) =>
    which == "9 EMA" ? "the 9 EMA" : which == "50 EMA" ? "the 50 EMA" : (onLine(e9, side) ? "the 9 EMA" : "the 50 EMA")

// ✖ FILTERS ───────────────────────────────────────────────────────────────
er = 0.0
path = math.sum(math.abs(close - close[1]), iErLen)
er := path > 0 ? math.abs(close - close[iErLen]) / path : 0.0
choppy = iEr > 0 and er < iEr
hr = hour(time, iTz)
inSess = not iSess or (hr >= iFrom and hr < iTo)

// ⑤ LAST SUPPORT: confirmed swing lows, newest first ──────────────────────
var array<float> supPx = array.new<float>()
pl = ta.pivotlow(low, iPivot, iPivot)
if not na(pl)
    array.unshift(supPx, pl)
    if array.size(supPx) > 60
        array.pop(supPx)
lastSupport(below) =>
    float r = na
    n = array.size(supPx)
    for i = 0 to (n > 0 ? n - 1 : 0)
        if n == 0
            break
        if array.get(supPx, i) < below
            r := array.get(supPx, i)
            break
    r

// STATE ───────────────────────────────────────────────────────────────────
var int   pSide = 0        // waiting setup: +1 long, -1 short
var float pHi = na
var float pLo = na
var int   pLeft = 0
var int   pBar = na
var int   pExitE = 50      // waiting LONG setup: which EMA will be its exit (9 or 50)
var int   tN = 0           // trades opened so far (it numbers them)
// OPEN TRADES — several can be open at once (⑪ Max open trades). Index i is the same trade in every array.
var array<int>    aSide  = array.new<int>()      // +1 long, -1 short
var array<float>  aEn    = array.new<float>()    // entry price
var array<float>  aSl    = array.new<float>()    // current stop
var array<float>  aTp    = array.new<float>()    // SHORT target (LONG exits at its EMA)
var array<int>    aBar   = array.new<int>()      // entry candle
var array<int>    aNum   = array.new<int>()      // trade number
var array<bool>   aBe    = array.new<bool>()     // stop moved to breakeven
var array<float>  aBest  = array.new<float>()    // best price since entry (for the trailing stop)
var array<bool>   aRide  = array.new<bool>()     // the TP was reached and the trade rides the trailing stop
var array<int>    aExitE = array.new<int>()      // LONG: which EMA is its exit
var array<bool>   aNoTp  = array.new<bool>()     // LONG whose exit EMA was below its entry: candle stop + exit on a close below the EMA
var array<int>    aBrkK  = array.new<int>()      // minute of the break on the entry candle
var array<line>   aLEn   = array.new<line>()
var array<line>   aLSl   = array.new<line>()
var array<line>   aLTp   = array.new<line>()
var array<label>  aXSl   = array.new<label>()
var array<label>  aXTp   = array.new<label>()
var array<string> aJOpen = array.new<string>()   // the entry half of the trade's journal row
var array<int>    aMoves = array.new<int>()      // trailing / breakeven stop moves
var int   nT = 0
var int   nW = 0
var int   nL = 0
var int   nLong = 0
var int   nShort = 0
var float gW = 0.0
var float gL = 0.0
var float netL = 0.0
var float netS = 0.0
var int   nSkip = 0
var int   nChop = 0
var int   nToday = 0
var float pnlToday = 0.0
var int   maxOpenSeen = 0
var string status = "Waiting for a pin bar or marubozu on a line"
if ta.change(dayofweek(time, iTz)) != 0
    nToday := 0
    pnlToday := 0.0

removeTrade(int i) =>
    array.remove(aSide, i), array.remove(aEn, i), array.remove(aSl, i), array.remove(aTp, i), array.remove(aBar, i)
    array.remove(aNum, i), array.remove(aBe, i), array.remove(aBest, i), array.remove(aRide, i), array.remove(aExitE, i)
    array.remove(aNoTp, i), array.remove(aBrkK, i), array.remove(aLEn, i), array.remove(aLSl, i), array.remove(aLTp, i)
    array.remove(aXSl, i), array.remove(aXTp, i), array.remove(aJOpen, i), array.remove(aMoves, i)
// is a trade in this direction already open?
sideOpen(int side) =>
    bool r = false
    n = array.size(aSide)
    if n > 0
        for i = 0 to n - 1
            if array.get(aSide, i) == side
                r := true
    r
// room for a new trade in this direction?
dirOk(int side) => iSameDir or not sideOpen(side)

closeTrade(int side, float en, float px, string why, bool ride, int num, float sl, int bar0, line le, line ls, line lt, label xs, label xt,
     string jop, int moves, int exE, bool noTp) =>
    d    = side > 0 ? px - en : en - px
    cost = iSpread * iLots * iCs + iComm * iLots
    pnl  = usd(d) - cost
    win = pnl > 0
    array.push(jRows, jop + " || OUT " + ts(time) + " " + why + " @ " + str.tostring(px, "#.##") + (ride ? " [rode]" : "") +
         " moves " + str.tostring(moves) + " || " + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#.##"))
    if iLog
        log.info("EXIT|#{0}|{1}|{2}|px={3}|pnl={4}|entry={5}|sl={6}", num, ts(time), why, str.tostring(px, "#.###"), str.tostring(pnl, "#.##"), str.tostring(en, "#.###"), str.tostring(sl, "#.###"))
    pcSend(iPCLic + "," + (side > 0 ? "closelong" : "closeshort") + "," + iPCSym)
    money = (pnl >= 0 ? "+$" : "−$") + str.tostring(math.abs(pnl), "#.##")
    txt = "⑥ EXIT #" + str.tostring(num) + (win ? " ✅ " : pnl == 0 ? " ⚪ " : " ❌ ") + why + "\n" + money
    color rc = win ? iWinCol : pnl == 0 ? color.gray : iLossCol
    string tipX = "EXIT #" + str.tostring(num) + " (" + (side > 0 ? "BUY" : "SELL") + ")\n" + why +
         "\nEntry: " + fp(en) + "\nExit:  " + fp(px) + "\nResult: " + money + " after costs"
    if iClean
        if vis
            label.new(bar_index, side > 0 ? high : low, "EXIT #" + str.tostring(num) + "\n" + money, style = side > 0 ? label.style_label_down : label.style_label_up,
             color = cTag, textcolor = rc, size = size.small, tooltip = tipX)
    else
        if vis
            label.new(bar_index, side > 0 ? high : low, txt, style = side > 0 ? label.style_label_down : label.style_label_up,
             color = win ? color.new(color.green, 10) : pnl == 0 ? color.new(color.gray, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small, tooltip = tipX)
    if iTradeLn
        // MT5-style: a dotted line from the entry price to the exit price, coloured by the result
        if vis
            line.new(bar0, en, bar_index, px, color = rc, width = 2, style = line.style_dotted)
        if vis
            label.new(bar_index, px, "", style = label.style_xcross, color = rc, size = size.tiny, tooltip = tipX)
    line.set_x2(le, bar_index), line.set_x2(ls, bar_index)
    if not na(lt)
        line.set_x2(lt, bar_index)
    if iClean
        // the trade is over: its SL / TP notes would only clutter the chart (the EXIT tag says how it ended)
        label.delete(xs)
        label.delete(xt)
    else
        label.set_x(xs, bar_index)
        label.set_x(xt, bar_index)
        if side > 0 and iLTpP == 0 and not noTp
            label.set_y(xt, exitVal(exE))
    pnl

trLow  = ta.lowest(low, iTrN)       // computed every candle (Pine needs history functions outside conditions)
trHigh = ta.highest(high, iTrN)
// the trailing-stop level for a trade whose best price is `best` (used at the TP and on every candle close)
trailLvl(int side, float best) =>
    iTrMode == "Low / high of the last N candles" ? (side > 0 ? trLow : trHigh) :
     iTrMode == "X pips behind the best price" ? (side > 0 ? best - iTrPips * pip : best + iTrPips * pip) :
     (side > 0 ? best - iTrAtr * atr : best + iTrAtr * atr)
trailOn(int side) =>
    iTrail and (iTrSide == "Both" or (side > 0 and iTrSide == "LONG only") or (side < 0 and iTrSide == "SHORT only"))
pcMod(int side, float sl) => iPCLic + "," + (side > 0 ? "newsltplong" : "newsltpshort") + "," + iPCSym + ",sl=" + fp(sl)

// a candle that opens after a gap in time (daily close, weekend)
gapBar = time - time[1] > timeframe.in_seconds() * 1500

// ═ A) A WAITING SETUP: does this candle break it? (the minute of the break is found in the 1-minute data) ═
if pSide != 0 and bar_index > pBar and iGapSkip and gapBar
    if iShowSk
        skipTag(pSide > 0 ? high : low, pSide > 0, "market closed in between")
    nSkip += 1
    if iLog
        log.info("SKIP|{0}|gap|{1}", ts(time), pDesc)
    pSide := 0
if pSide != 0 and bar_index > pBar
    lvl = pSide > 0 ? pHi + iBrkP * pip : pLo - iBrkP * pip
    int k0 = -1
    if iBrkC
        if pSide > 0 ? close > lvl : close < lvl
            k0 := nSteps - 1
    else
        for k = 0 to nSteps - 1
            if pSide > 0 ? mHi(k) > lvl : mLo(k) < lvl
                k0 := k
                break
    if k0 >= 0
        // the stop order fills at the level, or at the candle's open if it gapped past it
        float tEn = iBrkC ? close : k0 == 0 ? (pSide > 0 ? math.max(open, lvl) : math.min(open, lvl)) : lvl
        float tSl = pSide > 0 ? pLo - iSlUsd : pHi + iSlUsd
        sup = pSide < 0 ? lastSupport(tEn - iMinTp * pip) : na
        float tTp = pSide > 0 ? na : (na(sup) ? na : sup + iSTpP * pip)
        int tExitE = pExitE
        bool tNoTp = pSide > 0 and exitVal(pExitE) - iLTpP * pip < tEn + iMinTp * pip
        risk = math.abs(tEn - tSl)
        string skipWhy = pSide < 0 and (na(tTp) or tTp >= tEn) ? "no support below to target" :
             iMaxRisk > 0 and risk > iMaxRisk ? "stop too far ($" + fp(risk) + " > $" + fp(iMaxRisk) + ")" : ""
        if skipWhy != ""
            nSkip += 1
            if iLog
                log.info("SKIP|{0}|{1}|{2}", ts(time), skipWhy, pDesc)
            if iShowSk
                skipTag(pSide > 0 ? high : low, pSide > 0, skipWhy)
        else
            tN += 1
            bool sendTp = pSide < 0 and not (trailOn(-1) and iTrRide)
            pcSend(iPCLic + "," + (pSide > 0 ? "buy" : "sell") + "," + iPCSym + ",sl=" + fp(tSl) + (sendTp ? ",tp=" + fp(tTp) : "") + ",risk=" + str.tostring(iLots))
            string jOpen = "#" + str.tostring(tN) + " | " + pDesc + " || IN " + ts(time) + " " + (pSide > 0 ? "BUY" : "SELL") + " " + str.tostring(tEn, "#.##") +
                 " SL " + str.tostring(tSl, "#.##") + " TP " + (pSide > 0 ? (tNoTp ? "none (EMA" + str.tostring(pExitE) + " below / too close to entry)" : "EMA" + str.tostring(pExitE)) : str.tostring(tTp, "#.##"))
            if iLog
                log.info("ENTRY|#{0}|{1}|{2}|entry={3}|sl={4}|tp={5}|exitEMA={6}|setup: {7}", tN, ts(time), pSide > 0 ? "LONG" : "SHORT",
                     str.tostring(tEn, "#.###"), str.tostring(tSl, "#.###"), pSide > 0 ? "EMA" + str.tostring(pExitE) : str.tostring(tTp, "#.###"), pSide > 0 ? str.tostring(pExitE) : "-", pDesc)
            if pSide > 0
                nLong += 1
            else
                nShort += 1
            tip = (pSide > 0 ? "BUY" : "SELL") + "  #" + str.tostring(tN) +
                 "\nEntry: " + str.tostring(tEn, "#.##") +
                 "\nSL:    " + str.tostring(tSl, "#.##") + "  −$" + str.tostring(usd(risk), "#.##") +
                 "\nTP:    " + (pSide > 0 ? (tNoTp ? "none — the exit EMA is below / too close to the entry" : "the " + str.tostring(tExitE) + " EMA") :
                                 str.tostring(tTp, "#.##") + "  +$" + str.tostring(usd(tEn - tTp), "#.##") + " (last support)") +
                 "\nLots:  " + str.tostring(iLots, "#.##") +
                 "\n\nWhy: " + (pSide > 0 ? "the setup's HIGH was broken" : "the setup's LOW was broken") + (iBrkC ? " by a close" : "") +
                 (array.size(aSide) > 0 ? "\nOpen alongside " + str.tostring(array.size(aSide)) + " other trade" + (array.size(aSide) > 1 ? "s" : "") : "")
            if vis
                label.new(bar_index, pSide > 0 ? low : high,
                     T((pSide > 0 ? "▲ BUY #" : "▼ SELL #") + str.tostring(tN) + "\n" + fp(tEn),
                       (pSide > 0 ? "③ HIGH BROKEN → BUY" : "③ LOW BROKEN → SELL") + (iBrkC ? " (close)" : "") + "\n@ " + str.tostring(tEn, "#.##")),
                 style = pSide > 0 ? label.style_label_up : label.style_label_down,
                 color = pSide > 0 ? iBuyCol : iSellCol, textcolor = color.white,
                 size = size.normal, tooltip = tip)
            line lEn = not vis ? na : line.new(bar_index, tEn, bar_index + 1, tEn, color = color.new(color.white, 20), width = 1)
            line lSl = not vis ? na : line.new(bar_index, tSl, bar_index + 1, tSl, color = color.new(color.red, 0), width = 2, style = line.style_dashed)
            line lTp = vis and pSide < 0 ? line.new(bar_index, tTp, bar_index + 1, tTp, color = color.new(color.lime, 0), width = 2, style = line.style_dashed) : na
            string slFull = "④ SL: $" + str.tostring(iSlUsd, "#.00") + " " + (pSide > 0 ? "below" : "above") +
                 " the candle = " + str.tostring(tSl, "#.##") + "  (−$" + str.tostring(usd(risk), "#.##") + ")"
            string tpFull = pSide > 0 ? (tNoTp ? "⑤ no TP: the " + str.tostring(tExitE) + " EMA is below the entry" + " — the stop stays below the candle; exits if a candle closes below the EMA" :
                             "⑤ TP: exit when a candle " + (iLTp == "Candle touches the 50 EMA" ? "touches" : "closes at") + " the " + str.tostring(tExitE) + " EMA" +
                             (iLTpP > 0 ? " (−" + str.tostring(iLTpP, "#") + " pips)" : "")) :
                 "⑤ TP: last support (liquidity) = " + str.tostring(tTp, "#.##") + "  (+$" + str.tostring(usd(tEn - tTp), "#.##") + ")"
            label xSl = not vis ? na : label.new(bar_index + 2, tSl, T((iMaxOpen > 1 ? "SL #" + str.tostring(tN) + " " : "SL ") + fp(tSl) + "  −$" + fp(usd(risk)), slFull),
                 style = label.style_label_left, color = color.new(color.red, 15), textcolor = color.white, size = size.small, tooltip = slFull)
            label xTp = not vis ? na : label.new(bar_index + 2, pSide > 0 ? exitVal(tExitE) : tTp,
                 T((pSide > 0 ? (tNoTp ? "no TP · exit on close < " + str.tostring(tExitE) + " EMA" : "TP " + str.tostring(tExitE) + " EMA") :
                   "TP " + fp(tTp) + "  +$" + fp(usd(tEn - tTp))) + (iMaxOpen > 1 ? "  #" + str.tostring(tN) : ""), tpFull),
                 style = label.style_label_left, color = color.new(color.green, 15), textcolor = color.white, size = size.small, tooltip = tpFull)
            // a LONG with no TP (exit EMA below / too close to the entry) keeps its candle stop and does NOT trail:
            // Zee 2026-10-11, rules: the trailing stop starts only "when we reach TP 1"; until then the SL is below the candle.
            // (It used to trail from the entry, which pulled the stop off the candle at once and stopped these trades out.)
            array.push(aSide, pSide), array.push(aEn, tEn), array.push(aSl, tSl), array.push(aTp, tTp), array.push(aBar, bar_index)
            array.push(aNum, tN), array.push(aBe, false), array.push(aBest, na), array.push(aRide, false), array.push(aExitE, tExitE)
            array.push(aNoTp, tNoTp), array.push(aBrkK, k0), array.push(aLEn, lEn), array.push(aLSl, lSl), array.push(aLTp, lTp)
            array.push(aXSl, xSl), array.push(aXTp, xTp), array.push(aJOpen, jOpen), array.push(aMoves, 0)
            maxOpenSeen := math.max(maxOpenSeen, array.size(aSide))
            status := (pSide > 0 ? "IN LONG #" : "IN SHORT #") + str.tostring(tN) + " @ " + str.tostring(tEn, "#.##") +
                 " | SL " + str.tostring(tSl, "#.##") + " | TP " + (pSide > 0 ? (tNoTp ? "none (candle stop, exit on close below the EMA)" : str.tostring(tExitE) + " EMA") : str.tostring(tTp, "#.##"))
        pSide := 0
    else
        pLeft -= 1
        if pLeft <= 0
            if iShowSk
                skipTag(pSide > 0 ? high : low, pSide > 0, "(rule) " + (pSide > 0 ? "high" : "low") + " not broken within " + str.tostring(iBreak) + " candle" + (iBreak > 1 ? "s" : ""))
            nSkip += 1
            if iLog
                log.info("SKIP|{0}|not broken in {1}|{2}", ts(time), iBreak, pDesc)
            status := "Setup skipped: its " + (pSide > 0 ? "high" : "low") + " was not broken"
            pSide := 0

// ═ B) MANAGE EVERY OPEN TRADE — minute by minute, so stop vs target is decided in the order it happened ═
nOpen0 = array.size(aSide)
if nOpen0 > 0
    for ii = 0 to nOpen0 - 1
        i = nOpen0 - 1 - ii      // newest first: removing a closed trade does not shift the ones still to visit
        int    tSide  = array.get(aSide, i)
        float  tEn    = array.get(aEn, i)
        float  tSl    = array.get(aSl, i)
        float  tTp    = array.get(aTp, i)
        int    tBar   = array.get(aBar, i)
        int    tNum   = array.get(aNum, i)
        bool   tBe    = array.get(aBe, i)
        float  tBest  = array.get(aBest, i)
        bool   tRide  = array.get(aRide, i)
        int    tExitE = array.get(aExitE, i)
        bool   tNoTp  = array.get(aNoTp, i)
        int    brkK   = array.get(aBrkK, i)
        line   lEn    = array.get(aLEn, i)
        line   lSl    = array.get(aLSl, i)
        line   lTp    = array.get(aLTp, i)
        label  xSl    = array.get(aXSl, i)
        label  xTp    = array.get(aXTp, i)
        string jOpen  = array.get(aJOpen, i)
        int    jMoves = array.get(aMoves, i)
        string tag    = iMaxOpen > 1 ? "#" + str.tostring(tNum) + " " : ""   // which trade an SL note belongs to
        float exitPx = na
        string why = ""
        ltol = iLTpP * pip
        eX = exitVal(tExitE)
        float tgtL = tSide > 0 and not tNoTp ? eX - ltol : na
        bool tpValidL = not na(tgtL) and tgtL > tEn          // a LONG target only counts while it is above the entry
        bool touchMode = iLTp == "Candle touches the 50 EMA"
        startK = tBar == bar_index ? brkK + 1 : 0              // on the entry candle: only the minutes AFTER the break
        if startK < nSteps
            for k = startK to nSteps - 1
                h = mHi(k)
                l = mLo(k)
                if tSide > 0 ? l <= tSl : h >= tSl
                    exitPx := tSl
                    why := tRide or (tSide > 0 ? tSl > tEn : tSl < tEn) ? "trailing stop hit" : tBe ? "breakeven stop" : "stop loss hit"
                    break
                if not tRide
                    bool tpHit = tSide > 0 ? (touchMode and tpValidL and h >= tgtL) : (not na(tTp) and l <= tTp)
                    if tpHit
                        tpLv = tSide > 0 ? tgtL : tTp
                        if trailOn(tSide) and iTrRide
                            tRide := true
                            if vis
                                label.new(bar_index, tSide > 0 ? high : low, T("TP ✓ riding", "⑤ TP reached → now trailing"), style = tSide > 0 ? label.style_label_down : label.style_label_up,
                                 color = color.new(color.teal, 10), textcolor = color.white, size = size.tiny)
                            if iLog
                                log.info("RIDE|#{0}|{1}|TP reached, now trailing", tNum, ts(time))
                            tBest := tSide > 0 ? math.max(nz(tBest, tEn), tpLv) : math.min(nz(tBest, tEn), tpLv)
                            float lockLv = iRideLock == "TP level" ? (tSide > 0 ? tpLv - iLockBuf * pip : tpLv + iLockBuf * pip) : iRideLock == "Entry (breakeven)" ? tEn :
                                 iRideLock == "Trail from the TP price" ? trailLvl(tSide, tpLv) : na
                            if not na(lockLv) and (tSide > 0 ? lockLv > tSl : lockLv < tSl)
                                line.set_x2(lSl, bar_index)
                                tSl := lockLv
                                jMoves += 1
                                lSl := not vis ? na : line.new(bar_index, tSl, bar_index + 1, tSl, color = color.new(color.orange, 0), width = 2, style = line.style_dashed)
                                label.set_y(xSl, tSl)
                                label.set_text(xSl, T(tag + "SL locked " + fp(tSl), "④ SL locked at the " + (iRideLock == "TP level" ? "TP" : iRideLock == "Trail from the TP price" ? "trail behind the TP" : "entry") + " = " + fp(tSl)))
                                pcSend(pcMod(tSide, tSl))
                        else
                            exitPx := tpLv
                            why := tSide > 0 ? str.tostring(tExitE) + " EMA touched (TP)" : "reached last support (TP)"
                            break
        // candle-close exits (decided only when the candle has closed)
        if na(exitPx) and tSide > 0 and not tRide
            if not touchMode and tpValidL and close >= tgtL
                if trailOn(1) and iTrRide
                    tRide := true
                    if vis
                        label.new(bar_index, high, T("TP ✓ riding", "⑤ TP reached (close) → now trailing"), style = label.style_label_down,
                         color = color.new(color.teal, 10), textcolor = color.white, size = size.tiny)
                    tBest := math.max(nz(tBest, tEn), close)
                    float lockC = iRideLock == "TP level" ? tgtL - iLockBuf * pip : iRideLock == "Entry (breakeven)" ? tEn :
                         iRideLock == "Trail from the TP price" ? trailLvl(1, close) : na
                    if not na(lockC) and lockC > tSl and lockC < close
                        line.set_x2(lSl, bar_index)
                        tSl := lockC
                        jMoves += 1
                        lSl := not vis ? na : line.new(bar_index, tSl, bar_index + 1, tSl, color = color.new(color.orange, 0), width = 2, style = line.style_dashed)
                        label.set_y(xSl, tSl)
                        label.set_text(xSl, T(tag + "SL locked " + fp(tSl), "④ SL locked at the " + (iRideLock == "TP level" ? "TP" : iRideLock == "Trail from the TP price" ? "trail behind the TP" : "entry") + " = " + fp(tSl)))
                        if barstate.isconfirmed
                            pcSend(pcMod(1, tSl))
                else if barstate.isconfirmed
                    exitPx := close
                    why := str.tostring(tExitE) + " EMA close (TP)"
            else if tNoTp and close < eX and barstate.isconfirmed
                exitPx := close
                why := "closed below the " + str.tostring(tExitE) + " EMA"
        if not na(exitPx)
            pnl = closeTrade(tSide, tEn, exitPx, why, tRide, tNum, tSl, tBar, lEn, lSl, lTp, xSl, xTp, jOpen, jMoves, tExitE, tNoTp)
            nT += 1, nToday += 1, pnlToday += pnl
            if pnl > 0
                nW += 1, gW += pnl
            else if pnl < 0
                nL += 1, gL -= pnl
            if tSide > 0
                netL += pnl
            else
                netS += pnl
            removeTrade(i)
            status := "Trade #" + str.tostring(tNum) + " closed: " + why + (array.size(aSide) > 0 ? "" : " — waiting for the next setup")
        else
            if trailOn(tSide) and (bar_index > tBar or tRide)
                tBest := tSide > 0 ? math.max(nz(tBest, tEn), high) : math.min(nz(tBest, tEn), low)
                started = iTrRide ? tRide : (tSide > 0 ? tBest - tEn : tEn - tBest) >= iTrStart * pip
                if started
                    float lvl = trailLvl(tSide, tBest)
                    better = tSide > 0 ? lvl > tSl and lvl < close : lvl < tSl and lvl > close
                    if better
                        // end the old stop segment here and start a new, tighter one: the stop is drawn as steps
                        line.set_x2(lSl, bar_index)
                        tSl := lvl
                        jMoves += 1
                        if iLog
                            log.info("TRAIL|#{0}|{1}|newSL={2}|ride={3}", tNum, ts(time), str.tostring(tSl, "#.###"), tRide)
                        lSl := not vis ? na : line.new(bar_index, tSl, bar_index + 1, tSl, color = color.new(color.orange, 0), width = 2, style = line.style_dashed)
                        label.set_y(xSl, tSl)
                        label.set_text(xSl, tag + (iClean ? "TRAIL SL " : "④ TRAILING SL = ") + str.tostring(tSl, "#.##") + "  (" + (tSide > 0 ? (tSl >= tEn ? "+$" : "−$") : (tSl <= tEn ? "+$" : "−$")) +
                             str.tostring(math.abs(usd(tSide > 0 ? tSl - tEn : tEn - tSl)), "#.##") + " locked)")
                        if barstate.isconfirmed
                            pcSend(pcMod(tSide, tSl))
            if iBeUsd > 0 and not tBe and bar_index > tBar
                // ⑥ breakeven: judged on this candle's best price, applied from the next one
                best = tSide > 0 ? high - tEn : tEn - low
                gain = iBeMode == "Price moved $X" ? best : usd(best)
                if gain > iBeUsd and (tSide > 0 ? tEn > tSl : tEn < tSl)
                    tBe := true
                    tSl := tEn
                    jMoves += 1
                    if iLog
                        log.info("BE|#{0}|{1}|SL=entry {2}", tNum, ts(time), str.tostring(tEn, "#.###"))
                    line.set_y1(lSl, tEn), line.set_y2(lSl, tEn)
                    label.set_y(xSl, tEn)
                    label.set_text(xSl, T(tag + "SL @ entry " + fp(tEn), "④ SL moved to entry (breakeven) = " + str.tostring(tEn, "#.##")))
                    if vis
                        label.new(bar_index, tSide > 0 ? high : low, "BE", style = tSide > 0 ? label.style_label_down : label.style_label_up,
                         color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
                    if barstate.isconfirmed
                        pcSend(pcMod(tSide, tSl))
            // stretch the open trade's lines to the current bar
            line.set_x2(lEn, bar_index + 1), line.set_x2(lSl, bar_index + 1)
            if not na(lTp)
                line.set_x2(lTp, bar_index + 1)
            label.set_x(xSl, bar_index + 2)
            label.set_x(xTp, bar_index + 2)
            if tSide > 0 and not tNoTp
                label.set_y(xTp, exitVal(tExitE))
            // write the trade back
            array.set(aSl, i, tSl), array.set(aBe, i, tBe), array.set(aBest, i, tBest), array.set(aRide, i, tRide)
            array.set(aLSl, i, lSl), array.set(aMoves, i, jMoves)

// 3) A NEW SETUP ON THE CANDLE THAT JUST CLOSED ───────────────────────────
// a setup candle that appears while another setup is waiting, or while the open trades are at the limit
// (⑪ Max open trades), is not taken — counted as "busy"
var int nBusy = 0
nOpenNow = array.size(aSide)
full = nOpenNow >= iMaxOpen
if barstate.isconfirmed and (pSide != 0 or full) and shape != 0 and inSess and bar_index > iSlow * 2 and not choppy
    if (iBuys and (onLine(e9, 1) or onLine(e50, 1))) or (iSells and lineFor(iShrtLn, -1))
        nBusy += 1
if barstate.isconfirmed and pSide == 0 and not full and shape != 0 and inSess and bar_index > iSlow * 2 and not (iDayTgt > 0 and pnlToday >= iDayTgt)
    // ⑧ which long rule(s) this candle satisfies: the original (on 9, exit 50) and/or the inverse (on 50, exit 9)
    bool rulesOk = iLRule != "50 EMA setup → exit at 9 EMA" and (iLRule == "Both" ? onLine(e9, 1) : lineFor(iLongLn, 1)) and not (iL50Up and e50 <= high)
    bool invOk   = iLRule != "9 EMA setup → exit at 50 EMA" and onLine(e50, 1) and not (iL50Up and e9 <= high)
    longLine  = rulesOk or invOk
    shortLine = lineFor(iShrtLn, -1)
    longRaw   = iBuys and longLine and (shape == 1 or (shape == 2 and (not shortLine or close >= open)))
    shortRaw  = iSells and shortLine and (shape == -1 or shape == 2) and not longRaw
    // ⑪ with "same direction" OFF, a setup whose direction already has an open trade is not taken
    longOk  = longRaw and dirOk(1)
    shortOk = shortRaw and dirOk(-1)
    if not choppy and ((longRaw and not longOk) or (shortRaw and not shortOk))
        nBusy += 1
    if longOk or shortOk
        if choppy
            nChop += 1
            if iLog
                log.info("CHOPPY|{0}|{1} {2}|ER={3}", ts(time), longOk ? "LONG" : "SHORT", kind, str.tostring(er, "#.##"))
            if iShowSk
                skipTag(longOk ? low : high, not longOk, "choppy market (ER " + str.tostring(er, "#.##") + " < " + str.tostring(iEr, "#.##") + ")")
        else
            pSide := longOk ? 1 : -1
            pDesc := ts(time) + " " + (longOk ? "LONG " : "SHORT ") + kind + " on " +
                 (longOk ? (rulesOk ? "EMA9(rule:9->exit50)" : "EMA50(inverse:50->exit9)") : (onLine(e50, -1) ? "EMA50" : "EMA9")) +
                 " O=" + str.tostring(open, "#.###") + " H=" + str.tostring(high, "#.###") + " L=" + str.tostring(low, "#.###") + " C=" + str.tostring(close, "#.###") +
                 " e9=" + str.tostring(e9, "#.###") + " e50=" + str.tostring(e50, "#.###") + " ER=" + str.tostring(er, "#.##")
            pHi := high, pLo := low, pLeft := iBreak, pBar := bar_index
            pExitE := rulesOk ? 50 : 9
            if vis
                box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.yellow, iClean ? 40 : 0), iClean ? 1 : 2, bgcolor = color.new(color.yellow, iClean ? 94 : 85))
            string setupFull = "① " + (longOk ? "LONG" : "SHORT") + " SETUP: " + kind + " on " +
                 (longOk ? (rulesOk ? (iLRule == "Both" ? "the 9 EMA" : lineName(iLongLn, 1)) : "the 50 EMA") + " → exit at the " + str.tostring(rulesOk ? 50 : 9) + " EMA" : lineName(iShrtLn, -1)) +
                 "\n② wait max " + str.tostring(iBreak) + " candle" + (iBreak > 1 ? "s" : "") + " for a " + (iBrkC ? "close " : "") +
                 "break of its " + (longOk ? "HIGH " + str.tostring(high, "#.##") : "LOW " + str.tostring(low, "#.##")) +
                 (iBrkP > 0 ? " ±" + str.tostring(iBrkP, "#") + " pips" : "")
            // clean: a small dark tag with yellow text; the whole explanation is in the tooltip
            if vis
                label.new(bar_index, longOk ? high : low, T((longOk ? "long setup · " : "short setup · ") + str.lower(kind), setupFull),
                 style = longOk ? label.style_label_down : label.style_label_up,
                 color = iClean ? cTag : color.new(color.yellow, 10), textcolor = iClean ? color.yellow : color.black, size = iClean ? size.tiny : size.small,
                 tooltip = setupFull)
            if vis
                line.new(bar_index, longOk ? high : low, bar_index + iBreak, longOk ? high : low,
                 color = color.new(color.yellow, 0), width = 1, style = line.style_dotted)
            status := (longOk ? "LONG" : "SHORT") + " setup: waiting " + str.tostring(iBreak) + " candles for a break of " +
                 str.tostring(longOk ? high : low, "#.##")

// shade the trading hours
bgcolor(iSess and inSess ? color.new(color.blue, 94) : na, title = "Trading hours")

row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(color.silver, 10), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

// RULES BOX: the steps, showing the CURRENT setting of each ─────────────────
rr(table t, int r, string n, string tx) =>
    table.cell(t, 0, r, n, text_color = color.yellow, text_size = size.small)
    table.cell(t, 1, r, tx, text_color = color.white, text_size = size.small, text_halign = text.align_left)
if barstate.islast and iShowRules
    var table rb = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15),
         border_color = color.new(color.gray, 70), border_width = 1)
    table.cell(rb, 0, 0, "📜 SAAD'S RULES — step by step   (LONG · SHORT) — current settings", text_color = color.yellow, text_size = size.small)
    table.merge_cells(rb, 0, 0, 1, 0)
    rr(rb, 1, "①", (iPinDir ? "Thumb pin" : "Any pin") + (iHammer ? " / hammer" : "") + (iMaru ? " / marubozu" : "") + " on the " +
         (iLRule == "Both" ? "9 or 50 EMA" : iLRule == "50 EMA setup → exit at 9 EMA" ? "50 EMA" : iLongLn) + "  ·  on the " + iShrtLn +
         (iTouchP > 0 ? "  (±" + str.tostring(iTouchP, "#") + " pips)" : "") + (iTouch == "Candle touches the EMA" ? "" : "  · body on trade side"))
    rr(rb, 2, "②", "Wait max " + str.tostring(iBreak) + " candle" + (iBreak > 1 ? "s" : "") + " for the break" + (iBrkC ? " (on a close)" : "") +
         (iBrkP > 0 ? " by " + str.tostring(iBrkP, "#") + " pips" : ""))
    rr(rb, 3, "③", "High broken → BUY  ·  low broken → SELL" + (not iBuys ? "   (longs OFF)" : "") + (not iSells ? "   (shorts OFF)" : ""))
    rr(rb, 4, "④", "SL $" + str.tostring(iSlUsd, "#.00") + " below  ·  above the pin / marubozu")
    rr(rb, 5, "⑤", "TP: candle " + (iLTp == "Candle touches the 50 EMA" ? "touches" : "closes at") + " the " +
         (iLRule == "Both" ? "other EMA" : iLRule == "50 EMA setup → exit at 9 EMA" ? "9 EMA" : "50 EMA") + "  ·  last support (swing " + str.tostring(iPivot) + ")")
    rr(rb, 6, "⑥", "Exit at TP or SL" + (iBeUsd > 0 ? "  · breakeven after $" + str.tostring(iBeUsd, "#.#") : "") +
         (iTrail ? "  · ⑦ trailing " + iTrSide + (iTrRide ? " after the TP" : "") : ""))
    rr(rb, 7, "✖", "Skip: not broken in " + str.tostring(iBreak) + (iEr > 0 ? " · choppy (ER < " + str.tostring(iEr, "#.##") + ")" : "") +
         (iSess ? " · outside " + str.tostring(iFrom) + "–" + str.tostring(iTo) : ""))

// PANELS ──────────────────────────────────────────────────────────────────
if barstate.islast
    var table st = table.new(position.bottom_left, 1, 2, bgcolor = color.new(color.black, 10),
         border_color = color.new(color.gray, 40), border_width = 1)
    table.cell(st, 0, 0, "🎯 SAAD STRATEGY — NOW", text_color = color.yellow, text_size = size.small, text_halign = text.align_left)
    nOpenL = array.size(aSide)
    string openTxt = ""
    if nOpenL > 0
        for i = 0 to nOpenL - 1
            openTxt += (i > 0 ? "\n" : "") + (array.get(aSide, i) > 0 ? "IN LONG #" : "IN SHORT #") + str.tostring(array.get(aNum, i)) +
                 " @ " + fp(array.get(aEn, i)) + " | SL " + fp(array.get(aSl, i)) + (array.get(aRide, i) ? " (trailing)" : "")
    if iPC and iMaxOpen > 1
        openTxt += (openTxt == "" ? "" : "\n") + "⚠ PineConnector alerts are OFF while Max open trades > 1"
    stNow = nOpenL > 0 ? openTxt : not inSess ? "Outside trading hours — no new setups" :
         choppy ? "Market choppy (ER " + str.tostring(er, "#.##") + " < " + str.tostring(iEr, "#.##") + ") — setups skipped" : status
    table.cell(st, 0, 1, stNow + (nOpenL == 0 and iPC and iMaxOpen > 1 ? "\n⚠ PineConnector alerts are OFF while Max open trades > 1" : ""), text_color = color.white, text_size = size.small, text_halign = text.align_left)

    if iShowPn
        var table p = table.new(position.bottom_right, 2, 13, bgcolor = color.new(color.black, 15),
             border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)
        pf  = gL > 0 ? gW / gL : na
        wr  = nT > 0 ? float(nW) / nT * 100.0 : 0.0
        net = gW - gL
        cWhite = color.white, cDim = color.new(color.silver, 10)
        table.cell(p, 0, 0, "📊 SAAD STRATEGY (EA v4.02)", text_color = color.yellow, text_size = size.small)
        table.merge_cells(p, 0, 0, 1, 0)
        table.cell(p, 0, 1, "EMA " + str.tostring(iFast) + " / " + str.tostring(iSlow) + " · SL $" + str.tostring(iSlUsd, "#.00") + (iMaxOpen > 1 ? " · up to " + str.tostring(iMaxOpen) + " open (most at once: " + str.tostring(maxOpenSeen) + ")" : "") + " · results for THESE settings", text_color = cDim, text_size = size.tiny)
        table.merge_cells(p, 0, 1, 1, 1)
        row(p, 2,  "Trades on this chart", str.tostring(nT) + "  (" + str.tostring(nLong) + " long · " + str.tostring(nShort) + " short)", cWhite)
        row(p, 3,  "Win rate", str.tostring(wr, "#.#") + "%  (" + str.tostring(nW) + "W / " + str.tostring(nL) + "L)", wr >= 50 ? color.lime : color.orange)
        row(p, 4,  "Net @ " + str.tostring(iLots, "#.##") + " lots, after $" + str.tostring(iSpread, "#.##") + " spread", (net >= 0 ? "+$" : "−$") + str.tostring(math.abs(net), "#.##"), net >= 0 ? color.lime : color.red)
        row(p, 5,  "Profit factor", na(pf) ? "—" : str.tostring(pf, "#.##"), na(pf) or pf >= 1 ? color.lime : color.red)
        row(p, 6,  "Longs / shorts net", (netL >= 0 ? "+$" : "−$") + str.tostring(math.abs(netL), "#") + " / " + (netS >= 0 ? "+$" : "−$") + str.tostring(math.abs(netS), "#"), cWhite)
        row(p, 7,  "Today", str.tostring(nToday) + " trades  " + (pnlToday >= 0 ? "+$" : "−$") + str.tostring(math.abs(pnlToday), "#.##"), pnlToday >= 0 ? color.lime : color.red)
        row(p, 8,  "Skipped: no break / choppy / busy", str.tostring(nSkip) + " / " + str.tostring(nChop) + " / " + str.tostring(nBusy), cDim)
        row(p, 9,  "Efficiency ratio now", str.tostring(er, "#.##") + (choppy ? "  CHOPPY" : "  ok"), choppy ? color.orange : color.lime)
        table.cell(p, 0, 10, "MT5 receipt, EA v4.02 settings (Axi gold M5, real ticks, Jan–Oct 2026)", text_color = color.aqua, text_size = size.tiny)
        table.merge_cells(p, 0, 10, 1, 10)
        table.cell(p, 0, 11, "+$14,800 · 1,360 trades · 46% · PF 1.33 · DD 7% · 65% days green", text_color = color.aqua, text_size = size.small)
        table.merge_cells(p, 0, 11, 1, 11)
        table.cell(p, 0, 12, "Chart counts are a bar-close sketch; MT5 is the judge", text_color = cDim, text_size = size.tiny)
        table.merge_cells(p, 0, 12, 1, 12)

// TRADE JOURNAL ────────────────────────────────────────────────────────────
if barstate.islast and iJPage > 0
    var table jt = table.new(position.middle_center, 1, 42, bgcolor = color.new(color.black, 5), border_width = 0)
    n = array.size(jRows)
    first = (iJPage - 1) * 40
    table.cell(jt, 0, 0, "TRADE JOURNAL page " + str.tostring(iJPage) + " of " + str.tostring(math.ceil(n / 40.0)) + "  (" + str.tostring(n) + " closed trades)",
         text_color = color.yellow, text_size = size.tiny, text_halign = text.align_left)
    for r = 0 to 39
        i = first + r
        table.cell(jt, 0, r + 1, i < n ? array.get(jRows, i) : "", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
