//@version=5
// ═══════════════════════════════════════════════════════════════════════════
// Saad Strategy — visual guide to mt5/Saad_strategy.mq5 v3.20 (2026-10-11)
// Rules: mt5/RULES_EMA_SAAD.md. Drawn so Saad bhai can SEE what the EA does.
//   LONG : pin bar / marubozu ON the 9 EMA (50 EMA above it) -> buy when the
//          next 2 candles break its HIGH -> exit when a candle touches the 50 EMA
//   SHORT: pin bar / marubozu ON the 50 EMA -> sell when the next 2 candles
//          break its LOW -> target the last support (swing low)
//   Stop 25 pips ($2.50) beyond the candle · hours 08-17 Axi server (UTC+3) ·
//   skip choppy markets (efficiency ratio < 0.20)
// Bar-close approximation of the EA: the MT5 Strategy Tester is the judge.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Saad Strategy v3.20 — EMA 9/50 pin & marubozu", "Saad Strategy", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// SETTINGS ─────────────────────────────────────────────────────────────────
gS = "📐 Strategy (same defaults as the EA)"
iFast   = input.int(9,  'Fast EMA (the LONG line)', group = gS)
iSlow   = input.int(50, 'Slow EMA (the SHORT line, and the long target)', group = gS)
iWick   = input.float(0.60, 'Pin: long wick ≥ this × candle range', step = 0.05, group = gS)
iBody   = input.float(0.30, 'Pin: body ≤ this × range', step = 0.05, group = gS)
iNose   = input.float(0.25, 'Pin: short wick ≤ this × range', step = 0.05, group = gS)
iMaru   = input.bool(true, 'Also accept a marubozu', group = gS)
iMaruB  = input.float(0.80, 'Marubozu: body ≥ this × range', step = 0.05, group = gS)
iMinAtr = input.float(0.50, 'Candle range ≥ this × ATR(14) (0 = off)', step = 0.1, group = gS)
iBreak  = input.int(2, 'High/low must break within N candles', minval = 1, group = gS)
iL50Up  = input.bool(true, 'Longs only when the 50 EMA is above (its touch is a profit)', group = gS)
iSlPips = input.float(25, 'Stop: pips beyond the candle (1 gold pip = $0.10)', group = gS)
iPivot  = input.int(3, 'Last support: swing low with N bars each side', minval = 1, group = gS)
iEr     = input.float(0.20, 'Skip choppy: efficiency ratio below (0 = off)', step = 0.05, group = gS)
iErLen  = input.int(14, 'Efficiency ratio length', group = gS)
iSess   = input.bool(true, 'Only trade 08:00–17:00 Axi server time (UTC+3)', group = gS)
iFrom   = input.int(8, 'From hour (server)', group = gS)
iTo     = input.int(17, 'To hour (server)', group = gS)
iTz     = input.string("GMT+3", 'Server timezone', group = gS)
iBuys   = input.bool(true, 'Allow longs', group = gS)
iSells  = input.bool(true, 'Allow shorts', group = gS)

gV = "🎨 Display"
iLots   = input.float(0.10, 'Lots for the $ figures', step = 0.01, group = gV)
iCs     = input.float(100,  'Contract size ($ per $1 move per lot)', group = gV)
iShowSk = input.bool(true, 'Show skipped setups (no break / choppy)', group = gV)
iShowPn = input.bool(true, 'Show stats panel', group = gV)

// LINES ────────────────────────────────────────────────────────────────────
e9  = ta.ema(close, iFast)
e50 = ta.ema(close, iSlow)
plot(e9,  "EMA 9",  color = color.new(color.orange, 0), linewidth = 2)
plot(e50, "EMA 50", color = color.new(#2962ff, 0), linewidth = 2)
atr = ta.atr(14)
pip = 0.10
usd(d) => d * iLots * iCs

// SHAPE: +1 bullish pin/marubozu, -1 bearish, 0 none, and which kind ───────
rng  = high - low
body = math.abs(close - open)
up   = high - math.max(open, close)
lo   = math.min(open, close) - low
bigEnough = rng > 0 and (iMinAtr <= 0 or rng >= iMinAtr * atr)
pinBull = bigEnough and body <= iBody * rng and lo >= iWick * rng and up <= iNose * rng
pinBear = bigEnough and body <= iBody * rng and up >= iWick * rng and lo <= iNose * rng
maru    = bigEnough and iMaru and body >= iMaruB * rng and not pinBull and not pinBear
shape   = pinBull ? 1 : pinBear ? -1 : maru ? (close > open ? 1 : -1) : 0
kind    = pinBull or pinBear ? "PIN" : "MARUBOZU"

// FILTERS ─────────────────────────────────────────────────────────────────
er = 0.0
path = math.sum(math.abs(close - close[1]), iErLen)
er := path > 0 ? math.abs(close - close[iErLen]) / path : 0.0
choppy = iEr > 0 and er < iEr
hr = hour(time, iTz)
inSess = not iSess or (hr >= iFrom and hr < iTo)
on9  = low <= e9 and high >= e9
on50 = low <= e50 and high >= e50

// LAST SUPPORT: confirmed swing lows, newest first ────────────────────────
var array<float> supPx = array.new<float>()
pl = ta.pivotlow(low, iPivot, iPivot)
if not na(pl)
    array.unshift(supPx, pl)
    if array.size(supPx) > 60
        array.pop(supPx)
lastSupport(below) =>
    float r = na
    n = array.size(supPx)
    for i = 0 to (n > 0 ? n - 1 : 0)
        if n == 0
            break
        if array.get(supPx, i) < below
            r := array.get(supPx, i)
            break
    r

// STATE ───────────────────────────────────────────────────────────────────
var int   pSide = 0        // waiting setup: +1 long, -1 short
var float pHi = na
var float pLo = na
var int   pLeft = 0
var int   pBar = na
var int   tSide = 0        // open trade
var float tEn = na
var float tSl = na
var float tTp = na
var int   tBar = na
var int   tN = 0
var line  lEn = na
var line  lSl = na
var line  lTp = na
var int   nT = 0
var int   nW = 0
var int   nL = 0
var int   nLong = 0
var int   nShort = 0
var float gW = 0.0
var float gL = 0.0
var float netL = 0.0
var float netS = 0.0
var int   nSkip = 0
var int   nChop = 0
var int   nToday = 0
var float pnlToday = 0.0
var string status = "Waiting for a pin bar or marubozu on a line"
if ta.change(dayofweek(time, iTz)) != 0
    nToday := 0
    pnlToday := 0.0

closeTrade(px, why) =>
    d   = tSide > 0 ? px - tEn : tEn - px
    pnl = usd(d)
    win = pnl > 0
    txt = (win ? "✅ #" : "❌ #") + str.tostring(tN) + " " + why + "  " + (pnl >= 0 ? "+$" : "−$") + str.tostring(math.abs(pnl), "#.##")
    label.new(bar_index, tSide > 0 ? high : low, txt, style = tSide > 0 ? label.style_label_down : label.style_label_up,
         color = win ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
    line.set_x2(lEn, bar_index), line.set_x2(lSl, bar_index)
    if not na(lTp)
        line.set_x2(lTp, bar_index)
    pnl

// 1) MANAGE THE OPEN TRADE (stop checked first: the conservative order) ───
if tSide != 0 and bar_index > tBar
    float exitPx = na
    string why = ""
    if tSide > 0
        if low <= tSl
            exitPx := tSl, why := "SL hit"
        else if low <= e50 and high >= e50
            exitPx := e50, why := "50 EMA touch"
    else
        if high >= tSl
            exitPx := tSl, why := "SL hit"
        else if low <= tTp
            exitPx := tTp, why := "Support hit"
    if not na(exitPx)
        pnl = closeTrade(exitPx, why)
        nT += 1, nToday += 1, pnlToday += pnl
        if pnl > 0
            nW += 1, gW += pnl
        else
            nL += 1, gL -= pnl
        if tSide > 0
            netL += pnl
        else
            netS += pnl
        tSide := 0
        status := "Trade closed: " + why + " — waiting for the next setup"

// 2) A WAITING SETUP: does this candle break it? ──────────────────────────
if pSide != 0 and tSide == 0 and bar_index > pBar
    brk = pSide > 0 ? high > pHi : low < pLo
    if brk
        tSide := pSide
        tEn := pSide > 0 ? math.max(open, pHi) : math.min(open, pLo)
        tSl := pSide > 0 ? pLo - iSlPips * pip : pHi + iSlPips * pip
        tTp := pSide > 0 ? na : lastSupport(tEn)
        tBar := bar_index
        if pSide < 0 and na(tTp)
            tSide := 0                                   // the EA skips a short with no support below
            if iShowSk
                label.new(bar_index, high, "⏭ no support below", style = label.style_label_down,
                     color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
        else
            tN += 1
            if pSide > 0
                nLong += 1
            else
                nShort += 1
            risk = math.abs(tEn - tSl)
            tip = (pSide > 0 ? "BUY" : "SELL") + "  #" + str.tostring(tN) +
                 "\nEntry: " + str.tostring(tEn, "#.##") +
                 "\nSL:    " + str.tostring(tSl, "#.##") + "  −$" + str.tostring(usd(risk), "#.##") +
                 "\nTP:    " + (pSide > 0 ? "first candle touching the 50 EMA" :
                                 str.tostring(tTp, "#.##") + "  +$" + str.tostring(usd(tEn - tTp), "#.##") + " (last support)") +
                 "\nLots:  " + str.tostring(iLots, "#.##")
            label.new(bar_index, pSide > 0 ? low : high, pSide > 0 ? "BUY" : "SELL",
                 style = pSide > 0 ? label.style_label_up : label.style_label_down,
                 color = pSide > 0 ? color.new(#089981, 0) : color.new(#f23645, 0), textcolor = color.white,
                 size = size.normal, tooltip = tip)
            lEn := line.new(bar_index, tEn, bar_index + 1, tEn, color = color.new(color.white, 20), width = 1)
            lSl := line.new(bar_index, tSl, bar_index + 1, tSl, color = color.new(color.red, 0), width = 2, style = line.style_dashed)
            lTp := pSide < 0 ? line.new(bar_index, tTp, bar_index + 1, tTp, color = color.new(color.lime, 0), width = 2, style = line.style_dashed) : na
            status := (pSide > 0 ? "IN LONG #" : "IN SHORT #") + str.tostring(tN) + " @ " + str.tostring(tEn, "#.##") +
                 " | SL " + str.tostring(tSl, "#.##") + " | TP " + (pSide > 0 ? "50 EMA touch" : str.tostring(tTp, "#.##"))
        pSide := 0
    else
        pLeft -= 1
        if pLeft <= 0
            if iShowSk
                label.new(bar_index, pSide > 0 ? high : low, "⏭ not broken in " + str.tostring(iBreak),
                     style = pSide > 0 ? label.style_label_down : label.style_label_up,
                     color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
            nSkip += 1
            status := "Setup skipped: its " + (pSide > 0 ? "high" : "low") + " was not broken"
            pSide := 0

// stretch the open trade's lines to the current bar
if tSide != 0
    line.set_x2(lEn, bar_index + 1), line.set_x2(lSl, bar_index + 1)
    if not na(lTp)
        line.set_x2(lTp, bar_index + 1)

// 3) A NEW SETUP ON THE CANDLE THAT JUST CLOSED ───────────────────────────
if barstate.isconfirmed and tSide == 0 and pSide == 0 and shape != 0 and inSess
    longOk  = shape > 0 and iBuys and on9 and not (iL50Up and e50 <= high)
    shortOk = shape < 0 and iSells and on50
    if longOk or shortOk
        if choppy
            nChop += 1
            if iShowSk
                label.new(bar_index, longOk ? low : high, "〰 choppy (ER " + str.tostring(er, "#.##") + ")",
                     style = longOk ? label.style_label_up : label.style_label_down,
                     color = color.new(color.gray, 50), textcolor = color.white, size = size.tiny)
        else
            pSide := longOk ? 1 : -1
            pHi := high, pLo := low, pLeft := iBreak, pBar := bar_index
            box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.yellow, 0), 2, bgcolor = color.new(color.yellow, 85))
            label.new(bar_index, longOk ? high : low,
                 (kind == "PIN" ? "📌 PIN" : "🧱 MARUBOZU") + (longOk ? " on 9 EMA" : " on 50 EMA") +
                 "\nwaiting for " + (longOk ? "> " + str.tostring(high, "#.##") : "< " + str.tostring(low, "#.##")),
                 style = longOk ? label.style_label_down : label.style_label_up,
                 color = color.new(color.yellow, 10), textcolor = color.black, size = size.small)
            line.new(bar_index, longOk ? high : low, bar_index + iBreak, longOk ? high : low,
                 color = color.new(color.yellow, 0), width = 1, style = line.style_dotted)
            status := (longOk ? "LONG" : "SHORT") + " setup: waiting " + str.tostring(iBreak) + " candles for a break of " +
                 str.tostring(longOk ? high : low, "#.##")

// shade the trading hours
bgcolor(iSess and inSess ? color.new(color.blue, 94) : na, title = "Trading hours")

row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(color.silver, 10), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

// PANELS ──────────────────────────────────────────────────────────────────
if barstate.islast
    var table st = table.new(position.bottom_left, 1, 2, bgcolor = color.new(color.black, 10),
         border_color = color.new(color.gray, 40), border_width = 1)
    table.cell(st, 0, 0, "🎯 SAAD STRATEGY — NOW", text_color = color.yellow, text_size = size.small, text_halign = text.align_left)
    stNow = tSide != 0 ? status : not inSess ? "Outside trading hours (08–17 server) — no new setups" :
         choppy ? "Market choppy (ER " + str.tostring(er, "#.##") + " < " + str.tostring(iEr, "#.##") + ") — setups skipped" : status
    table.cell(st, 0, 1, stNow, text_color = color.white, text_size = size.small, text_halign = text.align_left)

    if iShowPn
        var table p = table.new(position.bottom_right, 2, 13, bgcolor = color.new(color.black, 15),
             border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)
        pf  = gL > 0 ? gW / gL : na
        wr  = nT > 0 ? float(nW) / nT * 100.0 : 0.0
        net = gW - gL
        cWhite = color.white, cDim = color.new(color.silver, 10)
        table.cell(p, 0, 0, "📊 SAAD STRATEGY v3.20", text_color = color.yellow, text_size = size.small)
        table.merge_cells(p, 0, 0, 1, 0)
        table.cell(p, 0, 1, "EMA 9 / 50 · pin & marubozu · SL 25 pips", text_color = cDim, text_size = size.tiny)
        table.merge_cells(p, 0, 1, 1, 1)
        row(p, 2,  "Trades on this chart", str.tostring(nT) + "  (" + str.tostring(nLong) + " long · " + str.tostring(nShort) + " short)", cWhite)
        row(p, 3,  "Win rate", str.tostring(wr, "#.#") + "%  (" + str.tostring(nW) + "W / " + str.tostring(nL) + "L)", wr >= 50 ? color.lime : color.orange)
        row(p, 4,  "Net @ " + str.tostring(iLots, "#.##") + " lots", (net >= 0 ? "+$" : "−$") + str.tostring(math.abs(net), "#.##"), net >= 0 ? color.lime : color.red)
        row(p, 5,  "Profit factor", na(pf) ? "—" : str.tostring(pf, "#.##"), na(pf) or pf >= 1 ? color.lime : color.red)
        row(p, 6,  "Longs / shorts net", (netL >= 0 ? "+$" : "−$") + str.tostring(math.abs(netL), "#") + " / " + (netS >= 0 ? "+$" : "−$") + str.tostring(math.abs(netS), "#"), cWhite)
        row(p, 7,  "Today", str.tostring(nToday) + " trades  " + (pnlToday >= 0 ? "+$" : "−$") + str.tostring(math.abs(pnlToday), "#.##"), pnlToday >= 0 ? color.lime : color.red)
        row(p, 8,  "Skipped: no break / choppy", str.tostring(nSkip) + " / " + str.tostring(nChop), cDim)
        row(p, 9,  "Efficiency ratio now", str.tostring(er, "#.##") + (choppy ? "  CHOPPY" : "  ok"), choppy ? color.orange : color.lime)
        table.cell(p, 0, 10, "MT5 receipt (Axi gold M5, real ticks, Jan–Oct 2026)", text_color = color.aqua, text_size = size.tiny)
        table.merge_cells(p, 0, 10, 1, 10)
        table.cell(p, 0, 11, "+$5,679 · 272 trades · 65.8% · PF 1.66 · DD 4.4%", text_color = color.aqua, text_size = size.small)
        table.merge_cells(p, 0, 11, 1, 11)
        table.cell(p, 0, 12, "Chart counts are a bar-close sketch; MT5 is the judge", text_color = cDim, text_size = size.tiny)
        table.merge_cells(p, 0, 12, 1, 12)
