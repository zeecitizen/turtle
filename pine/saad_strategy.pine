//@version=5
// ═══════════════════════════════════════════════════════════════════════════
// Saad Strategy — visual guide to mt5/Saad_strategy.mq5 v3.20 (2026-10-11)
// Rules: mt5/RULES_EMA_SAAD.md. Drawn so Saad bhai can SEE what the EA does.
// The SETTINGS are grouped by the rules' own steps ① to ⑥, and every rule can be
// TIGHTENED or RELAXED there. Defaults = the EA's tested v3.20 settings.
// Bar-close approximation of the EA: the MT5 Strategy Tester is the judge.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Saad Strategy v3.20 — EMA 9/50 pin & marubozu", "Saad", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// SETTINGS — one section per rule ──────────────────────────────────────────
g1 = "① SETUP CANDLE — pin bar (thumb pin) or marubozu"
iWick   = input.float(0.60, 'Pin: long wick at least this share of the candle   (higher = stricter)', minval = 0.3, maxval = 0.95, step = 0.05, group = g1)
iBody   = input.float(0.30, 'Pin: body at most this share of the candle   (lower = stricter)', minval = 0.05, maxval = 0.6, step = 0.05, group = g1)
iNose   = input.float(0.25, 'Pin: short wick at most this share   (lower = stricter)', minval = 0.0, maxval = 0.5, step = 0.05, group = g1)
iPinDir = input.bool(true, 'Pin must point the trade way (thumb down for LONG, up for SHORT)   OFF = any pin, the EMA decides', group = g1)
iMaru   = input.bool(true, 'Accept a marubozu too', group = g1)
iMaruB  = input.float(0.80, 'Marubozu: body at least this share of the candle   (higher = stricter)', minval = 0.5, maxval = 1.0, step = 0.05, group = g1)
iMinAtr = input.float(0.50, 'Candle at least this × an average candle (ATR 14)   (0 = any size; higher = only big candles)', minval = 0.0, step = 0.1, group = g1)

g1b = "① ...MADE ON THE EMA"
iFast   = input.int(9,  'Fast EMA length', minval = 1, group = g1b)
iSlow   = input.int(50, 'Slow EMA length', minval = 1, group = g1b)
iLongLn = input.string("9 EMA",  'LONG setups must be on', options = ["9 EMA", "50 EMA", "Either EMA"], group = g1b)
iShrtLn = input.string("50 EMA", 'SHORT setups must be on', options = ["50 EMA", "9 EMA", "Either EMA"], group = g1b)
iTouch  = input.string("Candle touches the EMA", '"On the EMA" means', options = ["Candle touches the EMA", "Wick touches, body stays on the trade side"], group = g1b)
iTouchP = input.float(0.0, 'Touch tolerance in pips   (0 = must really touch; higher = near-misses count)', minval = 0.0, step = 1.0, group = g1b)
iL50Up  = input.bool(true, 'LONG only when the 50 EMA is above the candle (so the 50 EMA exit is a profit)', group = g1b)

g2 = "② WAIT FOR THE BREAK — next or next-to-next candle"
iBreak  = input.int(2, 'Candles allowed to break the high / low   (rule = 2; 1 = stricter)', minval = 1, maxval = 10, group = g2)
iBrkP   = input.float(0.0, 'Break must clear the high / low by at least this many pips   (0 = any break)', minval = 0.0, step = 1.0, group = g2)
iBrkC   = input.bool(false, 'Break must be a candle CLOSE beyond it (stricter; entry at that close)', group = g2)

g3 = "③ ENTRY"
iBuys   = input.bool(true, 'Allow LONG trades', group = g3)
iSells  = input.bool(true, 'Allow SHORT trades', group = g3)

g4 = "④ STOP LOSS"
iSlPips = input.float(25, 'Stop this many pips beyond the pin / marubozu   (rules 20; EA tested best 25–30)', minval = 1, step = 1, group = g4)

g5 = "⑤ TAKE PROFIT"
iLTp    = input.string("Candle touches the 50 EMA", 'LONG exit', options = ["Candle touches the 50 EMA", "Candle CLOSES at / beyond the 50 EMA"], group = g5)
iLTpP   = input.float(0.0, 'LONG: take profit this many pips before the 50 EMA   (0 = at the line)', minval = 0.0, step = 1.0, group = g5)
iPivot  = input.int(3, 'SHORT "last support" = a swing low with this many candles each side   (higher = bigger, further levels)', minval = 1, maxval = 10, group = g5)
iSTpP   = input.float(0.0, 'SHORT: take profit this many pips before the support   (0 = at the level)', minval = 0.0, step = 1.0, group = g5)

g6 = "⑥ BREAKEVEN — the rules' \"test if profit above 3 USD\""
iBeUsd  = input.float(0.0, 'Move the stop to entry once profit passes this many $   (0 = off; rules test 3)', minval = 0.0, step = 0.5, group = g6)
iBeMode = input.string("Price moved $X", 'Measure the $ as', options = ["Price moved $X", "Profit $X at the chosen lots"], group = g6)

gX = "✖ SKIP FILTERS (added after testing; not in the rules)"
iEr     = input.float(0.20, 'Skip choppy markets: efficiency ratio below this   (0 = off; higher = stricter)', minval = 0.0, maxval = 0.9, step = 0.05, group = gX)
iErLen  = input.int(14, 'Efficiency ratio length (candles)', minval = 2, group = gX)
iSess   = input.bool(true, 'Only trade between these hours', group = gX)
iFrom   = input.int(8, 'From hour (Axi server time; 8 = 10 AM Pakistan)', minval = 0, maxval = 23, group = gX)
iTo     = input.int(17, 'To hour (17 = 7 PM Pakistan)', minval = 1, maxval = 24, group = gX)
iTz     = input.string("GMT+3", 'Server timezone', group = gX)

gV = "🎨 DISPLAY"
iLots   = input.float(0.10, 'Lots for the $ figures', step = 0.01, group = gV)
iCs     = input.float(100,  'Contract size ($ per $1 move per lot)', group = gV)
iShowSk = input.bool(true, 'Show skipped setups', group = gV)
iShowPn = input.bool(true, 'Show stats panel', group = gV)
iShowRules = input.bool(true, 'Show the numbered rules box', group = gV)

g7 = "⑦ TRAILING STOP (test — not in the rules)"
iTrail   = input.bool(false, 'Use a trailing stop', group = g7)
iTrSide  = input.string("LONG only", 'Apply it to', options = ["LONG only", "SHORT only", "Both"], group = g7)
iTrRide  = input.bool(true, 'Let winners run: when the TP is reached, start trailing instead of exiting', group = g7)
iTrMode  = input.string("Low / high of the last N candles", 'Trail the stop by', options = ["Low / high of the last N candles", "X pips behind the best price", "ATR multiple behind the best price"], group = g7)
iTrN     = input.int(3, 'N candles   (more = looser)', minval = 1, maxval = 20, group = g7)
iTrPips  = input.float(30, 'X pips   (more = looser)', minval = 1, step = 1, group = g7)
iTrAtr   = input.float(1.5, 'ATR multiple   (more = looser)', minval = 0.1, step = 0.1, group = g7)
iTrStart = input.float(0, 'Without "let winners run": start trailing after this many pips of profit   (0 = at once)', minval = 0, step = 1, group = g7)

g8 = "⑧ LONG RULE — which EMA is the setup, which is the exit"
iLRule   = input.string("9 EMA setup → exit at 50 EMA", 'LONG rule', options = ["9 EMA setup → exit at 50 EMA", "50 EMA setup → exit at 9 EMA", "Both"], group = g8,
     tooltip = "The rules: a bullish pin / marubozu ON the 9 EMA, exit when a candle touches the 50 EMA.\nThe inverse: ON the 50 EMA, exit when a candle touches the 9 EMA.\n'Both' takes either; each trade exits at the OTHER EMA.\nIn the inverse and Both modes this replaces 'LONG setups must be on'; 'LONG only when the exit EMA is above' still applies.")

g9 = "⑨ HAMMERS — accept them as setup candles too"
iHammer  = input.bool(false, 'Also accept hammers (LONG) and shooting stars (SHORT)', group = g9,
     tooltip = "Hammer: long LOWER wick at least N × the body, little or no upper wick, any colour.\nShooting star: the mirror (long UPPER wick) for SHORT setups.\nA pin bar needs its wick to be 60% of the whole candle; a hammer only needs it to be N × the body, so hammers with a bigger body now count.")
iHamRatio = input.float(2.0, 'Hammer: long wick at least this × the body   (higher = stricter; classic = 2)', minval = 1.0, step = 0.5, group = g9)
iHamNose  = input.float(0.10, 'Hammer: opposite wick at most this share of the candle   (lower = stricter)', minval = 0.0, maxval = 0.5, step = 0.05, group = g9)

// LINES ────────────────────────────────────────────────────────────────────
e9  = ta.ema(close, iFast)
e50 = ta.ema(close, iSlow)
plot(e9,  "EMA fast", color = color.new(color.orange, 0), linewidth = 2)
plot(e50, "EMA slow", color = color.new(#2962ff, 0), linewidth = 2)
atr = ta.atr(14)
pip = 0.10
usd(d) => d * iLots * iCs
exitVal(int which) => which == 9 ? e9 : e50

// ① SHAPE: +1 bullish, -1 bearish, 2 = a pin whose direction the EMA decides ─
rng  = high - low
body = math.abs(close - open)
up   = high - math.max(open, close)
lo   = math.min(open, close) - low
bigEnough = rng > 0 and (iMinAtr <= 0 or rng >= iMinAtr * atr)
pinBull = bigEnough and body <= iBody * rng and lo >= iWick * rng and up <= iNose * rng
pinBear = bigEnough and body <= iBody * rng and up >= iWick * rng and lo <= iNose * rng
hamBull = bigEnough and iHammer and not pinBull and not pinBear and lo >= iHamRatio * body and lo > 0 and up <= iHamNose * rng
hamBear = bigEnough and iHammer and not pinBull and not pinBear and up >= iHamRatio * body and up > 0 and lo <= iHamNose * rng
maru    = bigEnough and iMaru and body >= iMaruB * rng and not pinBull and not pinBear and not hamBull and not hamBear
shape   = (pinBull or pinBear) and not iPinDir ? 2 : pinBull ? 1 : pinBear ? -1 : hamBull ? 1 : hamBear ? -1 : maru ? (close > open ? 1 : -1) : 0
kind    = pinBull or pinBear ? "PIN BAR" : hamBull ? "HAMMER" : hamBear ? "SHOOTING STAR" : "MARUBOZU"

// ① ON THE EMA ─────────────────────────────────────────────────────────────
tol = iTouchP * pip
onLine(float e, int side) =>
    bool r = false
    if iTouch == "Candle touches the EMA"
        r := low - tol <= e and high + tol >= e
    else
        // wick reaches the line, body stays on the trade's side of it
        r := side > 0 ? (low - tol <= e and math.min(open, close) >= e) : (high + tol >= e and math.max(open, close) <= e)
    r
lineFor(string which, int side) =>
    which == "9 EMA" ? onLine(e9, side) : which == "50 EMA" ? onLine(e50, side) : (onLine(e9, side) or onLine(e50, side))
lineName(string which, int side) =>
    which == "9 EMA" ? "the 9 EMA" : which == "50 EMA" ? "the 50 EMA" : (onLine(e9, side) ? "the 9 EMA" : "the 50 EMA")

// ✖ FILTERS ───────────────────────────────────────────────────────────────
er = 0.0
path = math.sum(math.abs(close - close[1]), iErLen)
er := path > 0 ? math.abs(close - close[iErLen]) / path : 0.0
choppy = iEr > 0 and er < iEr
hr = hour(time, iTz)
inSess = not iSess or (hr >= iFrom and hr < iTo)

// ⑤ LAST SUPPORT: confirmed swing lows, newest first ──────────────────────
var array<float> supPx = array.new<float>()
pl = ta.pivotlow(low, iPivot, iPivot)
if not na(pl)
    array.unshift(supPx, pl)
    if array.size(supPx) > 60
        array.pop(supPx)
lastSupport(below) =>
    float r = na
    n = array.size(supPx)
    for i = 0 to (n > 0 ? n - 1 : 0)
        if n == 0
            break
        if array.get(supPx, i) < below
            r := array.get(supPx, i)
            break
    r

// STATE ───────────────────────────────────────────────────────────────────
var int   pSide = 0        // waiting setup: +1 long, -1 short
var float pHi = na
var float pLo = na
var int   pLeft = 0
var int   pBar = na
var int   tSide = 0        // open trade
var float tEn = na
var float tSl = na
var float tTp = na
var int   tBar = na
var int   tN = 0
var bool  tBe = false
var float tBest = na       // best price since entry (for the trailing stop)
var bool  tRide = false    // the TP was reached and the trade is now riding the trailing stop
var int   pExitE = 50      // waiting LONG setup: which EMA will be its exit (9 or 50)
var int   tExitE = 50      // open LONG: which EMA is its exit
var line  lEn = na
var line  lSl = na
var line  lTp = na
var label xSl = na
var label xTp = na
var int   nT = 0
var int   nW = 0
var int   nL = 0
var int   nLong = 0
var int   nShort = 0
var float gW = 0.0
var float gL = 0.0
var float netL = 0.0
var float netS = 0.0
var int   nSkip = 0
var int   nChop = 0
var int   nToday = 0
var float pnlToday = 0.0
var string status = "Waiting for a pin bar or marubozu on a line"
if ta.change(dayofweek(time, iTz)) != 0
    nToday := 0
    pnlToday := 0.0

closeTrade(px, why) =>
    d   = tSide > 0 ? px - tEn : tEn - px
    pnl = usd(d)
    win = pnl > 0
    txt = "⑥ EXIT #" + str.tostring(tN) + (win ? " ✅ " : pnl == 0 ? " ⚪ " : " ❌ ") + why + "\n" + (pnl >= 0 ? "+$" : "−$") + str.tostring(math.abs(pnl), "#.##")
    label.new(bar_index, tSide > 0 ? high : low, txt, style = tSide > 0 ? label.style_label_down : label.style_label_up,
         color = win ? color.new(color.green, 10) : pnl == 0 ? color.new(color.gray, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
    line.set_x2(lEn, bar_index), line.set_x2(lSl, bar_index)
    if not na(lTp)
        line.set_x2(lTp, bar_index)
    label.set_x(xSl, bar_index)
    label.set_x(xTp, bar_index)
    if tSide > 0 and iLTpP == 0
        label.set_y(xTp, exitVal(tExitE))
    pnl

trLow  = ta.lowest(low, iTrN)       // computed every candle (Pine needs history functions outside conditions)
trHigh = ta.highest(high, iTrN)
trailOn(int side) =>
    iTrail and (iTrSide == "Both" or (side > 0 and iTrSide == "LONG only") or (side < 0 and iTrSide == "SHORT only"))

// 1) MANAGE THE OPEN TRADE (stop checked first: the conservative order) ───
if tSide != 0 and bar_index > tBar
    float exitPx = na
    string why = ""
    ltol = iLTpP * pip
    if tSide > 0
        eX  = exitVal(tExitE)
        tgt = eX >= tEn ? eX - ltol : eX + ltol
        hitTp = iLTp == "Candle touches the 50 EMA" ? (low <= tgt and high >= tgt) : (eX >= tEn ? close >= tgt : close <= tgt)
        if low <= tSl
            exitPx := tSl, why := tRide or tSl > tEn ? "trailing stop hit" : tBe ? "breakeven stop" : "stop loss hit"
        else if hitTp and not tRide
            if trailOn(1) and iTrRide
                tRide := true
                label.new(bar_index, high, "⑤ TP reached → now trailing", style = label.style_label_down,
                     color = color.new(color.teal, 10), textcolor = color.white, size = size.tiny)
            else
                exitPx := iLTp == "Candle touches the 50 EMA" ? tgt : close
                why := str.tostring(tExitE) + " EMA " + (iLTp == "Candle touches the 50 EMA" ? "touched" : "close") + " (TP)"
    else
        if high >= tSl
            exitPx := tSl, why := tRide or tSl < tEn ? "trailing stop hit" : tBe ? "breakeven stop" : "stop loss hit"
        else if low <= tTp and not tRide
            if trailOn(-1) and iTrRide
                tRide := true
                label.new(bar_index, low, "⑤ TP reached → now trailing", style = label.style_label_up,
                     color = color.new(color.teal, 10), textcolor = color.white, size = size.tiny)
            else
                exitPx := tTp, why := "reached last support (TP)"
    if not na(exitPx)
        pnl = closeTrade(exitPx, why)
        nT += 1, nToday += 1, pnlToday += pnl
        if pnl > 0
            nW += 1, gW += pnl
        else if pnl < 0
            nL += 1, gL -= pnl
        if tSide > 0
            netL += pnl
        else
            netS += pnl
        tSide := 0
        status := "Trade closed: " + why + " — waiting for the next setup"
    else if trailOn(tSide)
        tBest := tSide > 0 ? math.max(nz(tBest, tEn), high) : math.min(nz(tBest, tEn), low)
        started = iTrRide ? tRide : (tSide > 0 ? tBest - tEn : tEn - tBest) >= iTrStart * pip
        if started
            float lvl = na
            if iTrMode == "Low / high of the last N candles"
                lvl := tSide > 0 ? trLow : trHigh
            else if iTrMode == "X pips behind the best price"
                lvl := tSide > 0 ? tBest - iTrPips * pip : tBest + iTrPips * pip
            else
                lvl := tSide > 0 ? tBest - iTrAtr * atr : tBest + iTrAtr * atr
            better = tSide > 0 ? lvl > tSl and lvl < close : lvl < tSl and lvl > close
            if better
                // end the old stop segment here and start a new, tighter one: the stop is drawn as steps
                line.set_x2(lSl, bar_index)
                tSl := lvl
                lSl := line.new(bar_index, tSl, bar_index + 1, tSl, color = color.new(color.orange, 0), width = 2, style = line.style_dashed)
                label.set_y(xSl, tSl)
                label.set_text(xSl, "④ TRAILING SL = " + str.tostring(tSl, "#.##") + "  (" + (tSide > 0 ? (tSl >= tEn ? "+$" : "−$") : (tSl <= tEn ? "+$" : "−$")) +
                     str.tostring(math.abs(usd(tSide > 0 ? tSl - tEn : tEn - tSl)), "#.##") + " locked)")
    if tSide != 0 and iBeUsd > 0 and not tBe
        // ⑥ breakeven: judged on this candle's best price, applied from the next one
        best = tSide > 0 ? high - tEn : tEn - low
        gain = iBeMode == "Price moved $X" ? best : usd(best)
        if gain > iBeUsd
            tBe := true
            tSl := tEn
            line.set_y1(lSl, tEn), line.set_y2(lSl, tEn)
            label.set_y(xSl, tEn)
            label.set_text(xSl, "④ SL moved to entry (breakeven) = " + str.tostring(tEn, "#.##"))
            label.new(bar_index, tSide > 0 ? high : low, "BE", style = tSide > 0 ? label.style_label_down : label.style_label_up,
                 color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)

// 2) A WAITING SETUP: does this candle break it? ──────────────────────────
if pSide != 0 and tSide == 0 and bar_index > pBar
    lvl = pSide > 0 ? pHi + iBrkP * pip : pLo - iBrkP * pip
    brk = iBrkC ? (pSide > 0 ? close > lvl : close < lvl) : (pSide > 0 ? high > lvl : low < lvl)
    if brk
        tSide := pSide
        tEn := iBrkC ? close : (pSide > 0 ? math.max(open, lvl) : math.min(open, lvl))
        tSl := pSide > 0 ? pLo - iSlPips * pip : pHi + iSlPips * pip
        sup = pSide < 0 ? lastSupport(tEn) : na
        tTp := pSide > 0 ? na : (na(sup) ? na : sup + iSTpP * pip)
        tBar := bar_index
        tBe := false
        tBest := na
        tRide := false
        tExitE := pExitE
        if pSide < 0 and (na(tTp) or tTp >= tEn)
            tSide := 0                                   // the EA skips a short with no support below
            if iShowSk
                label.new(bar_index, high, "✖ SKIP: no support below to target", style = label.style_label_down,
                     color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
        else
            tN += 1
            if pSide > 0
                nLong += 1
            else
                nShort += 1
            risk = math.abs(tEn - tSl)
            tip = (pSide > 0 ? "BUY" : "SELL") + "  #" + str.tostring(tN) +
                 "\nEntry: " + str.tostring(tEn, "#.##") +
                 "\nSL:    " + str.tostring(tSl, "#.##") + "  −$" + str.tostring(usd(risk), "#.##") +
                 "\nTP:    " + (pSide > 0 ? "the " + str.tostring(tExitE) + " EMA" :
                                 str.tostring(tTp, "#.##") + "  +$" + str.tostring(usd(tEn - tTp), "#.##") + " (last support)") +
                 "\nLots:  " + str.tostring(iLots, "#.##")
            label.new(bar_index, pSide > 0 ? low : high,
                 (pSide > 0 ? "③ HIGH BROKEN → BUY" : "③ LOW BROKEN → SELL") + (iBrkC ? " (close)" : "") + "\n@ " + str.tostring(tEn, "#.##"),
                 style = pSide > 0 ? label.style_label_up : label.style_label_down,
                 color = pSide > 0 ? color.new(#089981, 0) : color.new(#f23645, 0), textcolor = color.white,
                 size = size.normal, tooltip = tip)
            lEn := line.new(bar_index, tEn, bar_index + 1, tEn, color = color.new(color.white, 20), width = 1)
            lSl := line.new(bar_index, tSl, bar_index + 1, tSl, color = color.new(color.red, 0), width = 2, style = line.style_dashed)
            lTp := pSide < 0 ? line.new(bar_index, tTp, bar_index + 1, tTp, color = color.new(color.lime, 0), width = 2, style = line.style_dashed) : na
            xSl := label.new(bar_index + 2, tSl, "④ SL: " + str.tostring(iSlPips, "#") + " pips " + (pSide > 0 ? "below" : "above") +
                 " the candle = " + str.tostring(tSl, "#.##") + "  (−$" + str.tostring(usd(risk), "#.##") + ")",
                 style = label.style_label_left, color = color.new(color.red, 15), textcolor = color.white, size = size.small)
            xTp := label.new(bar_index + 2, pSide > 0 ? exitVal(tExitE) : tTp,
                 pSide > 0 ? "⑤ TP: exit when a candle " + (iLTp == "Candle touches the 50 EMA" ? "touches" : "closes at") + " the " + str.tostring(tExitE) + " EMA" +
                             (iLTpP > 0 ? " (−" + str.tostring(iLTpP, "#") + " pips)" : "") :
                 "⑤ TP: last support (liquidity) = " + str.tostring(tTp, "#.##") + "  (+$" + str.tostring(usd(tEn - tTp), "#.##") + ")",
                 style = label.style_label_left, color = color.new(color.green, 15), textcolor = color.white, size = size.small)
            status := (pSide > 0 ? "IN LONG #" : "IN SHORT #") + str.tostring(tN) + " @ " + str.tostring(tEn, "#.##") +
                 " | SL " + str.tostring(tSl, "#.##") + " | TP " + (pSide > 0 ? str.tostring(tExitE) + " EMA" : str.tostring(tTp, "#.##"))
        pSide := 0
    else
        pLeft -= 1
        if pLeft <= 0
            if iShowSk
                label.new(bar_index, pSide > 0 ? high : low, "✖ SKIP (rule): " + (pSide > 0 ? "high" : "low") + " not broken within " + str.tostring(iBreak) + " candle" + (iBreak > 1 ? "s" : ""),
                     style = pSide > 0 ? label.style_label_down : label.style_label_up,
                     color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
            nSkip += 1
            status := "Setup skipped: its " + (pSide > 0 ? "high" : "low") + " was not broken"
            pSide := 0

// stretch the open trade's lines to the current bar
if tSide != 0
    line.set_x2(lEn, bar_index + 1), line.set_x2(lSl, bar_index + 1)
    if not na(lTp)
        line.set_x2(lTp, bar_index + 1)
    label.set_x(xSl, bar_index + 2)
    label.set_x(xTp, bar_index + 2)
    if tSide > 0
        label.set_y(xTp, exitVal(tExitE))

// 3) A NEW SETUP ON THE CANDLE THAT JUST CLOSED ───────────────────────────
if barstate.isconfirmed and tSide == 0 and pSide == 0 and shape != 0 and inSess
    // ⑧ which long rule(s) this candle satisfies: the original (on 9, exit 50) and/or the inverse (on 50, exit 9)
    bool rulesOk = iLRule != "50 EMA setup → exit at 9 EMA" and (iLRule == "Both" ? onLine(e9, 1) : lineFor(iLongLn, 1)) and not (iL50Up and e50 <= high)
    bool invOk   = iLRule != "9 EMA setup → exit at 50 EMA" and onLine(e50, 1) and not (iL50Up and e9 <= high)
    longLine  = rulesOk or invOk
    shortLine = lineFor(iShrtLn, -1)
    longOk  = iBuys  and longLine  and (shape == 1 or (shape == 2 and (not shortLine or close >= open)))
    shortOk = iSells and shortLine and (shape == -1 or shape == 2) and not longOk
    if longOk or shortOk
        if choppy
            nChop += 1
            if iShowSk
                label.new(bar_index, longOk ? low : high, "✖ SKIP: choppy market (ER " + str.tostring(er, "#.##") + " < " + str.tostring(iEr, "#.##") + ")",
                     style = longOk ? label.style_label_up : label.style_label_down,
                     color = color.new(color.gray, 50), textcolor = color.white, size = size.tiny)
        else
            pSide := longOk ? 1 : -1
            pHi := high, pLo := low, pLeft := iBreak, pBar := bar_index
            pExitE := rulesOk ? 50 : 9
            box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.yellow, 0), 2, bgcolor = color.new(color.yellow, 85))
            label.new(bar_index, longOk ? high : low,
                 "① " + (longOk ? "LONG" : "SHORT") + " SETUP: " + kind + " on " +
                 (longOk ? (rulesOk ? (iLRule == "Both" ? "the 9 EMA" : lineName(iLongLn, 1)) : "the 50 EMA") + " → exit at the " + str.tostring(rulesOk ? 50 : 9) + " EMA" : lineName(iShrtLn, -1)) +
                 "\n② wait max " + str.tostring(iBreak) + " candle" + (iBreak > 1 ? "s" : "") + " for a " + (iBrkC ? "close " : "") +
                 "break of its " + (longOk ? "HIGH " + str.tostring(high, "#.##") : "LOW " + str.tostring(low, "#.##")) +
                 (iBrkP > 0 ? " ±" + str.tostring(iBrkP, "#") + " pips" : ""),
                 style = longOk ? label.style_label_down : label.style_label_up,
                 color = color.new(color.yellow, 10), textcolor = color.black, size = size.small)
            line.new(bar_index, longOk ? high : low, bar_index + iBreak, longOk ? high : low,
                 color = color.new(color.yellow, 0), width = 1, style = line.style_dotted)
            status := (longOk ? "LONG" : "SHORT") + " setup: waiting " + str.tostring(iBreak) + " candles for a break of " +
                 str.tostring(longOk ? high : low, "#.##")

// shade the trading hours
bgcolor(iSess and inSess ? color.new(color.blue, 94) : na, title = "Trading hours")

row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(color.silver, 10), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

// RULES BOX: the steps, showing the CURRENT setting of each ─────────────────
rr(table t, int r, string n, string tx) =>
    table.cell(t, 0, r, n, text_color = color.yellow, text_size = size.small)
    table.cell(t, 1, r, tx, text_color = color.white, text_size = size.small, text_halign = text.align_left)
if barstate.islast and iShowRules
    var table rb = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15),
         border_color = color.new(color.gray, 70), border_width = 1)
    table.cell(rb, 0, 0, "📜 SAAD'S RULES — step by step   (LONG · SHORT) — current settings", text_color = color.yellow, text_size = size.small)
    table.merge_cells(rb, 0, 0, 1, 0)
    rr(rb, 1, "①", (iPinDir ? "Thumb pin" : "Any pin") + (iHammer ? " / hammer" : "") + (iMaru ? " / marubozu" : "") + " on the " +
         (iLRule == "Both" ? "9 or 50 EMA" : iLRule == "50 EMA setup → exit at 9 EMA" ? "50 EMA" : iLongLn) + "  ·  on the " + iShrtLn +
         (iTouchP > 0 ? "  (±" + str.tostring(iTouchP, "#") + " pips)" : "") + (iTouch == "Candle touches the EMA" ? "" : "  · body on trade side"))
    rr(rb, 2, "②", "Wait max " + str.tostring(iBreak) + " candle" + (iBreak > 1 ? "s" : "") + " for the break" + (iBrkC ? " (on a close)" : "") +
         (iBrkP > 0 ? " by " + str.tostring(iBrkP, "#") + " pips" : ""))
    rr(rb, 3, "③", "High broken → BUY  ·  low broken → SELL" + (not iBuys ? "   (longs OFF)" : "") + (not iSells ? "   (shorts OFF)" : ""))
    rr(rb, 4, "④", "SL " + str.tostring(iSlPips, "#") + " pips below  ·  above the pin / marubozu")
    rr(rb, 5, "⑤", "TP: candle " + (iLTp == "Candle touches the 50 EMA" ? "touches" : "closes at") + " the " +
         (iLRule == "Both" ? "other EMA" : iLRule == "50 EMA setup → exit at 9 EMA" ? "9 EMA" : "50 EMA") + "  ·  last support (swing " + str.tostring(iPivot) + ")")
    rr(rb, 6, "⑥", "Exit at TP or SL" + (iBeUsd > 0 ? "  · breakeven after $" + str.tostring(iBeUsd, "#.#") : "") +
         (iTrail ? "  · ⑦ trailing " + iTrSide + (iTrRide ? " after the TP" : "") : ""))
    rr(rb, 7, "✖", "Skip: not broken in " + str.tostring(iBreak) + (iEr > 0 ? " · choppy (ER < " + str.tostring(iEr, "#.##") + ")" : "") +
         (iSess ? " · outside " + str.tostring(iFrom) + "–" + str.tostring(iTo) : ""))

// PANELS ──────────────────────────────────────────────────────────────────
if barstate.islast
    var table st = table.new(position.bottom_left, 1, 2, bgcolor = color.new(color.black, 10),
         border_color = color.new(color.gray, 40), border_width = 1)
    table.cell(st, 0, 0, "🎯 SAAD STRATEGY — NOW", text_color = color.yellow, text_size = size.small, text_halign = text.align_left)
    stNow = tSide != 0 ? status : not inSess ? "Outside trading hours — no new setups" :
         choppy ? "Market choppy (ER " + str.tostring(er, "#.##") + " < " + str.tostring(iEr, "#.##") + ") — setups skipped" : status
    table.cell(st, 0, 1, stNow, text_color = color.white, text_size = size.small, text_halign = text.align_left)

    if iShowPn
        var table p = table.new(position.bottom_right, 2, 13, bgcolor = color.new(color.black, 15),
             border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)
        pf  = gL > 0 ? gW / gL : na
        wr  = nT > 0 ? float(nW) / nT * 100.0 : 0.0
        net = gW - gL
        cWhite = color.white, cDim = color.new(color.silver, 10)
        table.cell(p, 0, 0, "📊 SAAD STRATEGY v3.20", text_color = color.yellow, text_size = size.small)
        table.merge_cells(p, 0, 0, 1, 0)
        table.cell(p, 0, 1, "EMA " + str.tostring(iFast) + " / " + str.tostring(iSlow) + " · SL " + str.tostring(iSlPips, "#") + " pips · results for THESE settings", text_color = cDim, text_size = size.tiny)
        table.merge_cells(p, 0, 1, 1, 1)
        row(p, 2,  "Trades on this chart", str.tostring(nT) + "  (" + str.tostring(nLong) + " long · " + str.tostring(nShort) + " short)", cWhite)
        row(p, 3,  "Win rate", str.tostring(wr, "#.#") + "%  (" + str.tostring(nW) + "W / " + str.tostring(nL) + "L)", wr >= 50 ? color.lime : color.orange)
        row(p, 4,  "Net @ " + str.tostring(iLots, "#.##") + " lots", (net >= 0 ? "+$" : "−$") + str.tostring(math.abs(net), "#.##"), net >= 0 ? color.lime : color.red)
        row(p, 5,  "Profit factor", na(pf) ? "—" : str.tostring(pf, "#.##"), na(pf) or pf >= 1 ? color.lime : color.red)
        row(p, 6,  "Longs / shorts net", (netL >= 0 ? "+$" : "−$") + str.tostring(math.abs(netL), "#") + " / " + (netS >= 0 ? "+$" : "−$") + str.tostring(math.abs(netS), "#"), cWhite)
        row(p, 7,  "Today", str.tostring(nToday) + " trades  " + (pnlToday >= 0 ? "+$" : "−$") + str.tostring(math.abs(pnlToday), "#.##"), pnlToday >= 0 ? color.lime : color.red)
        row(p, 8,  "Skipped: no break / choppy", str.tostring(nSkip) + " / " + str.tostring(nChop), cDim)
        row(p, 9,  "Efficiency ratio now", str.tostring(er, "#.##") + (choppy ? "  CHOPPY" : "  ok"), choppy ? color.orange : color.lime)
        table.cell(p, 0, 10, "MT5 receipt, DEFAULT settings (Axi gold M5, real ticks, Jan–Oct 2026)", text_color = color.aqua, text_size = size.tiny)
        table.merge_cells(p, 0, 10, 1, 10)
        table.cell(p, 0, 11, "+$5,679 · 272 trades · 65.8% · PF 1.66 · DD 4.4%", text_color = color.aqua, text_size = size.small)
        table.merge_cells(p, 0, 11, 1, 11)
        table.cell(p, 0, 12, "Chart counts are a bar-close sketch; MT5 is the judge", text_color = cDim, text_size = size.tiny)
        table.merge_cells(p, 0, 12, 1, 12)
