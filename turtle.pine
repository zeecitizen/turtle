//@version=5

// ═══════════════════════════════════════════════════════════════════════════
// CLAUDE — READ THIS ON SESSION START:
//   monitor/automatic_monitoring_cron.md      — how to resume 5-min auto-monitoring
//   monitor/start_all.bat                     — start MT5 + TradingView (run first)
//   pine/save_and_refresh_alert.md            — BEFORE any pine_save, read this
//   pine/inputs_map.json                      — named input map (in_0..in_139)
//   dashboard/start.bat                       — Indicator dashboard → http://localhost:3456
//   dashboard/claude_trader/start.bat         — Claude Trader dashboard → http://localhost:3457
// ═══════════════════════════════════════════════════════════════════════════

indicator("Turtle Trader Desk v1.0, by M. Zeeshan MIT Alumni", "Turtle Trader Desk", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_polylines_count = 100)
max_bars_back(low, 300)
max_bars_back(high, 300)

// SETTINGS

// --- 0. Account --------------------------
gAc = "💼 My Account"
iMon = input.float(865.0, 'My Starting Capital ($)', minval = 1.0, group = gAc)
cM        = input.float(100.0,  'Contract size ($/point/lot)', minval = 0.001, group = gAc)
lA       = input.float(1.0,   'Position Size Multiplier  + / - to scale all lot sizes (1.0 = normal, 2.0 = double lots/profit, 0.5 = half size, etc.)', minval = 0.1, group = gAc)
uSpread  = input.float(0.13,  'Spread ($) — enter live broker spread to simulate real conditions (e.g. 0.28 for gold). Widens SL minimum so backtests reflect spread cost.', minval = 0.0, step = 0.01, group = gAc)
uLev     = input.int(500, 'Account Leverage (e.g. 2000 for 2000:1)', minval = 1, group = gAc)
_sRD = 0

// --- 2. Strategy: UHV Breakout -----------
gU = "📊 Strategy: Ultra High Volume Breakout"
eUHV             = input.bool(true,  'Use this strategy?', group = gU)
uDir          = input.string("Both", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = gU)
rUS       = input.bool(false, 'Must any candle wick through or break the UHV low before the entry candle breaks its high?', group = gU)
rULV    = input.bool(false, 'Must the breakout candle have lower volume than the UHV candle?', group = gU)
uHTD    = input.string("Off", '──── Align direction to higher timeframe? (bull if HTF bullish / bear if HTF bearish)', options = ["Off", "1", "5", "15", "60", "240"], group = gU)
uVTOn      = input.bool(false, '──── UHV Detection: Require UHV candle to have higher volume than the last N candles? (OFF = pick highest volume candle from this retracement only)', group = gU)
uVLB       = input.int(20,    '──────── N — how many previous candles the UHV volume must exceed', minval = 1, maxval = 500, group = gU)
uSBgOn = input.bool(false, '──── Require background context: for bullish signals, majority of the last N candles before the UHV must be red (selling climax context); for bearish signals, majority must be green (buying climax context)', group = gU)
uSBgN  = input.int(5, '──────── Background lookback (bars): count red (bull) or green (bear) candles in the last N bars — passes if more than half are the required color', group = gU, minval = 2, maxval = 30)
uWSpOn = input.bool(false, '──── Require wide-spread UHV candle: UHV candle range (high − low) must exceed X × 14-bar ATR to qualify as a climactic bar — filters narrow indecision bars that lack genuine selling/buying pressure', group = gU)
uWSpK  = input.float(1.5, '──────── Wide spread multiplier: UHV range must exceed X × 14-bar ATR (1.5 = 50% wider than avg; 2.0 = twice avg — higher = stricter climax filter)', group = gU, minval = 0.5, maxval = 5.0, step = 0.25)
uUHVWkOn  = input.bool(false, '──── UHV Candle: Limit max wick size? — combined upper+lower wicks must not exceed X% of candle range (filters doji/indecision bars; a real climax bar has a strong directional body)', group = gU)
uUHVWkPct = input.float(60.0, '──────── Max combined wick % of candle range (60 = wicks ≤ 60% → body ≥ 40%; lower = stricter. 40–50 = strong-body bars only)', group = gU, minval = 5.0, maxval = 95.0, step = 5.0)
uUHVBdOn  = input.bool(false, '──── UHV Candle: Require minimum body strength? — body as % of total range (1 = any body allowed, 100 = body must fill entire candle; filters weak indecision bars that lack directional intent)', group = gU)
uUHVBdPct = input.float(40.0, '──────── Min body strength (% of candle range): 40 = body fills ≥ 40% of high-low; higher = stricter — use 50–70 to require clearly directional UHV candles', group = gU, minval = 1.0, maxval = 100.0, step = 5.0)
uSB         = input.int(0,      'How many bars must pass after the UHV candle before entry?', group = gU)
uOE = input.string("Instant at Breakout", '──── Open trade at', options = ["Candle Close", "Instant at Breakout"], group = gU)
uPBD = input.float(1.0, '──── Pre-breakout offset ($): fire signal this many $ BEFORE the breakout level (0 = at breakout, 0.05 = 5 cents early = better fill)', group = gU)
uPBsD = input.float(0.0, '──── Post-breakout offset ($): wait for price to move this many $ PAST the breakout level before entering (0 = off, 0.5 = wait for 50¢ confirmation — combines with pre-offset)', group = gU)
uPBCo = input.bool(false, '──── Also allow signal at actual breakout level: when pre-offset is set and price breaks out without reaching the offset level, fire at the actual breakout price instead of missing the trade', group = gU)
uDR = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', group = gU)
uRp = input.float(0.0,  '──── Risk: % of capital per trade (when $Risk = 0) — sizes lots so each trade risks this % of your starting capital', group = gU)
uLS    = input.float(0.4, '──── Risk: Fixed lot size? (when $Risk = 0 and % = 0)', group = gU)
uTM   = input.string("R:R Ratio", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = gU)
uT1    = input.float(7.0, '──── Take Profit: R:R Ratio (R:R method only)', group = gU)
uTD   = input.float(1.1,  '──── Take Profit: Fixed $ target (Dollar method only)', group = gU)
uSHLOff = input.float(0.5, '──── Take Profit: Structural offset ($): target this much before the structural level (0 = at level, 1 = $1 before; applies to Structural High/Low method only)', group = gU, step = 0.5)
uST    = input.string("Breakout Wick", '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "Breakout Wick", "SwingLow", "Dollar", "Retracement's Min/Max", "Prev Candle"], group = gU)
uSBf  = input.float(0.4,    '──── Stop Loss: Offset from SL level (+ = below the level for tighter protection, − = above the level for a tighter stop inside the candle) [UHV=relative to UHV candle low | Breakout Wick=relative to entry candle wick | SwingLow=relative to swing | Retracement\'s Min/Max=relative to lowest/highest retracement point | Prev Candle=relative to previous candle low/high | not used for ATR or Dollar]', group = gU)
uSMn = input.float(0.2,    '──── Stop Loss: Closest it can ever be to entry? ($)', group = gU)
uSAm = input.float(1.0,    '──── Stop Loss: Volatility width? (ATR method only)', group = gU)
uSDo  = input.float(2.0,    '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', group = gU)
uSSw = input.int(11,      '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', group = gU)
uSLPips = input.float(15.0, '──── Stop Loss: Override with fixed pips (0 = off, uses SL method above)', group = gU)
uTPPips = input.float(52.0, '──── Take Profit: Override with fixed pips (0 = off, uses TP method above)', group = gU)
uBEon  = input.bool(true,  '──── Breakeven: move SL to entry+spread when price hits X% of TP', group = gU)
uBEPct = input.float(10.0, '──────── Breakeven trigger: % of TP distance (10 = early, 50 = halfway, 100 = at TP) — ignored when R:R ratio below is set', group = gU, minval = 1, maxval = 100, step = 5)
uBERR  = input.float(0.1,  '──────── Breakeven at R:R ratio (0 = off; 1.0 = BE triggers when profit = 1× structural SL distance; 0.5 = half the risk; overrides % of TP trigger above)', group = gU, minval = 0.0, maxval = 10.0, step = 0.5)
uBELkTP = input.bool(false, '──────── Lock SL at BE trigger price: move SL to the exact 50% TP level instead of entry+offset (locks in 50% of potential profit when BE fires)', group = gU)
uBELkR  = input.float(0.0, '──────── Lock SL at X×R profit when BE fires (0 = off; 1.0 = move SL to 1R above entry — "Plus One" rule: set BE trigger to 1.5–2R, lock here at 1R so minor pullbacks don\'t stop you out)', group = gU, minval = 0.0, maxval = 5.0, step = 0.25)
useInvalidation = input.bool(true, '──── Invalidation Exit: close trade when a 1-min candle closes back inside the UHV candle range — prevents stop hunts, exits early when breakout fails (MT5 uses wide Hard SL as disaster insurance; Pine simulation keeps wick SL for accurate R:R stats)', group = gU)
iExHSL = input.int(15, '──────── Invalidation Exit: Hard SL sent to MT5 (pips) — wide disaster SL for broker-side safety if connection fails (default 150 pips; does NOT affect lot sizing or Pine stats)', group = gU, minval = 10, step = 5)
iExOff = input.float(0.3, '──────── Invalidation Exit: Tolerance ($) — only exit if close is this much past the UHV level (0 = strictly below/above, 0.05 = small buffer against shaved levels)', group = gU, step = 0.05, minval = 0.0)
iExMode  = input.string("UHV Midpoint", '──────── Invalidation rule — UHV Range: current bar closes back inside UHV candle range (original) | UHV Midpoint: close crosses the midpoint of the UHV candle (VSA rule — below midpoint = absorption, not accumulation) | Breakout Body: close crosses the midpoint of the breakout candle body (prop-firm structural failure rule)', options = ["UHV Range", "UHV Midpoint", "Breakout Body"], group = gU)
iExModeOff = input.float(1.0, '──────────── Invalidation offset ($): shift the trigger level further from entry — adds to Tolerance above (0 = at trigger level, 0.5 = needs to close $0.50 beyond midpoint/range/body before invalidating; larger = more room, fewer exits)', group = gU, step = 0.1, minval = 0.0)
uMAEPips = input.int(60, '──────── Emergency MAE stop: close if trade moves X pips against entry (0 = off) — tick-based, fires immediately on every price update without waiting for bar close or UHV logic. Primary shield against instant dumps.', group = gU, minval = 0, step = 5)
uMAEDol  = input.float(0.0, '──────── Emergency MAE stop: close if unrealised loss exceeds $X (0 = off) — fires on every tick regardless of SL, invalidation, or trailing status. Disabled once breakeven fires.', group = gU, minval = 0.0, step = 5.0)
uKillSec = input.int(5, '──────── Kill timer: close trade if still open after X seconds (0 = off) — tick-based, fires the moment elapsed wall-clock time exceeds the limit. Good trades move fast; stagnant trades bleed slowly. Disabled once breakeven fires.', group = gU, minval = 0, step = 10)
uKillLossSec = input.int(0, '──────── Kill timer (loss only): close trade if still in loss after X seconds (0 = off) — same as kill timer but only fires when current P&L is negative. Lets winning trades run freely while cutting losers that haven\'t moved. Disabled once breakeven fires.', group = gU, minval = 0, step = 10)
ptpOn   = input.bool(false, '──── Partial Take-Profit + Runner: lock in profit on part of the position, then let the rest run with breakeven protection. Captures the long tail of big UHV extensions without adding risk.', group = gU)
ptpPips = input.int(40,    '──────── Partial TP trigger: pips in profit before firing (40 = close partial when +40 pips; set to your typical quick-win distance)', group = gU, minval = 1, step = 5)
ptpPct  = input.float(50.0,'──────── Partial TP: % of position to close (50 = close half, keep half as runner; 25 = small lock, 75 = large lock)', group = gU, minval = 10.0, maxval = 90.0, step = 10.0)
uREU   = input.bool(false,  '──── Cancel this strategy on early bounce-back (price returns to IB level before touching POI)?', group = gU)
uMomB    = input.bool(false,  '──── Momentum Candle: Require min body size (strong body)?', group = gU)
uMomBR   = input.float(80.0, '──────── Min body size as % of candle range (60 = body must be =60% of high-low range)', minval = 10, maxval = 100, step = 5, group = gU)
uMomW    = input.bool(false,  '──── Momentum Candle: Require max wick size (small wicks)?', group = gU)
uMomWkD  = input.float(30.0, '──────── Max wick in the direction of breakout (% of candle range) — bull: upper wick (high−close); bear: lower wick (close−low). Limits how much the candle extends past its close in the breakout direction (a big wick here = rejection)', minval = 0, maxval = 95, step = 5, group = gU)
uMomWkO  = input.float(30.0, '──────── Max wick opposite to the breakout direction (% of candle range) — bull: lower wick (open−low); bear: upper wick (high−open). Limits the tail on the non-breakout side (a big tail here = indecision / wicking both ways)', minval = 0, maxval = 95, step = 5, group = gU)
uBrkVROn = input.bool(false,  '──── Require volume drop vs UHV candle?', group = gU)
uBrkVR   = input.float(5.0, '──────── Volume drop % — breakout candle must have at least this much less volume than UHV candle', minval = 5, maxval = 90, step = 5, group = gU)
uBrkBody = input.bool(true, '──── Require body breakout: only enter if the candle body crosses the breakout level (close must be above/below the trigger — wick-only crossings are ignored) [IOE mode only — bar-close already uses close]', group = gU)
uTVOn  = input.bool(false, '──── Tick Velocity Filter: only enter if breakout candle has above-average participation density (ticks/pip — filters lazy drift breakouts, keeps institutional-pressure moves)', group = gU)
uTVK   = input.float(1.2,  '──────── Velocity multiplier threshold (1.2 = must exceed 1.2× the N-bar average; higher = stricter — 1.2 preserves most signals, 1.5+ cuts significantly)', minval = 1.0, maxval = 3.0, step = 0.1, group = gU)
uTVN   = input.int(5,     '──────── Velocity baseline lookback (bars) — SMA window for average participation density', minval = 5, maxval = 100, step = 5, group = gU)


// --- 7. Trend & Filters -------------------
gTr = "📈 Trend & Filters"
// Per-strategy cooldowns (replacing old shared signalCooldown)
uCd    = input.int(0,  '──── Cooldown: Bars after a signal before another can fire?', group = gU)
uIOEGrd = input.float(1.0,  '──── IOE TP Guard: spread multiplier (0 = off, 1 = guard triggers when TP within 1× spread of close, 2 = stricter — within 2× spread)', minval = 0.0, step = 0.5, group = gU)
mTS  = input.int(0, 'Min Trend Strength at Signal', group = gTr)
tPB  = input.int(8, 'Trend Persistence Lookback (bars)', group = gTr)
sFilt = input.bool(false, 'Only trade London + NY sessions? (8–12 GMT and 13–17 GMT)', group = gTr)
aTS      = input.bool(false,  'Avoid trading when trend is shifting?', group = gTr)
aTSU   = input.bool(false, '──── Apply to UHV Breakout?', group = gTr)
tSTh  = input.int(53, '──── How much can trend weaken before blocking the entry? — compares trend strength now vs when the UHV candle (⚡) first printed for this setup. If it has fallen by this many points or more by the time the breakout fires, the signal is blocked. Each new ⚡ candle resets the comparison (e.g. 53 = only block if strength fell 53+ points, like from 70 down to 17 or less). Higher = more lenient. 100 = never block.', group = gTr)
sTC     = input.bool(false,  'Require Full Trend Confirmation at Entry?',  group = gTr)
sTCU  = input.bool(false, '──── Apply to UHV Breakout?',               group = gTr)
rSwT  = input.bool(false, 'Require structural trend — buy only when HH+HL confirmed, sell only when LH+LL confirmed (prevents taking buys in a downtrend or sells in an uptrend)', group = gTr)
avoidRng  = input.bool(false,  'Avoid signals during ranging market (ADX-based — suppresses entries when trend strength is too weak for a breakout to follow through)', group = gTr)
rngTh     = input.int(14,    '──── Ranging threshold: ADX below this = ranging (14 = very strict, 18 = balanced, 25 = aggressive)', minval = 5, maxval = 40, group = gTr)
bRW = input.bool(true, 'Bypass retracement rules — retracement starts whenever a red candle closes below the prior green candle\'s low (removes trend/IB phase requirements)', group = gTr)
bRWW = input.bool(false, '──── Wick trigger: wick piercing below prior green low is enough (default = body close required)', group = gTr)
bRWLB = input.int(3, '──── bRW lookback (bars): find the most recent opposite-colored candle within this many bars — 1 = prior candle only, 3 = looks back 3 bars. Higher = more signals in trending markets', group = gTr, minval = 1, maxval = 10)


// --- 9. Display ---------------------------
gDi = "🖥️ Display"
sL     = input.bool(true,  'Show Signal Labels', group = gDi)
sDb      = input.bool(true, 'Show Debug Labels', group = gDi)
sSP = input.bool(true,  'Show Stats Panel', group = gDi)
sCH = input.bool(true,  'Highlight signal candles (outline which candles were studied)', group = gDi)

// --- 10. Simulation ---------
gPc = "⚙️ Simulation (pip size, lots, slippage, trailing)"
mLot  = input.float(0.01, 'Minimum lot size allowed by your broker', group = gPc)
pPip  = input.float(0.10, 'MT5 pip size for this symbol (XAUUSD=0.10, ETHUSD=1.0, BTCUSD=10.0)', minval = 0.00001, group = gPc)
pcTDist  = input.int(0, '──── Trailing stop: maintain SL X broker pips from price (0 = off)', group = gPc, minval = 0)
pcTTrig  = input.int(0, '──── Trailing: activate after X broker pips profit (0 = immediate when pcTDist>0)', group = gPc, minval = 0)
pcTStep  = input.int(3, '──── Trailing: move SL every X additional broker pips gained', group = gPc, minval = 1)
pLat  = input.string("200", 'Signal→MT5 latency ms (comma-sep, copy from PineConnector Bridge logs)', group = gPc)
pSlip = input.float(0.0, "Slippage: X USD:", group = gPc)


// Camel-hump trend — keep new inputs at the END of the input list:
// the chart stores inputs by position (in_N), so inserting one earlier shifts every saved value.
camOn   = input.bool(true, 'Camel-hump trend gates the signals: BUY only while the latest hump is green (ended higher than it started), SELL only while it is red (ended lower)', group = gTr)
camPiv  = input.int(1,  '──── Camel hump size: a top must be the highest candle within this many candles each side (1 = every swing counts — Zee: the humps read every low; the Diamond EA used 2; larger = bigger, fewer humps)', minval = 1, maxval = 10, group = gTr)
camDraw = input.bool(true, '──── Draw the camel humps: a rounded arch over each hump (green = it ended higher than it started = uptrend, red = it ended lower = downtrend) + the trend verdict on the latest candle', group = gTr)
camRet  = input.bool(true, '──── Retracements follow the humps (LAWS.md): a RED retracement (buy setup) can only start while the latest hump is GREEN, a GREEN retracement (sell setup) only while it is RED', group = gTr)
camStrong = input.int(2, '──── Strong trend (Zee): after this many trend humps in a row, a breakout LOUDER than the UHV is allowed — with the trend, price is moving anyway (0 = off: the breakout must always be quieter)', minval = 0, maxval = 10, group = gTr)
scMin   = input.float(1.0, 'Breakout test: a label WINS if price moves our way by at least this much PROFIT after the spread, in $ on 0.1 lots (5 = $5 = a $0.50 move)', minval = 0.0, step = 0.5, group = gTr)
scN     = input.int(1, '──── Breakout test window: the rest of the breakout candle (Instant) or nothing (Candle Close) PLUS this many more 1-minute candles', minval = 0, maxval = 30, group = gTr)

// Pre-computed timeframe constants — derived from timeframe.period string (global scope safe)
tFm   = timeframe.period == "D" ? 1440.0 : timeframe.period == "W" ? 10080.0 : str.tonumber(timeframe.period)
bPH = math.max(1, math.round(60.0 / tFm))
_utcH = hour(time, "UTC")
_utcM = minute(time, "UTC")
_tMU  = _utcH * 60 + _utcM
_inSess = not sFilt or (_utcH >= 8 and _utcH < 12) or (_utcH >= 13 and _utcH < 17)

// TYPES
type bar
    float h = high
    float l = low
    float c = close
    int   i = bar_index

// VARS
bar b = bar.new()

// -- Signal-tracking --
var _lb    = false
var _fU       = false

// UHV tracking
var _uVol     = 0.0
var float _uHi       = na
var float _uLo        = na
var float _uSl         = na
var label _uLbl      = na
var int   _uBar        = na
var _uLSw   = false  // bull: UHV low must be swept (wick below OR body close below) before breakout
var _uHSw  = false  // bear: UHV high must be swept (wick above OR body close above) before breakout
var bool _uWSp = false  // UHV candle has wide spread — Selling Climax Condition 3
var bool _uSBg = false  // UHV background context confirmed — Selling Climax Condition 1
var float _rceLo    = na     // bull: lowest low during retracement — used as structural SL
var float _rceHi   = na     // bear: highest high during retracement — used as structural SL

// Accuracy tracking
var _wC      = 0

// Dollar P&L per trade
var _cTr  = 0

// Active trade tracking
var _tEn  = array.new_float()
var _tSl     = array.new_float()
var _tTP    = array.new_float()
var bool [] _tBl   = array.new_bool()
var bool [] _tTH = array.new_bool()
var bool  [] _tSH    = array.new_bool()
var bool  [] _tBE    = array.new_bool()    // true = breakeven already triggered for this trade
var float [] _tIL    = array.new_float()   // invalidation level per trade (UHV candle high for bull / low for bear)
var float [] _tILM   = array.new_float()   // UHV midpoint per trade: (uhv_high + uhv_low) / 2
var float [] _tBrkMid = array.new_float()  // breakout candle body midpoint per trade: (open + close) / 2 at signal fire
var bool  [] _tPTP   = array.new_bool()    // true = partial TP already fired for this trade (one-shot flag)
var bool  [] _tTrA   = array.new_bool()    // true = trailing stop trigger reached (pcTTrig pips)
var float [] _tTrH   = array.new_float()   // trail water mark: highest high (bull) / lowest low (bear) since trail activated
var float [] _tEL  = array.new_float()
var int   [] _tEB = array.new_int()
var int   [] _tFT = array.new_int()  // timenow (ms wall-clock) when each signal alert fired
var bool  [] _tLive = array.new_bool()  // true = trade was entered on a realtime bar (alert actually sent to MT5)
var label [] _tLbl    = array.new<label>()  // signal label ref for post-trade update
var _tTy     = array.new_string()   // "uhv"
var int   [] _tN      = array.new_int()       // sequential trade number (#1, #2, ...)
var float [] _tTS = array.new_float()    // _tS at entry
var bool  [] _tW      = array.new_bool()     // true = TP hit, false = SL hit (set on close)
// Breakout line
var float _bL      = na
var _bT  = false
varip bool _uF = false  // UHV has fired from the current setup
var _uWB     = false  // UHV would have fired but lower-vol filter blocked it
varip bool _uAlF  = false  // UHV alert sent this bar (varip: persists across realtime ticks)
varip int  _uAlBi = -1     // bar_index of last _uAlF reset
// Deferred label+array creation: set when UHV alert fires intra-bar; processed at barstate.isconfirmed
varip bool   _uPendBull = false
varip bool   _uPendBear = false
varip float  _uPndEn   = 0.
varip float  _uPndSL   = 0.
varip float  _uPndTP   = 0.
varip float  _uPndLt   = 0.
varip float  _uPndTS   = 0.
varip int    _uPndN    = 0
varip int    _uPndFT   = 0   // timenow at alert fire — used by _tFT so kill timer counts from MT5 send time, not bar close
varip bool   _uPndLive = false  // true when alert fired on a realtime bar (actually sent to MT5)
var float _sigChkW = 0.  // checksum written at signal formation
var float _sigChkR = 0.  // checksum read at deferred block (before arrays/label)
var label _uLblBull = na  // persistent BUY label — recreated each signal, survives reloads
var label _uLblBear = na  // persistent SELL label

// -- Stats tracking --
varip int _sigT      = 0       // signals fired today
var _pT          = 0.0     // P&L closed today
var _pLH       = 0.0     // P&L closed in last 60 min
var _tLSt   = 0       // current consecutive losses today
var _mLST = 0       // max consecutive losses today
var _ltd      = -1      // dayofmonth of last reset
var _tCTi    = array.new_int()   // bar_index when trade closed
var _tCTs      = array.new_int()   // actual unix timestamp when trade closed (for date/hour filtering)
var _tPA     = array.new_float() // P&L parallel to _tCTi
// BREAKOUT TEST (Zee, 2026-10-09): every BUY/SELL label, judged on the best move our way after entry
var _scE = array.new_float()   // entry price
var _scB = array.new_int()     // bar_index of the entry candle
var _scD = array.new_bool()    // true = BUY
var _scT = array.new_int()     // time of the entry candle
var _scX = array.new_float()   // best move our way so far (price $), before spread
var _scR = array.new_int()     // 1 win, -1 loss, 0 window still open
var _scL = array.new_label()   // the label, to print the verdict on it
var int _scP = 0               // first signal whose window is still open
var int _scFirstT = 0
if _scFirstT == 0
    _scFirstT := time
float _scSigE = na             // data-window export: entry price on the entry candle
float _scSigD = na             // data-window export: +1 BUY / -1 SELL
float _scSigU = na             // data-window export: open time of the UHV candle this signal broke (ms)

var int  [] _tDB = array.new_int()   // trade duration in bars (pushed at SL+TP close)
var _sBT    = array.new_int()   // bar_index of each signal label printed (for signals/day)
var int [] _sABT = array.new_int()  // bar_index of each alert actually fired (subset of _sBT, gated)
varip int _alT    = 0   // alerts fired today
var _tAAD   = 0   // total alerts across all days (for daily avg)
var _tDS       = 1
var _tSAD = 0
// Per-strategy P&L and trade tracking
var _uPnL      = 0.0
var _uTr   = 0
var _uWn     = 0
var _uPT = 0.0
// Blocked-signal counters — for recommendation engine
var _bSwp    = 0   // UHV blocked only by no-sweep
var _bUV     = 0   // UHV blocked only by volume check
var _bCd = 0   // any signal blocked only by cooldown
var _bStr = 0   // any signal blocked only by trend strength

// Per-strategy per-direction P&L — for Cut Low Probability Trades
var _uBP = 0.0
var _uBT   = 0
var _uBeP = 0.0
var _uBeT   = 0
// Yesterday stats computed from _tCTs in panel block

// -- Bullish tracking --
var float _rnHi    = na
var float _pvHi       = na
var float _lgL   = na
var float _lgC = na

// -- Bearish tracking --
var float _rnLo     = na
var float _pvLo        = na
var float _lrH    = na
var float _lrC   = na

// Retracement state
var _iR  = false
var _fR     = false
var _rwb = false
var float _rCeil  = na
var float _rFlr    = na
var float _rIBLo  = na
var float _rIBHi  = na
varip string _lastSigTxt = ""
var int   _rSB = na

var _ibT        = false   // true from IB detection until retracement fires
var int _ibTBar = na      // bar_index when _ibT was last set — used for timeout
var _sbIB      = true    // start true so first IB can fire immediately
var _sgIB     = true    // bear side equivalent
var bool _uReBnc = false  // UHV blocked by per-strategy early bounce-back
var float _sStr     = na     // _tS at the moment this retracement began (for trend-shift threshold)
var float _sH1 = na   // most recent confirmed swing high (structural trend tracking)
var float _sH2 = na   // previous confirmed swing high
var float _sL1 = na   // most recent confirmed swing low
var float _sL2 = na   // previous confirmed swing low

// Cooldown tracking
varip int _luSB = -999   // last bar UHV fired (for per-strategy cooldown)

// Latency parse: average ms from signal fire to MT5 fill (from PineConnector Bridge logs)
_latArr = str.split(pLat, ",")
_latSum = 0.0
_latCnt = 0
for _s in _latArr
    _v = str.tonumber(_s)
    if not na(_v)
        _latSum += _v
        _latCnt += 1
_avgLat = _latCnt > 0 ? _latSum / float(_latCnt) : 175.0

// Analysis token parse: v1,wins,total,avgWin($),avgLoss($)[,lots,slipB,slipS]

// STEP 1: TREND DETECTION
_iGr = close > open
_iRd   = close < open
_bSz    = math.abs(close - open)
_cRng = high - low

if not _iR
    if _iGr
        if high > nz(_rnHi, high - 1)
            _pvHi    := _rnHi
            _rnHi := high
        _lgL   := low
        _lgC := close
    if _iRd
        if low < nz(_rnLo, low + 1)
            _pvLo    := _rnLo
            _rnLo := low
        _lrH    := high
        _lrC   := close

_inUp   = not na(_pvHi) and not na(_rnHi) and _rnHi > _pvHi
_inDn = not na(_pvLo)  and not na(_rnLo)  and _rnLo  < _pvLo

// TREND ENGINE (EMA 34 / 89 multi-factor)
_fe        = 34
_se        = 89
_swL    = 20
_aL      = 14
_vL      = 20
_rF = 0.45
_hTF      = "240"
_bPct = 0.001

_fEma   = ta.ema(close, _fe)
_sEma   = ta.ema(close, _se)
_tAt       = ta.atr(_aL)
_tAtM     = ta.sma(_tAt, _aL)
_tVm     = ta.sma(volume, _vL)
_tSlA  = math.abs(_fEma - _fEma[1])

_tEmB   = _fEma > _sEma
_tEmBr   = _fEma < _sEma
_tSlB = _fEma > _fEma[1]
_tSlBr = _fEma < _fEma[1]
_tFS = _tSlA < _tAt * 0.1

_tRH = ta.highest(high, _swL)
_tRL  = ta.lowest(low,  _swL)
_tStB = close > _tRL
_tStBr = close < _tRH
_tNS   = not _tStB and not _tStBr

_tHF   = request.security(syminfo.tickerid, _hTF, ta.ema(close, _fe))
_tHS   = request.security(syminfo.tickerid, _hTF, ta.ema(close, _se))
_tHB   = _tHF > _tHS
_tHBr   = _tHF < _tHS

_tVE    = volume > _tVm
_tAE    = _tAt > _tAtM
_tAC   = _tAt < _tAtM * _rF
_tIR = _tAC and _tFS and _tNS

_tBU     = close > _tRH * (1 + _bPct)
_tBD     = close < _tRL  * (1 - _bPct)

_tRwB   = (_tEmB and _tSlB and _tStB and not _tIR) or _tBU
_tRwBr   = (_tEmBr and _tSlBr and _tStBr and not _tIR) or _tBD

_tRlx   = (_tVE or _tAE)
_tBC  = (_tRwB and _tRlx) or _tBU
_tBCr  = (_tRwBr and _tRlx) or _tBD

_tBS = _tBC or _tRwB
_tBSr = _tBCr or _tRwBr

_tStr  = 0.0
_tStr += _tBC or _tBCr ? 30.0 : 0.0
_tStr += _tVE and _tAE    ? 25.0 : 0.0
_tStr += _tHB or _tHBr  ? 10.0 : 0.0
_tStr += _tSlA > _tAt * 0.2 ? 15.0 : 0.0
_tStr += not _tIR           ? 10.0 : 0.0
_tS = math.round(math.min(100.0, math.max(0.0, _tStr)))

_ib = (_tBS and not _tBSr) or (_tBS and _tBSr and _tS >= 50)
_ibr = (_tBSr and not _tBS) or (_tBS and _tBSr and _tS < 50)

_hb = _ib
_hbr = _ibr



// -- ATR for SL calculations --
_a14 = ta.atr(14)

[_, _dmM, _adxV] = ta.dmi(14, 14)
_isRng = avoidRng and _adxV < float(rngTh)

// POST-SIGNAL AUTO-RESET
if _fU and not _iR
    if _lb and high > nz(_rnHi, high - 1)
        _fU := false
    if not _lb and low < nz(_rnLo, low + 1)
        _fU := false

// STEP 2: RETRACEMENT START  (Block A improved logic)
// cooldown is now per-strategy: uCd / eCd

// -- Update seen-bear/green trackers --
// Once an IB fires we reset the flag; it flips back when the opposite candle appears
if not _iR
    if _iRd
        _sbIB  := true
    if _iGr
        _sgIB := true

// -- SL calculation helper: all SL params passed per-strategy --
fSL(_isBull, _entryPrice, _structLow, _structHigh, _slType, _slBuffer, _slAtrMult, _slSwingLb, _slMinDist, _dollarRisk, _lotSize, _slDollar = 2.0, float _wL = na, float _wH = na) =>
    _atrSL     = _isBull ? _entryPrice - _a14 * _slAtrMult : _entryPrice + _a14 * _slAtrMult
    _wickSL    = _isBull ? (na(_wL) ? low : _wL) - _slBuffer : (na(_wH) ? high : _wH) + _slBuffer
    _swingLow  = nz(ta.lowest(low,  _slSwingLb), _structLow)
    _swingHigh = nz(ta.highest(high, _slSwingLb), _structHigh)
    _swingSL   = _isBull ? _swingLow  - _slBuffer : _swingHigh + _slBuffer
    _structSLv = _isBull ? _structLow - _slBuffer  : _structHigh + _slBuffer
    _dollarDist = _dollarRisk > 0 ? _dollarRisk / (_lotSize * cM) : _lotSize * 1.0
    _dollarSLv  = _isBull ? _entryPrice - _slDollar : _entryPrice + _slDollar
    _raw = _slType == "ATR"        ? _atrSL :
           _slType == "Breakout Wick" or _slType == "Below High Vol. Candle Wick" ? _wickSL :
           _slType == "SwingLow"   ? _swingSL :
           _slType == "Dollar"     ? _dollarSLv : _structSLv
    _candleAnch = _slType == "Breakout Wick" or _slType == "Below High Vol. Candle Wick" or _slType == "Prev Candle"
    _result = _candleAnch ? _raw : (_isBull ? math.min(_entryPrice - _slMinDist, _raw) : math.max(_entryPrice + _slMinDist, _raw))
    math.max(syminfo.mintick, _result)

// -- Signal block helpers (replace repeated code in all 8 signal entry blocks) --
fAS(_w, _t) =>
    _t > 0 ? str.tostring(_w) + "/" + str.tostring(_t) + " won (" + str.tostring(math.round(_w / _t * 100)) + "%)" : "No trades yet"

fLL(_dr, _lots, _cap = false) =>
    _dr > 0 ? "auto (" + str.tostring(_lots, "#.####") + " lots)" : _cap ? "risk-sized (" + str.tostring(_lots, "#.####") + " lots)" : "user-defined (" + str.tostring(_lots, "#.##") + " lots)"

fPTS(_pnl) =>
    _pnl >= 0.01 ? "💰 This strategy brought in: $" + str.tostring(_pnl, "#.##") + " in profits today" : _pnl <= -0.01 ? "📉 This strategy is down $" + str.tostring(math.abs(_pnl), "#.##") + " today" : "No completed trades yet today"

fTS() =>
    _t = barstate.isrealtime ? timenow : time
    _h = hour(_t, "UTC+3")
    _m = minute(_t, "UTC+3")
    _s = second(_t, "UTC+3")
    str.tostring(_h) + ":" + (_m < 10 ? "0" : "") + str.tostring(_m) + ":" + (_s < 10 ? "0" : "") + str.tostring(_s) + " Moscow"

fTP(_e, _t) => _e + math.sign(_t - _e) * math.round(math.abs(_t - _e) / pPip) * pPip

fCT(_strat, _num, _bits, float _en = na) =>
    _h = hour(timenow, "UTC")
    _m = minute(timenow, "UTC")
    _strat + "@" + str.tostring(na(_en) ? close : _en, "#.##") + "_" + str.tostring(_h) + ":" + (_m < 10 ? "0" : "") + str.tostring(_m) + "_#" + str.tostring(_num) + "#" + _bits

// CAMEL-HUMP TREND — read from the humps drawn on the chart. A hump that ends on a higher low
// than it started from is green (uptrend), one that ends lower is red (downtrend) — Zee's rule,
// 2026-10-08. The same verdict gates retracement starts (camRet) and breakout signals (camOn),
// so what is drawn is what is traded.
// A swing is confirmed `camPiv` candles after it prints: a high no lower than the `camPiv`
// candles on each side (a low mirrors it), ties counting — the Diamond EA's pivot rule.
bool _camIsPH = bar_index >= 2 * camPiv
bool _camIsPL = bar_index >= 2 * camPiv
for _d = 1 to camPiv
    if high[camPiv] < high[camPiv - _d] or high[camPiv] < high[camPiv + _d]
        _camIsPH := false
    if low[camPiv] > low[camPiv - _d] or low[camPiv] > low[camPiv + _d]
        _camIsPL := false
// Smooth humps, as Zee draws them: one rounded arch per hump — previous swing low, over the
// swing high, down to the next swing low (pointed bottoms, round tops). Highs and lows
// alternate here, so two highs in a row merge into the taller one. Arch colour (Zee) = the
// camel trend: green when the hump ends higher than it started, red when it ends lower.
var int      _czT  = 0          // last swing kept: 1 high, -1 low
var int      _czHB = na
var float    _czHV = na
var int      _czL0B = na        // low where this hump starts
var float    _czL0V = na
var int      _czLB = na         // low where this hump ends
var float    _czLV = na
var polyline _czArc = na
var int      _czStk = 0         // trend humps in a row: +n up, -n down, 0 after a ranging hump
var int      _czStk0 = 0        // streak before the hump now forming
var int      _czTr = 0          // camel trend = colour of the latest hump: 1 green (ended higher than it started), -1 red (ended lower), 0 level / none yet
// Arch shape: quarter-sine up (steep from the low, rounding into the top), quarter-cosine
// down (round off the top, steep into the next low), sampled ONE point per candle — TradingView
// snaps points to candles, so finer sampling stacks points and leaves corners. The polyline is
// then curved through those points: smooth, and it never strays far from the true swing points.
fCzArch(int _b0, float _v0, int _bh, float _vh, int _b1, float _v1) =>
    _pts = array.new<chart.point>()
    int _n1 = math.max(_bh - _b0, 1)
    int _n2 = math.max(_b1 - _bh, 1)
    for _i = 0 to _n1
        array.push(_pts, chart.point.from_index(_b0 + _i, _v0 + (_vh - _v0) * math.sin(float(_i) / _n1 * math.pi / 2)))
    for _i = 1 to _n2
        array.push(_pts, chart.point.from_index(_bh + _i, _vh - (_vh - _v1) * (1 - math.cos(float(_i) / _n2 * math.pi / 2))))
    _pts
if _camIsPH
    int   _b = bar_index - camPiv
    float _v = high[camPiv]
    if _czT == 1
        if _v >= _czHV
            _czHB := _b
            _czHV := _v
    else
        _czStk0 := _czStk
        _czL0B := _czLB
        _czL0V := _czLV
        _czHB  := _b
        _czHV  := _v
        _czArc := na
        _czT   := 1
if _camIsPL
    int   _b = bar_index - camPiv
    float _v = low[camPiv]
    bool  _redraw = false
    if _czT == 1
        _czLB := _b
        _czLV := _v
        _czT  := -1
        _redraw := true
    else if _czT == -1 and _v <= _czLV
        _czLB := _b
        _czLV := _v
        _redraw := true
    else if _czT == 0
        _czLB := _b
        _czLV := _v
        _czT  := -1
    if _redraw and not na(_czHB) and not na(_czL0B)
        _czTr := _czLV > _czL0V ? 1 : _czLV < _czL0V ? -1 : 0
        _czStk := _czTr == 1 ? math.max(_czStk0, 0) + 1 : _czTr == -1 ? math.min(_czStk0, 0) - 1 : 0
    if _redraw and camDraw and not na(_czHB) and not na(_czL0B)
        polyline.delete(_czArc)
        _czArc := polyline.new(fCzArch(_czL0B, _czL0V, _czHB, _czHV, _czLB, _czLV), curved = true, line_color = _czTr == 1 ? color.new(color.green, 0) : _czTr == -1 ? color.new(color.red, 0) : color.new(color.gray, 0), line_width = 2)
var label _camLbl = na
if camDraw and barstate.islast
    label.delete(_camLbl)
    _camLbl := label.new(bar_index + 2, close, _czTr == 1 ? "🐪 UP — buys only" : _czTr == -1 ? "🐪 DOWN — sells only" : "🐪 RANGING — no trades", style = label.style_label_left, color = _czTr == 1 ? color.new(color.green, 10) : _czTr == -1 ? color.new(color.red, 10) : color.new(color.gray, 10), textcolor = color.white, size = size.small)

// Retracement gate from the humps (camRet): buy-side (red) retracements only under a green
// hump, sell-side (green) only under a red one. No completed hump yet = no retracement.
bool _czRetB  = not camRet or _czTr == 1
bool _czRetBe = not camRet or _czTr == -1
bool _camB    = not camOn  or _czTr == 1
bool _camBe   = not camOn  or _czTr == -1
// Strong trend: a louder-than-UHV breakout is allowed (Zee, 2026-10-08: "with the trend, even a
// high volume breakout can give a great result ... the price is moving upwards anyways").
bool _czStrB  = camStrong > 0 and _czStk >= camStrong
bool _czStrBe = camStrong > 0 and _czStk <= -camStrong

// Multi-bar bRW lookback: find most recent opposite-colored candle within bRWLB bars
float _bRWPGL = na  // most recent green candle's low (bull bRW trigger reference)
float _bRWPGH = na  // most recent green candle's high (rCeil for bull bRW)
float _bRWPRH = na  // most recent red candle's high (bear bRW trigger reference)
float _bRWPRL = na  // most recent red candle's low (rFlr for bear bRW)
int   _bRWPGi = na  // bars back to that green candle
int   _bRWPRi = na  // bars back to that red candle
if bRW
    for _bi = 1 to bRWLB
        if na(_bRWPGL) and close[_bi] >= open[_bi]
            _bRWPGL := low[_bi]
            _bRWPGH := high[_bi]
            _bRWPGi := _bi
        if na(_bRWPRH) and close[_bi] < open[_bi]
            _bRWPRH := high[_bi]
            _bRWPRL := low[_bi]
            _bRWPRi := _bi
        if not na(_bRWPGL) and not na(_bRWPRH)
            break

_bFA = true
// bRW guard: if bRW mode would start a bear retracement on this candle, don't let _bIB steal it for a bull IB phase
_bRWBearCand = bRW and _czRetBe and not _iR and not _ibT and _iGr and not na(_bRWPRH) and (bRWW ? high > _bRWPRH : close > _bRWPRH)
_bIB = _ib and _bFA and (not _iR or (_iR and not _rwb)) and _iGr and not na(high[1]) and close > high[1] and not _bRWBearCand
_beFA = true
// bRW guard: if bRW mode would start a bull retracement on this candle, don't let _beIB steal it for a bear IB phase
_bRWBullCand = bRW and _czRetB and not _iR and not _ibT and _iRd and not na(_bRWPGL) and (bRWW ? low < _bRWPGL : close < _bRWPGL)
_beIB = _ibr and _beFA and (not _iR or (_iR and _rwb)) and _iRd and not na(low[1]) and close < low[1] and not _bRWBullCand

if _bIB and not _ibT
    // Cancel any active opposite (bear) retracement before starting bull IB phase
    if _iR and not _rwb
        _iR := false
        _fR := false
        _uVol := 0.0
        _uHi := na
        _uLo := na
        _uBar := na
        _uLSw := false
        _uHSw := false
        _rceLo := na
        _rceHi := na
        _bL := na
        _bT := false
        _uF := false
        _uWSp := false
        _uSBg := false
        if not na(_uLbl)
            label.delete(_uLbl)
        _uLbl := na
    _rceLo  := na
    _rceHi  := na
    _ibT       := true
    _ibTBar  := bar_index
    _rwb   := true
    _rCeil   := high
    _rIBLo  := low
    _sbIB  := false
    _lb       := true
    if sDb
        label.new(bar_index, low, "IB↑", style = label.style_label_up, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

if _beIB and not _ibT
    // Cancel any active opposite (bull) retracement before starting bear IB phase
    if _iR and _rwb
        _iR := false
        _fR := false
        _uVol := 0.0
        _uHi := na
        _uLo := na
        _uBar := na
        _uLSw := false
        _uHSw := false
        _rceLo := na
        _rceHi := na
        _bL := na
        _bT := false
        _uF := false
        _uWSp := false
        _uSBg := false
        if not na(_uLbl)
            label.delete(_uLbl)
        _uLbl := na
    _rceLo  := na
    _rceHi  := na
    _ibT       := true
    _ibTBar  := bar_index
    _rwb   := false
    _rFlr     := low
    _rIBHi  := high
    _sgIB := false
    _lb       := false
    if sDb
        label.new(bar_index, high, "IB↓", style = label.style_label_down, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

// Reset IB tracking if trend flips opposite
if _ibT and _rwb and _ibr
    _ibT    := false
    _ibTBar := na
    _rIBLo  := na
if _ibT and not _rwb and _ib
    _ibT    := false
    _ibTBar := na
    _rIBHi  := na

// IBt timeout: if retracement hasn't started within 3 bars, release the lock so bRW can try
if _ibT and not na(_ibTBar) and (bar_index - _ibTBar) >= 3
    _ibT    := false
    _ibTBar := na

int _euCd = uCd

_bRet = _czRetB and _ibT and _rwb and _iRd and not na(_rIBLo) and close < _rIBLo
_beRet = _czRetBe and _ibT and not _rwb and _iGr and not na(_rIBHi) and close > _rIBHi

if _bRet
    _ibT      := false
    _ibTBar   := na
    _iR   := true
    _rwb  := true
    _rSB := bar_index
    _uHi    := high
    _uSl    := low
    _uLo    := na
    _uLSw   := false
    _uHSw   := false
    if not uVTOn or volume > ta.highest(volume[1], uVLB)
        _uVol   := volume
        _uBar   := bar_index
        if sL or sDb
            _uLbl := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    _rceLo    := math.min(low, nz(_rceLo, low))
    _rceHi   := math.max(high, nz(_rceHi, high))
    _bL     := high
    _bT          := false
    _uF     := false
    _uWB         := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr  := _tS
    _uWSp   := (not uWSpOn or (high - low) > uWSpK * ta.atr(14)) and (not uUHVWkOn or (high - low) <= 0 or ((high - low - math.abs(close - open)) / (high - low) * 100 <= uUHVWkPct)) and (not uUHVBdOn or (high - low) <= 0 or (math.abs(close - open) / (high - low) * 100 >= uUHVBdPct))
    _uSBg   := not uSBgOn or math.sum(close < open ? 1 : 0, uSBgN) > uSBgN / 2
    if sL or sDb
        label.new(bar_index, low, "Ret↓", style = label.style_label_up, color = color.new(color.gray, 60), textcolor = color.new(color.white, 20), size = size.tiny)

if _beRet
    _ibT      := false
    _ibTBar   := na
    _iR   := true
    _rwb  := false
    _rSB := bar_index
    _uLo       := low
    _uSl        := high
    _uHSw := false
    _uLSw  := false
    _uHi      := na
    _rceLo   := math.min(low, nz(_rceLo, low))
    _rceHi  := math.max(high, nz(_rceHi, high))
    _bL     := low
    if not uVTOn or volume > ta.highest(volume[1], uVLB)
        _uVol    := volume
        _uBar       := bar_index
        if sL or sDb
            _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bT          := false
    _uF     := false
    _uWB         := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr   := _tS
    _uWSp   := (not uWSpOn or (high - low) > uWSpK * ta.atr(14)) and (not uUHVWkOn or (high - low) <= 0 or ((high - low - math.abs(close - open)) / (high - low) * 100 <= uUHVWkPct)) and (not uUHVBdOn or (high - low) <= 0 or (math.abs(close - open) / (high - low) * 100 >= uUHVBdPct))
    _uSBg   := not uSBgOn or math.sum(close > open ? 1 : 0, uSBgN) > uSBgN / 2
    if sL or sDb
        label.new(bar_index, high, "Ret↑", style = label.style_label_down, color = color.new(color.gray, 60), textcolor = color.new(color.white, 20), size = size.tiny)

if bRW and _czRetB and not _iR and not _ibT and _iRd and not na(_bRWPGL) and (bRWW ? low < _bRWPGL : close < _bRWPGL)
    _iR     := true
    _rwb    := true
    _lb     := true
    _rCeil  := _bRWPGH
    _fR     := false
    _rSB    := bar_index
    _uHi    := high
    _uSl    := low
    _uLo    := na
    _uLSw   := false
    _uHSw   := false
    if not uVTOn or volume > ta.highest(volume[1], uVLB)
        _uVol   := volume
        _uBar   := bar_index
        if sL or sDb
            if not na(_uLbl)
                label.delete(_uLbl)
            _uLbl := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    _rceLo  := low
    _rceHi  := high
    _bL     := high
    _bT     := false
    _uF     := false
    _uWB    := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr   := _tS
    _uWSp   := (not uWSpOn or (high - low) > uWSpK * ta.atr(14)) and (not uUHVWkOn or (high - low) <= 0 or ((high - low - math.abs(close - open)) / (high - low) * 100 <= uUHVWkPct)) and (not uUHVBdOn or (high - low) <= 0 or (math.abs(close - open) / (high - low) * 100 >= uUHVBdPct))
    _uSBg   := not uSBgOn or math.sum(close < open ? 1 : 0, uSBgN) > uSBgN / 2
    // BACKDATE (Zee, 2026-10-08): the camel may only allow this retracement some candles after it
    // really began. Price already decided where it began — the first red candle after the last
    // opposite candle whose body closed past that candle's low — so the retracement starts there
    // and the UHV is the loudest red candle since then, not just this one.
    int _bdO = 0
    if not na(_bRWPGi) and _bRWPGi >= 2
        for _j = _bRWPGi - 1 to 1
            if close[_j] < open[_j] and close[_j] < _bRWPGL
                _bdO := _j
                break
    int _bdU = 0
    float _bdV = volume
    for _j = _bdO to 0
        if close[_j] < open[_j] and volume[_j] > _bdV
            _bdV := volume[_j]
            _bdU := _j
    bool _bdStale = false
    if _bdU >= 1
        for _j = _bdU - 1 to 0
            if close[_j] > open[_j] and close[_j] > high[_bdU]
                _bdStale := true
    if _bdO > 0 and not _bdStale and not uVTOn
        _rSB   := bar_index - _bdO
        for _j = _bdO to 0
            _rceLo := math.min(_rceLo, low[_j])
            _rceHi := math.max(_rceHi, high[_j])
        _uVol  := _bdV
        _uBar  := bar_index - _bdU
        _uHi   := high[_bdU]
        _uSl   := low[_bdU]
        _bL    := high[_bdU]
        float _bdR = high[_bdU] - low[_bdU]
        _uWSp  := (not uWSpOn or _bdR > uWSpK * _a14[_bdU]) and (not uUHVWkOn or _bdR <= 0 or ((_bdR - math.abs(close[_bdU] - open[_bdU])) / _bdR * 100 <= uUHVWkPct)) and (not uUHVBdOn or _bdR <= 0 or (math.abs(close[_bdU] - open[_bdU]) / _bdR * 100 >= uUHVBdPct))
        if sL or sDb
            if not na(_uLbl)
                label.delete(_uLbl)
            _uLbl := label.new(bar_index - _bdU, high[_bdU], "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    if sL or sDb
        label.new(bar_index - _bdO, low[_bdO], "Ret↓", style = label.style_label_up, color = color.new(color.gray, 60), textcolor = color.new(color.white, 20), size = size.tiny)

if bRW and _czRetBe and not _iR and not _ibT and _iGr and not na(_bRWPRH) and (bRWW ? high > _bRWPRH : close > _bRWPRH)
    _iR     := true
    _rwb    := false
    _lb     := false
    _rFlr   := _bRWPRL
    _fR     := false
    _rSB    := bar_index
    _uLo    := low
    _uSl    := high
    _uHSw   := false
    _uLSw   := false
    _uHi    := na
    _rceLo  := low
    _rceHi  := high
    _bL     := low
    if not uVTOn or volume > ta.highest(volume[1], uVLB)
        _uVol   := volume
        _uBar   := bar_index
        if sL or sDb
            _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bT     := false
    _uF     := false
    _uWB    := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr   := _tS
    _uWSp   := (not uWSpOn or (high - low) > uWSpK * ta.atr(14)) and (not uUHVWkOn or (high - low) <= 0 or ((high - low - math.abs(close - open)) / (high - low) * 100 <= uUHVWkPct)) and (not uUHVBdOn or (high - low) <= 0 or (math.abs(close - open) / (high - low) * 100 >= uUHVBdPct))
    _uSBg   := not uSBgOn or math.sum(close > open ? 1 : 0, uSBgN) > uSBgN / 2
    // BACKDATE (Zee, 2026-10-08): the camel may only allow this retracement some candles after it
    // really began. Price already decided where it began — the first green candle after the last
    // opposite candle whose body closed past that candle's high — so the retracement starts there
    // and the UHV is the loudest green candle since then, not just this one.
    int _bdO = 0
    if not na(_bRWPRi) and _bRWPRi >= 2
        for _j = _bRWPRi - 1 to 1
            if close[_j] > open[_j] and close[_j] > _bRWPRH
                _bdO := _j
                break
    int _bdU = 0
    float _bdV = volume
    for _j = _bdO to 0
        if close[_j] > open[_j] and volume[_j] > _bdV
            _bdV := volume[_j]
            _bdU := _j
    bool _bdStale = false
    if _bdU >= 1
        for _j = _bdU - 1 to 0
            if close[_j] < open[_j] and close[_j] < low[_bdU]
                _bdStale := true
    if _bdO > 0 and not _bdStale and not uVTOn
        _rSB   := bar_index - _bdO
        for _j = _bdO to 0
            _rceLo := math.min(_rceLo, low[_j])
            _rceHi := math.max(_rceHi, high[_j])
        _uVol  := _bdV
        _uBar  := bar_index - _bdU
        _uLo   := low[_bdU]
        _uSl   := high[_bdU]
        _bL    := low[_bdU]
        float _bdR = high[_bdU] - low[_bdU]
        _uWSp  := (not uWSpOn or _bdR > uWSpK * _a14[_bdU]) and (not uUHVWkOn or _bdR <= 0 or ((_bdR - math.abs(close[_bdU] - open[_bdU])) / _bdR * 100 <= uUHVWkPct)) and (not uUHVBdOn or _bdR <= 0 or (math.abs(close[_bdU] - open[_bdU]) / _bdR * 100 >= uUHVBdPct))
        if sL or sDb
            if not na(_uLbl)
                label.delete(_uLbl)
            _uLbl := label.new(bar_index - _bdU, low[_bdU], "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    if sL or sDb
        label.new(bar_index - _bdO, high[_bdO], "Ret↑", style = label.style_label_down, color = color.new(color.gray, 60), textcolor = color.new(color.white, 20), size = size.tiny)

// TREND PERSISTENCE (needed by both _tFlp and breakout checks)
_bPC = 0
_bePC = 0
for _pi = 0 to tPB - 1
    _bPC += _ib[_pi] ? 1 : 0
    _bePC += _ibr[_pi] ? 1 : 0
_bTP = _bPC >= math.round(tPB * 0.6)
_beTP = _bePC >= math.round(tPB * 0.6)

_swPH = ta.pivothigh(high, 5, 5)
_swPL = ta.pivotlow(low,  5, 5)
if not na(_swPH)
    _sH2 := _sH1
    _sH1 := _swPH
if not na(_swPL)
    _sL2 := _sL1
    _sL1 := _swPL
_strUp = not rSwT or (not na(_sH1) and not na(_sH2) and not na(_sL1) and not na(_sL2) and _sH1 > _sH2 and _sL1 > _sL2)
_strDn = not rSwT or (not na(_sH1) and not na(_sH2) and not na(_sL1) and not na(_sL2) and _sH1 < _sH2 and _sL1 < _sL2)

_tsA = _iR and not na(_sStr) and (_sStr - _tS >= tSTh)
_tsU    = aTS and aTSU and _tsA

// STEP 3b: TREND FLIP CANCELLATION + RETRACEMENT EXPIRY
if _iR
    _tmo         = not na(_rSB) and (bar_index - _rSB) > 100
    _retExp   = _tmo
    // Per-strategy early bounce-back: fires when price returns to IB level before touching any POI
    _eBncCond = _lb ? (not na(_rCeil) and close >= _rCeil and not _fR) : (not na(_rFlr) and close <= _rFlr and not _fR)
    if _eBncCond
        if uREU
            _uReBnc := true
            _uWB    := true  // mark UHV as serviced so setup can end via _aSFrd

    // Only cancel retracement if trend has persistently flipped (not just one candle flicker)
    // Use _bePC / _bPC so short 1m noise doesn't kill the setup
    _tkB = _lb  and _bePC >= math.round(tPB * 0.8)
    _tkBr = not _lb and _bPC >= math.round(tPB * 0.8)
    _tFlp = _tkB or _tkBr

    // NEW: if price bounces back above IB ceiling (bull) or below IB floor (bear)
    // AFTER already touching FVG, cancel so a fresh IB+retrace can start
    // This is what allows the second and third drops in the same zone to each get a Retrace label
    _boB = _fR and _lb  and not na(_rCeil) and close > _rCeil
    _boBr = _fR and not _lb and not na(_rFlr)   and close < _rFlr
    _uBeF = _iRd and not na(_bL) and not na(_uBar) and close < _bL and not _uF
    _uBF = _iGr and not na(_bL) and not na(_uBar) and close > _bL and not _uF
    _aSF  = _uBeF or _uBF
    // Bypass mode: if breakout level was reached but signal was still blocked (e.g. by trend persistence),
    // end the retracement immediately so a new setup can start on the very next qualifying candle.
    if bRW and ((_rwb and _uBF) or (not _rwb and _uBeF))
        _uWB := true
    _uDOB = _uF or _uWB
    _nYF    = not _uDOB
    _bnC     = (_boB or _boBr) and not _aSF and _nYF
    // Camel turned against an unfired setup (its own low completed an opposite or ranging
    // hump — LAWS.md "we stop buying when the last low is broken"): cancel it, UHV label too.
    _czKill  = camRet and not _uF and (_lb ? _czTr != 1 : _czTr != -1)

    if (_tFlp and not bRW) or _retExp or _bnC or _czKill
        _iR := false
        _ibT    := false
        _fR    := false
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLSw   := false
        _uHSw  := false
        _rceLo    := na
        _rceHi   := na
        if not na(_uLbl)
            label.delete(_uLbl)
        _uLbl      := na
        _bL      := na
        _bT  := false
        _uReBnc := false
        _uWSp := false
        _uSBg := false
        if sDb and _czKill and not _bnC
            label.new(bar_index, _lb ? low : high, "Setup cancelled: trend turned", style = _lb ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
        if sDb and _bnC
            _lbl = _lb ? _rCeil : _rFlr
            label.new(bar_index, _lbl, "Setup reset", style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)

// Update structural low/high throughout the retracement (NOT during _ibT — that phase
// includes rising candles before the pullback, which would push _rceLo too low)
if _iR
    if _lb and (na(_rceLo) or low < _rceLo)
        _rceLo  := low
    if not _lb and (na(_rceHi) or high > _rceHi)
        _rceHi := high

// STEP 4: UHV — Highest Volume Candle During Retracement
// Compare volume WITHIN the retracement only (not vs prior impulse bars)
// _uVol starts at 0.0 when retracement begins, so first red/green candle always qualifies
// UHV = highest volume candle during retracement (any color — fast 1m pullbacks often have no clean red candle)
if _iR and _lb and _iRd and not _uF and volume > _uVol and (not uVTOn or volume > ta.highest(volume[1], uVLB))
    _uVol   := volume
    _uHi     := high
    _uSl       := low
    _uLSw := false
    _uBar      := bar_index
    if sL or sDb
        if not na(_uLbl)
            label.delete(_uLbl)
        _uLbl := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    _bL := high
    _uWSp := (not uWSpOn or (high - low) > uWSpK * ta.atr(14)) and (not uUHVWkOn or (high - low) <= 0 or ((high - low - math.abs(close - open)) / (high - low) * 100 <= uUHVWkPct)) and (not uUHVBdOn or (high - low) <= 0 or (math.abs(close - open) / (high - low) * 100 >= uUHVBdPct))
    _uSBg := not uSBgOn or math.sum(close < open ? 1 : 0, uSBgN) > uSBgN / 2

if _iR and not _lb and _iGr and not _uF and volume > _uVol and (not uVTOn or volume > ta.highest(volume[1], uVLB))
    _uVol    := volume
    _uLo       := low
    _uSl        := high
    _uHSw := false
    _uBar       := bar_index
    if sL or sDb
        if not na(_uLbl)
            label.delete(_uLbl)
        _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bL := low
    _uWSp := (not uWSpOn or (high - low) > uWSpK * ta.atr(14)) and (not uUHVWkOn or (high - low) <= 0 or ((high - low - math.abs(close - open)) / (high - low) * 100 <= uUHVWkPct)) and (not uUHVBdOn or (high - low) <= 0 or (math.abs(close - open) / (high - low) * 100 >= uUHVBdPct))
    _uSBg := not uSBgOn or math.sum(close > open ? 1 : 0, uSBgN) > uSBgN / 2

// STEP 4b: TRACK UHV LOW SWEEP
// Bull: UHV red low must be swept (wick or close below) before breakout fires
// Bear: no sweep requirement — red candle just needs to close below UHV green low
if _iR and _lb and not na(_uSl) and not _uLSw
    if low < _uSl or close < _uSl
        _uLSw := true

if _iR and not _lb and not na(_uSl) and not _uHSw
    if high > _uSl or close > _uSl
        _uHSw := true

// Per-strategy direction filters
_uBDir  = uDir != "Bear only"
_uBeDir  = uDir != "Bull only"

bool   _erUS  = rUS
bool   _erULV = rULV
string _euST  = uST
float  _euTD  = uTD
bool   _euBD  = _uBDir
bool   _euBeD = _uBeDir

bool _eStU = sTC and sTCU
int  _eMS  = mTS
bool _eTsU = _tsU

bool _uFC = true



// TRADE MONITORING
// Runs BEFORE the entry signal so exits are judged first.
if array.size(_tEn) > 0
    for _ti = array.size(_tEn) - 1 to 0
        _done  = array.get(_tSH, _ti) or array.get(_tTH, _ti)
        if not _done
            _bull  = array.get(_tBl,  _ti)
            _sl    = array.get(_tSl,    _ti)
            _tp1   = array.get(_tTP,   _ti)
            _t1hit = array.get(_tTH, _ti)
            _slhit = array.get(_tSH,  _ti)
            _tNum  = array.get(_tN, _ti)

            _entryBar = array.get(_tEB, _ti)
            _trType = array.get(_tTy, _ti)
            _isIOE = _trType == "uhv" and uOE == "Instant at Breakout"

            // EMERGENCY MAE STOP — tick-based (NO barstate.isconfirmed gate)
            // Fires on every price tick the moment adverse move exceeds uMAEPips or uMAEDol.
            // This is the only exit fast enough to catch instant dumps before bar close.
            // Disabled once breakeven fires (trade is already protected at entry).
            bool _maeExited = false
            if (uMAEPips > 0 or uMAEDol > 0) and not array.get(_tBE, _ti) and not array.get(_tSH, _ti) and (bar_index > _entryBar or _isIOE)
                float _maeEn   = array.get(_tEn, _ti)
                float _maeLots = array.get(_tEL, _ti)
                float _maeAdv  = _bull ? (_maeEn - close) / pPip : (close - _maeEn) / pPip
                float _maePnl  = (_bull ? (close - _maeEn) : (_maeEn - close)) * _maeLots * cM
                bool  _maeHit  = (uMAEPips > 0 and _maeAdv >= float(uMAEPips)) or (uMAEDol > 0 and _maePnl <= -uMAEDol)
                if _maeHit
                    _maeExited := true
                    // Cap MAE loss at iExHSL pips when invalidation mode is on.
                    // In MT5, the broker-side hard SL fires at iExHSL pips, so the trade
                    // is already closed before bar close reflects the full adverse move.
                    float _maePnlCapped = useInvalidation and _maePnl < 0 ? math.max(_maePnl, -iExHSL * pPip * _maeLots * cM) : _maePnl
                    array.set(_tSH, _ti, true)
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _maePnlCapped)
                    _cTr  += 1
                    _pT   += _maePnlCapped
                    _tLSt += 1
                    if _tLSt > _mLST
                        _mLST := _tLSt
                    array.push(_tDB, bar_index - _entryBar)
                    _uPnL += _maePnlCapped
                    _uPT  += _maePnlCapped
                    _uTr  += 1
                    if _bull
                        _uBP += _maePnlCapped
                        _uBT += 1
                    else
                        _uBeP += _maePnlCapped
                        _uBeT += 1
                    label _maeOrigLbl = array.get(_tLbl, _ti)
                    string _maeExt = "🚨 #" + str.tostring(_tNum) + " MAE Stop — -$" + str.tostring(math.abs(_maePnlCapped), "#.##") + " [" + str.tostring(math.round(_maeAdv)) + " pips]"
                    if not na(_maeOrigLbl)
                        label.set_text(_maeOrigLbl, label.get_text(_maeOrigLbl) + "\n" + _maeExt)
                    label.new(bar_index, _bull ? low : high, _maeExt, style = _bull ? label.style_label_up : label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

            // BREAKEVEN CHECK — runs before kill timer so the kill timer sees _tBE=true and skips.
            // In real MT5, price ticks trigger BE immediately when the trigger is touched; the 5-second
            // kill timer then finds _tBE=true and does not fire. Moving this check here replicates
            // that ordering in historical sim: if bar N+1 touches the BE trigger BEFORE the kill window
            // (within the first uKillSec seconds), BE fires first and the trade becomes a runner.
            // If the trigger is only hit AFTER second uKillSec, the kill timer fires first — BE cannot
            // save a trade that MT5 already closed. Historical sim judges this on the whole bar N+1
            // (no 1-second data — it needs a Premium plan and errors with RE10063 otherwise).
            if uBEon and not _maeExited and not array.get(_tBE, _ti) and not array.get(_tSH, _ti) and not _t1hit and (bar_index > _entryBar or _isIOE)
                float _beEn     = array.get(_tEn, _ti)
                float _beSlDist = math.abs(_beEn - array.get(_tSl, _ti))
                float _beTrig   = uBERR > 0 ? (_bull ? _beEn + _beSlDist * uBERR : _beEn - _beSlDist * uBERR) : _beEn + (_tp1 - _beEn) * (uBEPct / 100.0)
                bool _beTriggered = _bull ? high >= _beTrig : low <= _beTrig
                if _beTriggered
                    array.set(_tBE, _ti, true)
                    array.set(_tSl, _ti, uBELkR > 0 ? (_bull ? _beEn + uBELkR * _beSlDist : _beEn - uBELkR * _beSlDist) : uBELkTP ? _beTrig : (_bull ? _beEn - uSpread : _beEn + uSpread))

            // KILL TIMER — tick-based: close if trade still open after uKillSec seconds
            // Uses _tFT (timenow at signal fire) to measure elapsed wall-clock time on every tick.
            // A good trade moves within seconds; anything stuck past the limit is a dead zone trade.
            // Disabled once breakeven fires (trade is already protected at entry level).
            bool _killExited = false
            if uKillSec > 0 and not _maeExited and not array.get(_tBE, _ti) and not array.get(_tSH, _ti) and (bar_index > _entryBar or _isIOE)
                // Historical sim: judged on bar N+1 as a whole and exits at its close (an approximation —
                // the real kill fires ~uKillSec seconds into the bar). Exits are taken by hand on MT5.
                float _ktTP    = array.get(_tTP, _ti)
                bool _histTPHit = not barstate.isrealtime and bar_index == _entryBar + 1 and (_bull ? high >= _ktTP : low <= _ktTP)
                bool _timeHit = (barstate.isrealtime and (timenow - array.get(_tFT, _ti)) >= uKillSec * 1000) or (not barstate.isrealtime and bar_index == _entryBar + 1 and not _histTPHit)
                if _timeHit
                    _killExited := true
                    array.set(_tSH, _ti, true)
                    float _kEn   = array.get(_tEn, _ti)
                    float _kLots = array.get(_tEL, _ti)
                    float _kExit   = close
                    float _kPnlRaw = (_bull ? (_kExit - _kEn) : (_kEn - _kExit)) * _kLots * cM
                    // In historical sim, cap loss at iExHSL pips — mirrors the MT5 hard SL that fires before bar close
                    float _kPnl  = not barstate.isrealtime and _kPnlRaw < 0 ? math.max(_kPnlRaw, -iExHSL * pPip * _kLots * cM) : _kPnlRaw
                    bool  _kWin  = _kPnl > 0
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _kPnl)
                    _cTr += 1
                    _pT  += _kPnl
                    if _kWin
                        _wC   += 1
                        _tLSt := 0
                    else
                        _tLSt += 1
                        if _tLSt > _mLST
                            _mLST := _tLSt
                    array.push(_tDB, bar_index - _entryBar)
                    _uPnL += _kPnl
                    _uPT  += _kPnl
                    _uTr  += 1
                    if _kWin
                        _uWn += 1
                        array.set(_tW, _ti, true)
                    if _bull
                        _uBP += _kPnl
                        _uBT += 1
                    else
                        _uBeP += _kPnl
                        _uBeT += 1
                    label _killOrigLbl = array.get(_tLbl, _ti)
                    int   _kElapsed    = barstate.isrealtime ? math.round((timenow - array.get(_tFT, _ti)) / 1000) : 60
                    string _killExt = (_kWin ? "✅" : "❌") + " #" + str.tostring(_tNum) + " ⏱" + str.tostring(_kElapsed) + "s " + (_kWin ? "+$" : "-$") + str.tostring(math.abs(_kPnl), "#.##")
                    if not na(_killOrigLbl)
                        label.set_text(_killOrigLbl, label.get_text(_killOrigLbl) + "\n" + _killExt)
                    label.new(bar_index, _bull ? low : high, _killExt, style = _bull ? label.style_label_up : label.style_label_down, color = _kWin ? color.new(color.green, 10) : color.new(color.orange, 10), textcolor = color.white, size = size.small)

            // KILL TIMER (LOSS ONLY) — same as kill timer but only fires when currently in loss
            // Lets winners run freely; cuts losers that stagnate without recovering.
            // Disabled once breakeven fires.
            bool _killLossExited = false
            if uKillLossSec > 0 and not _maeExited and not _killExited and not _killLossExited and not array.get(_tSH, _ti) and (bar_index > _entryBar or _isIOE)
                // Historical sim: fire at bar N+1 close ONLY — simulates the one-shot 5-sec check.
                // The real timer fires once; if price was profitable at that moment it never fires again.
                // Using bar_index > _entryBar (any bar) is too aggressive: trades that recover after N+1
                // would get killed on a later down-bar, converting wins into losses.
                bool _klTimeHit = (barstate.isrealtime and (timenow - array.get(_tFT, _ti)) >= uKillLossSec * 1000) or (not barstate.isrealtime and bar_index == _entryBar + 1)
                float _klEn     = array.get(_tEn, _ti)
                float _klLots   = array.get(_tEL, _ti)
                float _klPnlRaw = (_bull ? (close - _klEn) : (_klEn - close)) * _klLots * cM
                // Cap historical loss at iExHSL pips — matches MT5 hard SL
                float _klPnl    = not barstate.isrealtime and _klPnlRaw < 0 ? math.max(_klPnlRaw, -iExHSL * pPip * _klLots * cM) : _klPnlRaw
                if _klTimeHit and _klPnl < 0
                    _killLossExited := true
                    array.set(_tSH, _ti, true)
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _klPnl)
                    _cTr  += 1
                    _pT   += _klPnl
                    _tLSt += 1
                    if _tLSt > _mLST
                        _mLST := _tLSt
                    array.push(_tDB, bar_index - _entryBar)
                    _uPnL += _klPnl
                    _uPT  += _klPnl
                    _uTr  += 1
                    if _bull
                        _uBP += _klPnl
                        _uBT += 1
                    else
                        _uBeP += _klPnl
                        _uBeT += 1
                    label _klOrigLbl = array.get(_tLbl, _ti)
                    int   _klElapsed = math.round((timenow - array.get(_tFT, _ti)) / 1000)
                    string _klExt = "❌ #" + str.tostring(_tNum) + " ⏱" + str.tostring(_klElapsed) + "s -$" + str.tostring(math.abs(_klPnl), "#.##")
                    if not na(_klOrigLbl)
                        label.set_text(_klOrigLbl, label.get_text(_klOrigLbl) + "\n" + _klExt)
                    label.new(bar_index, _bull ? low : high, _klExt, style = _bull ? label.style_label_up : label.style_label_down, color = color.new(color.orange, 10), textcolor = color.white, size = size.small)

            bool _dllExited = false  // (risk-management exit removed — kept so later checks compile)

            // PARTIAL TAKE-PROFIT + RUNNER — tick-based, fires once when profit >= ptpPips
            // Closes ptpPct% of the position, moves SL to breakeven, lets the runner continue.
            // Runner is protected by existing trail/wick SL/hard SL — invalidation disabled
            // after BE fires (existing behaviour: price back to entry = worst case breakeven exit).
            if ptpOn and not _maeExited and not _killExited and not _killLossExited and not _dllExited and not array.get(_tPTP, _ti) and not array.get(_tSH, _ti) and not array.get(_tTH, _ti) and (bar_index > _entryBar or _isIOE)
                float _ptpEn      = array.get(_tEn, _ti)
                float _ptpLots    = array.get(_tEL, _ti)
                float _ptpProfPip = _bull ? (close - _ptpEn) / pPip : (_ptpEn - close) / pPip
                if _ptpProfPip >= float(ptpPips)
                    // Compute partial and remaining lots — if remainder < mLot, close everything
                    float _ptpClose  = math.max(math.round(_ptpLots * ptpPct / 100.0, 2), mLot)
                    float _ptpRemain = math.round(_ptpLots - _ptpClose, 2)
                    bool  _ptpFull   = _ptpRemain < mLot  // can't leave sub-minimum runner
                    if _ptpFull
                        _ptpClose := _ptpLots
                    float _ptpPnl = (_bull ? (close - _ptpEn) : (_ptpEn - close)) * _ptpClose * cM
                    // One-shot flag — must be set before any further checks on this trade
                    array.set(_tPTP, _ti, true)
                    if _ptpFull
                        array.set(_tSH, _ti, true)  // no runner — trade fully closed
                    else
                        // Reduce to runner lots, move SL to breakeven
                        array.set(_tEL, _ti, _ptpRemain)
                        array.set(_tSl, _ti, _bull ? _ptpEn - uSpread : _ptpEn + uSpread)
                        array.set(_tBE, _ti, true)
                    // Stats — partial P&L is a real win event
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _ptpPnl)
                    _cTr  += 1
                    _pT   += _ptpPnl
                    _wC   += 1
                    _tLSt := 0
                    _uPnL += _ptpPnl
                    _uPT  += _ptpPnl
                    _uTr  += 1
                    _uWn  += 1
                    if _ptpFull
                        array.set(_tW, _ti, true)  // full close — mark win for recommendation engine
                    if _bull
                        _uBP += _ptpPnl
                        _uBT += 1
                    else
                        _uBeP += _ptpPnl
                        _uBeT += 1
                    // Labels
                    label _ptpOrigLbl = array.get(_tLbl, _ti)
                    string _ptpNote   = _ptpFull ? " (full close — no runner)" : " → Runner at BE"
                    string _ptpExt    = "💰 #" + str.tostring(_tNum) + " Partial TP +" + str.tostring(math.round(_ptpProfPip)) + "p — +$" + str.tostring(_ptpPnl, "#.##") + " (" + str.tostring(int(ptpPct), "#") + "%)" + _ptpNote
                    if not na(_ptpOrigLbl)
                        label.set_text(_ptpOrigLbl, label.get_text(_ptpOrigLbl) + "\n" + _ptpExt)
                    label.new(bar_index, _bull ? high : low, _ptpExt, style = _bull ? label.style_label_down : label.style_label_up, color = color.new(color.teal, 10), textcolor = color.white, size = size.small)
                    // PineConnector partial close: vol_lots= closes that specific lot count

            // INVALIDATION EXIT — bar-close logic: exit when candle closes back inside UHV range (not triggered once BE has fired)
            bool _invExited = false
            if useInvalidation and not _maeExited and not _killExited and not _killLossExited and not _dllExited and barstate.isconfirmed and not array.get(_tBE, _ti) and bar_index > _entryBar and array.size(_tIL) > _ti
                float _iLvl = iExMode == "UHV Midpoint"  ? array.get(_tILM,    _ti) :
                              iExMode == "Breakout Body" ? array.get(_tBrkMid, _ti) :
                              array.get(_tIL, _ti)
                float _iTot = iExOff + iExModeOff
                bool  _iHit = _bull ? close < _iLvl - _iTot : close > _iLvl + _iTot
                if _iHit
                    _invExited := true
                    array.set(_tSH, _ti, true)
                    float _iEn   = array.get(_tEn, _ti)
                    float _iLots = array.get(_tEL, _ti)
                    float _iPnlRaw = (_bull ? (close - _iEn) : (_iEn - close)) * _iLots * cM
                    // Cap loss at iExHSL pips — MT5 holds a hard SL at this level, so in reality
                    // the position would already be closed before a big close-beyond-midpoint bar.
                    float _iPnl  = _iPnlRaw < 0 ? math.max(_iPnlRaw, -iExHSL * pPip * _iLots * cM) : _iPnlRaw
                    bool  _iWin  = _iPnl > 0
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _iPnl)
                    _cTr += 1
                    _pT  += _iPnl
                    if _iWin
                        _wC   += 1
                        _tLSt := 0
                    else
                        _tLSt += 1
                        if _tLSt > _mLST
                            _mLST := _tLSt
                    array.push(_tDB, bar_index - _entryBar)
                    _uPnL += _iPnl
                    _uPT  += _iPnl
                    _uTr  += 1
                    if _iWin
                        _uWn += 1
                        array.set(_tW, _ti, true)
                    if _bull
                        _uBP += _iPnl
                        _uBT += 1
                    else
                        _uBeP += _iPnl
                        _uBeT += 1
                    label _iOrigLbl = array.get(_tLbl, _ti)
                    string _modeNote = iExMode == "UHV Range" ? "" : " [" + iExMode + "]"
                    string _iExt = (_iWin ? "✅" : "⚡") + " #" + str.tostring(_tNum) + " Invalidation Exit" + _modeNote + " — " + (_iWin ? "+$" : "-$") + str.tostring(math.abs(_iPnl), "#.##")
                    if not na(_iOrigLbl)
                        label.set_text(_iOrigLbl, label.get_text(_iOrigLbl) + "\n" + _iExt)
                    label.new(bar_index, _bull ? low : high, _iExt, style = _bull ? label.style_label_up : label.style_label_down, color = _iWin ? color.new(color.green, 10) : color.new(color.orange, 10), textcolor = color.white, size = size.small)

            // STRUCTURAL SL — logic-based exit: bar closes beyond structural SL (breakout wick low/high).
            // MT5 does not hold this level — Pine must send closelong/closeshort.
            // Bar-close only (barstate.isconfirmed) — avoids false exits on intra-bar wick sweeps.
            // Disabled once BE fires (MT5 BE stop would close it first anyway).
            // Disabled when useInvalidation=true — in that mode MT5 holds a hard limit at iExHSL pips,
            // so Hard SL Simulation (wick-based, P&L at SL price) handles all SL exits instead.
            bool _structSLExited = false
            if barstate.isconfirmed and not useInvalidation and not _maeExited and not _killExited and not _killLossExited and not _dllExited and not _invExited and not array.get(_tBE, _ti) and not array.get(_tSH, _ti) and bar_index > _entryBar
                bool _structHit = _bull ? close <= _sl : close >= _sl
                if _structHit
                    _structSLExited := true
                    array.set(_tSH, _ti, true)
                    float _sEn   = array.get(_tEn, _ti)
                    float _sLots = array.get(_tEL, _ti)
                    float _sPnl  = (_bull ? (close - _sEn) : (_sEn - close)) * _sLots * cM
                    bool  _sWin  = _sPnl > 0
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _sPnl)
                    _cTr  += 1
                    _pT   += _sPnl
                    if _sWin
                        _wC   += 1
                        _tLSt := 0
                        array.set(_tW, _ti, true)
                    else
                        _tLSt += 1
                        if _tLSt > _mLST
                            _mLST := _tLSt
                    array.push(_tDB, bar_index - _entryBar)
                    if array.get(_tTy, _ti) == "uhv"
                        _uPnL += _sPnl
                        _uPT  += _sPnl
                        _uTr  += 1
                        if _sWin
                            _uWn += 1
                        if _bull
                            _uBP += _sPnl
                            _uBT += 1
                        else
                            _uBeP += _sPnl
                            _uBeT += 1
                    label _sOrigLbl = array.get(_tLbl, _ti)
                    string _sExt = "🔻 #" + str.tostring(_tNum) + " Structure SL — " + (_sWin ? "+$" : "-$") + str.tostring(math.abs(_sPnl), "#.##")
                    if not na(_sOrigLbl)
                        label.set_text(_sOrigLbl, label.get_text(_sOrigLbl) + "\n" + _sExt)
                    label.new(bar_index, _bull ? low : high, _sExt, style = _bull ? label.style_label_up : label.style_label_down, color = _sWin ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)

            bool _ouExited = false  // (risk-management exit removed — kept so later checks compile)

            bool _bfExited = false  // (risk-management exit removed — kept so later checks compile)

            bool _vcExited = false  // (risk-management exit removed — kept so later checks compile)

            bool _vdExited = false  // (risk-management exit removed — kept so later checks compile)

            bool _msExited = false  // (risk-management exit removed — kept so later checks compile)

            bool _todKillExited = false

            // HARD SL SIMULATION — mirrors iExHSL sent to MT5 when invalidation mode is on
            // Without this, Pine uses the wide wick SL while MT5 uses the narrow hard SL,
            // causing Pine to show wins on trades MT5 already closed as losses.
            bool _hardSLExited = false
            if useInvalidation and not _maeExited and not _killExited and not _killLossExited and not _dllExited and not _invExited and not array.get(_tSH, _ti) and (bar_index > _entryBar or _isIOE)
                float _hardSLPrice = _bull ? array.get(_tEn, _ti) - iExHSL * pPip : array.get(_tEn, _ti) + iExHSL * pPip
                // On the IOE entry bar, low/high includes price action BEFORE the entry tick fired.
                // Use close (current realtime tick) on the entry bar to avoid false hard SL triggers.
                bool  _onEntryBar  = (bar_index == _entryBar)
                float _hardSLTP    = array.get(_tTP, _ti)
                bool  _tpAlsoHit   = not _onEntryBar and (_bull ? high >= _hardSLTP : low <= _hardSLTP)
                bool  _hardSLHit   = not _tpAlsoHit and (_bull ? ((_onEntryBar ? close : low)  <= _hardSLPrice) : ((_onEntryBar ? close : high) >= _hardSLPrice))
                if _hardSLHit
                    _hardSLExited := true
                    array.set(_tSH, _ti, true)
                    float _hEn   = array.get(_tEn, _ti)
                    float _hLots = array.get(_tEL, _ti)
                    float _hPnl  = (_bull ? (_hardSLPrice - _hEn) : (_hEn - _hardSLPrice)) * _hLots * cM
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _hPnl)
                    _cTr  += 1
                    _pT   += _hPnl
                    _tLSt += 1
                    if _tLSt > _mLST
                        _mLST := _tLSt
                    array.push(_tDB, bar_index - _entryBar)
                    _uPnL += _hPnl
                    _uPT  += _hPnl
                    _uTr  += 1
                    if _bull
                        _uBP += _hPnl
                        _uBT += 1
                    else
                        _uBeP += _hPnl
                        _uBeT += 1
                    label _hOrigLbl = array.get(_tLbl, _ti)
                    string _hExt = "🔴 #" + str.tostring(_tNum) + " Hard SL — -$" + str.tostring(math.abs(_hPnl), "#.##")
                    if not na(_hOrigLbl)
                        label.set_text(_hOrigLbl, label.get_text(_hOrigLbl) + "\n" + _hExt)
                    label.new(bar_index, _bull ? low : high, _hExt, style = _bull ? label.style_label_up : label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.small)

            // TRAIL SIMULATION — mirrors pcTDist/pcTTrig managed by MT5
            // Tracks highest high (bull) / lowest low (bear) since trail activated,
            // then closes when price reverses pcTDist pips from the peak.
            bool _trailExited = false
            if pcTDist > 0 and not _maeExited and not _killExited and not _killLossExited and not _dllExited and not _invExited and not _hardSLExited and not array.get(_tSH, _ti) and not _t1hit and (bar_index > _entryBar or _isIOE)
                float _trEn   = array.get(_tEn, _ti)
                float _trTrig = _bull ? _trEn + pcTTrig * pPip : _trEn - pcTTrig * pPip
                if not array.get(_tTrA, _ti)
                    // Activate trail when price reaches the trigger level
                    if (_bull ? high >= _trTrig : low <= _trTrig)
                        array.set(_tTrA, _ti, true)
                        array.set(_tTrH, _ti, _bull ? high : low)
                else
                    // Update water mark
                    if _bull and high > array.get(_tTrH, _ti)
                        array.set(_tTrH, _ti, high)
                    if not _bull and low < array.get(_tTrH, _ti)
                        array.set(_tTrH, _ti, low)
                    float _trPeak  = array.get(_tTrH, _ti)
                    float _trSLPrc = _bull ? _trPeak - pcTDist * pPip : _trPeak + pcTDist * pPip
                    bool  _trHit   = _bull ? low <= _trSLPrc : high >= _trSLPrc
                    if _trHit
                        _trailExited := true
                        array.set(_tSH, _ti, true)
                        float _trLots = array.get(_tEL, _ti)
                        float _trPnl  = (_bull ? (_trSLPrc - _trEn) : (_trEn - _trSLPrc)) * _trLots * cM
                        bool  _trWin  = _trPnl > 0
                        array.push(_tCTi, bar_index)
                        array.push(_tCTs, time)
                        array.push(_tPA,  _trPnl)
                        _cTr  += 1
                        _pT   += _trPnl
                        if _trWin
                            _wC   += 1
                            _tLSt := 0
                            array.set(_tW, _ti, true)
                        else
                            _tLSt += 1
                            if _tLSt > _mLST
                                _mLST := _tLSt
                        array.push(_tDB, bar_index - _entryBar)
                        if array.get(_tTy, _ti) == "uhv"
                            _uPnL += _trPnl
                            _uPT  += _trPnl
                            _uTr  += 1
                            if _trWin
                                _uWn += 1
                            if _bull
                                _uBP += _trPnl
                                _uBT += 1
                            else
                                _uBeP += _trPnl
                                _uBeT += 1
                        label _trOrigLbl = array.get(_tLbl, _ti)
                        string _trExt = "🏃 #" + str.tostring(_tNum) + " Trail Stop — " + (_trWin ? "+$" : "-$") + str.tostring(math.abs(_trPnl), "#.##")
                        if not na(_trOrigLbl)
                            label.set_text(_trOrigLbl, label.get_text(_trOrigLbl) + "\n" + _trExt)
                        label.new(bar_index, _bull ? low : high, _trExt, style = _bull ? label.style_label_up : label.style_label_down, color = _trWin ? color.new(color.green, 10) : color.new(color.orange, 10), textcolor = color.white, size = size.small)

            if not _slhit and not _maeExited and not _killExited and not _killLossExited and not _dllExited and not _invExited and not _structSLExited and not _ouExited and not _bfExited and not _vcExited and not _vdExited and not _msExited and not _todKillExited and not _hardSLExited and not _trailExited and (bar_index > _entryBar or _isIOE)
                bool _onEB2      = (bar_index == _entryBar)
                // When invalidation mode is on, MT5 holds a hard SL at iExHSL pips (not the structural wick SL).
                // After BE fires, MT5's SL is moved to entry level — use _tSl (the updated BE stop) instead.
                // Read directly from the array (not the local _sl var) so we get the post-BE-update value.
                bool  _beActive    = array.get(_tBE, _ti)
                float _effectiveSL = (useInvalidation and not _beActive) ? (_bull ? array.get(_tEn, _ti) - iExHSL * pPip : array.get(_tEn, _ti) + iExHSL * pPip) : array.get(_tSl, _ti)
                float _slTP1Ref    = array.get(_tTP, _ti)
                bool  _tpAlsoHitSL = not _onEB2 and (_bull ? high >= _slTP1Ref : low <= _slTP1Ref)
                _slTriggered = not _tpAlsoHitSL and (_bull ? ((_onEB2 ? close : low) <= _effectiveSL) : ((_onEB2 ? close : high) >= _effectiveSL))
                if _slTriggered
                    array.set(_tSH, _ti, true)
                    if not _t1hit
                        _pnl = (_bull ? (_effectiveSL - array.get(_tEn, _ti)) : (array.get(_tEn, _ti) - _effectiveSL)) * array.get(_tEL, _ti) * cM
                        bool _isBEWin = _pnl > 0
                        array.push(_tCTi, bar_index)
                        array.push(_tCTs,   time)
                        array.push(_tPA, _pnl)
                        _cTr += 1
                        _pT             += _pnl
                        if _isBEWin
                            _wC += 1
                            _tLSt := 0
                        else
                            _tLSt += 1
                            if _tLSt > _mLST
                                _mLST := _tLSt
                        array.push(_tDB, bar_index - _entryBar)
                        _stype = array.get(_tTy, _ti)
                        _sbull = array.get(_tBl, _ti)
                        if _stype == "uhv"
                            _uPnL += _pnl
                            _uPT += _pnl
                            _uTr += 1
                            if _isBEWin
                                _uWn += 1
                                array.set(_tW, _ti, true)
                            if _sbull
                                _uBP += _pnl
                                _uBT += 1
                            else
                                _uBeP += _pnl
                                _uBeT += 1
                        _origLbl = array.get(_tLbl, _ti)
                        _dPnlSL  = _pnl - pSlip
                        // _beActive is true when BE had already moved SL to entry level — label as "BE Stop" not "SL Hit"
                        string _slExitTxt = _beActive ? ("🔵 #" + str.tostring(_tNum) + " BE Stop — -$" + str.tostring(math.abs(_dPnlSL), "#.##") + " Loss") : (_isBEWin ? "✅ #" + str.tostring(_tNum) + " BE Close — +$" + str.tostring(_pnl, "#.##") + " Profit" : "🛑 #" + str.tostring(_tNum) + " SL Hit — -$" + str.tostring(math.abs(_dPnlSL), "#.##") + " Loss")
                        color  _slExitCol = _beActive ? color.new(color.blue, 10) : (_isBEWin ? color.new(color.green, 10) : color.new(color.red, 10))
                        if not na(_origLbl)
                            _origTxt = label.get_text(_origLbl)
                            label.set_text(_origLbl, _origTxt + "\n" + _slExitTxt)
                        label.new(bar_index, _bull ? low : high, _slExitTxt, style = _bull ? label.style_label_up : label.style_label_down, color = _slExitCol, textcolor = color.white, size = size.small)

            // BE check moved above kill timer — see "BREAKEVEN CHECK" block earlier in this loop.

            if not _t1hit and not array.get(_tSH, _ti) and (bar_index > _entryBar or _isIOE)
                _fireTime = array.size(_tFT) > _ti ? array.get(_tFT, _ti) : int(na)
                _postFill = not barstate.isrealtime or na(_fireTime) or timenow >= _fireTime + int(_avgLat)
                _tp1Triggered = _postFill and (bar_index == _entryBar ? (_bull ? close >= _tp1 : close <= _tp1) : (_bull ? high >= _tp1 : low <= _tp1))
                if _tp1Triggered
                    array.set(_tTH, _ti, true)
                    _wC += 1
                    _lots = array.get(_tEL, _ti)
                    _pnl  = (_bull ? (_tp1 - array.get(_tEn, _ti)) : (array.get(_tEn, _ti) - _tp1)) * _lots * cM
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs,   time)
                    array.push(_tPA, _pnl)
                    _cTr += 1
                    _pT             += _pnl
                    _tLSt := 0
                    array.push(_tDB, bar_index - _entryBar)
                    _stype = array.get(_tTy, _ti)
                    _sbull = array.size(_tBl) > _ti ? array.get(_tBl, _ti) : true
                    array.set(_tW, _ti, true)
                    if _stype == "uhv"
                        _uPnL += _pnl
                        _uPT += _pnl
                        _uTr += 1
                        _uWn += 1
                        if _sbull
                            _uBP += _pnl
                            _uBT += 1
                        else
                            _uBeP += _pnl
                            _uBeT += 1
                    _origLbl = array.get(_tLbl, _ti)
                    _dPnlTP  = _pnl - pSlip
                    if not na(_origLbl)
                        _origTxt = label.get_text(_origLbl)
                        label.set_text(_origLbl, _origTxt + "\n✅ #" + str.tostring(_tNum) + " TP Hit — +$" + str.tostring(_dPnlTP, "#.##") + " Profit")
                    label.new(bar_index, _bull ? high : low, "✅ #" + str.tostring(_tNum) + " TP Hit — +$" + str.tostring(_dPnlTP, "#.##") + " Profit", style = _bull ? label.style_label_down : label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = size.small)

// STEP 5: BREAKOUT — Absorption Signal
_uHTFB = request.security(syminfo.tickerid, uHTD == "Off" ? timeframe.period : uHTD, close >= open)
_uMomBOk  = (not uMomB or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (close[1]-open[1])/_cRng[1] >= uMomBR/100.0) : (_cRng > 0 and (close-open)/_cRng >= uMomBR/100.0))) and (not uMomW or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (high[1]-close[1])/_cRng[1] <= uMomWkD/100.0 and (open[1]-low[1])/_cRng[1] <= uMomWkO/100.0) : (_cRng > 0 and (high-close)/_cRng <= uMomWkD/100.0 and (open-low)/_cRng <= uMomWkO/100.0)))
_uMomBeOk = (not uMomB or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (open[1]-close[1])/_cRng[1] >= uMomBR/100.0) : (_cRng > 0 and (open-close)/_cRng >= uMomBR/100.0))) and (not uMomW or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (high[1]-open[1])/_cRng[1] <= uMomWkO/100.0 and (close[1]-low[1])/_cRng[1] <= uMomWkD/100.0) : (_cRng > 0 and (high-open)/_cRng <= uMomWkO/100.0 and (close-low)/_cRng <= uMomWkD/100.0)))
_uBVOk    = not uBrkVROn or (uOE == "Instant at Breakout" and not barstate.isrealtime) or volume <= _uVol * (1.0 - uBrkVR/100.0)
// Tick Velocity Filter — participation density = ticks per pip of movement
// IOE mode: uses previous bar (completed) to avoid partial-bar noise; bar-close mode: uses current bar
float _tvRng  = math.max(high - low, syminfo.mintick)
float _tvVel  = volume / _tvRng
float _tvBase = ta.sma(_tvVel, uTVN)
bool  _uVelOk = not uTVOn or (uOE == "Instant at Breakout" ? (volume[1] / math.max(high[1] - low[1], syminfo.mintick)) > uTVK * _tvBase[1] : _tvVel > uTVK * _tvBase)
_uPBMok   = uPBD <= 0.0 or uOE == "Instant at Breakout" or close > close[1]   // pre-breakout momentum guard: bull — price must be rising bar-over-bar (skipped for IOE: bar hasn't closed yet)
_uPBMbok  = uPBD <= 0.0 or uOE == "Instant at Breakout" or close < close[1]   // pre-breakout momentum guard: bear — price must be falling bar-over-bar (skipped for IOE: bar hasn't closed yet)
bool _uIOE = uOE == "Instant at Breakout"
bool _uIOEh = _uIOE and not barstate.isrealtime   // Instant mode on a finished (historical) candle
// Instant mode reads the trend from the PREVIOUS candle - it was complete when the breakout began
bool _camBx    = _uIOE ? nz(_camB[1])    : _camB
bool _camBex   = _uIOE ? nz(_camBe[1])   : _camBe
bool _czStrBx  = _uIOE ? nz(_czStrB[1])  : _czStrB
bool _czStrBex = _uIOE ? nz(_czStrBe[1]) : _czStrBe
bool _uHTFBx   = _uIOE ? nz(_uHTFB[1])   : _uHTFB

float _bTrigEff  = uPBCo and uPBD > 0 and not (low  <= _bL + uPBsD - uPBD) ? _bL + uPBsD : _bL + uPBsD - uPBD
float _beTrigEff = uPBCo and uPBD > 0 and not (high >= _bL - uPBsD + uPBD) ? _bL - uPBsD : _bL - uPBsD + uPBD
// INSTANT: fires the moment price trades past the trigger. On history that is "the high went
// above it" - never the close, which nobody knows at the moment of entry (it would quietly drop
// the breakouts that poked through and fell back, i.e. the losers).
bool  _bBrkPO    = _uIOE ? high > _bTrigEff : (low <= _bTrigEff and close > _bL + uPBsD)   // Candle-Close: always require close above actual UHV level (not just pre-offset zone)
bool  _beBrkPO   = _uIOE ? low < _beTrigEff : (high >= _beTrigEff and close < _bL - uPBsD)   // Candle-Close: always require close below actual UHV level
if bar_index != _uAlBi
    _uAlF  := false
    _uAlBi := bar_index
// Instant mode: armed at the previous close, fires when price passes the armed trigger
_armB  = _euBD and eUHV and _iR and _lb and _rwb and not _uReBnc and (bRW or (_eStU ? (_hb and _bTP) : not _beTP)) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index + 1 - _uBar) >= uSB and (_erUS ? _uLSw : true) and _uWSp and _uSBg and not _eTsU and (bar_index + 1 - _luSB) >= _euCd and _strUp and _camB and (uHTD == "Off" or _uHTFB) and not _isRng
_armTB = _bTrigEff
_armUT = na(_uBar) ? float(na) : float(time[math.max(bar_index - _uBar, 0)])   // UHV candle of the armed setup
_bBrk = _uIOE ? (nz(_armB[1]) and not _uF and high > nz(_armTB[1]) and _uMomBOk and _uBVOk and _uVelOk and (bar_index - _luSB) >= _euCd) : (_euBD and eUHV and _iR and _lb and _rwb and not _uReBnc and (bRW or (_eStU ? (_hb and _bTP) : not _beTP)) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and (_erUS ? _uLSw : true) and (_erULV ? (_uIOEh or volume < _uVol or _czStrBx) : true) and _uWSp and _uSBg and not _eTsU and (_uIOE or _iGr) and _bBrkPO and (bar_index - _luSB) >= _euCd and _strUp and _camBx and _uMomBOk and _uBVOk and _uPBMok and _uVelOk and (uHTD == "Off" or _uHTFBx) and not _isRng and (_uIOE or barstate.isconfirmed))

// -- Blocked-signal detection (for recommendation engine) --
// UHV bull: would have fired without sweep requirement
_uBBase = _euBD and eUHV and _iR and _lb and _rwb and ((sTC and sTCU) ? (_hb and _bTP) : not _beTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iGr and low <= _bL and close > _bL
if _uBBase and _erUS and not _uLSw and _tS >= mTS
    _bSwp += 1
    _uWB := true
// UHV bull: would have fired without volume requirement
if _uBBase and (_erUS ? _uLSw : true) and _erULV and volume >= _uVol and not _czStrB and _tS >= mTS and (bar_index - _luSB) >= _euCd and not _tsU
    _bUV += 1
    _uWB := true
// Blocked by trend strength (sweep ok, everything else ok, only strength fails)
if _uBBase and (_erUS ? _uLSw : true) and _tS < mTS and (bar_index - _luSB) >= _euCd
    _bStr += 1
// Blocked by cooldown (everything ok except cooldown)
if _uBBase and (_erUS ? _uLSw : true) and _tS >= mTS and (bar_index - _luSB) < _euCd
    _bCd += 1
    _uWB := true
// Blocked by trend shift — mark serviced
if _uBBase and (_erUS ? _uLSw : true) and (bar_index - _luSB) >= _euCd and _tsU
    _uWB := true
// Blocked by strict trend check — relaxed mode would pass (not _beTP) but _hb+persistence fails
if eUHV and _iR and _lb and _rwb and not _beTP and (sTC and sTCU) and not (_hb and _bTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iGr and low <= _bL and close > _bL and (_erUS ? _uLSw : true) and (bar_index - _luSB) >= _euCd
    _uWB := true

// sDb: "bRW?" = a retracement the bypass rule would have started; "No BUY: <reason>" = why a buy breakout was refused
if sDb and barstate.isconfirmed
    if not bRW and not _iR and not _ibT and _iRd and close[1]>=open[1] and close<low[1]
        label.new(bar_index,high,"bRW?",style=label.style_label_down,color=color.new(color.gray,30),textcolor=color.white,size=size.tiny)
    if _iR and _lb and _rwb and not _uF and not na(_bL) and not na(_uBar) and _iGr and close>_bL and not _bBrk
        string _bw=not _camB?"trend not up":not((sTC and sTCU)?(_hb and _bTP):not _beTP)?"trend not confirmed":not(_tS>=_eMS)?"trend too weak":_erUS and not _uLSw?"UHV low not swept":_erULV and volume>=_uVol and not _czStrB?"breakout louder than UHV":not _bBrkPO?"no close above UHV high":_eTsU?"trend weakening":not _uSBg?"no selling climax before UHV":not _uWSp?"UHV candle too weak":not _uVelOk?"breakout too slow":_uReBnc?"price bounced back early":"other rule"
        label.new(bar_index,_bL,"No BUY: "+_bw,style=label.style_label_up,color=color.new(color.orange,15),textcolor=color.white,size=size.small)

int _nU = math.max(1, _uTr > 19 ? _uWn * 50 / _uTr - 44 : 0)
float _lOp = 0.
if array.size(_tEn) > 0
    for i = 0 to array.size(_tEn) - 1
        if not array.get(_tSH, i) and not array.get(_tTH, i)
            _lOp += math.abs(array.get(_tEn, i) - array.get(_tSl, i)) * array.get(_tEL, i) * cM

// Pine requires functions containing ta.* to run every bar, not only inside conditional branches.
// These unconditional calls keep ta.lowest/ta.highest inside fSL series-consistent across all bars.
float _fSLWarmB  = fSL(true,  close, nz(_rceLo, low),  high, _euST, uSBf, uSAm, uSSw, uSMn + uSpread, uDR, uLS, uSDo, float(na))
float _fSLWarmBe = fSL(false, close, low, nz(_rceHi, high), _euST, uSBf, uSAm, uSSw, uSMn + uSpread, uDR, uLS, uSDo, float(na), float(na))

if _bBrk
    _entry    = _uIOE ? math.max(open, nz(_armTB[1])) : close
    _sl       = uSLPips > 0 ? _entry - uSLPips * pPip : fSL(true, _entry, _euST == "Prev Candle" ? low[1] : _euST == "UHV" ? nz(_uSl, nz(_rceLo, low)) : nz(_rceLo, nz(_uSl, low)), high, _euST, uSBf, uSAm, uSSw, uSMn + uSpread, uDR, uLS, uSDo, float(na))
    _slDist   = math.max(useInvalidation ? math.max(_entry - _sl, iExHSL * pPip) : _entry - _sl, uSMn)
    _effLots  = (uDR > 0 ? math.max(uDR / (_slDist * cM), mLot) : uRp > 0 ? math.max(iMon * uRp / 100.0 / math.max(_slDist * cM, syminfo.mintick), mLot) : uLS) * lA
    float _tp1 = uTPPips > 0 ? _entry + uTPPips * pPip : fTP(_entry, uTM == "Structural High/Low" ? nz(_rCeil, _entry + _slDist * uT1) - uSHLOff : uTM == "Dollar Amount" ? _entry + _euTD : _entry + _slDist * uT1)
    if _tp1 <= _entry  // TP at or below entry for buy → structural ceiling below entry; force dollar fallback
        _tp1 := fTP(_entry, _entry + _euTD)
    if _uIOE and barstate.isrealtime and uIOEGrd > 0 and _tp1 <= close + uSpread * uIOEGrd  // IOE guard: recalc TP from current close if too close — Stop pending orders fill at trigger price, not close, so guard skipped
        _tp1   := fTP(close, uTPPips > 0 ? close + uTPPips * pPip : (uTM == "Dollar Amount" ? close + _euTD : close + _slDist * uT1))
        _entry := close  // sim accuracy: MT5 fills at market (close) when IOE guard fires — not _bTrigEff
        _sl    := uSLPips > 0 ? _entry - uSLPips * pPip : _sl
    bool _safe = _inSess  // margin check removed (Zee, 2026-10-08): always give the signal
    if not _uAlF  // once-per-bar gate: varip prevents all side-effects from re-firing on every IOE tick
        _uAlF := true
        if _safe
            _uF := true
            _luSB := bar_index
            _uPndEn   := _entry
            _uPndSL   := math.max(math.round(math.abs(_entry - _sl) / pPip), int(uSMn / pPip))
            _uPndTP   := math.round(math.abs(_tp1 - _entry) / pPip)
            _uPndLt   := math.round(_effLots, 2)
            _uPndTS   := _tS
            _uPndN    := dayofmonth * 10000 + hour * 100 + minute
            _sigChkW  := _uPndEn + _uPndSL + _uPndTP + _uPndLt
            bool _gateOkU = true
            if _gateOkU
                _sigT += 1
                _alT += 1
                _uPndFT   := timenow  // capture alert fire time — used by kill timer via _tFT (IOE: bar close ≠ fill time)
                _uPndLive := barstate.isrealtime  // tag: live bar = alert actually sent to MT5
                _lastSigTxt := "BUY NOW  #" + str.tostring(_uPndN) + "\n(UHV Breakout)  ⏰ " + fTS() + "\nEntry: " + str.tostring(_uPndEn, "#.###") + "\nSL:    " + str.tostring(_uPndEn - _uPndSL * pPip, "#.###") + "  -$" + str.tostring(math.round(_uPndSL * pPip * _uPndLt * cM * 100) / 100, "#.##") + "  [" + _euST + ", risk: " + str.tostring(_uPndSL * pPip * _uPndLt * cM / iMon * 100, "#.##") + "%]" + "\nLots:  " + fLL(uDR, _uPndLt, uRp > 0) + "\nTP:    " + str.tostring(_uPndEn + _uPndTP * pPip, "#.###") + "  +$" + str.tostring(math.round(_uPndTP * pPip * _uPndLt * cM * 100) / 100, "#.##") + "\n" + fAS(_uWn, _uTr)
                _uPendBull := true
                if sL
                    if not na(_uLblBull)
                        label.delete(_uLblBull)
                    _uLblBull := label.new(bar_index, high, "BUY", style = label.style_label_down, color = color.new(#089981, 0), textcolor = color.white, size = size.normal, tooltip = _lastSigTxt)

// UHV bear: base condition (without sweep/vol/strength/cooldown) for blocked-counter tracking
_uBeBase = _euBeD and eUHV and _iR and not _lb and not _rwb and ((sTC and sTCU) ? (_hbr and _beTP) : not _bTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iRd and close < _bL
if _uBeBase and _erUS and not _uHSw and _tS >= mTS
    _bSwp += 1
    _uWB := true
// UHV bear: would have fired without volume requirement
if _uBeBase and (_erUS ? _uHSw : true) and _erULV and volume >= _uVol and not _czStrBe and _tS >= mTS and (bar_index - _luSB) >= _euCd and not _tsU
    _bUV += 1
    _uWB := true
// Blocked by trend strength
if _uBeBase and (_erUS ? _uHSw : true) and _tS < mTS and (bar_index - _luSB) >= _euCd
    _bStr += 1
// Blocked by cooldown
if _uBeBase and (_erUS ? _uHSw : true) and _tS >= mTS and (bar_index - _luSB) < _euCd
    _bCd += 1
    _uWB := true
// Blocked by trend shift — mark serviced
if _uBeBase and (_erUS ? _uHSw : true) and (bar_index - _luSB) >= _euCd and _tsU
    _uWB := true
// Blocked by strict trend check — relaxed mode would pass (not _bTP) but _hbr+persistence fails
if eUHV and _iR and not _lb and not _rwb and not _bTP and (sTC and sTCU) and not (_hbr and _beTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iRd and close < _bL and (_erUS ? _uHSw : true) and (bar_index - _luSB) >= _euCd
    _uWB := true

_armE  = _euBeD and eUHV and _iR and not _lb and not _rwb and not _uReBnc and (bRW or (_eStU ? (_hbr and _beTP) : not _bTP)) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index + 1 - _uBar) >= uSB and (_erUS ? _uHSw : true) and _uWSp and _uSBg and not _eTsU and (bar_index + 1 - _luSB) >= _euCd and _strDn and _camBe and (uHTD == "Off" or not _uHTFB) and not _isRng
_armTE = _beTrigEff
_beBrk = _uIOE ? (nz(_armE[1]) and not _uF and low < nz(_armTE[1]) and _uMomBeOk and _uBVOk and _uVelOk and (bar_index - _luSB) >= _euCd) : (_euBeD and eUHV and _iR and not _lb and not _rwb and not _uReBnc and (bRW or (_eStU ? (_hbr and _beTP) : not _bTP)) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and (_erUS ? _uHSw : true) and (_erULV ? (_uIOEh or volume < _uVol or _czStrBex) : true) and _uWSp and _uSBg and not _eTsU and (_uIOE or _iRd) and _beBrkPO and (bar_index - _luSB) >= _euCd and _strDn and _camBex and _uMomBeOk and _uBVOk and _uPBMbok and _uVelOk and (uHTD == "Off" or not _uHTFBx) and not _isRng and (_uIOE or barstate.isconfirmed))

if _beBrk
    _entry      = _uIOE ? math.min(open, nz(_armTE[1])) : close
    _sl         = uSLPips > 0 ? _entry + uSLPips * pPip : fSL(false, _entry, low, _euST == "Prev Candle" ? high[1] : _euST == "UHV" ? nz(_uSl, nz(_rceHi, high)) : nz(_rceHi, nz(_uSl, high)), _euST, uSBf, uSAm, uSSw, uSMn + uSpread, uDR, uLS, uSDo, float(na), float(na))
    _slDist     = math.max(useInvalidation ? math.max(_sl - _entry, iExHSL * pPip) : _sl - _entry, uSMn)
    _effLots    = (uDR > 0 ? math.max(uDR / (_slDist * cM), mLot) : uRp > 0 ? math.max(iMon * uRp / 100.0 / math.max(_slDist * cM, syminfo.mintick), mLot) : uLS) * lA
    float _tp1 = uTPPips > 0 ? _entry - uTPPips * pPip : fTP(_entry, uTM == "Structural High/Low" ? nz(_rFlr, _entry - _slDist * uT1) + uSHLOff : uTM == "Dollar Amount" ? _entry - _euTD : _entry - _slDist * uT1)
    if _tp1 >= _entry  // TP at or above entry for sell → structural floor above entry; force dollar fallback
        _tp1 := fTP(_entry, _entry - _euTD)
    if _uIOE and barstate.isrealtime and uIOEGrd > 0 and _tp1 >= close - uSpread * uIOEGrd  // IOE guard: recalc TP from current close if too close — Stop pending orders fill at trigger price, not close, so guard skipped
        _tp1   := fTP(close, uTPPips > 0 ? close - uTPPips * pPip : (uTM == "Dollar Amount" ? close - _euTD : close - _slDist * uT1))
        _entry := close  // sim accuracy: MT5 fills at market (close) when IOE guard fires — not _beTrigEff
        _sl    := uSLPips > 0 ? _entry + uSLPips * pPip : _sl
    bool _safe = _inSess  // margin check removed (Zee, 2026-10-08): always give the signal
    if not _uAlF
        _uAlF := true
        if _safe
            _uF := true
            _luSB := bar_index
            _uPndEn   := _entry
            _uPndSL   := math.max(math.round(math.abs(_sl - _entry) / pPip), int(uSMn / pPip))
            _uPndTP   := math.round(math.abs(_entry - _tp1) / pPip)
            _uPndLt   := math.round(_effLots, 2)
            _uPndTS   := _tS
            _uPndN    := dayofmonth * 10000 + hour * 100 + minute
            _sigChkW  := _uPndEn + _uPndSL + _uPndTP + _uPndLt
            bool _gateOkUe = true
            if _gateOkUe
                _sigT += 1
                _alT += 1
                _uPndFT   := timenow  // capture alert fire time — used by kill timer via _tFT (IOE: bar close ≠ fill time)
                _uPndLive := barstate.isrealtime  // tag: live bar = alert actually sent to MT5
                _lastSigTxt := "SELL NOW  #" + str.tostring(_uPndN) + "\n(UHV Breakout)  ⏰ " + fTS() + "\nEntry: " + str.tostring(_uPndEn, "#.###") + "\nSL:    " + str.tostring(_uPndEn + _uPndSL * pPip, "#.###") + "  -$" + str.tostring(math.round(_uPndSL * pPip * _uPndLt * cM * 100) / 100, "#.##") + "  [" + _euST + ", risk: " + str.tostring(_uPndSL * pPip * _uPndLt * cM / iMon * 100, "#.##") + "%]" + "\nLots:  " + fLL(uDR, _uPndLt, uRp > 0) + "\nTP:    " + str.tostring(_uPndEn - _uPndTP * pPip, "#.###") + "  +$" + str.tostring(math.round(_uPndTP * pPip * _uPndLt * cM * 100) / 100, "#.##") + "\n" + fAS(_uWn, _uTr)
                _uPendBear := true
                if sL
                    if not na(_uLblBear)
                        label.delete(_uLblBear)
                    _uLblBear := label.new(bar_index, low, "SELL", style = label.style_label_up, color = color.new(#f23645, 0), textcolor = color.white, size = size.normal, tooltip = _lastSigTxt)

// RANDOM BASELINE — every candle as a pretend BUY and SELL, judged by the same rule. Its window
// closes now if it started scN candles ago: Instant enters at that candle's open and sees that
// whole candle + scN more; Candle Close enters at its close and sees the next scN candles.
var int _rbN = 0
var int _rbW = 0
float _rbHi = ta.highest(high, scN + 1)
float _rbLo = ta.lowest(low, scN + 1)
float _rbHi2 = scN > 0 ? ta.highest(high, math.max(scN, 1)) : na
float _rbLo2 = scN > 0 ? ta.lowest(low, math.max(scN, 1)) : na
if barstate.isconfirmed and bar_index > scN + 1
    float _rbE = uOE == "Instant at Breakout" ? open[scN] : close[scN]
    float _rbUp = uOE == "Instant at Breakout" ? _rbHi - _rbE : _rbHi2 - _rbE
    float _rbDn = uOE == "Instant at Breakout" ? _rbE - _rbLo : _rbE - _rbLo2
    if not na(_rbUp) and not na(_rbDn)
        _rbN += 2
        _rbW += (_rbUp - uSpread >= scMin / 10.0 ? 1 : 0) + (_rbDn - uSpread >= scMin / 10.0 ? 1 : 0)

// BREAKOUT TEST JUDGE — runs on every closed candle after an entry candle
if barstate.isconfirmed
    for _j = _scP to array.size(_scB) - 1
        if array.size(_scB) == 0 or _j >= array.size(_scB)
            break
        int _age = bar_index - array.get(_scB, _j)
        if _age >= 1 and array.get(_scR, _j) == 0
            float _mv = array.get(_scD, _j) ? high - array.get(_scE, _j) : array.get(_scE, _j) - low
            array.set(_scX, _j, math.max(array.get(_scX, _j), _mv))
    while _scP < array.size(_scB)
        if bar_index - array.get(_scB, _scP) < scN
            break
        float _best = array.get(_scX, _scP)
        bool  _won  = _best - uSpread >= scMin / 10.0
        array.set(_scR, _scP, _won ? 1 : -1)
        label _scLb = array.get(_scL, _scP)
        if not na(_scLb)
            float _net = _best - uSpread
            label.set_text(_scLb, label.get_text(_scLb) + "\n" + (_won ? "✅ best " : "❌ best ") + (_net >= 0 ? "+" : "-") + str.tostring(math.abs(_net), "#.##") + " ($" + str.tostring(_net * 10, "#.#") + " on 0.1 lot)")
        _scP += 1

// Deferred UHV label+array creation — runs at bar close (barstate.isconfirmed only; realtime objects are ephemeral)
if (_uPendBull or _uPendBear) and barstate.isconfirmed
    bool _dIsBull = _uPendBull
    _sigChkR  := _uPndEn + _uPndSL + _uPndTP + _uPndLt  // read signal before any use — must equal _sigChkW
    float _slPrice    = _dIsBull ? _uPndEn - _uPndSL * pPip : _uPndEn + _uPndSL * pPip
    float _tpPrice    = _dIsBull ? _uPndEn + _uPndTP * pPip : _uPndEn - _uPndTP * pPip
    float _uPndSlDist = _uPndSL * pPip
    string _lblTxt = (_dIsBull ? "BUY NOW" : "SELL NOW") + "  #" + str.tostring(_uPndN) + "\n(UHV Breakout)  ⏰ " + fTS() +
         "\nEntry: " + str.tostring(_uPndEn, "#.###") +
         "\nSL:    " + str.tostring(_slPrice, "#.###") + "  -$" + str.tostring(math.round(_uPndSlDist * _uPndLt * cM * 100) / 100, "#.##") + "  [" + _euST + ", risk: " + str.tostring(_uPndSlDist * _uPndLt * cM / iMon * 100, "#.##") + "%]" +
         "\nLots:  " + fLL(uDR, _uPndLt, uRp > 0) +
         "\nTP:    " + str.tostring(_tpPrice, "#.###") + "  +$" + str.tostring(math.round(_uPndTP * pPip * _uPndLt * cM * 100) / 100, "#.##") +
         "\n" + fAS(_uWn, _uTr)
    _lastSigTxt := _lblTxt
    // Instant: the rest of the entry candle after the entry counts (for a BUY every price at or
    // above the trigger in that candle comes after the cross, so its high is after the entry).
    // Candle Close: the entry is the close, so the entry candle itself does not count.
    array.push(_scE, _uPndEn)
    array.push(_scB, bar_index)
    array.push(_scD, _dIsBull)
    array.push(_scT, time)
    array.push(_scX, _uIOE ? (_dIsBull ? high - _uPndEn : _uPndEn - low) : -1e9)
    array.push(_scR, 0)
    array.push(_scL, label(na))
    _scSigE := _uPndEn
    _scSigD := _dIsBull ? 1 : -1
    _scSigU := _uIOE ? _armUT[1] : (na(_uBar) ? na : float(time[math.max(bar_index - _uBar, 0)]))
    if scN == 0 and _uIOE
        bool _won0 = array.get(_scX, array.size(_scX) - 1) - uSpread >= scMin / 10.0
        array.set(_scR, array.size(_scR) - 1, _won0 ? 1 : -1)
    array.push(_tEn,  _uPndEn)
    array.push(_tSl,  _slPrice)
    array.push(_tTP,  _tpPrice)
    array.push(_tBl,  _dIsBull)
    array.push(_tTH,  false)
    array.push(_tSH,  false)
    array.push(_tBE,  false)
    array.push(_tTrA, false)
    array.push(_tTrH, float(na))
    array.push(_tEL,  _uPndLt)
    array.push(_tTy,  "uhv")
    array.push(_tN,   _uPndN)
    array.push(_tTS,  _uPndTS)
    array.push(_tW,   false)
    array.push(_tLbl, label(na))  // placeholder — filled by persistent label block below
    array.push(_tEB,  bar_index)
    array.push(_tIL,    _bL)
    array.push(_tILM,   (_bL + _uSl) / 2)
    array.push(_tBrkMid, (open + close) / 2)
    array.push(_tPTP,  false)
    array.push(_tFT,   _uPndFT > 0 ? _uPndFT : timenow)  // IOE: use alert fire time, not bar close time
    array.push(_tLive, _uPndLive)  // true = live realtime bar → alert actually sent to MT5
    _uPndLive := false             // reset for next signal
    array.push(_sBT,  bar_index)
    array.push(_sABT, bar_index)
    _bT  := true
    _fU  := true
    if _dIsBull
        _pvHi := _rnHi
        _rnHi := high
        _lgL  := low
        _lgC  := close
        _lrH  := na
        _lrC  := na
        if sCH
            box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.lime, 0), 2, bgcolor=color.new(color.lime, 90))
            box.new(_uBar - 1, _uHi, _uBar + 1, _uSl, color.new(color.yellow, 0), 2, bgcolor=color.new(color.yellow, 90))
        if sL
            float _ahU  = ta.atr(14) * 1.2
            int   _gU   = bar_index - _uBar
            float _pkU  = math.max(_uHi, high) + _ahU
            polyline.new(array.from(chart.point.from_index(_uBar, _uHi), chart.point.from_index(_uBar + _gU / 2, _pkU), chart.point.from_index(bar_index, high)), curved = true, line_color = color.new(#00ff88, 0), line_width = 3)
            label.new(bar_index, high, "", style = label.style_arrowdown, color = color.new(#00ff88, 0), size = size.small)
    else
        _pvLo := _rnLo
        _rnLo := low
        _lrH  := high
        _lrC  := close
        _lgL  := na
        _lgC  := na
        if sCH
            box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.red, 0), 2, bgcolor=color.new(color.red, 90))
            box.new(_uBar - 1, _uSl, _uBar + 1, _uLo, color.new(color.yellow, 0), 2, bgcolor=color.new(color.yellow, 90))
        if sL
            float _ahUe = ta.atr(14) * 2.5
            int   _gUe  = bar_index - _uBar
            float _pkUe = math.min(_uLo, low) - _ahUe
            polyline.new(array.from(chart.point.from_index(_uBar, _uLo), chart.point.from_index(_uBar + _gUe / 2, _pkUe), chart.point.from_index(bar_index, low)), curved = true, line_color = color.new(#ff4444, 0), line_width = 3)
            label.new(bar_index, low, "", style = label.style_arrowup, color = color.new(#ff4444, 0), size = size.small)
    _uPendBull := false
    _uPendBear := false

// ─────────────────────────────────────────────────────────────────────────
// UHV SIGNAL LABEL — persistent, exact-bar, one-shot
// Same barstate.isconfirmed pass as deferred block (Pine = top-to-bottom).
// bar_index == _uAlBi: only fires on the bar the alert was sent.
// na(array.get(_tLbl, last)): one-shot — array.set locks it so it never
// re-fires on subsequent bars even if _uAlBi happens to match again.
// ─────────────────────────────────────────────────────────────────────────
if sL and barstate.isconfirmed
    if array.size(_tLbl) > 0
        if na(array.get(_tLbl, array.size(_tLbl) - 1))
            bool _lblIsBull = array.get(_tBl, array.size(_tBl) - 1)
            if _lblIsBull
                if na(_uLblBull)
                    _uLblBull := label.new(bar_index, high, "BUY", style = label.style_label_down, color = color.new(#089981, 0), textcolor = color.white, size = size.normal, tooltip = _lastSigTxt)
                else
                    label.set_y(_uLblBull, high)
                array.set(_tLbl, array.size(_tLbl) - 1, _uLblBull)
                array.set(_scL, array.size(_scL) - 1, _uLblBull)
                _uLblBull := na  // release ref so next signal doesn't delete this registered label
            else
                if na(_uLblBear)
                    _uLblBear := label.new(bar_index, low, "SELL", style = label.style_label_up, color = color.new(#f23645, 0), textcolor = color.white, size = size.normal, tooltip = _lastSigTxt)
                else
                    label.set_y(_uLblBear, low)
                array.set(_tLbl, array.size(_tLbl) - 1, _uLblBear)
                array.set(_scL, array.size(_scL) - 1, _uLblBear)
                _uLblBear := na  // release ref so next signal doesn't delete this registered label

// End setup when all enabled strategies have fired from this setup
if _iR
    _aSFrd = not eUHV or _uF or _uWB
    if _aSFrd
        _iR := false
        _ibT    := false
        _fR    := false
        _rceLo  := na
        _rceHi  := na
        _uLbl   := na

// DAILY RESET
_today = dayofmonth(time)
if _today != _ltd
    _tSAD  += _sigT
    _tAAD  += _alT
    _tDS        += 1
    _sigT         := 0
    _alT          := 0
    _pT             := 0.0
    _uPT          := 0.0
    _tLSt      := 0
    _mLST   := 0
    _ltd         := _today

// Risk classification helper: dollar risk as % of account
f_rTag(float d) =>
    p = d > 0.0 and iMon > 0 ? d / iMon * 100.0 : 0.0
    p == 0.0 ? "" : p <= 0.5 ? " (risk-free)" : p <= 2.0 ? " (safe)" : p <= 5.0 ? " (moderate)" : p <= 10.0 ? " (high risk)" : " (risk-max)"
f_mxL(float m, simple string slT) => m > 0 ? "  Avg. max drawdown: -$" + str.tostring(m, "#.##") : slT == "SwingLow" ? "  Avg. max drawdown: unknown (swing SL — consider $ Risk mode)" : ""

// STATS PANEL (top-right table)
fPct(int _w, int _n) => _n > 0 ? str.tostring(math.round(_w * 100.0 / _n)) + "%" : "—"

fDP() =>
    // -- Core stats --
    _totalPnL    = 0.0
    _avgDollarRisk = uDR
    _avgTp1Mult   = uT1
    // Compute actual avg win and avg loss from closed trade history
    _totalWinAmt = 0.0
    _totalLossAmt = 0.0
    _winTradesCount = 0
    _lossTradesCount = 0
    _pnlSz = math.min(array.size(_tPA), array.size(_tCTs))
    if _pnlSz > 0
        for _pi = 0 to _pnlSz - 1
            if array.get(_tCTs, _pi) >= _sRD
                _p = array.get(_tPA, _pi)
                _totalPnL += _p
                if _p > 0
                    _totalWinAmt += _p
                    _winTradesCount += 1
                else
                    _totalLossAmt += math.abs(_p)
                    _lossTradesCount += 1
    _filteredTrades = _winTradesCount + _lossTradesCount
    _acc         = _filteredTrades > 0 ? float(_winTradesCount) / _filteredTrades : 0.0
    _accPct      = math.round(_acc * 100)
    _avgPnL      = _filteredTrades > 0 ? _totalPnL / _filteredTrades : 0.0
    _winAmt  = _winTradesCount  > 0 ? _totalWinAmt  / _winTradesCount  : _avgDollarRisk * _avgTp1Mult
    _lossAmt = _lossTradesCount > 0 ? _totalLossAmt / _lossTradesCount : _avgDollarRisk
    _ev      = _acc * _winAmt - (1.0 - _acc) * _lossAmt

    // -- Doubling / target time --
    _tradesToDouble = _avgPnL > 0 ? math.ceil(iMon / _avgPnL) : 0
    _avgMinsPerSignal = 30.0
    if array.size(_sBT) > 1
        _totalGap = 0
        for _si = 1 to array.size(_sBT) - 1
            _totalGap += array.get(_sBT, _si) - array.get(_sBT, _si - 1)
        _avgMinsPerSignal := (_totalGap / (array.size(_sBT) - 1)) * tFm
    _hoursToDouble = _tradesToDouble > 0 and _avgMinsPerSignal > 0 ? math.round(_tradesToDouble * _avgMinsPerSignal / 60.0 * 10) / 10 : 0

    // -- Signals per day (avg across all days) --
    _allDaySignals  = _tSAD + _sigT
    _avgSigPerDay   = _tDS > 0 ? math.round(_allDaySignals / _tDS) : _sigT

    // -- Washout --
    // Use actual observed avg loss (not the input setting) — avoids showing 0 when fixed-lot mode is on
    _washout = math.floor(iMon / (_lossAmt > 0 ? _lossAmt : (_avgDollarRisk > 0 ? _avgDollarRisk : 1.0)))

    // -- Last hour P&L --
    _hourPnL = 0.0
    if array.size(_tCTi) > 0
        for _hi = 0 to array.size(_tCTi) - 1
            if bar_index - array.get(_tCTi, _hi) <= bPH
                _hourPnL += array.get(_tPA, _hi)

    // -- Avg time to next signal --
    _minsToNextSignal = math.round(_avgMinsPerSignal)

    // -- Session detection (UTC hour) --
    _session = _utcH >= 22 or _utcH < 7  ? "🌏 Sydney Session" :
               _utcH < 9                ? "🌸 Tokyo Session"  :
               _utcH < 13              ? "🏦 London Session" :
               _utcH < 22              ? "🗽 New York Session" : "📊 Market"
    // overlap labels
    _session := (_utcH >= 8 and _utcH < 9)   ? "🏦🌸 London/Tokyo Overlap"   : _session
    _session := (_utcH >= 13 and _utcH < 17)  ? "🗽🏦 New York/London Overlap" : _session

    // -- Pre-panel: today completed wins/trades --
    _winsToday            = 0
    _tradesCompletedToday = 0
    _livePnLToday         = 0.0   // live-only P&L (signals that actually fired to MT5)
    _liveClosedToday      = 0     // live-only closed trade count
    _liveWinsToday        = 0     // live-only win count
    _todayStartMs         = timestamp("Asia/Karachi", year(timenow, "Asia/Karachi"), month(timenow, "Asia/Karachi"), dayofmonth(timenow, "Asia/Karachi"), 0, 0)
    _simPnLToday          = 0.0   // simulated P&L of trades closed today (same day boundary as the counts)
    if array.size(_tCTs) > 0
        for _ict = 0 to array.size(_tCTs) - 1
            if array.get(_tCTs, _ict) >= _todayStartMs and array.get(_tCTs, _ict) >= _sRD
                _isLive = array.size(_tLive) > _ict and array.get(_tLive, _ict)
                _tradesCompletedToday += 1
                _simPnLToday += array.get(_tPA, _ict)
                if array.get(_tPA, _ict) > 0
                    _winsToday += 1
                if _isLive
                    _liveClosedToday += 1
                    _livePnLToday    += array.get(_tPA, _ict)
                    if array.get(_tPA, _ict) > 0
                        _liveWinsToday += 1

    // -- Pre-panel: trades closed in last hour --
    _hourTrades = 0
    if array.size(_tCTi) > 0
        for _iht = 0 to array.size(_tCTi) - 1
            if bar_index - array.get(_tCTi, _iht) <= bPH
                _hourTrades += 1

    // -- Pre-panel: current win/loss streak --
    _currentStreak = 0
    _streakSz = array.size(_tPA)
    if _streakSz > 0
        // find last filtered trade
        _lastIdx = -1
        for _ics0 = _streakSz - 1 to 0
            if array.get(_tCTs, _ics0) >= _sRD
                _lastIdx := _ics0
                break
        if _lastIdx >= 0
            _lastIsWin = array.get(_tPA, _lastIdx) > 0
            for _ics = _lastIdx to 0
                if array.get(_tCTs, _ics) < _sRD
                    break
                _cp = array.get(_tPA, _ics)
                if (_lastIsWin and _cp > 0) or (not _lastIsWin and _cp <= 0)
                    _currentStreak += 1
                else
                    break
            _currentStreak := _lastIsWin ? _currentStreak : -_currentStreak

    // -- Pre-panel: yesterday P&L (moved here for early use) --
    _ydayStart  = _todayStartMs - 86400000
    _pnlYday    = 0.0
    if array.size(_tCTs) > 0
        for _iyd = 0 to array.size(_tCTs) - 1
            _ts = array.get(_tCTs, _iyd)
            if _ts >= _ydayStart and _ts < _todayStartMs and _ts >= _sRD
                _pnlYday += array.get(_tPA, _iyd)

    // -- Per-strategy avg win and avg loss amounts --
    _uhvWinSum = 0.0
    _uhvWinN2  = 0
    _uhvLossSum = 0.0
    _uhvLossN2 = 0
    _uhvMaxLoss = 0.0
    _uhvPnLCalc    = 0.0
    _uhvTradesCalc = 0
    _uhvWinsCalc   = 0
    _stratSize2 = array.size(_tPA)
    if _stratSize2 > 0
        for _ist = 0 to _stratSize2 - 1
            if array.get(_tCTs, _ist) < _sRD
                continue
            _sp  = array.get(_tPA,  _ist)
            _uhvPnLCalc    += _sp
            _uhvTradesCalc += 1
            if _sp > 0
                _uhvWinSum  += _sp
                _uhvWinN2   += 1
                _uhvWinsCalc += 1
            else
                _uhvLossSum += math.abs(_sp)
                _uhvLossN2  += 1
                _uhvMaxLoss := math.max(_uhvMaxLoss, math.abs(_sp))
    _uhvAvgWin  = _uhvWinN2  > 0 ? _uhvWinSum  / _uhvWinN2  : 0.0
    _uhvAvgLoss = _uhvLossN2 > 0 ? _uhvLossSum / _uhvLossN2 : 0.0

    // -- Signals (labels) fired in last hour --
    _sigLastHour = 0
    if array.size(_sBT) > 0
        for _isb = 0 to array.size(_sBT) - 1
            if bar_index - array.get(_sBT, _isb) <= bPH
                _sigLastHour += 1
    // -- Alerts actually sent in last hour --
    _alLastHour = 0
    if array.size(_sABT) > 0
        for _iab = 0 to array.size(_sABT) - 1
            if bar_index - array.get(_sABT, _iab) <= bPH
                _alLastHour += 1
    // -- Alerts/hr pace (same priority logic as labels) --
    _avgMinsPerAlert = 30.0
    if array.size(_sABT) > 1
        _alGapTotal = 0
        for _ai = 1 to array.size(_sABT) - 1
            _alGapTotal += array.get(_sABT, _ai) - array.get(_sABT, _ai - 1)
        _avgMinsPerAlert := (_alGapTotal / (array.size(_sABT) - 1)) * tFm
    _trueAlHrSigs = _avgMinsPerAlert > 0 ? 60.0 / _avgMinsPerAlert : 0.0
    _alBasisLbl = "all-time avg"
    if _alLastHour > 0
        _trueAlHrSigs := float(_alLastHour)
        _alBasisLbl := "last hr"
    else if _alT >= 2
        _alHrsElapsed = (bar_index - array.get(_sABT, array.size(_sABT) - _alT)) * tFm / 60.0
        if _alHrsElapsed > 0
            _trueAlHrSigs := math.round(_alT / _alHrsElapsed * 10) / 10
            _alBasisLbl := "today"
    // -- Build panel (18 rows) --
    table statsPanel = table.new(position.bottom_right, 1, 19,
         bgcolor = color.new(color.black, 15),
         border_color = color.new(color.gray, 70),
         border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)

    // -- Shared colors --
    _bgDark    = color.new(color.black,   25)
    _bgDeep    = color.new(color.navy,    40)
    _txtDim    = color.new(color.silver,  10)
    _txtGreen  = color.new(color.lime,    10)
    _txtRed    = color.new(color.red,      0)
    _txtOrange = color.new(color.orange,   0)
    _txtAqua   = color.new(color.aqua,    10)
    _txtYellow = color.new(color.yellow,  10)

    // -- Pre-compute display vars --
    _uhvAcc  = _uhvTradesCalc > 0 ? math.round(_uhvWinsCalc / _uhvTradesCalc * 100) : 0
    _ydayGrowthPct = iMon > 0 ? math.round(_pnlYday / iMon * 100 * 10) / 10 : 0.0
    // Next-hour projection (priority: last hour ? today's pace ? all-time avg)
    _trueNextHrSigs = _avgMinsPerSignal > 0 ? 60.0 / _avgMinsPerSignal : 0.0
    _basisLbl = "all-time avg"
    if _sigLastHour > 0
        _trueNextHrSigs := float(_sigLastHour)
        _basisLbl := "last hour pace"
    else if _sigT >= 2
        _hrsElapsed = (bar_index - array.get(_sBT, array.size(_sBT) - _sigT)) * tFm / 60.0
        if _hrsElapsed > 0
            _trueNextHrSigs := math.round(_sigT / _hrsElapsed * 10) / 10
            _basisLbl := "today's pace"
    _projNextHrPnLEV = math.round(_trueNextHrSigs * _ev * 100) / 100

    // BREAKOUT TEST (Zee's win definition) — rows 2-4
    int _sN = 0
    int _sW = 0
    int _bN = 0
    int _bW = 0
    int _eN = 0
    int _eW = 0
    int _tdN = 0
    int _tdW = 0
    float _sBest = 0.0
    for _i = 0 to math.max(array.size(_scR) - 1, 0)
        if array.size(_scR) == 0
            break
        int _r = array.get(_scR, _i)
        if _r != 0
            _sN += 1
            _sW += _r == 1 ? 1 : 0
            _sBest += array.get(_scX, _i) - uSpread
            if array.get(_scD, _i)
                _bN += 1
                _bW += _r == 1 ? 1 : 0
            else
                _eN += 1
                _eW += _r == 1 ? 1 : 0
            if array.get(_scT, _i) >= _todayStartMs
                _tdN += 1
                _tdW += _r == 1 ? 1 : 0
    int _lblToday = 0   // every label since midnight PKT, judged or not
    for _i = 0 to math.max(array.size(_scT) - 1, 0)
        if array.size(_scT) == 0
            break
        if array.get(_scT, _i) >= _todayStartMs
            _lblToday += 1
    int _hN = int(_sN / 2)
    int _oN = 0
    int _oW = 0
    int _k = 0
    for _i = 0 to math.max(array.size(_scR) - 1, 0)
        if array.size(_scR) == 0
            break
        int _r = array.get(_scR, _i)
        if _r != 0
            if _k < _hN
                _oN += 1
                _oW += _r == 1 ? 1 : 0
            _k += 1
    string _win = uOE == "Instant at Breakout" ? "rest of the breakout candle" + (scN > 0 ? " + " + str.tostring(scN) + " min" : "") : "the next " + str.tostring(scN) + " min"
    table.cell(statsPanel, 0, 2, "BREAKOUT TEST — a label WINS if price moved our way by $" + str.tostring(scMin, "#.##") + "+ profit on 0.1 lot (after $" + str.tostring(uSpread, "#.##") + " spread) within the " + _win + "  |  entry: " + (uOE == "Instant at Breakout" ? "instant, at the trigger" : "breakout candle close"),
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))
    float _wrp = _sN > 0 ? _sW * 100.0 / _sN : 0.0
    table.cell(statsPanel, 0, 3, str.tostring(_sW) + " / " + str.tostring(_sN) + " labels won  =  " + fPct(_sW, _sN),
         text_color = _wrp >= 90 ? _txtGreen : _wrp >= 60 ? _txtYellow : _txtOrange, text_size = size.large, bgcolor = color.new(color.navy, 40))
    table.cell(statsPanel, 0, 4, "BUY " + str.tostring(_bW) + "/" + str.tostring(_bN) + " (" + fPct(_bW, _bN) + ")   SELL " + str.tostring(_eW) + "/" + str.tostring(_eN) + " (" + fPct(_eW, _eN) + ")   today " + str.tostring(_tdW) + "/" + str.tostring(_tdN) + " (" + fPct(_tdW, _tdN) + ")" +
         "\na random entry scores " + fPct(_rbW, _rbN) + " on this same test  →  edge " + (_sN > 0 and _rbN > 0 ? ((_sW * 100.0 / _sN - _rbW * 100.0 / _rbN) >= 0 ? "+" : "") + str.tostring(_sW * 100.0 / _sN - _rbW * 100.0 / _rbN, "#.#") + " pts" : "—") +
         "\nolder half " + fPct(_oW, _oN) + "  |  newer half " + fPct(_sW - _oW, _sN - _oN) + "  |  avg best move after spread: $" + str.tostring(_sN > 0 ? _sBest / _sN : 0.0, "#.##") + " ($" + str.tostring(_sN > 0 ? _sBest / _sN * 10 : 0.0, "#.#") + " on 0.1 lot)",
         text_color = color.white, text_size = size.small, bgcolor = _bgDark)
    // ROW 0 — HEADER
    string _integrityStr = _sigChkW == 0. ? "" : (_sigChkW == _sigChkR ? "  |  Signal integrity is preserved." : "  |  Signal integrity compromised")
    table.cell(statsPanel, 0, 0,
         "TURTLE TRADER DESK  |  " + syminfo.ticker + "  |  " + str.tostring(tFm) + "m  |  " + _session +
         "\nhistory: " + str.format_time(_scFirstT, "yyyy-MM-dd HH:mm", "Asia/Karachi") + " PKT → now  (" + str.tostring(bar_index + 1) + " candles)",
         text_color = color.white, text_size = size.small, bgcolor = color.new(#0a7a6a, 5))

    // ROW 1 — SIGNAL STATUS (largest text, highest priority)
    _sigStatus = _iR ? "SETUP IN PROGRESS — WATCHING FOR ENTRY" :
         _bT  ? "SIGNAL FIRED — MONITORING" : "STANDING BY"
    _sigBg = _iR ? color.new(color.blue,   40) :
         _bT  ? color.new(color.orange, 30) : color.new(color.gray, 50)
    _sigFg = _iR ? color.new(color.aqua,   0) :
         _bT  ? color.new(color.orange, 0) : color.new(color.silver, 10)
    table.cell(statsPanel, 0, 1, _sigStatus,
         text_color = _sigFg, text_size = size.normal, bgcolor = _sigBg)

    // ROW 2 — TREND + STRENGTH + NEXT SIGNAL ETA
    _tDir       = _czTr == 1 ? "🐪 UPTREND — buys only" : _czTr == -1 ? "🐪 DOWNTREND — sells only" : "🐪 NO TREND — no trades"
    _tColor     = _czTr == 1 ? _txtGreen : _czTr == -1 ? _txtRed : _txtDim
    _tBar       = _tS >= 80 ? "||||" : _tS >= 60 ? "|||." : _tS >= 40 ? "||.." : _tS >= 20 ? "|..." : "...."
    _tStL       = _tS >= 70 ? "Strong" : _tS >= 40 ? "Moderate" : "Weak"
    _nextSigEta = _minsToNextSignal >= 60 ? str.tostring(math.round(_minsToNextSignal / 60.0 * 10) / 10) + " hrs" : str.tostring(_minsToNextSignal) + " min"
    table.cell(statsPanel, 0, 5,
         _tDir + (_czStk != 0 ? "  (" + str.tostring(math.abs(_czStk)) + " hump" + (math.abs(_czStk) > 1 ? "s" : "") + " in a row" + ((camStrong > 0 and math.abs(_czStk) >= camStrong) ? ", strong" : "") + ")" : "") +
         "\nNext signal: ~" + _nextSigEta,
         text_color = _tColor, text_size = size.small, bgcolor = _bgDark)

    // ROW 3 — TODAY DIVIDER
    table.cell(statsPanel, 0, 6, "TODAY",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 4 — TODAY P&L (single best value: live if any live trades exist, else Pine sim)
    // Live = alerts that actually fired to MT5 (barstate.isrealtime at signal time)
    // Sim  = Pine historical replay (no live data yet — used as best estimate until live trades accumulate)
    _bestPnL      = _liveClosedToday > 0 ? _livePnLToday : _simPnLToday
    _bestCount    = _liveClosedToday > 0 ? _liveClosedToday : _tradesCompletedToday
    _bestWins     = _liveClosedToday > 0 ? _liveWinsToday : _winsToday
    _todayPnLDisp = math.round(_bestPnL * 100) / 100
    _todayBalDisp = iMon + _todayPnLDisp
    _todaySign    = _todayPnLDisp >= 0.01 ? "+" : ""
    _todayBg      = _todayPnLDisp >= 0.01 ? color.new(color.green, 55) : _todayPnLDisp <= -0.01 ? color.new(color.red, 55) : color.new(color.gray, 55)
    _todayFg      = _todayPnLDisp >= 0.01 ? _txtGreen : _todayPnLDisp <= -0.01 ? _txtRed : _txtDim
    table.cell(statsPanel, 0, 7,
         _todaySign + "$" + str.tostring(_todayPnLDisp, "#.##") + "  |  Balance: $" + str.tostring(_todayBalDisp, "#.##"),
         text_color = _todayFg, text_size = size.normal, bgcolor = _todayBg)

    // -- Avg trade duration --
    _avgDurMins = 0.0
    _durSz = array.size(_tDB)
    if _durSz > 0
        _durSum = 0
        for _di = 0 to _durSz - 1
            _durSum += array.get(_tDB, _di)
        _avgDurMins := math.round(_durSum / _durSz * tFm * 10) / 10
    _avgDurStr = _durSz == 0 ? "—" : _avgDurMins >= 60.0 ? str.tostring(math.round(_avgDurMins / 60.0 * 10) / 10) + " hr" : str.tostring(_avgDurMins) + " min"
    // ROW 5 — STRATEGY SUB-TOTALS + AVG DURATION (tiny, secondary detail under today P&L)
    _srcLbl = _liveClosedToday > 0 ? "live" : "sim"
    table.cell(statsPanel, 0, 8,
         "UHV " + _srcLbl + " " + (_bestPnL >= 0 ? "+" : "") + "$" + str.tostring(math.round(_bestPnL * 100) / 100, "#.##") +
         "  (" + str.tostring(_bestCount) + " trades, " + str.tostring(_bestWins) + " won)" +
         "\nAvg trade duration: " + _avgDurStr + "  (" + str.tostring(_durSz) + " all-time trades)",
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // ROW 6 — TRADE COUNT + STREAK + ALERT GATE STATUS
    // "live" = realtime alerts sent to MT5 | "hist" = historical bar replay (Pine sim only, never reached MT5)
    _gated = _sigT - _alT
    _histClosed = _tradesCompletedToday - _liveClosedToday
    _histNote   = _histClosed > 0 ? "  +  " + str.tostring(_histClosed) + " hist sim" : ""
    table.cell(statsPanel, 0, 9,
         str.tostring(_lblToday) + " labels today" +
         "  |  " + str.tostring(_liveClosedToday) + " live closed  |  " + str.tostring(_liveWinsToday) + " won" +
         (_liveClosedToday > 0 ? "  (" + str.tostring(math.round(_liveWinsToday / math.max(_liveClosedToday, 1) * 100)) + "%)" : "") + _histNote +
         "\n" + (_currentStreak > 1 ? str.tostring(_currentStreak) + " wins in a row" : _currentStreak == 1 ? "Last: win" : _currentStreak < -1 ? str.tostring(math.abs(_currentStreak)) + " losses in a row" : "Last: loss"),
         text_color = _currentStreak >= 0 ? _txtGreen : _txtOrange, text_size = size.small, bgcolor = _bgDark)

    // ROW 7 — LAST HOUR RESULT + NEXT HOUR EV PROJECTION + ALERT RATE
    table.cell(statsPanel, 0, 10,
         "Last hr: " + (_hourPnL >= 0.01 ? "+$" + str.tostring(_hourPnL, "#.##") : _hourPnL <= -0.01 ? "-$" + str.tostring(math.abs(_hourPnL), "#.##") : "—") + "  (" + str.tostring(_hourTrades) + " trades)" +
         "\nNext hr EV: " + (_projNextHrPnLEV >= 0 ? "+" : "") + "$" + str.tostring(math.abs(_projNextHrPnLEV), "#.##") + "  (" + _basisLbl + ")" +
         "\nLabels/hr: " + str.tostring(math.round(_trueNextHrSigs * 10) / 10) +
         "\nEV: $" + str.tostring(_ev, "#.##") + "/trade  |  " + str.tostring(_avgSigPerDay) + " signals/day avg",
         text_color = _txtAqua, text_size = size.small, bgcolor = _bgDark)

    // ROW 8 — STRATEGIES DIVIDER
    table.cell(statsPanel, 0, 11, "STRATEGIES",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 9 — UHV BREAKOUT (+ effective lot size when multiplier is active)
    // Find last lot size actually used per strategy (dollar-risk mode ? varies by SL distance)
    float _lastUhvLots = na
    _tySize = math.min(array.size(_tTy), array.size(_tEL))
    if _tySize > 0
        for _li = _tySize - 1 to 0
            _lt = array.get(_tTy, _li)
            _ll = array.get(_tEL, _li)
            if na(_lastUhvLots) and _lt == "uhv"
                _lastUhvLots := _ll
                break
    _uhvRiskTag = f_rTag(uDR > 0 ? uDR : _uhvAvgLoss)
    // Live dollar-at-risk: open trades (neither SL nor TP hit yet)
    float _uhvLR = na
    if _tySize > 0
        for _oi = 0 to _tySize - 1
            if not array.get(_tSH, _oi) and not array.get(_tTH, _oi)
                _oDR = math.abs(array.get(_tEn, _oi) - array.get(_tSl, _oi)) * array.get(_tEL, _oi) * cM
                _oTy2 = array.get(_tTy, _oi)
                if _oTy2 == "uhv"
                    _uhvLR := nz(_uhvLR, 0.0) + _oDR
    _uhvLS = not na(_uhvLR) ? "\n  [LIVE SL risk: -$" + str.tostring(math.round(_uhvLR * 100) / 100, "#.##") + "]" : ""
    _uhvWLStr = (_uhvAvgWin > 0 or _uhvAvgLoss > 0 ? "\navg +" + str.tostring(_uhvAvgWin, "#.##") + " / -" + str.tostring(_uhvAvgLoss, "#.##") : "") + f_mxL(_uhvMaxLoss, uST) + _uhvLS
    _uhvLotStr = "\n" + (not na(_lastUhvLots) ? str.tostring(_lastUhvLots, "0.####") : uDR > 0 ? "auto" : uRp > 0 ? str.tostring(uRp, "0.#") + "% cap" : str.tostring(uLS * lA, "0.####")) + " lots" + _uhvRiskTag + (not na(_lastUhvLots) and uLev > 0 ? " | margin ~$" + str.tostring(math.round(_lastUhvLots * cM * close / uLev * 100) / 100, "#.##") + " (" + str.tostring(uLev) + ":1)" : "")
    table.cell(statsPanel, 0, 12,
         "UHV  W/L: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " (" + str.tostring(_uhvAcc) + "%)" +
         "\nAll-time: " + (_uhvPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_uhvPnLCalc, "#.##") +
         "  |  Today: " + (_bestPnL >= 0 ? "+" : "") + "$" + str.tostring(math.round(_bestPnL * 100) / 100, "#.##") +
         _uhvWLStr + _uhvLotStr,
         text_color = _uhvPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 10 — ALL-TIME DIVIDER
    table.cell(statsPanel, 0, 13, "ALL-TIME",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 11 — ALL-TIME P&L + ACCURACY + EV
    table.cell(statsPanel, 0, 14,
         "P&L: " + (_totalPnL >= 0 ? "+" : "") + "$" + str.tostring(_totalPnL, "#.##") +
         "  |  " + str.tostring(_winTradesCount) + "/" + str.tostring(_filteredTrades) + " won (" + str.tostring(_accPct) + "%)" +
         "\n" + (_ev >= 0.01 ? "Positive EV" : _ev <= -0.01 ? "Negative EV" : "Breakeven") + ": $" + str.tostring(_ev, "#.##") + "/trade" +
         "  |  avg win: +$" + str.tostring(_winAmt, "#.##") + "  /  -$" + str.tostring(_lossAmt, "#.##"),
         text_color = _ev >= 0 ? _txtGreen : _txtRed, text_size = size.small, bgcolor = _bgDark)

    // ROW 12 — MILESTONES + RISK + YESTERDAY (condensed, tiny)
    table.cell(statsPanel, 0, 15,
         "To double: " + (_avgPnL > 0 ? str.tostring(_tradesToDouble) + " trades (~" + (_hoursToDouble >= 24 ? str.tostring(math.round(_hoursToDouble / 24.0 * 10) / 10) + " days" : str.tostring(_hoursToDouble) + " hrs") + ")" : "—") +
         "  |  Washout: " + str.tostring(_washout) + " losses" +
         "\nYesterday: " + (_pnlYday >= 0 ? "+" : "") + "$" + str.tostring(math.round(_pnlYday * 100) / 100, "#.##") + "  (" + (_ydayGrowthPct >= 0 ? "+" : "") + str.tostring(_ydayGrowthPct) + "%)",
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // Recommendations / optimize calculations derived from trade statistics
    // Compute avg _tS for winners and losers across all trades
    _winTSsum    = 0.0
    _winTScount  = 0
    _loseTSsum   = 0.0
    _loseTScount = 0
    _tsSize = array.size(_tW)
    if _tsSize > 0
        for _ri = 0 to _tsSize - 1
            _rts   = array.get(_tTS, _ri)
            _rwon  = array.get(_tW,      _ri)
            if _rwon
                _winTSsum   += _rts
                _winTScount += 1
            else
                _loseTSsum   += _rts
                _loseTScount += 1
    _avgWinTS  = _winTScount  > 0 ? _winTSsum  / _winTScount  : na
    _avgLoseTS = _loseTScount > 0 ? _loseTSsum / _loseTScount : na

    // -- Estimate dollar gain from unlocking blocked signals (per day) --
    _avgPnLPerTrade = _cTr > 0 ? _totalPnL / _cTr : 0.0
    _daysBase = math.max(_tDS, 1)
    // Only use estimate when avg is positive (net profitable)
    _canEstimate = _avgPnLPerTrade > 0 and _cTr >= 5

    // RECOMMENDATIONS ENGINE — grouped by priority
    _overallWinRate = _cTr > 0 ? _wC / _cTr : 0.0

    // -- Realized R:R from actual dollar win vs dollar loss amounts --
    // Use observed avg win and avg loss dollars — works correctly for all SL types
    _avgRealizedRR = (_lossAmt > 0 and _winAmt > 0) ? _winAmt / _lossAmt : _avgTp1Mult
    // Break-even win rate for the actual R:R being used
    _beWinRate = _avgRealizedRR > 0 ? 1.0 / (1.0 + _avgRealizedRR) : 0.5

    // -- Per-strategy EV --
    _uhvEV = _uhvTradesCalc >= 5 ? (_uhvWinsCalc / _uhvTradesCalc) * _uhvAvgWin - (1.0 - _uhvWinsCalc / _uhvTradesCalc) * _uhvAvgLoss : na

    _totalSlHits = _cTr - _wC
    _slHitRate   = _cTr > 0 ? float(_totalSlHits) / _cTr : 0.0

    // BUILD RECOMMENDATION STRINGS — ordered by priority
    _recs = array.new_string()
    // 🚨 CRITICAL
    if iMon > 0 and _pT < -(iMon * 0.10)
        array.push(_recs, "🚨 Down " + str.tostring(math.round(math.abs(_pT) / iMon * 100)) + "% today (-$" + str.tostring(math.abs(_pT), "#.##") + ")\nconsider stopping for the day to protect your capital")
    if not na(_uhvEV) and _uhvEV < -0.05
        array.push(_recs, "🚨 UHV Breakout has negative EV: -$" + str.tostring(math.abs(_uhvEV), "#.##") + "/trade avg (" + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won, avg win $" + str.tostring(_uhvAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_uhvAvgLoss, "#.##") + ")\ndisable or adjust settings")
    // ⚠️ WARNING
    if _uhvTradesCalc >= 5 and _uhvWinsCalc / _uhvTradesCalc < 0.40 and _uhvEV >= -0.05
        array.push(_recs, "⚠️ UHV Breakout: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won (" + str.tostring(math.round(_uhvWinsCalc / _uhvTradesCalc * 100)) + "%)\nbelow break-even. Try: raise Min Trend Strength, enable Require UHV Sweep, or disable this strategy")
    if _totalSlHits >= 5 and _slHitRate > 0.60 and _cTr >= 8
        array.push(_recs, "⚠️ " + str.tostring(math.round(_slHitRate * 100)) + "% of trades are hitting SL (" + str.tostring(_totalSlHits) + "/" + str.tostring(_cTr) + ")\nentries may be too early. Try: increase SL Buffer, switch to ATR stop, or raise Min Trend Strength")
    // 💡 OPTIMIZE
    if not na(_avgWinTS) and not na(_avgLoseTS) and _winTScount >= 3 and _loseTScount >= 3
        _tsDiff = _avgWinTS - _avgLoseTS
        if _tsDiff > 8
            array.push(_recs, "💡 Winners fire at avg trend strength " + str.tostring(math.round(_avgWinTS)) + " vs losers at " + str.tostring(math.round(_avgLoseTS)) + "\nraise 'Min Trend Strength' to ~" + str.tostring(math.round(_avgWinTS * 0.85)) + " to pre-filter weak setups (setting is in the Trend Engine group)")
        else if _tsDiff < -8
            array.push(_recs, "💡 Wins happen at lower trend strength (" + str.tostring(math.round(_avgWinTS)) + ") than losses (" + str.tostring(math.round(_avgLoseTS)) + ")\nlower 'Min Trend Strength' to catch more quality setups")
    if _cTr >= 10
        if _overallWinRate > _beWinRate + 0.10 and _avgTp1Mult < 2.2
            array.push(_recs, "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% beats break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nraise TP R:R to ~" + str.tostring(math.round(_avgRealizedRR * 1.3 * 10) / 10) + "R to earn more per winner (note: higher TP will reduce win rate — test first)")
        else if _overallWinRate < _beWinRate - 0.08 and _avgTp1Mult > 1.2
            array.push(_recs, "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% is below break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nlower TP R:R to ~" + str.tostring(math.round(_avgRealizedRR * 0.75 * 10) / 10) + "R so TP is easier to reach")
    // 🔓 UNLOCK — only suggest when win rate is close to break-even (filter may be over-filtering)
    // If win rate is well above break-even, the filter is earning its keep; dollar estimate
    // assumes blocked signals have same quality as passing ones, which is unlikely when win rate is high
    bool _ftOK = _overallWinRate < _beWinRate + 0.25
    if rUS and _bSwp >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 UHV Sweep filter blocked " + str.tostring(_bSwp) + " signals (" + str.tostring(math.round(_bSwp / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must any candle sweep UHV low before entry' may add ~$" + str.tostring(math.round(_bSwp / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    else if rULV and _bUV >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 UHV Volume filter blocked " + str.tostring(_bUV) + " signals (" + str.tostring(math.round(_bUV / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must breakout candle have lower volume' may add ~$" + str.tostring(math.round(_bUV / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if _bCd >= 5 and _canEstimate and _ftOK
        array.push(_recs, "🔓 Cooldown blocked " + str.tostring(_bCd) + " signals (" + str.tostring(math.round(_bCd / _daysBase * 10) / 10) + "/day avg)\nlower 'Signal Cooldown (bars)' may add ~$" + str.tostring(math.round(_bCd / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if _bStr >= 4 and _canEstimate and _ftOK
        array.push(_recs, "🔓 Min Trend Strength blocked " + str.tostring(_bStr) + " signals (" + str.tostring(math.round(_bStr / _daysBase * 10) / 10) + "/day avg)\nlower 'Min Trend Strength' may add ~$" + str.tostring(math.round(_bStr / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (only if trend stays strong)")
    // ROW 13 — OPTIMIZER & TOOLS DIVIDER + smiley
    _r15AP  = _cTr > 0 ? _uPnL / _cTr : 0.
    _r15Rel = _r15AP / math.max(uTD, 1.0)
    _r15Sm  = _cTr == 0 ? "⌛ Waiting..." : _r15Rel > 0.35 ? "😄  Loving it!" : _r15Rel > 0.05 ? "🙂  Profitable" : _r15Rel >= -0.05 ? "😐  Breaking even" : "😟  Try different values"
    table.cell(statsPanel, 0, 16, "OPTIMIZER & TOOLS  |  " + _r15Sm + "  ($" + str.tostring(math.round(_r15AP * 100) / 100, "#.##") + "/trade avg)",
         text_color = _r15AP >= 0. ? color.new(color.lime, 30) : color.new(color.red, 20), text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 14 — TOP RECOMMENDATIONS (surfacing computed _recs array)
    _recsSize = array.size(_recs)
    table.cell(statsPanel, 0, 17, (_recsSize > 0 ? array.get(_recs, 0) : "No recommendations yet — need more trade data") + (_recsSize > 1 ? "\n" + array.get(_recs, 1) : ""),
         text_color = _txtYellow, text_size = size.tiny, bgcolor = color.new(#1a2a1a, 10))



plot(_scSigE, "test entry", display = display.data_window)
plot(_scSigD, "test direction", display = display.data_window)
plot(_scSigU, "test uhv time", display = display.data_window)
// LIVE BRIDGE (pine/tv_armed_bridge.py -> the MT5 EA): the setup armed at this candle's close for
// the NEXT candle. Only meaningful in Instant mode; 0 = nothing armed.
plot(_uIOE ? (nz(_armB) ? 1 : nz(_armE) ? -1 : 0) : 0, "live armed side", display = display.data_window)
plot(_armUT, "live armed uhv time", display = display.data_window)
plot(nz(_armB) ? _armTB : nz(_armE) ? _armTE : na, "live armed trigger", display = display.data_window)

if barstate.islast and sSP
    fDP()

// -- Last Signal Panel (bottom-left) — always shows most recent signal label text --
if barstate.islast
    _lsP = table.new(position.bottom_left, 1, 2, bgcolor = color.new(color.black, 10), border_color = color.new(color.gray, 40), border_width = 1)
    table.cell(_lsP, 0, 0, "LAST SIGNAL", text_color = color.new(color.aqua, 0), text_size = size.small, bgcolor = color.new(#001830, 5))
    table.cell(_lsP, 0, 1, _lastSigTxt == "" ? "No signal yet" : _lastSigTxt, text_color = color.new(color.white, 0), text_size = size.normal, bgcolor = color.new(#0a0a14, 8))


// PARITY STATE (for mt5/TurtleUHV.mq5 checks): end-of-candle state, read by pine/compare_state.py
plot((_iR ? 1 : 0) + (_lb ? 2 : 0) + (_rwb ? 4 : 0) + (_ibT ? 8 : 0) + (_uF ? 16 : 0) + (_uWB ? 32 : 0) + (_uWSp ? 64 : 0) + (nz(_armB) ? 128 : 0) + (nz(_armE) ? 256 : 0) + (_ib ? 512 : 0) + (_ibr ? 1024 : 0), "dbg flags", display = display.data_window)
plot(_czTr * 100 + _czStk, "dbg camel", display = display.data_window)
plot(na(_uBar) ? na : float(time[math.max(bar_index - _uBar, 0)]), "dbg uhv time", display = display.data_window)
