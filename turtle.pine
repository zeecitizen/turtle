    if showLabels
        label.delete(_sigLbl)
        _sigLbl := label.new(bar_index, low, "🔴 SELL NOW  #" + str.tostring(totalSignals) + "\n(Two Bar Reversal)\n━━━━━━━━━━━━━━━━\nSell: " + str.tostring(_entry, "#.###") + "\nSL:   " + str.tostring(_sl, "#.###") + "  [" + _effTbrSlType + ", risk: $" + str.tostring(math.round(_slDist * _effLots2 * cMult * 100) / 100, "#.##") + "]\nLots: " + _lotLabel + "\nTP:   " + str.tostring(_tp1, "#.###") + " (" + (tbrTpMethod == "Structural High/Low" ? "Struct." : tbrTpMethod == "Dollar Amount" ? "$fixed" : str.tostring(tbrTp1Mult, "#.#") + "R") + ")  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLots2 * cMult * 100) / 100, "#.##") + "\n━━━━━━━━━━━━━━━━\n📊 " + _acc + "\n" + _pnlText, style = label.style_label_up, color = color.new(color.orange, 10), textcolor = color.white, size = size.normal)
    array.push(tradeEntry,    _entry)
    array.push(tradeSL,       _sl)
    array.push(tradeTP1,      _tp1)
    array.push(tradeBull,     false)
    array.push(tradeTP1Hit,   false)
    array.push(tradeSLHit,    false)
    array.push(tradeEffLots,  _effLots2)
    array.push(tradeType,     "tbr")
    array.push(tradeNum,      totalSignals)
    array.push(tradeTrendStr, trendStrength)
    array.push(tradeWon,      false)
    array.push(tradeSlDist,   _slDist)
    array.push(tradeSlBars,   -1)
    array.push(tradeLabel,    _sigLbl)
    array.push(tradeEntryBar, bar_index)

// STEP 5c: EFFORT VS RESULT (VSA) — Block C integration
// Entry fires when breakout candle:
//   1. Sweeps UHV candle low (low < uhvSL)
//   2. Closes back above it  (close > uhvSL)
//   3. Has HIGHER volume than the UHV candle (volume > uhvVolume)
// This is the pure VSA "effort vs result" signal — more buying effort than the biggest seller
// Bull EVR: two paths depending on avoidEVRTrendWick
// Path A — no wick filter OR wick is clean: fire immediately
// Path B — wick filter ON and wick > body: set pending, wait for next bar confirmation
_evrBullBase    = _effEvrBullDir and enableEVR and showVSA and inRetracement and lastIsBull and retraceWasBull and _evrFvgCheck and not evrFiredThisSetup and not na(vsaRedLow) and vsaRedVol > 0 and ((strictTrendCheck and strictTrendCheckEVR) ? (htfBull and bullTrendPersists) : not bearTrendPersists) and trendStrength >= minTrendStrength and not _trendShiftEVR and isGreen and low < vsaRedLow and close > vsaRedLow and (_effReqEVRHigherVol ? volume > vsaRedVol : true) and (requireEVRLowerVol ? volume < volume[1] : true) and (bar_index - lastEVRSignalBar) >= _effEvrCooldown
_evrBullHasWick = (high - close) > (close - open)   // upper wick larger than body
bullVSA         = _evrBullBase and (avoidEVRTrendWick ? not _evrBullHasWick : true) and barstate.isconfirmed
// When wick detected and filter is ON: arm pending confirmation
if _evrBullBase and avoidEVRTrendWick and _evrBullHasWick and not evrBullWickPending
    evrBullWickPending := true
    evrWickCandleHigh  := high

// Bear EVR: same two-path logic
_evrBearBase    = _effEvrBearDir and enableEVR and showVSA and inRetracement and not lastIsBull and not retraceWasBull and _evrFvgCheck and not evrFiredThisSetup and not na(vsaGrnHigh) and vsaGrnVol > 0 and ((strictTrendCheck and strictTrendCheckEVR) ? (htfBear and bearTrendPersists) : not bullTrendPersists) and trendStrength >= minTrendStrength and not _trendShiftEVR and isRed and high > vsaGrnHigh and close < vsaGrnHigh and (_effReqEVRHigherVol ? volume > vsaGrnVol : true) and (requireEVRLowerVol ? volume < volume[1] : true) and (bar_index - lastEVRSignalBar) >= _effEvrCooldown
_evrBearHasWick = (close - low) > (open - close)    // lower wick larger than body
bearVSA         = _evrBearBase and (avoidEVRTrendWick ? not _evrBearHasWick : true) and barstate.isconfirmed
// When wick detected and filter is ON: arm pending confirmation
if _evrBearBase and avoidEVRTrendWick and _evrBearHasWick and not evrBearWickPending
    evrBearWickPending := true
    evrWickCandleLow   := low

// EVR blocked by volume check
_evrBullBaseNoVol = _effEvrBullDir and enableEVR and showVSA and inRetracement and lastIsBull and retraceWasBull and _evrFvgCheck and not evrFiredThisSetup and not na(vsaRedLow) and vsaRedVol > 0 and ((strictTrendCheck and strictTrendCheckEVR) ? (htfBull and bullTrendPersists) : not bearTrendPersists) and trendStrength >= minTrendStrength and isGreen and low < vsaRedLow and close > vsaRedLow
_evrBearBaseNoVol = _effEvrBearDir and enableEVR and showVSA and inRetracement and not lastIsBull and not retraceWasBull and _evrFvgCheck and not evrFiredThisSetup and not na(vsaGrnHigh) and vsaGrnVol > 0 and ((strictTrendCheck and strictTrendCheckEVR) ? (htfBear and bearTrendPersists) : not bullTrendPersists) and trendStrength >= minTrendStrength and isRed and high > vsaGrnHigh and close < vsaGrnHigh
// Persist EVR structural appearance so bounceCancel stays suppressed on bars AFTER the sweep candle
// Without this, when requireEVRHigherVol=ON blocks EVR, evrFiredThisSetup stays false and bounceCancel
// can fire on the very next bar, wiping UHV/TBR setups
if _evrBullBaseNoVol or _evrBearBaseNoVol
    _evrSeenThisSetup := true
if _effReqEVRHigherVol and (_evrBullBaseNoVol or _evrBearBaseNoVol) and not (_evrBullBaseNoVol and volume > vsaRedVol) and not (_evrBearBaseNoVol and volume > vsaGrnVol)
    blockedEVRVol += 1
if requireEVRLowerVol and (_evrBullBaseNoVol or _evrBearBaseNoVol) and volume >= volume[1]
    blockedEVRLowerVol += 1

if bullVSA
    signalsToday += 1
    array.push(signalBarTimes, bar_index)
    evrFiredThisSetup := true
    brkTriggered  := true
    fvgUsed       := true
    lastEVRSignalBar := bar_index
    totalSignals  += 1
    _entry    = close
    _sl       = f_calcSL(true, close, nz(retraceLow, nz(vsaRedLow, low)), high, _effEvrSlType, evrSlBuffer, evrSlAtrMult, evrSlSwingLb, evrSlMinDist, evrDollarRisk, evrLotSize, evrSlDollar)
    _slDist   = math.max(_entry - _sl, syminfo.mintick)
    float _effLotsV = (evrDollarRisk > 0 ? math.max(evrDollarRisk / (_slDist * cMult), 0.001) : evrLotSize) * lotAmp
    if _slDist * _effLotsV * cMult > _evrLossCap
        _slDist := math.max(_evrLossCap / math.max(_effLotsV * cMult, syminfo.mintick), syminfo.mintick)
        _sl     := _entry - _slDist
    _tp1      = evrTpMethod == "Structural High/Low" ? nz(retraceCeiling, _entry + _slDist * evrTp1Mult) : evrTpMethod == "Dollar Amount" ? _entry + _effEvrTpDollar : _entry + _slDist * evrTp1Mult
    string _pcStr = pcLicenseId + ",buy," + pcSymbol + ",vol_lots=" + str.tostring(_effLotsV, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR"

    alert(pcEnable ? _pcStr : "🟢 BUY Signal — EVR | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
    _lotLabel = f_lotLabel(evrDollarRisk, _effLotsV)
    _acc = f_accStr(evrWins, evrTrades)
    _pnlText = f_pnlTodayStr(evrPnLToday)
    label _sigLbl = label.new(bar_index, high, "Result: Waiting for TP", style = label.style_none, size = size.tiny)
    if showLabels
        label.delete(_sigLbl)
        _sigLbl := label.new(bar_index, high, "BUY NOW  #" + str.tostring(totalSignals) + "\n(Effort vs Result)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _effEvrSlType + ", risk: $" + str.tostring(math.round(_slDist * _effLotsV * cMult * 100) / 100, "#.##") + "]" + "\nLots:  " + _lotLabel + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsV * cMult * 100) / 100, "#.##") + "\n" + _acc + "\n" + _pnlText, style = label.style_label_down, color = color.new(color.lime, 10), textcolor = color.black, size = size.normal)
    array.push(tradeEntry,    _entry)
    array.push(tradeSL,       _sl)
    array.push(tradeTP1,      _tp1)
    array.push(tradeBull,     true)
    array.push(tradeTP1Hit,   false)
    array.push(tradeSLHit,    false)
    array.push(tradeEffLots,  _effLotsV)
    array.push(tradeType,     "evr")
    array.push(tradeNum,      totalSignals)
    array.push(tradeTrendStr, trendStrength)
    array.push(tradeWon,      false)
    array.push(tradeSlDist,   _slDist)
    array.push(tradeSlBars,   -1)
    array.push(tradeLabel,    _sigLbl)
    array.push(tradeEntryBar, bar_index)

if bearVSA
    signalsToday += 1
    array.push(signalBarTimes, bar_index)
    evrFiredThisSetup := true
    brkTriggered  := true
    fvgUsed       := true
    lastEVRSignalBar := bar_index
    totalSignals  += 1
    _entry      = close
    _sl         = f_calcSL(false, close, low, nz(retraceHigh, nz(vsaGrnHigh, high)), _effEvrSlType, evrSlBuffer, evrSlAtrMult, evrSlSwingLb, evrSlMinDist, evrDollarRisk, evrLotSize, evrSlDollar)
    _slDist     = math.max(_sl - _entry, syminfo.mintick)
    float _effLotsV2 = (evrDollarRisk > 0 ? math.max(evrDollarRisk / (_slDist * cMult), 0.001) : evrLotSize) * lotAmp
    if _slDist * _effLotsV2 * cMult > _evrLossCap
        _slDist := math.max(_evrLossCap / math.max(_effLotsV2 * cMult, syminfo.mintick), syminfo.mintick)
        _sl     := _entry + _slDist
    _tp1        = evrTpMethod == "Structural High/Low" ? nz(retraceFloor, _entry - _slDist * evrTp1Mult) : evrTpMethod == "Dollar Amount" ? _entry - _effEvrTpDollar : _entry - _slDist * evrTp1Mult
    string _pcStr = pcLicenseId + ",sell," + pcSymbol + ",vol_lots=" + str.tostring(_effLotsV2, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR"

    alert(pcEnable ? _pcStr : "🔴 SELL Signal — EVR | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
    _lotLabel   = f_lotLabel(evrDollarRisk, _effLotsV2)
    _acc = f_accStr(evrWins, evrTrades)
    _pnlText = f_pnlTodayStr(evrPnLToday)
    label _sigLbl = label.new(bar_index, low, "Result: Waiting for TP", style = label.style_none, size = size.tiny)
    if showLabels
        label.delete(_sigLbl)
        _sigLbl := label.new(bar_index, low, "SELL NOW  #" + str.tostring(totalSignals) + "\n(Effort vs Result)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _effEvrSlType + ", risk: $" + str.tostring(math.round(_slDist * _effLotsV2 * cMult * 100) / 100, "#.##") + "]" + "\nLots:  " + _lotLabel + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsV2 * cMult * 100) / 100, "#.##") + "\n" + _acc + "\n" + _pnlText, style = label.style_label_up, color = color.new(color.red, 10), textcolor = color.white, size = size.normal)
    array.push(tradeEntry,    _entry)
    array.push(tradeSL,       _sl)
    array.push(tradeTP1,      _tp1)
    array.push(tradeBull,     false)
    array.push(tradeTP1Hit,   false)
    array.push(tradeSLHit,    false)
    array.push(tradeEffLots,  _effLotsV2)
    array.push(tradeType,     "evr")
    array.push(tradeNum,      totalSignals)
    array.push(tradeTrendStr, trendStrength)
    array.push(tradeWon,      false)
    array.push(tradeSlDist,   _slDist)
    array.push(tradeSlBars,   -1)
    array.push(tradeLabel,    _sigLbl)
    array.push(tradeEntryBar, bar_index)

// EVR WICK CONFIRMATION — pending entries waiting for breakout of wick candle

// Cancel pending if retracement ends or trend flipped
if evrBullWickPending and (not inRetracement or evrFiredThisSetup or bearTrendPersists or not enableEVR or not showVSA)
    evrBullWickPending := false
    evrWickCandleHigh  := na
if evrBearWickPending and (not inRetracement or evrFiredThisSetup or bullTrendPersists or not enableEVR or not showVSA)
    evrBearWickPending := false
    evrWickCandleLow   := na

// Bull confirmation: next candle closes above the wick candle high
if evrBullWickPending and not na(evrWickCandleHigh) and not evrFiredThisSetup and enableEVR and showVSA and inRetracement and lastIsBull and close > evrWickCandleHigh and barstate.isconfirmed
    evrBullWickPending := false
    signalsToday += 1
    array.push(signalBarTimes, bar_index)
    evrFiredThisSetup := true
    brkTriggered  := true
    fvgUsed       := true
    lastEVRSignalBar := bar_index
    totalSignals  += 1
    _entry    = close
    _sl       = f_calcSL(true, close, nz(retraceLow, nz(vsaRedLow, low)), high, _effEvrSlType, evrSlBuffer, evrSlAtrMult, evrSlSwingLb, evrSlMinDist, evrDollarRisk, evrLotSize, evrSlDollar)
    _slDist   = math.max(_entry - _sl, syminfo.mintick)
    float _effLotsVW = (evrDollarRisk > 0 ? math.max(evrDollarRisk / (_slDist * cMult), 0.001) : evrLotSize) * lotAmp
    if _slDist * _effLotsVW * cMult > _evrLossCap
        _slDist := math.max(_evrLossCap / math.max(_effLotsVW * cMult, syminfo.mintick), syminfo.mintick)
        _sl     := _entry - _slDist
    _tp1      = evrTpMethod == "Structural High/Low" ? nz(retraceCeiling, _entry + _slDist * evrTp1Mult) : evrTpMethod == "Dollar Amount" ? _entry + _effEvrTpDollar : _entry + _slDist * evrTp1Mult
    string _pcStr = pcLicenseId + ",buy," + pcSymbol + ",vol_lots=" + str.tostring(_effLotsVW, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR"

    alert(pcEnable ? _pcStr : "🟢 BUY Signal — EVR Wick Confirmed | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
    _lotLabel = f_lotLabel(evrDollarRisk, _effLotsVW)
    _acc = f_accStr(evrWins, evrTrades)
    _pnlText = f_pnlTodayStr(evrPnLToday)
    label _sigLblW = label.new(bar_index, high, "Result: Waiting for TP", style = label.style_none, size = size.tiny)
    if showLabels
        label.delete(_sigLblW)
        _sigLblW := label.new(bar_index, high, "BUY NOW  #" + str.tostring(totalSignals) + "\n(EVR — Wick Confirmed)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _effEvrSlType + ", risk: $" + str.tostring(math.round(_slDist * _effLotsVW * cMult * 100) / 100, "#.##") + "]\nLots:  " + _lotLabel + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsVW * cMult * 100) / 100, "#.##") + "\n" + _acc + "\n" + _pnlText, style = label.style_label_down, color = color.new(color.lime, 10), textcolor = color.black, size = size.normal)
    if showDebug
        label.new(bar_index, low, "✅ EVR Wick Confirmed ↑", style = label.style_label_up, color = color.new(color.lime, 20), textcolor = color.black, size = size.tiny)
    array.push(tradeEntry,    _entry)
    array.push(tradeSL,       _sl)
    array.push(tradeTP1,      _tp1)
    array.push(tradeBull,     true)
    array.push(tradeTP1Hit,   false)
    array.push(tradeSLHit,    false)
    array.push(tradeEffLots,  _effLotsVW)
    array.push(tradeType,     "evr")
    array.push(tradeNum,      totalSignals)
    array.push(tradeTrendStr, trendStrength)
    array.push(tradeWon,      false)
    array.push(tradeSlDist,   _slDist)
    array.push(tradeSlBars,   -1)
    array.push(tradeLabel,    _sigLblW)
    array.push(tradeEntryBar, bar_index)
    evrWickCandleHigh := na

// Bear confirmation: next candle closes below the wick candle low
if evrBearWickPending and not na(evrWickCandleLow) and not evrFiredThisSetup and enableEVR and showVSA and inRetracement and not lastIsBull and close < evrWickCandleLow and barstate.isconfirmed
    evrBearWickPending := false
    signalsToday += 1
    array.push(signalBarTimes, bar_index)
    evrFiredThisSetup := true
    brkTriggered  := true
    fvgUsed       := true
    lastEVRSignalBar := bar_index
    totalSignals  += 1
    _entry    = close
    _sl       = f_calcSL(false, close, low, nz(retraceHigh, nz(vsaGrnHigh, high)), _effEvrSlType, evrSlBuffer, evrSlAtrMult, evrSlSwingLb, evrSlMinDist, evrDollarRisk, evrLotSize, evrSlDollar)
    _slDist   = math.max(_sl - _entry, syminfo.mintick)
    float _effLotsVW2 = (evrDollarRisk > 0 ? math.max(evrDollarRisk / (_slDist * cMult), 0.001) : evrLotSize) * lotAmp
    if _slDist * _effLotsVW2 * cMult > _evrLossCap
        _slDist := math.max(_evrLossCap / math.max(_effLotsVW2 * cMult, syminfo.mintick), syminfo.mintick)
        _sl     := _entry + _slDist
    _tp1      = evrTpMethod == "Structural High/Low" ? nz(retraceFloor, _entry - _slDist * evrTp1Mult) : evrTpMethod == "Dollar Amount" ? _entry - _effEvrTpDollar : _entry - _slDist * evrTp1Mult
    string _pcStr = pcLicenseId + ",sell," + pcSymbol + ",vol_lots=" + str.tostring(_effLotsVW2, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR"

    alert(pcEnable ? _pcStr : "🔴 SELL Signal — EVR Wick Confirmed | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
    _lotLabel = f_lotLabel(evrDollarRisk, _effLotsVW2)
    _acc = f_accStr(evrWins, evrTrades)
    _pnlText = f_pnlTodayStr(evrPnLToday)
    label _sigLblW2 = label.new(bar_index, low, "Result: Waiting for TP", style = label.style_none, size = size.tiny)
    if showLabels
        label.delete(_sigLblW2)
        _sigLblW2 := label.new(bar_index, low, "SELL NOW  #" + str.tostring(totalSignals) + "\n(EVR — Wick Confirmed)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _effEvrSlType + ", risk: $" + str.tostring(math.round(_slDist * _effLotsVW2 * cMult * 100) / 100, "#.##") + "]\nLots:  " + _lotLabel + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsVW2 * cMult * 100) / 100, "#.##") + "\n" + _acc + "\n" + _pnlText, style = label.style_label_up, color = color.new(color.red, 10), textcolor = color.white, size = size.normal)
    if showDebug
        label.new(bar_index, high, "✅ EVR Wick Confirmed ↓", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.tiny)
    array.push(tradeEntry,    _entry)
    array.push(tradeSL,       _sl)
    array.push(tradeTP1,      _tp1)
    array.push(tradeBull,     false)
    array.push(tradeTP1Hit,   false)
    array.push(tradeSLHit,    false)
    array.push(tradeEffLots,  _effLotsVW2)
    array.push(tradeType,     "evr")
    array.push(tradeNum,      totalSignals)
    array.push(tradeTrendStr, trendStrength)
    array.push(tradeWon,      false)
    array.push(tradeSlDist,   _slDist)
    array.push(tradeSlBars,   -1)
    array.push(tradeLabel,    _sigLblW2)
    array.push(tradeEntryBar, bar_index)
    evrWickCandleLow := na

// End setup when all enabled strategies have fired from this setup
if inRetracement
    // _2brSeenThisSetup: a structural 2BR candle appeared this setup (regardless of vol filter)
    // When require2BRLowerVol=ON blocks TBR on a high-vol bar, the setup must not keep running
    // indefinitely waiting for TBR — that would delay UHV/EVR from freeing up the next setup.
    // Treating a seen-but-blocked 2BR as "TBR serviced" makes setup duration identical to OFF case.
    _allStratsFired = (not enableUHV or uhvFiredThisSetup or uhvWasBlocked) and (not enableTBR or tbrFiredThisSetup or _2brSeenThisSetup) and (not enableEVR or evrFiredThisSetup or _evrSeenThisSetup)
    if _allStratsFired
        inRetracement := false
        ibTracking    := false
        fvgReached    := false
        if not na(poiLineHL)
            line.delete(poiLineHL)
        if not na(poiLineSup)
            line.delete(poiLineSup)
        poiLineHL   := na
        poiLineSup  := na
        poiLevelHL  := na
        poiLevelSup := na

// DAILY RESET
_today = dayofmonth(time)
if _today != lastTradeDay
    totalSignalsAllDays  += signalsToday
    totalDaysSeen        += 1
    signalsToday         := 0
    pnlToday             := 0.0
    uhvPnLToday          := 0.0
    tbrPnLToday          := 0.0
    evrPnLToday          := 0.0
    todayLossStreak      := 0
    maxLossStreakToday   := 0
    lastTradeDay         := _today

// TRADE MONITORING
if array.size(tradeEntry) > 0
    for _ti = array.size(tradeEntry) - 1 to 0
        _done  = array.get(tradeSLHit, _ti) or array.get(tradeTP1Hit, _ti)
        if not _done
            _bull  = array.get(tradeBull,  _ti)
            _sl    = array.get(tradeSL,    _ti)
            _tp1   = array.get(tradeTP1,   _ti)
            _t1hit = array.get(tradeTP1Hit, _ti)
            _slhit = array.get(tradeSLHit,  _ti)
            _tNum  = array.size(tradeNum) > _ti ? array.get(tradeNum, _ti) : 0

            _entryBar = array.get(tradeEntryBar, _ti)
            if not _slhit and bar_index > _entryBar
                _slTriggered = _bull ? low <= _sl : high >= _sl
                if _slTriggered
                    array.set(tradeSLHit, _ti, true)
                    if not _t1hit
                        _pnl = (_bull ? (_sl - array.get(tradeEntry, _ti)) : (array.get(tradeEntry, _ti) - _sl)) * array.get(tradeEffLots, _ti) * cMult
                        array.push(dollarPnLHistory, _pnl)
                        array.push(tradeCloseTime, bar_index)
                        array.push(tradeCloseTS,   time)
                        array.push(tradePnLArr, _pnl)
                        array.push(tradePnLType, array.size(tradeType) > _ti ? array.get(tradeType, _ti) : "uhv")
                        completedTrades += 1
                        pnlToday             += _pnl
                        todayLossStreak += 1
                        if todayLossStreak > maxLossStreakToday
                            maxLossStreakToday := todayLossStreak
                        label.new(bar_index, _sl, "🛑 #" + str.tostring(_tNum) + " SL Hit  -$" + str.tostring(math.abs(_pnl), "#.##") + " (" + str.tostring(array.get(tradeEffLots,_ti),"#.####") + " lots)", style = _bull ? label.style_label_up : label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny)
                        if array.size(tradeSlBars) > _ti
                            array.set(tradeSlBars, _ti, bar_index - _entryBar)
                        if array.size(tradeType) > _ti
                            _stype = array.get(tradeType, _ti)
                            _sbull = array.size(tradeBull) > _ti ? array.get(tradeBull, _ti) : true
                            if _stype == "uhv"
                                uhvPnL += _pnl
                                uhvPnLToday += _pnl
                                uhvTrades += 1
                                uhvLossSum += math.abs(_pnl)
                                if _sbull
                                    uhvBullPnL += _pnl
                                    uhvBullT += 1
                                else
                                    uhvBearPnL += _pnl
                                    uhvBearT += 1
                            else if _stype == "tbr"
                                tbrPnL += _pnl
                                tbrPnLToday += _pnl
                                tbrTrades += 1
                                tbrLossSum += math.abs(_pnl)
                                if _sbull
                                    tbrBullPnL += _pnl
                                    tbrBullT += 1
                                else
                                    tbrBearPnL += _pnl
                                    tbrBearT += 1
                            else if _stype == "evr"
                                evrPnL += _pnl
                                evrPnLToday += _pnl
                                evrTrades += 1
                                evrLossSum += math.abs(_pnl)
                                if _sbull
                                    evrBullPnL += _pnl
                                    evrBullT += 1
                                else
                                    evrBearPnL += _pnl
                                    evrBearT += 1
                        if array.size(tradeLabel) > _ti
                            _origLbl = array.get(tradeLabel, _ti)
                            if not na(_origLbl)
                                _origTxt = label.get_text(_origLbl)
                                label.set_text(_origLbl, _origTxt + "\n━━━━━━━━━━━━━━━━\n🛑 #" + str.tostring(_tNum) + " SL Hit — -$" + str.tostring(math.abs(_pnl), "#.##") + " Loss")

            if not _t1hit and not array.get(tradeSLHit, _ti) and bar_index > _entryBar
                _tp1Triggered = _bull ? high >= _tp1 : low <= _tp1
                if _tp1Triggered
                    array.set(tradeTP1Hit, _ti, true)
                    winCount += 1
                    _lots = array.get(tradeEffLots, _ti)
                    _pnl  = (_bull ? (_tp1 - array.get(tradeEntry, _ti)) : (array.get(tradeEntry, _ti) - _tp1)) * _lots * cMult
                    array.push(dollarPnLHistory, _pnl)
                    array.push(tradeCloseTime, bar_index)
                    array.push(tradeCloseTS,   time)
                    array.push(tradePnLArr, _pnl)
                    array.push(tradePnLType, array.size(tradeType) > _ti ? array.get(tradeType, _ti) : "uhv")
                    completedTrades += 1
                    pnlToday             += _pnl
                    todayLossStreak := 0
                    // ── TP+1 same-bar proof: did price go $1 past TP on this bar? ──
                    tp1SameBarChecks += 1
                    if _bull ? high >= _tp1 + 1.0 : low <= _tp1 - 1.0
                        tp1SameBarWins += 1
                    label.new(bar_index, _tp1, "✅ #" + str.tostring(_tNum) + " TP Hit  +$" + str.tostring(_pnl, "#.##") + " (" + str.tostring(array.get(tradeEffLots,_ti),"#.####") + " lots)", style = _bull ? label.style_label_down : label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.tiny)
                    if array.size(tradeType) > _ti
                        _stype = array.get(tradeType, _ti)
                        _sbull = array.size(tradeBull) > _ti ? array.get(tradeBull, _ti) : true
                        if array.size(tradeWon) > _ti
                            array.set(tradeWon, _ti, true)
                        if _stype == "uhv"
                            uhvPnL += _pnl
                            uhvPnLToday += _pnl
                            uhvTrades += 1
                            uhvWins += 1
                            uhvWinSum += _pnl
                            if _sbull
                                uhvBullPnL += _pnl
                                uhvBullT += 1
                                uhvBullW += 1
                            else
                                uhvBearPnL += _pnl
                                uhvBearT += 1
                                uhvBearW += 1
                        else if _stype == "tbr"
                            tbrPnL += _pnl
                            tbrPnLToday += _pnl
                            tbrTrades += 1
                            tbrWins += 1
                            tbrWinSum += _pnl
                            if _sbull
                                tbrBullPnL += _pnl
                                tbrBullT += 1
                                tbrBullW += 1
                            else
                                tbrBearPnL += _pnl
                                tbrBearT += 1
                                tbrBearW += 1
                        else if _stype == "evr"
                            evrPnL += _pnl
                            evrPnLToday += _pnl
                            evrTrades += 1
                            evrWins += 1
                            evrWinSum += _pnl
                            if _sbull
                                evrBullPnL += _pnl
                                evrBullT += 1
                                evrBullW += 1
                            else
                                evrBearPnL += _pnl
                                evrBearT += 1
                                evrBearW += 1
                    if array.size(tradeLabel) > _ti
                        _origLbl = array.get(tradeLabel, _ti)
                        if not na(_origLbl)
                            _origTxt = label.get_text(_origLbl)
                            label.set_text(_origLbl, _origTxt + "\n━━━━━━━━━━━━━━━━\n✅ #" + str.tostring(_tNum) + " TP Hit — +$" + str.tostring(_pnl, "#.##") + " Profit")


// STATS PANEL (top-right table)
f_drawPanel() =>
    // ── Core stats ──
    _totalPnL    = 0.0
    _avgDollarRisk = (uhvDollarRisk + tbrDollarRisk + evrDollarRisk) / 3.0
    _avgTp1Mult   = (uhvTp1Mult + tbrTp1Mult + evrTp1Mult) / 3.0
    // Compute actual avg win and avg loss from closed trade history
    _totalWinAmt = 0.0
    _totalLossAmt = 0.0
    _winTradesCount = 0
    _lossTradesCount = 0
    int _pnlSz = math.min(array.size(tradePnLArr), array.size(tradeCloseTS))
    if _pnlSz > 0
        for _pi = 0 to _pnlSz - 1
            if array.get(tradeCloseTS, _pi) >= statsResetDate
                _p = array.get(tradePnLArr, _pi)
                _totalPnL += _p
                if _p > 0
                    _totalWinAmt += _p
                    _winTradesCount += 1
                else if _p < 0
                    _totalLossAmt += math.abs(_p)
                    _lossTradesCount += 1
    int _filteredTrades = _winTradesCount + _lossTradesCount
    _acc         = _filteredTrades > 0 ? float(_winTradesCount) / _filteredTrades : 0.0
    _accPct      = math.round(_acc * 100)
    _avgPnL      = _filteredTrades > 0 ? _totalPnL / _filteredTrades : 0.0
    _winAmt  = _winTradesCount  > 0 ? _totalWinAmt  / _winTradesCount  : _avgDollarRisk * _avgTp1Mult
    _lossAmt = _lossTradesCount > 0 ? _totalLossAmt / _lossTradesCount : _avgDollarRisk
    _ev      = _acc * _winAmt - (1.0 - _acc) * _lossAmt

    // ── Doubling / target time ──
    _tradesToDouble = _avgPnL > 0 ? math.ceil(initialMoney / _avgPnL) : 0
    _avgMinsPerSignal = 30.0
    if array.size(signalBarTimes) > 1
        _totalGap = 0
        if array.size(signalBarTimes) >= 2
            for _si = 1 to array.size(signalBarTimes) - 1
                _totalGap += array.get(signalBarTimes, _si) - array.get(signalBarTimes, _si - 1)
        _avgMinsPerSignal := (_totalGap / (array.size(signalBarTimes) - 1)) * tfMinutes
    _hoursToDouble = _tradesToDouble > 0 and _avgMinsPerSignal > 0 ? math.round(_tradesToDouble * _avgMinsPerSignal / 60.0 * 10) / 10 : 0

    // ── Signals per day (avg across all days) ──
    _allDaySignals  = totalSignalsAllDays + signalsToday
    _avgSigPerDay   = totalDaysSeen > 0 ? math.round(_allDaySignals / totalDaysSeen) : signalsToday

    // ── Trades to reach $100 from initial money ──
    _tradesToTarget = _avgPnL > 0 ? math.ceil((100.0 - initialMoney) / _avgPnL) : 0

    // ── Washout ──
    // Use actual observed avg loss (not the input setting) — avoids showing 0 when fixed-lot mode is on
    float _washoutLoss = _lossAmt > 0 ? _lossAmt : (_avgDollarRisk > 0 ? _avgDollarRisk : 1.0)
    _washout = math.floor(initialMoney / _washoutLoss)

    // ── Last hour P&L ──
    _hourPnL = 0.0
    if array.size(tradeCloseTime) > 0
        for _hi = 0 to array.size(tradeCloseTime) - 1
            if bar_index - array.get(tradeCloseTime, _hi) <= barsPerHour
                _hourPnL += array.get(tradePnLArr, _hi)

    // ── Avg time to next signal ──
    _minsToNextSignal = math.round(_avgMinsPerSignal)

    // ── Profit at 0.02 lots (same dollar risk, double lots) ──
    _doubleLotPnL = _totalPnL * 2.0

    // ── "Started with $X today morning" P&L ──
    _todayStartPnL = initialMoney + pnlToday

    // ── Session detection (UTC hour) ──
    _utcHour = hour(time, "UTC")
    _session = _utcHour >= 22 or _utcHour < 7  ? "🌏 Sydney Session" :
               _utcHour >= 0  and _utcHour < 9  ? "🌸 Tokyo Session"  :
               _utcHour >= 8  and _utcHour < 13 ? "🏦 London Session" :
               _utcHour >= 13 and _utcHour < 22 ? "🗽 New York Session" : "📊 Market"
    // overlap labels
    _session := (_utcHour >= 8 and _utcHour < 9)   ? "🏦🌸 London/Tokyo Overlap"   : _session
    _session := (_utcHour >= 13 and _utcHour < 17)  ? "🗽🏦 New York/London Overlap" : _session

    // ── Worst streak risk ──
    _pLoss        = 1.0 - _acc
    _streakAt5pct = _pLoss > 0 and _pLoss < 1 ? math.ceil(math.log(0.05) / math.log(_pLoss)) : 99
    _streakRisk   = _streakAt5pct * _lossAmt
    _pctCapital   = initialMoney > 0 ? _streakRisk / initialMoney * 100 : 0

    // ── Pre-panel: today completed wins/trades ──
    int _winsToday            = 0
    int _tradesCompletedToday = 0
    int _todayStartMs         = timenow - (timenow % 86400000)
    if array.size(tradeCloseTS) > 0
        for _ict = 0 to array.size(tradeCloseTS) - 1
            if array.get(tradeCloseTS, _ict) >= _todayStartMs and array.get(tradeCloseTS, _ict) >= statsResetDate
                _tradesCompletedToday += 1
                if array.get(tradePnLArr, _ict) > 0
                    _winsToday += 1

    // ── Pre-panel: trades closed in last hour ──
    int _hourTrades = 0
    if array.size(tradeCloseTime) > 0
        for _iht = 0 to array.size(tradeCloseTime) - 1
            if bar_index - array.get(tradeCloseTime, _iht) <= barsPerHour
                _hourTrades += 1

    // ── Pre-panel: current win/loss streak ──
    int  _currentStreak = 0
    int _streakSz = math.min(array.size(tradePnLArr), array.size(tradeCloseTS))
    if _streakSz > 0
        // find last filtered trade
        int _lastIdx = -1
        for _ics0 = _streakSz - 1 to 0
            if array.get(tradeCloseTS, _ics0) >= statsResetDate
                _lastIdx := _ics0
                break
        if _lastIdx >= 0
            bool _lastIsWin = array.get(tradePnLArr, _lastIdx) > 0
            for _ics = _lastIdx to 0
                if array.get(tradeCloseTS, _ics) < statsResetDate
                    break
                float _cp = array.get(tradePnLArr, _ics)
                if (_lastIsWin and _cp > 0) or (not _lastIsWin and _cp <= 0)
                    _currentStreak += 1
                else
                    break
            _currentStreak := _lastIsWin ? _currentStreak : -_currentStreak

    // ── Pre-panel: yesterday P&L (moved here for early use) ──
    int   _msPerDay   = 86400000
    int   _ydayStart  = _todayStartMs - _msPerDay
    int   _ydayEnd    = _todayStartMs
    float _pnlYday    = 0.0
    float _pnlYdayNY  = 0.0
    if array.size(tradeCloseTS) > 0
        for _iyd = 0 to array.size(tradeCloseTS) - 1
            int _ts = array.get(tradeCloseTS, _iyd)
            if _ts >= _ydayStart and _ts < _ydayEnd and _ts >= statsResetDate
                float _yp = array.get(tradePnLArr, _iyd)
                _pnlYday += _yp
                if hour(_ts, "UTC") >= 13 and hour(_ts, "UTC") < 22
                    _pnlYdayNY += _yp

    // ── Per-strategy avg win and avg loss amounts ──
    float _uhvWinSum = 0.0
    int   _uhvWinN2  = 0
    float _uhvLossSum = 0.0
    int   _uhvLossN2 = 0
    float _tbrWinSum = 0.0
    int   _tbrWinN2  = 0
    float _tbrLossSum = 0.0
    int   _tbrLossN2 = 0
    float _evrWinSum = 0.0
    int   _evrWinN2  = 0
    float _evrLossSum = 0.0
    int   _evrLossN2 = 0
    // ── Single source of truth: all per-strategy stats derived from close-time arrays ──
    // tradePnLArr and tradePnLType are always pushed together at trade close, so they
    // are always aligned and can never drift from each other.
    // We derive P&L totals, trade counts, win counts, AND avg win/loss from this same loop.
    // The running vars (uhvPnL, uhvTrades, uhvWins etc.) are kept for signal labels only.
    float _uhvPnLCalc    = 0.0
    float _tbrPnLCalc    = 0.0
    float _evrPnLCalc    = 0.0
    int   _uhvTradesCalc = 0
    int   _tbrTradesCalc = 0
    int   _evrTradesCalc = 0
    int   _uhvWinsCalc   = 0
    int   _tbrWinsCalc   = 0
    int   _evrWinsCalc   = 0
    int _stratSize2 = math.min(array.size(tradePnLType), math.min(array.size(tradePnLArr), array.size(tradeCloseTS)))
    if _stratSize2 > 0
        for _ist = 0 to _stratSize2 - 1
            if array.get(tradeCloseTS, _ist) < statsResetDate
                continue
            float _sp  = array.get(tradePnLArr,  _ist)
            string _st = array.get(tradePnLType, _ist)
            if _st == "uhv"
                _uhvPnLCalc    += _sp
                _uhvTradesCalc += 1
                if _sp > 0
                    _uhvWinSum  += _sp
                    _uhvWinN2   += 1
                    _uhvWinsCalc += 1
                else
                    _uhvLossSum += math.abs(_sp)
                    _uhvLossN2  += 1
            else if _st == "tbr"
                _tbrPnLCalc    += _sp
                _tbrTradesCalc += 1
                if _sp > 0
                    _tbrWinSum  += _sp
                    _tbrWinN2   += 1
                    _tbrWinsCalc += 1
                else
                    _tbrLossSum += math.abs(_sp)
                    _tbrLossN2  += 1
            else
                _evrPnLCalc    += _sp
                _evrTradesCalc += 1
                if _sp > 0
                    _evrWinSum  += _sp
                    _evrWinN2   += 1
                    _evrWinsCalc += 1
                else
                    _evrLossSum += math.abs(_sp)
                    _evrLossN2  += 1
    float _uhvAvgWin  = _uhvWinN2  > 0 ? _uhvWinSum  / _uhvWinN2  : 0.0
    float _uhvAvgLoss = _uhvLossN2 > 0 ? _uhvLossSum / _uhvLossN2 : 0.0
    float _tbrAvgWin  = _tbrWinN2  > 0 ? _tbrWinSum  / _tbrWinN2  : 0.0
    float _tbrAvgLoss = _tbrLossN2 > 0 ? _tbrLossSum / _tbrLossN2 : 0.0
    float _evrAvgWin  = _evrWinN2  > 0 ? _evrWinSum  / _evrWinN2  : 0.0
    float _evrAvgLoss = _evrLossN2 > 0 ? _evrLossSum / _evrLossN2 : 0.0

    // ── Signals fired in last hour (for next-hour projection) ──
    int _sigLastHour = 0
    if array.size(signalBarTimes) > 0
        for _isb = 0 to array.size(signalBarTimes) - 1
            if bar_index - array.get(signalBarTimes, _isb) <= barsPerHour
                _sigLastHour += 1
    // Projected next-hour P&L uses last-hour signal rate if available, else avg
    int   _projNextHrSigs = _sigLastHour > 0 ? _sigLastHour : math.max(1, math.round(60.0 / math.max(_avgMinsPerSignal, 1)))
    float _projNextHrPnL  = math.round(_projNextHrSigs * _avgPnL * 100) / 100

    // ── Build panel (18 rows) ──
    table statsPanel = table.new(position.top_right, 1, 18,
         bgcolor = color.new(color.black, 15),
         border_color = color.new(color.gray, 70),
         border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)

    // ── Shared colors ──
    color _bgDark    = color.new(color.black,   25)
    color _bgMid     = color.new(color.navy,    55)
    color _bgDeep    = color.new(color.navy,    40)
    color _hdrBg     = color.new(color.gray,    10)
    color _txtWhite  = color.white
    color _txtDim    = color.new(color.silver,  10)
    color _txtGreen  = color.new(color.lime,    10)
    color _txtRed    = color.new(color.red,      0)
    color _txtOrange = color.new(color.orange,   0)
    color _txtAqua   = color.new(color.aqua,    10)
    color _txtYellow = color.new(color.yellow,  10)

    // ── Pre-compute display vars ──
    float  _ydayGrowthPct = initialMoney > 0 ? math.round(_pnlYday / initialMoney * 100 * 10) / 10 : 0.0
    int    _uhvAcc  = _uhvTradesCalc > 0 ? math.round(_uhvWinsCalc / _uhvTradesCalc * 100) : 0
    int    _tbrAcc  = _tbrTradesCalc > 0 ? math.round(_tbrWinsCalc / _tbrTradesCalc * 100) : 0
    int    _evrAcc  = _evrTradesCalc > 0 ? math.round(_evrWinsCalc / _evrTradesCalc * 100) : 0
    string _best    = _uhvPnLCalc >= _tbrPnLCalc and _uhvPnLCalc >= _evrPnLCalc ? "UHV" : _tbrPnLCalc >= _uhvPnLCalc and _tbrPnLCalc >= _evrPnLCalc ? "2BR" : "EVR"
    string _evBadge = _ev >= 0.01 ? "Positive EV" : _ev <= -0.01 ? "Negative EV" : "Breakeven"
    string _toDoubleTime = _hoursToDouble >= 24 ? str.tostring(math.round(_hoursToDouble / 24.0 * 10) / 10) + " days" : str.tostring(_hoursToDouble) + " hrs"
    // Next-hour projection (priority: last hour → today's pace → all-time avg)
    float  _trueNextHrSigs = _avgMinsPerSignal > 0 ? 60.0 / _avgMinsPerSignal : 0.0
    string _basisLbl = "all-time avg"
    if _sigLastHour > 0
        _trueNextHrSigs := float(_sigLastHour)
        _basisLbl := "last hour pace"
    else if signalsToday >= 2
        int _stSz = array.size(signalBarTimes)
        int _firstTodayBar = array.get(signalBarTimes, _stSz - signalsToday)
        float _hrsElapsed = (bar_index - _firstTodayBar) * tfMinutes / 60.0
        if _hrsElapsed > 0
            _trueNextHrSigs := math.round(signalsToday / _hrsElapsed * 10) / 10
            _basisLbl := "today's pace"
    float _projNextHrPnLEV = math.round(_trueNextHrSigs * _ev * 100) / 100
    // ROW 0 — HEADER
    table.cell(statsPanel, 0, 0,
         "TURTLE TRADER DESK  |  " + syminfo.ticker + "  |  " + str.tostring(tfMinutes) + "m  |  " + _session,
         text_color = color.white, text_size = size.small, bgcolor = color.new(#0a7a6a, 5))

    // ROW 1 — SIGNAL STATUS (largest text, highest priority)
    string _sigStatus = inRetracement and fvgReached ? "POI REACHED — WATCHING FOR ENTRY" :
         inRetracement ? "SETUP IN PROGRESS — AWAITING POI" :
         brkTriggered  ? "SIGNAL FIRED — MONITORING" : "STANDING BY"
    color _sigBg = inRetracement and fvgReached ? color.new(color.green,  30) :
         inRetracement ? color.new(color.blue,   40) :
         brkTriggered  ? color.new(color.orange, 30) : color.new(color.gray, 50)
    color _sigFg = inRetracement and fvgReached ? color.new(color.lime,   0) :
         inRetracement ? color.new(color.aqua,   0) :
         brkTriggered  ? color.new(color.orange, 0) : color.new(color.silver, 10)
    table.cell(statsPanel, 0, 1, _sigStatus,
         text_color = _sigFg, text_size = size.normal, bgcolor = _sigBg)

    // ROW 2 — TREND + STRENGTH + NEXT SIGNAL ETA
    string _tDir       = lastIsBull ? "BULLISH" : "BEARISH"
    color  _tColor     = lastIsBull ? _txtGreen : _txtRed
    string _tBar       = trendStrength >= 80 ? "||||" : trendStrength >= 60 ? "|||." : trendStrength >= 40 ? "||.." : trendStrength >= 20 ? "|..." : "...."
    string _tLbl       = trendStrength >= 70 ? "Strong" : trendStrength >= 40 ? "Moderate" : "Weak"
    string _nextSigEta = _minsToNextSignal >= 60 ? str.tostring(math.round(_minsToNextSignal / 60.0 * 10) / 10) + " hrs" : str.tostring(_minsToNextSignal) + " min"
    table.cell(statsPanel, 0, 2,
         _tDir + "  |  " + _tBar + "  " + _tLbl + " (" + str.tostring(trendStrength) + ")" +
         "  |  Next signal: ~" + _nextSigEta,
         text_color = _tColor, text_size = size.small, bgcolor = _bgDark)

    // ROW 3 — TODAY DIVIDER
    table.cell(statsPanel, 0, 3, "TODAY",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 4 — TODAY P&L (large font — most visible number)
    float  _todayPnLDisp = math.round((uhvPnLToday + tbrPnLToday + evrPnLToday) * 100) / 100
    float  _todayBalDisp = initialMoney + _todayPnLDisp
    string _todaySign    = _todayPnLDisp >= 0.01 ? "+" : ""
    color  _todayBg      = _todayPnLDisp >= 0.01 ? color.new(color.green, 55) : _todayPnLDisp <= -0.01 ? color.new(color.red, 55) : color.new(color.gray, 55)
    color  _todayFg      = _todayPnLDisp >= 0.01 ? _txtGreen : _todayPnLDisp <= -0.01 ? _txtRed : _txtDim
    table.cell(statsPanel, 0, 4,
         _todaySign + "$" + str.tostring(_todayPnLDisp, "#.##") + "  |  Balance: $" + str.tostring(_todayBalDisp, "#.##"),
         text_color = _todayFg, text_size = size.normal, bgcolor = _todayBg)

    // ROW 5 — STRATEGY SUB-TOTALS (tiny, secondary detail under today P&L)
    table.cell(statsPanel, 0, 5,
         "UHV " + (uhvPnLToday >= 0 ? "+" : "") + "$" + str.tostring(math.round(uhvPnLToday * 100) / 100, "#.##") +
         "  |  2BR " + (tbrPnLToday >= 0 ? "+" : "") + "$" + str.tostring(math.round(tbrPnLToday * 100) / 100, "#.##") +
         "  |  EVR " + (evrPnLToday >= 0 ? "+" : "") + "$" + str.tostring(math.round(evrPnLToday * 100) / 100, "#.##"),
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // ROW 6 — TRADE COUNT + STREAK
    string _streakTxt2 = _currentStreak > 1 ? str.tostring(_currentStreak) + " wins in a row" : _currentStreak == 1 ? "Last: win" : _currentStreak < -1 ? str.tostring(math.abs(_currentStreak)) + " losses in a row" : "Last: loss"
    table.cell(statsPanel, 0, 6,
         str.tostring(signalsToday) + " signals  |  " + str.tostring(_tradesCompletedToday) + " closed  |  " + str.tostring(_winsToday) + " won" +
         (_tradesCompletedToday > 0 ? "  (" + str.tostring(math.round(_winsToday / math.max(_tradesCompletedToday, 1) * 100)) + "%)" : "") +
         "  |  " + _streakTxt2,
         text_color = _currentStreak >= 0 ? _txtGreen : _txtOrange, text_size = size.small, bgcolor = _bgDark)

    // ROW 7 — LAST HOUR RESULT + NEXT HOUR EV PROJECTION
    string _hourLbl2  = _hourPnL >= 0.01 ? "+$" + str.tostring(_hourPnL, "#.##") : _hourPnL <= -0.01 ? "-$" + str.tostring(math.abs(_hourPnL), "#.##") : "—"
    string _projSign2 = _projNextHrPnLEV >= 0 ? "+" : ""
    table.cell(statsPanel, 0, 7,
         "Last hr: " + _hourLbl2 + "  (" + str.tostring(_hourTrades) + " trades)  |  Next hr EV: " + _projSign2 + "$" + str.tostring(math.abs(_projNextHrPnLEV), "#.##") + "  (" + _basisLbl + ")\nEV: $" + str.tostring(_ev, "#.##") + "/trade  |  " + str.tostring(_avgSigPerDay) + " signals/day avg",
         text_color = _txtAqua, text_size = size.small, bgcolor = _bgDark)

    // ROW 8 — STRATEGIES DIVIDER
    table.cell(statsPanel, 0, 8, "STRATEGIES",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 9 — UHV BREAKOUT
    string _uhvWLStr = _uhvAvgWin > 0 or _uhvAvgLoss > 0 ? "  avg +" + str.tostring(_uhvAvgWin, "#.##") + " / -" + str.tostring(_uhvAvgLoss, "#.##") : ""
    table.cell(statsPanel, 0, 9,
         "UHV  W/L: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " (" + str.tostring(_uhvAcc) + "%)" +
         "  All-time: " + (_uhvPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_uhvPnLCalc, "#.##") +
         "  Today: " + (uhvPnLToday >= 0 ? "+" : "") + "$" + str.tostring(uhvPnLToday, "#.##") +
         _uhvWLStr + (_best == "UHV" ? "  [BEST]" : ""),
         text_color = _uhvPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 10 — TWO BAR REVERSAL
    string _tbrWLStr = _tbrAvgWin > 0 or _tbrAvgLoss > 0 ? "  avg +" + str.tostring(_tbrAvgWin, "#.##") + " / -" + str.tostring(_tbrAvgLoss, "#.##") : ""
    table.cell(statsPanel, 0, 10,
         "2BR  W/L: " + str.tostring(_tbrWinsCalc) + "/" + str.tostring(_tbrTradesCalc) + " (" + str.tostring(_tbrAcc) + "%)" +
         "  All-time: " + (_tbrPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_tbrPnLCalc, "#.##") +
         "  Today: " + (tbrPnLToday >= 0 ? "+" : "") + "$" + str.tostring(tbrPnLToday, "#.##") +
         _tbrWLStr + (_best == "2BR" ? "  [BEST]" : ""),
         text_color = _tbrPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 11 — EFFORT VS RESULT
    string _evrWLStr = _evrAvgWin > 0 or _evrAvgLoss > 0 ? "  avg +" + str.tostring(_evrAvgWin, "#.##") + " / -" + str.tostring(_evrAvgLoss, "#.##") : ""
    table.cell(statsPanel, 0, 11,
         "EVR  W/L: " + str.tostring(_evrWinsCalc) + "/" + str.tostring(_evrTradesCalc) + " (" + str.tostring(_evrAcc) + "%)" +
         "  All-time: " + (_evrPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_evrPnLCalc, "#.##") +
         "  Today: " + (evrPnLToday >= 0 ? "+" : "") + "$" + str.tostring(evrPnLToday, "#.##") +
         _evrWLStr + (_best == "EVR" ? "  [BEST]" : ""),
         text_color = _evrPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 12 — ALL-TIME DIVIDER
    table.cell(statsPanel, 0, 12, "ALL-TIME",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 13 — ALL-TIME P&L + ACCURACY + EV
    table.cell(statsPanel, 0, 13,
         "P&L: " + (_totalPnL >= 0 ? "+" : "") + "$" + str.tostring(_totalPnL, "#.##") +
         "  |  " + str.tostring(winCount) + "/" + str.tostring(completedTrades) + " won (" + str.tostring(_accPct) + "%)" +
         "  |  " + _evBadge + ": $" + str.tostring(_ev, "#.##") + "/trade" +
         "\navg win: +$" + str.tostring(_winAmt, "#.##") + "  |  avg loss: -$" + str.tostring(_lossAmt, "#.##"),
         text_color = _ev >= 0 ? _txtGreen : _txtRed, text_size = size.small, bgcolor = _bgDark)

    // ROW 14 — MILESTONES + RISK + YESTERDAY (condensed, tiny)
    table.cell(statsPanel, 0, 14,
         "To double: " + (_avgPnL > 0 ? str.tostring(_tradesToDouble) + " trades (~" + _toDoubleTime + ")" : "—") +
         "  |  Washout: " + str.tostring(_washout) + " losses" +
         "  |  Yesterday: " + (_pnlYday >= 0 ? "+" : "") + "$" + str.tostring(math.round(_pnlYday * 100) / 100, "#.##") + "  (" + (_ydayGrowthPct >= 0 ? "+" : "") + str.tostring(_ydayGrowthPct) + "%)",
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // Recommendations / optimize calculations derived from trade statistics
    // Compute avg trendStrength for winners and losers across all trades
    _winTSsum    = 0.0
    _winTScount  = 0
    _loseTSsum   = 0.0
    _loseTScount = 0
    _uhvWinTS  = 0.0
    _uhvWinN   = 0
    _uhvLoseTS = 0.0
    _uhvLoseN  = 0
    _tbrWinTS  = 0.0
    _tbrWinN   = 0
    _tbrLoseTS = 0.0
    _tbrLoseN  = 0
    _evrWinTS  = 0.0
    _evrWinN   = 0
    _evrLoseTS = 0.0
    _evrLoseN  = 0
    _tsSize = math.min(array.size(tradeTrendStr), math.min(array.size(tradeWon), array.size(tradeType)))
    if _tsSize > 0
        for _ri = 0 to _tsSize - 1
            _rts   = array.get(tradeTrendStr, _ri)
            _rwon  = array.get(tradeWon,      _ri)
            _rtype = array.get(tradeType,     _ri)
            if _rwon
                _winTSsum   += _rts
                _winTScount += 1
                if _rtype == "uhv"
                    _uhvWinTS += _rts
                    _uhvWinN  += 1
                else if _rtype == "tbr"
                    _tbrWinTS += _rts
                    _tbrWinN  += 1
                else
                    _evrWinTS += _rts
                    _evrWinN  += 1
            else
                _loseTSsum   += _rts
                _loseTScount += 1
                if _rtype == "uhv"
                    _uhvLoseTS += _rts
                    _uhvLoseN  += 1
                else if _rtype == "tbr"
                    _tbrLoseTS += _rts
                    _tbrLoseN  += 1
                else
                    _evrLoseTS += _rts
                    _evrLoseN  += 1
    _avgWinTS  = _winTScount  > 0 ? _winTSsum  / _winTScount  : na
    _avgLoseTS = _loseTScount > 0 ? _loseTSsum / _loseTScount : na

    // ── Estimate dollar gain from unlocking blocked signals (per day) ──
    _avgPnLPerTrade = completedTrades > 0 ? _totalPnL / completedTrades : 0.0
    _daysBase = math.max(totalDaysSeen, 1)
    // Only use estimate when avg is positive (net profitable)
    _canEstimate = _avgPnLPerTrade > 0 and completedTrades >= 5

    // RECOMMENDATIONS ENGINE — grouped by priority
    _overallWinRate = completedTrades > 0 ? winCount / completedTrades : 0.0

    // ── Realized R:R from actual dollar win vs dollar loss amounts ──
    // Use observed avg win and avg loss dollars — works correctly for all SL types
    float _avgRealizedRR = (_lossAmt > 0 and _winAmt > 0) ? _winAmt / _lossAmt : _avgTp1Mult
    // Break-even win rate for the actual R:R being used
    float _beWinRate = _avgRealizedRR > 0 ? 1.0 / (1.0 + _avgRealizedRR) : 0.5

    // ── Bull vs Bear win rates ──
    int   _bullWins   = 0
    int   _bullTrades = 0
    int   _bearWins   = 0
    int   _bearTrades = 0
    int   _bbSize = math.min(array.size(tradeBull), math.min(array.size(tradeWon), array.size(tradePnLArr)))
    if _bbSize > 0
        for _bi = 0 to _bbSize - 1
            bool _bBull = array.get(tradeBull, _bi)
            bool _bWon  = array.get(tradeWon,  _bi)
            if _bBull
                _bullTrades += 1
                if _bWon
                    _bullWins += 1
            else
                _bearTrades += 1
                if _bWon
                    _bearWins += 1
    float _bullWinRate = _bullTrades >= 3 ? _bullWins / _bullTrades : na
    float _bearWinRate = _bearTrades >= 3 ? _bearWins / _bearTrades : na

    // ── Session win rates (UTC hour buckets) ──
    // London: 8-13, NY: 13-22, Asia: 22-8
    int   _lonWins   = 0
    int   _lonTrades = 0
    int   _nyWins    = 0
    int   _nyTrades  = 0
    int   _asWins    = 0
    int   _asTrades  = 0
    int   _sessSize2 = math.min(array.size(tradeCloseTS), array.size(tradeWon))
    if _sessSize2 > 0
        for _si3 = 0 to _sessSize2 - 1
            int  _sts  = array.get(tradeCloseTS, _si3)
            bool _swon = array.get(tradeWon,     _si3)
            int  _sh   = hour(_sts, "UTC")
            if _sh >= 8 and _sh < 13
                _lonTrades += 1
                if _swon
                    _lonWins += 1
            else if _sh >= 13 and _sh < 22
                _nyTrades += 1
                if _swon
                    _nyWins += 1
            else
                _asTrades += 1
                if _swon
                    _asWins += 1
    float _lonWR = _lonTrades >= 4 ? _lonWins / _lonTrades : na
    float _nyWR  = _nyTrades  >= 4 ? _nyWins  / _nyTrades  : na
    float _asWR  = _asTrades  >= 4 ? _asWins  / _asTrades  : na

    // ── Recency analysis: last 10 trades vs all-time avg ──
    float _recentPnL  = 0.0
    int   _recentN    = 0
    int   _recentWins = 0
    int   _recentSize = math.min(array.size(tradePnLArr), 10)
    int   _totalSize2 = array.size(tradePnLArr)
    if _recentSize > 0
        for _rci = _totalSize2 - _recentSize to _totalSize2 - 1
            float _rcp = array.get(tradePnLArr, _rci)
            _recentPnL  += _rcp
            _recentN    += 1
            if _rcp > 0
                _recentWins += 1
    float _recentAvg = _recentN > 0 ? _recentPnL / _recentN : na
    float _recentWR  = _recentN > 0 ? _recentWins / _recentN : na

    // ── Per-strategy EV ──
    float _uhvEV = _uhvTradesCalc >= 5 ? (_uhvWinsCalc / _uhvTradesCalc) * _uhvAvgWin - (1.0 - _uhvWinsCalc / _uhvTradesCalc) * _uhvAvgLoss : na
    float _tbrEV = _tbrTradesCalc >= 5 ? (_tbrWinsCalc / _tbrTradesCalc) * _tbrAvgWin - (1.0 - _tbrWinsCalc / _tbrTradesCalc) * _tbrAvgLoss : na
    float _evrEV = _evrTradesCalc >= 5 ? (_evrWinsCalc / _evrTradesCalc) * _evrAvgWin - (1.0 - _evrWinsCalc / _evrTradesCalc) * _evrAvgLoss : na

    // ── SL hit analysis ──
    float _winSlDistSum  = 0.0
    int   _winSlDistN    = 0
    float _loseSlDistSum = 0.0
    int   _loseSlDistN   = 0
    int   _quickSlCount  = 0
    int   _totalSlHits   = 0
    float _slBarsSum     = 0.0
    int   _slBarsN       = 0
    int   _slSize = math.min(array.size(tradeSlDist), math.min(array.size(tradeWon), array.size(tradeBull)))
    if _slSize > 0
        for _si2 = 0 to _slSize - 1
            float _sd  = array.get(tradeSlDist, _si2)
            bool  _sw  = array.get(tradeWon,    _si2)
            int   _sb  = array.size(tradeSlBars) > _si2 ? array.get(tradeSlBars, _si2) : -1
            if _sw
                _winSlDistSum += _sd
                _winSlDistN   += 1
            else
                _loseSlDistSum += _sd
                _loseSlDistN   += 1
                _totalSlHits   += 1
                if _sb >= 0
                    if _sb <= 2
                        _quickSlCount += 1
                    _slBarsSum += _sb
                    _slBarsN   += 1
    float _avgWinSlDist  = _winSlDistN  > 0 ? _winSlDistSum  / _winSlDistN  : na
    float _avgLoseSlDist = _loseSlDistN > 0 ? _loseSlDistSum / _loseSlDistN : na
    float _avgSlBars     = _slBarsN     > 0 ? _slBarsSum     / _slBarsN     : na
    float _slHitRate     = completedTrades > 0 ? _totalSlHits / completedTrades : 0.0
    float _quickSlRate   = _totalSlHits > 0 ? _quickSlCount / _totalSlHits : 0.0

    // BUILD RECOMMENDATION STRINGS — ordered by priority
    // 🚨 CRITICAL  ⚠️ WARNING  💡 OPTIMIZE  🔓 UNLOCK  📊 INSIGHT

    // ── 🚨 CRITICAL: Today large loss ──
    string _rCrit1 = na
    if initialMoney > 0 and pnlToday < -(initialMoney * 0.10)
        _rCrit1 := "🚨 Down " + str.tostring(math.round(math.abs(pnlToday) / initialMoney * 100)) + "% today (-$" + str.tostring(math.abs(pnlToday), "#.##") + ")\nconsider stopping for the day to protect your capital"

    // ── 🚨 CRITICAL: Negative EV per strategy ──
    string _rCrit2 = na
    string _rCrit3 = na
    string _rCrit4 = na
    if not na(_uhvEV) and _uhvEV < -0.05
        _rCrit2 := "🚨 UHV Breakout has negative EV: -$" + str.tostring(math.abs(_uhvEV), "#.##") + "/trade avg (" + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won, avg win $" + str.tostring(_uhvAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_uhvAvgLoss, "#.##") + ")\ndisable or adjust settings"
    if not na(_tbrEV) and _tbrEV < -0.05
        _rCrit3 := "🚨 Two Bar Reversal has negative EV: -$" + str.tostring(math.abs(_tbrEV), "#.##") + "/trade avg (" + str.tostring(_tbrWinsCalc) + "/" + str.tostring(_tbrTradesCalc) + " won, avg win $" + str.tostring(_tbrAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_tbrAvgLoss, "#.##") + ")\ndisable or adjust settings"
    if not na(_evrEV) and _evrEV < -0.05
        _rCrit4 := "🚨 Effort vs Result has negative EV: -$" + str.tostring(math.abs(_evrEV), "#.##") + "/trade avg (" + str.tostring(_evrWinsCalc) + "/" + str.tostring(_evrTradesCalc) + " won, avg win $" + str.tostring(_evrAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_evrAvgLoss, "#.##") + ")\ndisable or adjust settings"

    // ── ⚠️ WARNING: Strategy win rate < 40% ──
    string _rWarn1 = na
    string _rWarn2 = na
    string _rWarn3 = na
    if _uhvTradesCalc >= 5 and _uhvWinsCalc / _uhvTradesCalc < 0.40 and na(_rCrit2)
        _rWarn1 := "⚠️ UHV Breakout: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won (" + str.tostring(math.round(_uhvWinsCalc / _uhvTradesCalc * 100)) + "%)\nbelow break-even. Try: raise Min Trend Strength, enable Require UHV Sweep, or disable this strategy"
    if _tbrTradesCalc >= 5 and _tbrWinsCalc / _tbrTradesCalc < 0.40 and na(_rCrit3)
        _rWarn2 := "⚠️ Two Bar Reversal: " + str.tostring(_tbrWinsCalc) + "/" + str.tostring(_tbrTradesCalc) + " won (" + str.tostring(math.round(_tbrWinsCalc / _tbrTradesCalc * 100)) + "%)\nbelow break-even. Try: enable Lower Volume filter, tighten Min Trend Strength, or disable this strategy"
    if _evrTradesCalc >= 5 and _evrWinsCalc / _evrTradesCalc < 0.40 and na(_rCrit4)
        _rWarn3 := "⚠️ Effort vs Result: " + str.tostring(_evrWinsCalc) + "/" + str.tostring(_evrTradesCalc) + " won (" + str.tostring(math.round(_evrWinsCalc / _evrTradesCalc * 100)) + "%)\nbelow break-even. Try: enable Higher Volume filter, or disable this strategy"

    // ── ⚠️ WARNING: SL hit rate too high ──
    string _rWarn4 = na
    if _totalSlHits >= 5 and _slHitRate > 0.60 and completedTrades >= 8
        _rWarn4 := "⚠️ " + str.tostring(math.round(_slHitRate * 100)) + "% of trades are hitting SL (" + str.tostring(_totalSlHits) + "/" + str.tostring(completedTrades) + ")\nentries may be too early. Try: increase SL Buffer, switch to ATR stop, or raise Min Trend Strength"

    // ── ⚠️ WARNING: SL clipped in noise (< 2 bars) ──
    string _rWarn5 = na
    if _totalSlHits >= 4 and _quickSlRate > 0.5
        _rWarn5 := "⚠️ " + str.tostring(_quickSlCount) + "/" + str.tostring(_totalSlHits) + " SL hits happen within 2 bars\nSL is inside the noise zone. Fix: open each strategy's settings → 'How much extra room past the structure?' and increase by $0.20–$0.50, or switch to ATR stop"

    // ── ⚠️ WARNING: Declining performance ──
    string _rWarn6 = na
    if not na(_recentAvg) and not na(_avgPnL) and completedTrades >= 15 and _recentN >= 5
        float _declinePct = _avgPnL > 0 ? (_avgPnL - _recentAvg) / _avgPnL * 100 : 0.0
        if _declinePct > 40 and _recentAvg < _avgPnL * 0.6
            _rWarn6 := "⚠️ Performance declining: last " + str.tostring(_recentN) + " trades avg $" + str.tostring(_recentAvg, "#.##") + " vs all-time avg $" + str.tostring(_avgPnL, "#.##") + "\nmarket conditions may have changed. Review recent losses for a common pattern"

    // ── 💡 OPTIMIZE: Win rate heavily biased to one direction ──
    string _rOpt1 = na
    if not na(_bullWinRate) and not na(_bearWinRate) and completedTrades >= 10
        float _dirGap = math.abs(_bullWinRate - _bearWinRate)
        if _dirGap > 0.25
            string _strongDir = _bullWinRate > _bearWinRate ? "Bull (📈)" : "Bear (📉)"
            string _weakDir   = _bullWinRate > _bearWinRate ? "Bear" : "Bull"
            int    _strongPct = _bullWinRate > _bearWinRate ? math.round(_bullWinRate * 100) : math.round(_bearWinRate * 100)
            int    _weakPct   = _bullWinRate > _bearWinRate ? math.round(_bearWinRate * 100) : math.round(_bullWinRate * 100)
            _rOpt1 := "💡 " + _strongDir + " trades win " + str.tostring(_strongPct) + "% vs " + _weakDir + " " + str.tostring(_weakPct) + "%\n" + _weakDir + " setups are dragging down results. Consider only taking " + _strongDir + " signals when the session aligns"

    // ── 💡 OPTIMIZE: Session win rate skew ──
    string _rOpt2 = na
    if not na(_lonWR) and not na(_nyWR)
        float _sessGap = math.abs(_lonWR - _nyWR)
        if _sessGap > 0.25
            string _bestSess  = _lonWR > _nyWR ? "🏦 London (" + str.tostring(math.round(_lonWR * 100)) + "%, " + str.tostring(_lonTrades) + " trades)" : "🗽 NY (" + str.tostring(math.round(_nyWR * 100)) + "%, " + str.tostring(_nyTrades) + " trades)"
            string _worstSess = _lonWR > _nyWR ? "NY (" + str.tostring(math.round(_nyWR * 100)) + "%)" : "London (" + str.tostring(math.round(_lonWR * 100)) + "%)"
            _rOpt2 := "💡 Session gap: " + _bestSess + " wins more than " + _worstSess + "\nyou could focus trading hours on the better session"
    if na(_rOpt2) and not na(_asWR) and not na(_nyWR) and math.abs(_asWR - _nyWR) > 0.25
        string _bestSess2  = _asWR > _nyWR ? "🌏 Asia (" + str.tostring(math.round(_asWR * 100)) + "%)" : "🗽 NY (" + str.tostring(math.round(_nyWR * 100)) + "%)"
        string _worstSess2 = _asWR > _nyWR ? "NY (" + str.tostring(math.round(_nyWR * 100)) + "%)" : "Asia (" + str.tostring(math.round(_asWR * 100)) + "%)"
        _rOpt2 := "💡 Session gap: " + _bestSess2 + " outperforms " + _worstSess2 + "\ntrade more during the better session"

    // ── 💡 OPTIMIZE: Trend strength filter ──
    string _rOpt3 = na
    if not na(_avgWinTS) and not na(_avgLoseTS) and _winTScount >= 3 and _loseTScount >= 3
        float _tsDiff = _avgWinTS - _avgLoseTS
        if _tsDiff > 8
            int _suggestTS = math.round(_avgWinTS * 0.85)
            float _filteredLosses = _loseTScount > 0 ? math.round((_loseTScount * (_suggestTS - _avgLoseTS) / math.max(_avgLoseTS, 1)) * 100) / 100 : 0.0
            _rOpt3 := "💡 Winners fire at avg trend strength " + str.tostring(math.round(_avgWinTS)) + " vs losers at " + str.tostring(math.round(_avgLoseTS)) + "\nraise 'Min Trend Strength' to ~" + str.tostring(_suggestTS) + " to pre-filter weak setups (setting is in the Trend Engine group)"
        else if _tsDiff < -8
            _rOpt3 := "💡 Wins happen at lower trend strength (" + str.tostring(math.round(_avgWinTS)) + ") than losses (" + str.tostring(math.round(_avgLoseTS)) + ")\nlower 'Min Trend Strength' to catch more quality setups"

    // ── 💡 OPTIMIZE: TP R:R vs actual break-even ──
    string _rOpt4 = na
    if completedTrades >= 10
        if _overallWinRate > _beWinRate + 0.10 and _avgTp1Mult < 2.2
            // Winning more than needed — can push TP further
            float _suggestRR = math.round(_avgRealizedRR * 1.3 * 10) / 10
            _rOpt4 := "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% beats break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nraise TP R:R to ~" + str.tostring(_suggestRR) + "R to earn more per winner without affecting your hit rate"
        else if _overallWinRate < _beWinRate - 0.08 and _avgTp1Mult > 1.2
            // Losing more than break-even demands — lower TP to close faster
            float _suggestRR2 = math.round(_avgRealizedRR * 0.75 * 10) / 10
            _rOpt4 := "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% is below break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nlower TP R:R to ~" + str.tostring(_suggestRR2) + "R so TP is easier to reach"

    // ── 💡 OPTIMIZE: SL distance comparison — show in dollars (not ticks, which are meaningless on XAUUSD) ──
    string _rOpt5 = na
    if not na(_avgWinSlDist) and not na(_avgLoseSlDist) and _winSlDistN >= 3 and _loseSlDistN >= 3
        // SL distances are stored as price (e.g. 0.22 = $0.22 on XAUUSD). Convert to dollar impact for clarity.
        float _slDiffDlr = _avgLoseSlDist - _avgWinSlDist
        float _slThresh  = syminfo.mintick * 20  // meaningful difference threshold
        if _slDiffDlr > _slThresh
            // Losers had WIDER SL — given more room and still lost
            _rOpt5 := "💡 Losing trades had wider avg SL ($" + str.tostring(_avgLoseSlDist, "#.####") + ") vs winners ($" + str.tostring(_avgWinSlDist, "#.####") + ")\nextra room didn't help. Reduce SL Buffer or switch to CandleWick SL"
        else if -_slDiffDlr > _slThresh
            // Winners had WIDER SL — losers stopped out too tight
            float _suggestBufDlr = math.round((_avgWinSlDist - _avgLoseSlDist) * 0.5 * 100) / 100
            _rOpt5 := "💡 Winners had wider avg SL ($" + str.tostring(_avgWinSlDist, "#.####") + ") vs losers ($" + str.tostring(_avgLoseSlDist, "#.####") + ")\nSL too tight on losing trades. Try increasing SL Buffer by ~$" + str.tostring(_suggestBufDlr, "#.##") + " in strategy settings"

    // ── 💡 OPTIMIZE: ATR vs current SL method ──
    string _rOpt6 = na
    if (uhvSlType == "UHV" or uhvSlType == "CandleWick" or tbrSlType == "CandleWick" or evrSlType == "UHV" or evrSlType == "CandleWick") and not na(_avgLoseSlDist) and _loseSlDistN >= 4
        float _currentAtr2 = nz(_atr14, 1.0)
        if _avgLoseSlDist < _currentAtr2 * 0.75
            float _suggestedMult2 = math.round(_currentAtr2 * 1.2 / syminfo.mintick * 10) / 10
            _rOpt6 := "💡 Avg SL distance ($" + str.tostring(_avgLoseSlDist, "#.####") + ") is below ATR ($" + str.tostring(_currentAtr2, "#.####") + ")\nyour SL sits inside normal price noise. Try 'ATR' SL method (each strategy → Stop Loss → ATR) which auto-widens in volatile markets"

    // ── 🔓 UNLOCK: Filter settings blocking profitable signals ──
    string _rUnlock1 = na
    string _rUnlock2 = na
    string _rUnlock3 = na
    string _rUnlock4 = na
    string _rUnlock5 = na
    string _rUnlock6 = na
    if requireUHVSweep and blockedBySwept >= 3 and _canEstimate
        float _estGainSweep = math.round(blockedBySwept / _daysBase * _avgPnLPerTrade * 100) / 100
        float _sweepPerDay  = math.round(blockedBySwept / _daysBase * 10) / 10
        _rUnlock1 := "🔓 UHV Sweep filter blocked " + str.tostring(blockedBySwept) + " signals (" + str.tostring(_sweepPerDay) + "/day avg)\nturning OFF 'Must entry candle wick through UHV' could add ~$" + str.tostring(_estGainSweep, "#.##") + "/day"
    if requireUHVLowerVol and blockedUHVVol >= 3 and _canEstimate and na(_rUnlock1)
        float _estGainUHVVol = math.round(blockedUHVVol / _daysBase * _avgPnLPerTrade * 100) / 100
        float _uhvVolPerDay  = math.round(blockedUHVVol / _daysBase * 10) / 10
        _rUnlock1 := "🔓 UHV Volume filter blocked " + str.tostring(blockedUHVVol) + " signals (" + str.tostring(_uhvVolPerDay) + "/day avg)\nturning OFF 'Must breakout candle have lower volume' could add ~$" + str.tostring(_estGainUHVVol, "#.##") + "/day"
    if requireOpposingCandle and blockedByOpposing >= 3 and _canEstimate
        float _estGainOpp = math.round(blockedByOpposing / _daysBase * _avgPnLPerTrade * 100) / 100
        float _oppPerDay  = math.round(blockedByOpposing / _daysBase * 10) / 10
        _rUnlock2 := "🔓 Opposing candle filter blocked " + str.tostring(blockedByOpposing) + " 2BR signals (" + str.tostring(_oppPerDay) + "/day avg)\nturning OFF 'Must there be an opposing candle' (Two Bar Reversal settings) could add ~$" + str.tostring(_estGainOpp, "#.##") + "/day"
    if require2BRLowerVol and blocked2BRVol >= 3 and _canEstimate
        float _estGain2BR = math.round(blocked2BRVol / _daysBase * _avgPnLPerTrade * 100) / 100
        float _tbrPerDay  = math.round(blocked2BRVol / _daysBase * 10) / 10
        _rUnlock3 := "🔓 2BR Volume filter blocked " + str.tostring(blocked2BRVol) + " signals (" + str.tostring(_tbrPerDay) + "/day avg)\nturning OFF 'Must engulfing candle have lower volume' could add ~$" + str.tostring(_estGain2BR, "#.##") + "/day"
    if requireEVRHigherVol and blockedEVRVol >= 3 and _canEstimate
        float _estGainEVR = math.round(blockedEVRVol / _daysBase * _avgPnLPerTrade * 100) / 100
        float _evrPerDay  = math.round(blockedEVRVol / _daysBase * 10) / 10
        _rUnlock4 := "🔓 EVR Volume filter blocked " + str.tostring(blockedEVRVol) + " signals (" + str.tostring(_evrPerDay) + "/day avg)\nturning OFF 'Must sweep candle have higher volume' could add ~$" + str.tostring(_estGainEVR, "#.##") + "/day"
    if requireEVRLowerVol and blockedEVRLowerVol >= 3 and _canEstimate and na(_rUnlock4)
        float _estGainEVRLow = math.round(blockedEVRLowerVol / _daysBase * _avgPnLPerTrade * 100) / 100
        float _evrLowPerDay  = math.round(blockedEVRLowerVol / _daysBase * 10) / 10
        _rUnlock4 := "🔓 EVR Lower Vol filter blocked " + str.tostring(blockedEVRLowerVol) + " signals (" + str.tostring(_evrLowPerDay) + "/day avg)\nturning OFF 'Must sweep candle have lower volume' could add ~$" + str.tostring(_estGainEVRLow, "#.##") + "/day"
    if blockedByCooldown >= 5 and _canEstimate
        float _estGainCD = math.round(blockedByCooldown / _daysBase * _avgPnLPerTrade * 100) / 100
        float _cdPerDay  = math.round(blockedByCooldown / _daysBase * 10) / 10
        _rUnlock5 := "🔓 Cooldown blocked " + str.tostring(blockedByCooldown) + " signals (" + str.tostring(_cdPerDay) + "/day avg)\nlower 'Signal Cooldown (bars)' in General Settings to add ~$" + str.tostring(_estGainCD, "#.##") + "/day"
    if blockedByStrength >= 4 and _canEstimate
        float _estGainTS = math.round(blockedByStrength / _daysBase * _avgPnLPerTrade * 100) / 100
        float _tsPerDay  = math.round(blockedByStrength / _daysBase * 10) / 10
        _rUnlock6 := "🔓 Min Trend Strength blocked " + str.tostring(blockedByStrength) + " signals (" + str.tostring(_tsPerDay) + "/day avg)\nlower 'Min Trend Strength' in General Settings for ~$" + str.tostring(_estGainTS, "#.##") + "/day more (only do this if trend quality stays high)"

    // ─── Assemble final list in priority order ───────────────────
    string[] _recs = array.new_string()
    // Critical first
    if not na(_rCrit1)
        array.push(_recs, _rCrit1)
    if not na(_rCrit2)
        array.push(_recs, _rCrit2)
    if not na(_rCrit3)
        array.push(_recs, _rCrit3)
    if not na(_rCrit4)
        array.push(_recs, _rCrit4)
    // Warnings
    if not na(_rWarn1)
        array.push(_recs, _rWarn1)
    if not na(_rWarn2)
        array.push(_recs, _rWarn2)
    if not na(_rWarn3)
        array.push(_recs, _rWarn3)
    if not na(_rWarn4)
        array.push(_recs, _rWarn4)
    if not na(_rWarn5)
        array.push(_recs, _rWarn5)
    if not na(_rWarn6)
        array.push(_recs, _rWarn6)
    // Optimizations
    if not na(_rOpt1)
        array.push(_recs, _rOpt1)
    if not na(_rOpt2)
        array.push(_recs, _rOpt2)
    if not na(_rOpt3)
        array.push(_recs, _rOpt3)
    if not na(_rOpt4)
        array.push(_recs, _rOpt4)
    if not na(_rOpt5)
        array.push(_recs, _rOpt5)
    if not na(_rOpt6)
        array.push(_recs, _rOpt6)
    // Unlocks
    if not na(_rUnlock1)
        array.push(_recs, _rUnlock1)
    if not na(_rUnlock2)
        array.push(_recs, _rUnlock2)
    if not na(_rUnlock3)
        array.push(_recs, _rUnlock3)
    if not na(_rUnlock4)
        array.push(_recs, _rUnlock4)
    if not na(_rUnlock5)
        array.push(_recs, _rUnlock5)
    if not na(_rUnlock6)
        array.push(_recs, _rUnlock6)
    // ROW 15 — OPTIMIZER & TOOLS DIVIDER
    table.cell(statsPanel, 0, 15, "OPTIMIZER & TOOLS",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 16 — TOP RECOMMENDATIONS (surfacing computed _recs array)
    int    _recsSize = array.size(_recs)
    string _rec1     = _recsSize > 0 ? array.get(_recs, 0) : "No recommendations yet — need more trade data"
    string _rec2     = _recsSize > 1 ? "\n" + array.get(_recs, 1) : ""
    table.cell(statsPanel, 0, 16, _rec1 + _rec2,
         text_color = _txtYellow, text_size = size.tiny, bgcolor = color.new(#1a2a1a, 10))
    // ROW 17 — GUIDED OPTIMIZER
    string _gStratCode = _gIsUhv ? "UHV" : _gIsTbr ? "2BR" : "EVR"
    string _gPanelHdr  = "GUIDED OPTIMIZER [" + _gStratCode + "] — " + _gRndLabel + "\n"
    string _gPanelBody = ""
    string _gUhvSt = _gHLu == 0 ? "not started" : "R" + str.tostring(_gHLu) + " done"
    string _gTbrSt = _gHLb == 0 ? "not started" : "R" + str.tostring(_gHLb) + " done"
    string _gEvrSt = _gHLe == 0 ? "not started" : "R" + str.tostring(_gHLe) + " done"
    if optGuideReset
        _gPanelBody := "RESET — all round history cleared. Ready to start new optimization.\nUncheck 'Reset Optimizer' in Settings → Optimize to begin Round 1 again.\n(Winner integers in Settings are ignored while reset is active)"
    else if not optGuideEnable
        _gPanelBody := "Off — enable Guided Optimizer in Settings → Optimize"
    else
        string _gSlot   = (_gIsUhv ? "UHV" : _gIsTbr ? "2BR" : "EVR") + " Strategy Round " + str.tostring(_gRound) + " Best Setting"
        bool   _gNoneOnly = optGuideNoneAbove and not (optGuideTry1 or optGuideTry2 or optGuideTry3 or optGuideTry4 or optGuideTry5)
        string _gStatus = _gNoneOnly ? "None improved — current settings are already optimal for this round\nEnter 3 in '" + _gSlot + "' to advance to next round\n" :
             _gAny ? "Testing Setting #" + str.tostring(_gChoice) + " — run 10+ trades then compare P&L\n" :
             "Check an Apply Setting box in Settings → Optimize to begin\n"
        string _gTblHdr = "         TP        Cooldown  RL Cap\n"
        string _gRows = ""
        for _gi = 0 to 4
            string _gMk = _gAny and _gChoice == _gi + 1 ? ">" : " "
            float  _tp  = array.get(_g5tp, _gi)
            int    _cd  = int(array.get(_g5cd, _gi))
            float  _rl  = array.get(_g5rl, _gi)
            _gRows := _gRows + _gMk + " Ch" + str.tostring(_gi + 1) +
                 "  $" + str.tostring(_tp, "#.#") +
                 "  " + str.tostring(_cd) + " bars" +
                 "  $" + str.tostring(_rl, "#") + "\n"
        string _gAllSt  = "UHV: " + _gUhvSt + "  |  2BR: " + _gTbrSt + "  |  EVR: " + _gEvrSt + "\n"
        string _gFooter = "Best found → enter number in '" + _gSlot + "' in Settings → next round auto-starts"
        _gPanelBody := _gStatus + _gTblHdr + _gRows + _gAllSt + _gFooter
    color _gBg = optGuideReset ? color.new(#4a2000, 5) : optGuideEnable ? color.new(#003838, 5) : color.new(color.black, 20)
    color _gFg = optGuideReset ? color.new(#ffaa44, 5) : optGuideEnable ? color.white : color.new(color.silver, 5)
    table.cell(statsPanel, 0, 17, _gPanelHdr + _gPanelBody, text_color = _gFg, text_size = size.tiny, bgcolor = _gBg)


if barstate.islast and showStatsPanel
    f_drawPanel()

// ── Optimizer Game Panel (bottom-left) ──
// Build progress dots: ● = completed round, ○ = future (6 rounds shown)
f_dots(hl) =>
    string _d = ""
    for _i = 1 to 6
        _d := _d + (_i <= hl ? "●" : "○")
    _d

if barstate.islast and optGuideEnable
    string _uDots = f_dots(_gHLu)
    string _bDots = f_dots(_gHLb)
    string _eDots = f_dots(_gHLe)
    string _uLbl  = _gHLu == 0 ? "  Start" : "  Round " + str.tostring(_gHLu + 1)
    string _bLbl  = _gHLb == 0 ? "  Start" : "  Round " + str.tostring(_gHLb + 1)
    string _eLbl  = _gHLe == 0 ? "  Start" : "  Round " + str.tostring(_gHLe + 1)
    string _curStrat = _gIsUhv ? "UHV" : _gIsTbr ? "2BR" : "EVR"
    string _instrLine = _gAny ? "Testing Setting #" + str.tostring(_gChoice) + " — compare P&L" :
         "Check an Apply Setting box to test"
    color _gpBg     = color.new(color.black, 10)
    color _gpHdrBg  = color.new(#001830, 5)
    color _gpRowBg  = color.new(#0a0a14, 8)
    gamePanel = table.new(position.bottom_left, 2, 6,
         border_color = color.new(color.gray, 40), border_width = 1,
         bgcolor = _gpBg)
    table.cell(gamePanel, 0, 0, "OPTIMIZER", text_color = color.new(color.aqua, 0), text_size = size.small, bgcolor = _gpHdrBg)
    table.cell(gamePanel, 1, 0, "", text_size = size.small, bgcolor = _gpHdrBg)
    table.merge_cells(gamePanel, 0, 0, 1, 0)
    table.cell(gamePanel, 0, 1, "UHV  " + _uDots, text_color = _gHLu >= 4 ? color.new(color.lime, 0) : color.silver, text_size = size.small, bgcolor = _gpRowBg)
    table.cell(gamePanel, 1, 1, _uLbl, text_color = color.silver, text_size = size.small, bgcolor = _gpRowBg)
    table.cell(gamePanel, 0, 2, "2BR  " + _bDots, text_color = _gHLb >= 4 ? color.new(color.lime, 0) : color.silver, text_size = size.small, bgcolor = _gpRowBg)
    table.cell(gamePanel, 1, 2, _bLbl, text_color = color.silver, text_size = size.small, bgcolor = _gpRowBg)
    table.cell(gamePanel, 0, 3, "EVR  " + _eDots, text_color = _gHLe >= 4 ? color.new(color.lime, 0) : color.silver, text_size = size.small, bgcolor = _gpRowBg)
    table.cell(gamePanel, 1, 3, _eLbl, text_color = color.silver, text_size = size.small, bgcolor = _gpRowBg)
    table.cell(gamePanel, 0, 4, "── " + _curStrat + ": " + _gRndLabel + " ──", text_color = color.new(color.aqua, 0), text_size = size.small, bgcolor = _gpHdrBg)
    table.cell(gamePanel, 1, 4, "", text_size = size.small, bgcolor = _gpHdrBg)
    table.merge_cells(gamePanel, 0, 4, 1, 4)
    table.cell(gamePanel, 0, 5, _instrLine, text_color = _gAny ? color.new(color.lime, 0) : color.new(color.yellow, 0), text_size = size.small, bgcolor = _gpRowBg)
    table.cell(gamePanel, 1, 5, "", text_size = size.small, bgcolor = _gpRowBg)
    table.merge_cells(gamePanel, 0, 5, 1, 5)

// ALERT CONDITIONS
// Create alerts via: right-click chart → Add Alert → Condition → FVG Absorption
alertcondition(bullBreakout, title = '🟢 BUY Signal', message = '🟢 BUY Signal — FVG Absorption fired on {{ticker}} at {{close}}')
alertcondition(bearBreakout, title = '🔴 SELL Signal', message = '🔴 SELL Signal — FVG Absorption fired on {{ticker}} at {{close}}')

// TREND LINE PLOTS (EMA 34, colored by trend strength)
plot(trendShowMA ? te_fastEma : na, 'Trend (base)',  color = color.new(color.gray, 85),   linewidth = 1)
plot(trendShowMA ? te_w1      : na, 'Trend w1',      color = te_lineColor,                linewidth = 6,  style = plot.style_linebr)
plot(trendShowMA ? te_w2      : na, 'Trend w2',      color = te_lineColor,                linewidth = 8,  style = plot.style_linebr)
plot(trendShowMA ? te_w3      : na, 'Trend w3',      color = te_lineColor,                linewidth = 10, style = plot.style_linebr)
plot(trendShowMA ? te_w4      : na, 'Trend w4',      color = te_lineColor,                linewidth = 12, style = plot.style_linebr)
plot(trendShowMA ? te_w5      : na, 'Trend w5',      color = te_lineColor,                linewidth = 14, style = plot.style_linebr)
