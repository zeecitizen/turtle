//@version=5

indicator("Turtle Trader Desk v1.0, by M. Zeeshan MIT Alumni", "Turtle Trader Desk", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_polylines_count = 100)
max_bars_back(low, 300)
max_bars_back(high, 300)

// SETTINGS

// --- 0. Account --------------------------
gAc = "💼 My Account"
iMon = input.float(865.0, 'My Starting Capital ($)', minval = 1.0, group = gAc)
cM        = input.float(100.0,  'Contract size ($/point/lot)', minval = 0.001, group = gAc)
lA       = input.float(1.0,   'Position Size Multiplier  + / - to scale all lot sizes (1.0 = normal, 2.0 = double lots/profit, 0.5 = half size, etc.)', minval = 0.1, group = gAc)
uSpread  = input.float(0.13,  'Spread ($) — enter live broker spread to simulate real conditions (e.g. 0.28 for gold). Widens SL minimum so backtests reflect spread cost.', minval = 0.0, step = 0.01, group = gAc)
uLev     = input.int(500, 'Account Leverage (e.g. 2000 for 2000:1)', minval = 1, group = gAc)
_sRD = 0

// --- 1. Points of Interest ---------------
gPi = "🎯 Points of Interest"
rPOI = input.bool(false, 'Require POI zone to exist before retracement starts', group = gPi)
rFT = input.bool(false, 'Require POI Touch Before Signal', group = gPi)
pFvg      = input.bool(false,  'Higher Time Frame Fair Value Gap (imbalance zone)', group = gPi)
pHL       = input.bool(false,  'Previous Higher Low (above the deeper low)', group = gPi)
pSup      = input.bool(false,  'Broken High / Low (now flipped to S or R)', group = gPi)
pLb = input.int(50, 'POI Lookback (bars)', group = gPi)

// --- 2. Strategy: UHV Breakout -----------
gU = "📊 Strategy: Ultra High Volume Breakout"
eUHV             = input.bool(true,  'Use this strategy?', group = gU)
uDir          = input.string("Both", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = gU)
rUS       = input.bool(false, 'Must any candle wick through or break the UHV low before the entry candle breaks its high?', group = gU)
rULV    = input.bool(false,  'Must the breakout candle have lower volume than the UHV candle?', group = gU)
uHTD    = input.string("Off", '──── Align direction to higher timeframe? (bull if HTF bullish / bear if HTF bearish)', options = ["Off", "1", "5", "15", "60", "240"], group = gU)
uVTOn      = input.bool(false, '──── UHV Detection: Require candle to rank in top percentile vs last N bars? (OFF = pick highest volume candle from this retracement only)', group = gU)
uVT        = input.int(95,    '──────── Min volume percentile threshold', minval = 1, maxval = 100, group = gU)
uVLB       = input.int(20,    '──────── Lookback bars for percentile calculation', group = gU)
uSB         = input.int(0,      'How many bars must pass after the UHV candle before entry?', group = gU)
uOE = input.string("Instant at Breakout", '──── Open trade at', options = ["Candle Close", "Instant at Breakout"], group = gU)
uPBD = input.float(5.0, '──── Pre-breakout offset ($): fire signal this many $ BEFORE the breakout level (0 = at breakout, 0.05 = 5 cents early = better fill)', group = gU)
uPBsD = input.float(0.0, '──── Post-breakout offset ($): wait for price to move this many $ PAST the breakout level before entering (0 = off, 0.5 = wait for 50¢ confirmation — combines with pre-offset)', group = gU)
uPBCo = input.bool(true, '──── Also allow signal at actual breakout level: when pre-offset is set and price breaks out without reaching the offset level, fire at the actual breakout price instead of missing the trade', group = gU)
uDR = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', group = gU)
uRp = input.float(1.0,  '──── Risk: % of capital per trade (when $Risk = 0) — sizes lots so each trade risks this % of your starting capital', group = gU)
uLS    = input.float(0.011, '──── Risk: Fixed lot size? (when $Risk = 0 and % = 0)', group = gU)
uTM   = input.string("Dollar Amount", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = gU)
uT1    = input.float(2.0,  '──── Take Profit: R:R Ratio (R:R method only)', group = gU)
uTD   = input.float(0.1,  '──── Take Profit: Fixed $ target (Dollar method only)', group = gU)
uSHLOff = input.float(0.5, '──── Take Profit: Structural offset ($): target this much before the structural level (0 = at level, 1 = $1 before; applies to Structural High/Low method only)', group = gU, step = 0.5)
uST    = input.string("Breakout Wick", '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "Breakout Wick", "SwingLow", "Dollar", "Retracement's Min/Max", "Prev Candle"], group = gU)
uSBf  = input.float(0.7,    '──── Stop Loss: Offset from SL level (+ = below the level for tighter protection, − = above the level for a tighter stop inside the candle) [UHV=relative to UHV candle low | Breakout Wick=relative to entry candle wick | SwingLow=relative to swing | Retracement\'s Min/Max=relative to lowest/highest retracement point | Prev Candle=relative to previous candle low/high | not used for ATR or Dollar]', group = gU)
uSMn = input.float(0.2,    '──── Stop Loss: Closest it can ever be to entry? ($)', group = gU)
uSAm = input.float(4.0,    '──── Stop Loss: Volatility width? (ATR method only)', group = gU)
uSDo  = input.float(2.0,    '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', group = gU)
uSSw = input.int(11,      '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', group = gU)
uSLPips = input.float(0.0, '──── Stop Loss: Override with fixed pips (0 = off, uses SL method above)', group = gU)
uTPPips = input.float(0.0, '──── Take Profit: Override with fixed pips (0 = off, uses TP method above)', group = gU)
uBEon  = input.bool(true,  '──── Breakeven: move SL to entry+spread when price hits X% of TP', group = gU)
uBEPct = input.float(33.0, '──────── Breakeven trigger: % of TP distance (10 = early, 50 = halfway, 100 = at TP)', group = gU, minval = 1, maxval = 100, step = 5)
uBELkTP = input.bool(true, '──────── Lock SL at BE trigger price: move SL to the exact 50% TP level instead of entry+offset (locks in 50% of potential profit when BE fires)', group = gU)
useInvalidation = input.bool(true, '──── Invalidation Exit: close trade when a 1-min candle closes back inside the UHV candle range — prevents stop hunts, exits early when breakout fails (MT5 uses wide Hard SL as disaster insurance; Pine simulation keeps wick SL for accurate R:R stats)', group = gU)
iExHSL = input.int(150, '──────── Invalidation Exit: Hard SL sent to MT5 (pips) — wide disaster SL for broker-side safety if connection fails (default 150 pips; does NOT affect lot sizing or Pine stats)', group = gU, minval = 10, step = 5)
iExOff = input.float(0.0, '──────── Invalidation Exit: Tolerance ($) — only exit if close is this much past the UHV level (0 = strictly below/above, 0.05 = small buffer against shaved levels)', group = gU, step = 0.05, minval = 0.0)
uREU   = input.bool(false,  '──── Cancel this strategy on early bounce-back (price returns to IB level before touching POI)?', group = gU)
uMomB    = input.bool(false,  '──── Momentum Candle: Require min body size (strong body)?', group = gU)
uMomBR   = input.float(30.0, '──────── Min body size as % of candle range (60 = body must be =60% of high-low range)', minval = 10, maxval = 100, step = 5, group = gU)
uMomW    = input.bool(false,  '──── Momentum Candle: Require max wick size (small wicks)?', group = gU)
uMomWk   = input.float(5.0, '──────── Max wick size as % of candle range — applies to both upper and lower wick (15 = each wick ≤15% of range)', minval = 0, maxval = 50, step = 5, group = gU)
uBrkVROn = input.bool(false,  '──── Require volume drop vs UHV candle?', group = gU)
uBrkVR   = input.float(5.0, '──────── Volume drop % — breakout candle must have at least this much less volume than UHV candle', minval = 5, maxval = 90, step = 5, group = gU)
uBrkBody = input.bool(true, '──── Require body breakout: only enter if the candle body crosses the breakout level (close must be above/below the trigger — wick-only crossings are ignored) [IOE mode only — bar-close already uses close]', group = gU)


// --- 7. Trend & Filters -------------------
gTr = "📈 Trend & Filters"
// Per-strategy cooldowns (replacing old shared signalCooldown)
uCd    = input.int(0,  '──── Cooldown: Bars after a signal before another can fire?', group = gU)
uAlGt  = input.float(-0.05, '──── Alert Gate ($): min gap from current price to TP before alert fires (−1 = always fire, 0 = block only if price already past TP, >0 = require X$ gap — protects against fast-candle fills past TP)', minval = -1.0, step = 0.05, group = gU)
uIOEGrd = input.float(1.0,  '──── IOE TP Guard: spread multiplier (0 = off, 1 = guard triggers when TP within 1× spread of close, 2 = stricter — within 2× spread)', minval = 0.0, step = 0.5, group = gU)
mTS  = input.int(3, 'Min Trend Strength at Signal', group = gTr)
tPB  = input.int(8, 'Trend Persistence Lookback (bars)', group = gTr)
sFilt = input.bool(false, 'Only trade London + NY sessions? (8–12 GMT and 13–17 GMT)', group = gTr)
cLP   = input.bool(false, 'Cut Low Probability Trades — suppress directions with ≥10 trades and negative all-time P&L', group = gTr)
aTS      = input.bool(false,  'Avoid trading when trend is shifting?', group = gTr)
aTSU   = input.bool(false, '──── Apply to UHV Breakout?', group = gTr)
tSTh  = input.int(53, '──── Shift Threshold (strength drop to trigger)', group = gTr)
sTC     = input.bool(false,  'Require Full Trend Confirmation at Entry?',  group = gTr)
sTCU  = input.bool(true, '──── Apply to UHV Breakout?',               group = gTr)
tSMA       = input.bool(true, 'Show Trend MA Line on Chart', group = gTr)
rSwT  = input.bool(false, 'Require structural trend — buy only when HH+HL confirmed, sell only when LH+LL confirmed (prevents taking buys in a downtrend or sells in an uptrend)', group = gTr)
avoidRng  = input.bool(false,  'Avoid signals during ranging market (ADX-based — suppresses entries when trend strength is too weak for a breakout to follow through)', group = gTr)
rngTh     = input.int(10,    '──── Ranging threshold: ADX below this = ranging (14 = very strict, 18 = balanced, 25 = aggressive)', minval = 5, maxval = 40, group = gTr)
ntW1 = input.bool(false,  '🚫 No-Trade Window: 21:00–23:00 UTC — NY Rollover (spreads spike 5–10×, spread cost can exceed entire TP)', group = gTr)
ntW2 = input.bool(false, '🚫 No-Trade Window: 23:00–03:00 UTC — Late Asia lull (slow drift, high fakeout risk, no institutional flow)', group = gTr)
ntW3 = input.bool(false, '🚫 No-Trade Window: 04:00–07:00 UTC — Pre-London trap (thin liquidity, breakouts fail before London volume arrives)', group = gTr)
ntW4 = input.bool(false, '🚫 No-Trade Window: 19:00–21:00 UTC — Volume fade / Friday profit-taking (institutions closing, reversals unpredictable)', group = gTr)
bRW = input.bool(true, 'Bypass retracement rules — retracement starts whenever a red candle closes below the prior green candle\'s low (removes trend/IB phase requirements)', group = gTr)
bRWW = input.bool(true, '──── Wick trigger: wick piercing below prior green low is enough (default = body close required)', group = gTr)

// --- 8. HTF Fair Value Gap ----------------
gH = "🔭 Higher Time Frame Fair Value Gap"
uHF      = input.bool(false, 'Use Higher Time Frame FVG for Signals', group = gH)
hFC = input.string("1", 'Higher Time Frame', options = ["Auto", "1", "5", "15", "60", "240"], group = gH)
hAT      = timeframe.period  // AUTO = same as the chart's current timeframe
hFT       = hFC == "Auto" ? hAT : hFC
hFCol    = input.color(color.new(#f5a623, 60), 'Higher Time Frame FVG Zone Color', group = gH)
fTH          = input.float(0.3, 'FVG Width Filter (ATR multiple)', group = gH)
uFTH       = input.float(0.3, '──── UHV Breakout: FVG Width Filter (ATR multiple)', group = gH)
fVF          = input.bool(true, 'Show Historical FVGs', inline = 'FL', group = gH)
fBC          = color.new(#089981, 55)
fAC          = color.new(#787b86, 77)
fSC          = color.new(#f23645, 55)
fFC          = color.new(#787b86, 77)

// --- 9. Display ---------------------------
gDi = "🖥️ Display"
sL     = input.bool(true,  'Show Signal Labels', group = gDi)
sDb      = input.bool(false, 'Show Debug Labels', group = gDi)
sSP = input.bool(true,  'Show Stats Panel', group = gDi)
sCH = input.bool(true,  'Highlight signal candles (outline which candles were studied)', group = gDi)

// --- 10. PineConnector Automation ---------
gPc = "🤖 PineConnector Automation"
pE    = input.bool(true,   'Send signals to PineConnector (MT5)?', group = gPc)
pLid = input.string("8778286989525", 'PineConnector License ID', group = gPc)
pSym    = input.string("XAUUSD",         'MT5 Symbol Name', group = gPc)
mLot  = input.float(0.01, 'Minimum lot size allowed by your broker', group = gPc)
pPip  = input.float(0.10, 'MT5 pip size for this symbol (XAUUSD=0.10, ETHUSD=1.0, BTCUSD=10.0)', minval = 0.00001, group = gPc)
pcBrkPip = input.float(0.10, 'Broker pip size for PineConnector pips mode (XAUUSD both brokers = 0.10) — only used when SL/TP format is Pips', minval = 0.00001, group = gPc)
pcSpread = input.int(30, '──── Spread filter: only enter if spread ≤ X broker pips (0 = off)', group = gPc, minval = 0)
pcBETrig = input.int(0, '──── Breakeven: move SL to entry after X broker pips profit (0 = off)', group = gPc, minval = 0)
pcBEOff  = input.int(0, '──── Breakeven offset: SL placed X pips above/below entry (0 = at entry)', group = gPc, minval = 0)
pcTDist  = input.int(15, '──── Trailing stop: maintain SL X broker pips from price (0 = off)', group = gPc, minval = 0)
pcTTrig  = input.int(25, '──── Trailing: activate after X broker pips profit (0 = immediate when pcTDist>0)', group = gPc, minval = 0)
pcTStep  = input.int(5, '──── Trailing: move SL every X additional broker pips gained', group = gPc, minval = 1)
pLat  = input.string("200", 'Signal→MT5 latency ms (comma-sep, copy from PineConnector Bridge logs)', group = gPc)
pAT   = input.string("", "Derive optimizations from Claude's analysis — Enter Token:", group = gPc)
pATon = input.bool(false, "Apply token corrections to labels (slip-adjusted entry & P&L)", group = gPc)
pcSL  = input.string("Price",   '──── Stop Loss format sent to MT5',        options = ["Pips", "Price"], group = gPc)
pcTP  = input.string("Price",   '──── Take Profit format sent to MT5',      options = ["Pips", "Price"], group = gPc)
pcOT  = input.string("Market", '──── Order type sent to MT5',              options = ["Market", "Limit"], group = gPc)

// --- 11. Optimize --------
gO  = "⚡ Optimize"
mTM   = input.bool(false, 'Maximize Trades — remove all cooldowns and optional filters to fire on every valid setup (uses trade history analysis to unlock blocked signals)', group = gO)
uDev  = input.bool(true, '──── Developer mode: show decoded condition bits + full alert string on each signal label', group = gO)

// Pre-computed timeframe constants — derived from timeframe.period string (global scope safe)
tFm   = timeframe.period == "D" ? 1440.0 : timeframe.period == "W" ? 10080.0 : str.tonumber(timeframe.period)
bPH = math.max(1, math.round(60.0 / tFm))
_utcH = hour(time, "UTC")
_utcM = minute(time, "UTC")
_tMU  = _utcH * 60 + _utcM
_ntBlock = (ntW1 and _tMU >= 1260 and _tMU < 1380) or (ntW2 and (_tMU >= 1380 or _tMU < 180)) or (ntW3 and _tMU >= 240 and _tMU < 420) or (ntW4 and _tMU >= 1140 and _tMU < 1260)
_inSess = not sFilt or (_utcH >= 8 and _utcH < 12) or (_utcH >= 13 and _utcH < 17)

// TYPES
type bar
    float h = high
    float l = low
    float c = close
    int   i = bar_index

// VARS
bar b = bar.new()

// -- Multi-FVG visual arrays --
var box  [] _aUF = array.new<box>(0)
var box  [] _aMF = array.new<box>(0)
var box  [] _aTF = array.new<box>(0)
var line [] _aLF = array.new<line>(0)
var bool [] _aD  = array.new<bool>(0)

// -- Signal-tracking FVG --
// Initialize as false instead of na to avoid type error on some Pine versions
var _lb    = false
var float _fZT    = na
var float _fZB    = na
var float _plHL    = na   // Higher Low / Lower High POI level
var float _plSp   = na   // Support / Resistance flip POI level
var line  _pnHL     = na   // chart line for Higher Low POI
var line  _pnSp    = na   // chart line for Support POI
var int   _fCB = na
var _hFvg        = false
var _fU       = false

// UHV tracking
var _uVol     = 0.0
var float _uHi       = na
var float _uLo        = na
var float _uSl         = na
var label _uLbl      = na
var int   _uBar        = na
var _uLSw   = false  // bull: UHV low must be swept (wick below OR body close below) before breakout
var _uHSw  = false  // bear: UHV high must be swept (wick above OR body close above) before breakout
var float _rceLo    = na     // bull: lowest low during retracement — used as structural SL
var float _rceHi   = na     // bear: highest high during retracement — used as structural SL

// Accuracy tracking
var _wC      = 0

// Dollar P&L per trade
var _cTr  = 0

// Active trade tracking
var _tEn  = array.new_float()
var _tSl     = array.new_float()
var _tTP    = array.new_float()
var bool [] _tBl   = array.new_bool()
var bool [] _tTH = array.new_bool()
var bool  [] _tSH    = array.new_bool()
var bool  [] _tBE    = array.new_bool()    // true = breakeven already triggered for this trade
var float [] _tIL    = array.new_float()   // invalidation level per trade (UHV candle high for bull / low for bear)
var float [] _tEL  = array.new_float()
var int   [] _tEB = array.new_int()
var int   [] _tFT = array.new_int()  // timenow (ms wall-clock) when each signal alert fired
var label [] _tLbl    = array.new<label>()  // signal label ref for post-trade update
var _tTy     = array.new_string()   // "uhv"
var int   [] _tN      = array.new_int()       // sequential trade number (#1, #2, ...)
var float [] _tTS = array.new_float()    // _tS at entry
var bool  [] _tW      = array.new_bool()     // true = TP hit, false = SL hit (set on close)
// Breakout line
var float _bL      = na
var _bT  = false
varip bool _uF = false  // UHV has fired from the current setup
var _uWB     = false  // UHV would have fired but lower-vol filter blocked it
varip bool _uAlF  = false  // UHV alert sent this bar (varip: persists across realtime ticks)
varip int  _uAlBi = -1     // bar_index of last _uAlF reset
// Deferred label+array creation: set when UHV alert fires intra-bar; processed at barstate.isconfirmed
varip bool   _uPendBull = false
varip bool   _uPendBear = false
varip float  _uPndEn   = 0.
varip float  _uPndSL   = 0.
varip float  _uPndTP   = 0.
varip float  _uPndLt   = 0.
varip float  _uPndTS   = 0.
varip int    _uPndN    = 0
varip string _uPndBits = ""
varip string _uPndMsg  = "—"
var float _sigChkW = 0.  // checksum written at signal formation
var float _sigChkR = 0.  // checksum read at deferred block (before arrays/label)

// -- Stats tracking --
varip int _sigT      = 0       // signals fired today
var _pT          = 0.0     // P&L closed today
var _pLH       = 0.0     // P&L closed in last 60 min
var _tLSt   = 0       // current consecutive losses today
var _mLST = 0       // max consecutive losses today
var _ltd      = -1      // dayofmonth of last reset
var _tCTi    = array.new_int()   // bar_index when trade closed
var _tCTs      = array.new_int()   // actual unix timestamp when trade closed (for date/hour filtering)
var _tPA     = array.new_float() // P&L parallel to _tCTi

var int  [] _tDB = array.new_int()   // trade duration in bars (pushed at SL+TP close)
var _sBT    = array.new_int()   // bar_index of each signal label printed (for signals/day)
var int [] _sABT = array.new_int()  // bar_index of each alert actually fired (subset of _sBT, gated)
varip int _alT    = 0   // alerts fired today
var _tAAD   = 0   // total alerts across all days (for daily avg)
var _tDS       = 1
var _tSAD = 0
// Per-strategy P&L and trade tracking
var _uPnL      = 0.0
var _uTr   = 0
var _uWn     = 0
var _uPT = 0.0
// Blocked-signal counters — for recommendation engine
var _bSwp    = 0   // UHV blocked only by no-sweep
var _bUV     = 0   // UHV blocked only by volume check
var _bCd = 0   // any signal blocked only by cooldown
var _bStr = 0   // any signal blocked only by trend strength

// Per-strategy per-direction P&L — for Cut Low Probability Trades
var _uBP = 0.0
var _uBT   = 0
var _uBeP = 0.0
var _uBeT   = 0
// Yesterday stats computed from _tCTs in panel block

// -- Bullish tracking --
var float _rnHi    = na
var float _pvHi       = na
var float _lgL   = na
var float _lgC = na

// -- Bearish tracking --
var float _rnLo     = na
var float _pvLo        = na
var float _lrH    = na
var float _lrC   = na

// Retracement state
var _iR  = false
var _fR     = false
var _rwb = false
var float _rCeil  = na
var float _rFlr    = na
var string _lastAlertMsg = "—"
varip string _lastSigTxt = ""
var int   _rSB = na

// -- Block A improved IB + retracement logic --
// IB = Independent Bar: close breaks ABOVE prev candle high (bull) / BELOW prev candle low (bear)
// seenBear/GreenSinceIB guards prevent consecutive IBs without a real pullback between them
var _ibT        = false   // true from IB detection until retracement fires
var _sbIB      = true    // start true so first IB can fire immediately
var _sgIB     = true    // bear side equivalent
var bool _uReBnc = false  // UHV blocked by per-strategy early bounce-back
var float _sStr     = na     // _tS at the moment this retracement began (for trend-shift threshold)
var float _sH1 = na   // most recent confirmed swing high (structural trend tracking)
var float _sH2 = na   // previous confirmed swing high
var float _sL1 = na   // most recent confirmed swing low
var float _sL2 = na   // previous confirmed swing low

// Cooldown tracking
varip int _luSB = -999   // last bar UHV fired (for per-strategy cooldown)

// BASE FVG CALCULATIONS
_bG = b.l > b.h[1]
_beG = b.h < b.l[1]
atr   = nz(ta.atr(144)) * fTH
bull  = (b.l - b.h[2]) > atr and b.l > b.h[2] and b.c[1] > b.h[2] and not (_bG or _bG[1])
bear  = (b.l[2] - b.h) > atr and b.h < b.l[2] and b.c[1] < b.l[2] and not (_beG or _beG[1])

// Latency parse: average ms from signal fire to MT5 fill (from PineConnector Bridge logs)
_latArr = str.split(pLat, ",")
_latSum = 0.0
_latCnt = 0
for _s in _latArr
    _v = str.tonumber(_s)
    if not na(_v)
        _latSum += _v
        _latCnt += 1
_avgLat = _latCnt > 0 ? _latSum / float(_latCnt) : 175.0

// Analysis token parse: v1,wins,total,avgWin($),avgLoss($)[,lots,slipB,slipS]
int   _atWins  = 0
int   _atTotal = 0
float _atAvgW  = 0.
float _atAvgL  = 0.
float _atSlipB = 0.
float _atSlipS = 0.
bool  _atValid = false
if str.length(pAT) > 2
    _atParts = str.split(pAT, ",")
    if array.size(_atParts) >= 5 and array.get(_atParts, 0) == "v1"
        _aw = str.tonumber(array.get(_atParts, 1))
        _at = str.tonumber(array.get(_atParts, 2))
        _atWins  := not na(_aw) ? int(_aw) : 0
        _atTotal := not na(_at) ? int(_at) : 0
        _atAvgW  := nz(str.tonumber(array.get(_atParts, 3)))
        _atAvgL  := nz(str.tonumber(array.get(_atParts, 4)))
        _atSlipB := array.size(_atParts) > 6 ? nz(str.tonumber(array.get(_atParts, 6))) : 0.
        _atSlipS := array.size(_atParts) > 7 ? nz(str.tonumber(array.get(_atParts, 7))) : 0.
        _atValid := _atTotal > 0

// STEP 1: TREND DETECTION
_iGr = close > open
_iRd   = close < open
_bSz    = math.abs(close - open)
_cRng = high - low

if not _iR
    if _iGr
        if high > nz(_rnHi, high - 1)
            _pvHi    := _rnHi
            _rnHi := high
        _lgL   := low
        _lgC := close
    if _iRd
        if low < nz(_rnLo, low + 1)
            _pvLo    := _rnLo
            _rnLo := low
        _lrH    := high
        _lrC   := close

_inUp   = not na(_pvHi) and not na(_rnHi) and _rnHi > _pvHi
_inDn = not na(_pvLo)  and not na(_rnLo)  and _rnLo  < _pvLo

// TREND ENGINE (EMA 34 / 89 multi-factor)
_fe        = 34
_se        = 89
_swL    = 20
_aL      = 14
_vL      = 20
_rF = 0.45
_hTF      = "240"
_bPct = 0.001

_fEma   = ta.ema(close, _fe)
_sEma   = ta.ema(close, _se)
_tAt       = ta.atr(_aL)
_tAtM     = ta.sma(_tAt, _aL)
_tVm     = ta.sma(volume, _vL)
_tSlA  = math.abs(_fEma - _fEma[1])

_tEmB   = _fEma > _sEma
_tEmBr   = _fEma < _sEma
_tSlB = _fEma > _fEma[1]
_tSlBr = _fEma < _fEma[1]
_tFS = _tSlA < _tAt * 0.1

_tRH = ta.highest(high, _swL)
_tRL  = ta.lowest(low,  _swL)
_tStB = close > _tRL
_tStBr = close < _tRH
_tNS   = not _tStB and not _tStBr

_tHF   = request.security(syminfo.tickerid, _hTF, ta.ema(close, _fe))
_tHS   = request.security(syminfo.tickerid, _hTF, ta.ema(close, _se))
_tHB   = _tHF > _tHS
_tHBr   = _tHF < _tHS

_tVE    = volume > _tVm
_tAE    = _tAt > _tAtM
_tAC   = _tAt < _tAtM * _rF
_tIR = _tAC and _tFS and _tNS

_tBU     = close > _tRH * (1 + _bPct)
_tBD     = close < _tRL  * (1 - _bPct)

_tRwB   = (_tEmB and _tSlB and _tStB and not _tIR) or _tBU
_tRwBr   = (_tEmBr and _tSlBr and _tStBr and not _tIR) or _tBD

_tRlx   = (_tVE or _tAE)
_tBC  = (_tRwB and _tRlx) or _tBU
_tBCr  = (_tRwBr and _tRlx) or _tBD

_tBS = _tBC or _tRwB
_tBSr = _tBCr or _tRwBr

_tStr  = 0.0
_tStr += _tBC or _tBCr ? 30.0 : 0.0
_tStr += _tVE and _tAE    ? 25.0 : 0.0
_tStr += _tHB or _tHBr  ? 10.0 : 0.0
_tStr += _tSlA > _tAt * 0.2 ? 15.0 : 0.0
_tStr += not _tIR           ? 10.0 : 0.0
_tS = math.round(math.min(100.0, math.max(0.0, _tStr)))

_ib = (_tBS and not _tBSr) or (_tBS and _tBSr and _tS >= 50)
_ibr = (_tBSr and not _tBS) or (_tBS and _tBSr and _tS < 50)

_hb = _ib
_hbr = _ibr

_tTL = _tS > 75 ? 0 : _tS > 50 ? 20 : _tS > 25 ? 40 : _tS > 10 ? 60 : 80
_tLCol = _ib ? color.new(color.green, _tTL) : _ibr ? color.new(color.red, _tTL) : color.new(color.gray, 80)

_w1 = _tS <= 10                              ? _fEma : na
_w2 = _tS > 10 and _tS <= 25       ? _fEma : na
_w3 = _tS > 25 and _tS <= 50       ? _fEma : na
_w4 = _tS > 50 and _tS <= 75       ? _fEma : na
_w5 = _tS > 75                               ? _fEma : na

// -- ATR for SL calculations --
_a14 = ta.atr(14)

// -- Ranging market detection (ADX) --
// ADX < threshold = price is oscillating without directional conviction
// ta.dmi() returns [+DI, -DI, ADX]
[_, _dmM, _adxV] = ta.dmi(14, 14)
_isRng = avoidRng and _adxV < float(rngTh)

// HTF FVG DETECTION
// Detection runs INSIDE request.security so [2] means 2 HTF bars ago
// This is the only correct way — [2] on current TF would be 2 current bars
fHF(_th) =>
    _atr  = nz(ta.atr(144)) * _th
    _bull = (low - high[2]) > _atr and low > high[2] and close[1] > high[2]
    _bear = (low[2] - high) > _atr and high < low[2] and close[1] < low[2]
    // Persist the most recent zone levels across HTF bars
    var float _zTop    = na
    var float _zBot    = na
    var bool  _zIsBull = na
    if _bull
        _zTop    := low
        _zBot    := high[2]
        _zIsBull := true
    if _bear
        _zTop    := low[2]
        _zBot    := high
        _zIsBull := false
    [_bull, _bear, _zTop, _zBot, _zIsBull]

// Fetch all 5 values from HTF — [2] inside runs on HTF bars, not current TF bars
[_hRB, _hRBr, _hZT, _hZB, _hZIB] =
     request.security(syminfo.tickerid, hFT, fHF(fTH), barmerge.gaps_off, barmerge.lookahead_on)

// Detect rising edge on current TF (_hRB stays true for all lower-TF bars in that HTF candle)
var _pRB = false
var _pRBr = false
_hNB = _hRB and not _pRB
_hNBr = _hRBr and not _pRBr
_pRB := _hRB
_pRBr := _hRBr

// Draw ALL HTF FVG zones as boxes — one per FVG, auto-removed when filled
var box[]   _hFBx      = array.new<box>()
var _hFTp       = array.new_float()
var _hFBt       = array.new_float()
var _hFBl       = array.new_bool()
var _hFTC = array.new_int()    // 0=untouched, 1=first touch, 2=retested
var _hFIZ     = array.new_bool()   // true when price is currently inside zone
var _hFRB  = array.new_int()    // bar_index when retest began (-1 = not yet)

if uHF
    if _hNB
        _top = _hZT
        _bot = _hZB
        _b   = box.new(bar_index, _top, bar_index + 1, _bot,
             border_color = color.new(hFCol, 10), border_width = 1,
             bgcolor = color.new(hFCol, 80))
        array.push(_hFBx,      _b)
        array.push(_hFTp,       _top)
        array.push(_hFBt,       _bot)
        array.push(_hFBl,       true)
        array.push(_hFTC, 0)
        array.push(_hFIZ,     false)
        array.push(_hFRB,  -1)

    if _hNBr
        _top = _hZT
        _bot = _hZB
        _b   = box.new(bar_index, _top, bar_index + 1, _bot,
             border_color = color.new(color.red, 10), border_width = 1,
             bgcolor = color.new(color.red, 80))
        array.push(_hFBx,      _b)
        array.push(_hFTp,       _top)
        array.push(_hFBt,       _bot)
        array.push(_hFBl,       false)
        array.push(_hFTC, 0)
        array.push(_hFIZ,     false)
        array.push(_hFRB,  -1)

    // Extend boxes, track touches, freeze box 3 bars after retest
    _htfSize = array.size(_hFBx)
    if _htfSize > 0
        for _hfi = _htfSize - 1 to 0
            // Guard: array may have shrunk due to mid-loop removals
            if _hfi < array.size(_hFBx)
                _hBx        = array.get(_hFBx,      _hfi)
                _ht         = array.get(_hFTp,        _hfi)
                _hbo        = array.get(_hFBt,        _hfi)
                _hbull      = array.get(_hFBl,        _hfi)
                _touches    = array.get(_hFTC,  _hfi)
                _wasInZone  = array.get(_hFIZ,      _hfi)
                _retestBar  = array.get(_hFRB,   _hfi)

                // Is price currently inside the zone?
                _inZoneNow  = low <= _ht and high >= _hbo

                // Detect entry into zone (new touch)
                if _inZoneNow and not _wasInZone
                    _touches += 1
                    array.set(_hFTC, _hfi, _touches)
                    if _touches == 2
                        array.set(_hFRB, _hfi, bar_index)

                array.set(_hFIZ, _hfi, _inZoneNow)

                // Full invalidation: price closed well beyond zone
                _invalidated = _hbull ? close < _hbo - (_ht - _hbo) : close > _ht + (_ht - _hbo)
                // Retest done: 3 bars have passed since second touch
                _retestDone  = _retestBar >= 0 and (bar_index - _retestBar) >= 3

                if _invalidated
                    box.delete(_hBx)
                    array.remove(_hFBx,     _hfi)
                    array.remove(_hFTp,      _hfi)
                    array.remove(_hFBt,      _hfi)
                    array.remove(_hFBl,      _hfi)
                    array.remove(_hFTC,_hfi)
                    array.remove(_hFIZ,    _hfi)
                    array.remove(_hFRB, _hfi)
                else if _retestDone
                    // Freeze box: fade colors, stop extending
                    _fadedBg     = _hbull ? color.new(hFCol, 92) : color.new(color.red, 92)
                    _fadedBorder = _hbull ? color.new(hFCol, 60) : color.new(color.red, 60)
                    box.set_bgcolor(_hBx, _fadedBg)
                    box.set_border_color(_hBx, _fadedBorder)
                    array.remove(_hFBx,     _hfi)
                    array.remove(_hFTp,      _hfi)
                    array.remove(_hFBt,      _hfi)
                    array.remove(_hFBl,      _hfi)
                    array.remove(_hFTC,_hfi)
                    array.remove(_hFIZ,    _hfi)
                    array.remove(_hFRB, _hfi)
                else
                    box.set_right(_hBx, bar_index + 1)

// FVG BOX CREATION
if bull
    // Only draw current-TF FVG boxes when HTF mode is OFF
    if not uHF
        _aUF.unshift(box.new(b.i - 1, b.l,    b.i, b.h[2], border_color = na, bgcolor = fBC))
        _aMF.unshift(box.new(b.i - 1, b.l,    b.i, b.l,    border_color = na, bgcolor = fAC))
        _aTF.unshift(box.new(b.i - 1, b.l,    b.i, b.h[2], border_color = na, bgcolor = color(na), text_color = chart.fg_color, text_size = size.small))
        _aLF.unshift(line.new(b.i - 1, b.h[2], b.i, b.h[2], color = fBC, width = 2))
        _aD.unshift(true)
    // Signal-tracking: only update from current-TF FVG when HTF mode is OFF
    if not uHF and not _iR
        _fZT    := b.l
        _fZB    := b.h[2]
        _fCB := b.i
        _hFvg        := true
        _lb    := true
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        _iR := false
        _ibT    := false
        _fR    := false

if bear
    // Only draw current-TF FVG boxes when HTF mode is OFF
    if not uHF
        _aUF.unshift(box.new(b.i - 1, b.l[2], b.i, b.h,    border_color = na, bgcolor = fSC))
        _aMF.unshift(box.new(b.i - 1, b.h,    b.i, b.h,    border_color = na, bgcolor = fFC))
        _aTF.unshift(box.new(b.i - 1, b.l[2], b.i, b.h,    border_color = na, bgcolor = color(na), text_color = chart.fg_color, text_size = size.small))
        _aLF.unshift(line.new(b.i - 1, b.l[2], b.i, b.l[2], color = fSC, width = 2))
        _aD.unshift(false)
    // Signal-tracking: only update from current-TF FVG when HTF mode is OFF
    if not uHF and not _iR
        _fZT    := b.l[2]
        _fZB    := b.h
        _fCB := b.i
        _hFvg        := true
        _lb    := false
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        _iR := false
        _ibT    := false
        _fR    := false

// -- HTF FVG signal-tracking update --
// When HTF mode is ON: signal-tracking zone is driven by the HTF FVG
// On every bar: ensure _hFvg=true whenever a valid HTF zone exists
// This fixes 1m (and other lower-TF) charts where _hNB/Bear only fires once
// historically and _hFvg would otherwise stay false indefinitely
if uHF and not na(_hZT) and not na(_hZB) and not na(_hZIB)
    // Always keep zone synced — even if the FVG formed long ago
    if not _hFvg or (_fZT != _hZT and _fZB != _hZB and not _iR)
        _fZT := _hZT
        _fZB := _hZB
        _lb := _hZIB
        _hFvg     := true
    // On a brand-new HTF FVG: full reset of retracement state
    if (_hNB or _hNBr) and not _iR
        _fZT    := _hZT
        _fZB    := _hZB
        _fCB := b.i
        _hFvg        := true
        _lb    := _hZIB
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        _iR := false
        _ibT    := false
        _fR    := false

// UPDATE ALL FVGs
if _aUF.size() > 0
    _sz = _aUF.size()
    for _k = _sz - 1 to 0
        cUB = _aUF.get(_k)
        tUB = cUB.get_top()
        bUB = cUB.get_bottom()
        cMB = _aMF.get(_k)
        tMB = cMB.get_top()
        bMB = cMB.get_bottom()
        cTB = _aTF.get(_k)
        cL  = _aLF.get(_k)
        _p  = _aD.get(_k)
        _remove = false

        if b.h > bUB and b.l < tUB
            if _p
                if b.l > bUB
                    cMB.set_bottom(math.min(b.l, bMB))
                    cUB.set_top(math.min(b.l, bMB))
                    cTB.set_text(str.tostring((tMB - math.min(b.l, bMB)) / (tMB - bUB), '#.#%'))
                else
                    cMB.set_bottom(bUB)
                    cUB.set_top(bUB)
                    cTB.set_text('')
                    _remove := true
            else
                if b.h < tUB
                    cMB.set_top(math.max(b.h, tMB))
                    cUB.set_bottom(math.max(b.h, tMB))
                    cTB.set_text(str.tostring((math.max(b.h, tMB) - bMB) / (tUB - bMB), '#.#%'))
                else
                    cMB.set_top(tUB)
                    cUB.set_bottom(tUB)
                    cTB.set_text('')
                    _remove := true

        if _remove
            if not fVF
                cUB.delete()
                cMB.delete()
                cTB.delete()
                cL.delete()
            _aUF.remove(_k)
            _aMF.remove(_k)
            _aTF.remove(_k)
            _aLF.remove(_k)
            _aD.remove(_k)
        else
            cUB.set_right(b.i)
            cMB.set_right(b.i)
            cTB.set_right(b.i)
            cL.set_x2(b.i)

// POST-SIGNAL AUTO-RESET
if _fU and not _iR
    if _lb and _hFvg and high > nz(_rnHi, high - 1)
        _fU := false
    if not _lb and _hFvg and low < nz(_rnLo, low + 1)
        _fU := false

// STEP 2: RETRACEMENT START  (Block A improved logic)
// cooldown is now per-strategy: uCd / eCd

// -- Update seen-bear/green trackers --
// Once an IB fires we reset the flag; it flips back when the opposite candle appears
if not _iR
    if _iRd
        _sbIB  := true
    if _iGr
        _sgIB := true

// -- POI helper functions: find Higher Low / Support level for zone touch mode --
fHL(_lb) =>
    float _sw1 = na
    float _sw2 = na
    float _result = na
    for _i = 2 to _lb - 1
        if low[_i] < low[_i - 1] and low[_i] < low[_i + 1]
            if na(_sw1)
                _sw1 := low[_i]
            else
                _sw2 := low[_i]
                break
    if not na(_sw1) and not na(_sw2) and _sw1 > _sw2
        _result := _sw1
    _result

fLH(_lb) =>
    float _sh1 = na
    float _sh2 = na
    float _result = na
    for _i = 2 to _lb - 1
        if high[_i] > high[_i - 1] and high[_i] > high[_i + 1]
            if na(_sh1)
                _sh1 := high[_i]
            else
                _sh2 := high[_i]
                break
    if not na(_sh1) and not na(_sh2) and _sh1 < _sh2
        _result := _sh1
    _result

fSup(_lb) =>
    float _result = na
    for _i = 2 to _lb - 1
        if high[_i] > high[_i - 1] and high[_i] > high[_i + 1] and high[_i] < close
            _result := high[_i]
            break
    _result

fRes(_lb) =>
    float _result = na
    for _i = 2 to _lb - 1
        if low[_i] < low[_i - 1] and low[_i] < low[_i + 1] and low[_i] > close
            _result := low[_i]
            break
    _result

// -- SL calculation helper: all SL params passed per-strategy --
fSL(_isBull, _entryPrice, _structLow, _structHigh, _slType, _slBuffer, _slAtrMult, _slSwingLb, _slMinDist, _dollarRisk, _lotSize, _slDollar = 2.0, float _wL = na, float _wH = na) =>
    _atrSL     = _isBull ? _entryPrice - _a14 * _slAtrMult : _entryPrice + _a14 * _slAtrMult
    _wickSL    = _isBull ? (na(_wL) ? low : _wL) - _slBuffer : (na(_wH) ? high : _wH) + _slBuffer
    _swingLow  = nz(ta.lowest(low,  _slSwingLb), _structLow)
    _swingHigh = nz(ta.highest(high, _slSwingLb), _structHigh)
    _swingSL   = _isBull ? _swingLow  - _slBuffer : _swingHigh + _slBuffer
    _structSLv = _isBull ? _structLow - _slBuffer  : _structHigh + _slBuffer
    _dollarDist = _dollarRisk > 0 ? _dollarRisk / (_lotSize * cM) : _lotSize * 1.0
    _dollarSLv  = _isBull ? _entryPrice - _slDollar : _entryPrice + _slDollar
    _raw = _slType == "ATR"        ? _atrSL :
           _slType == "Breakout Wick" or _slType == "Below High Vol. Candle Wick" ? _wickSL :
           _slType == "SwingLow"   ? _swingSL :
           _slType == "Dollar"     ? _dollarSLv : _structSLv
    // Candle-anchored types: SL is fixed at the candle level; skip min-distance enforcement so
    // pre/post breakout entry offset cannot push the SL away from its candle anchor.
    // Other types (ATR, SwingLow, Dollar, structural) still enforce minimum distance from entry.
    _candleAnch = _slType == "Breakout Wick" or _slType == "Below High Vol. Candle Wick" or _slType == "Prev Candle"
    _result = _candleAnch ? _raw : (_isBull ? math.min(_entryPrice - _slMinDist, _raw) : math.max(_entryPrice + _slMinDist, _raw))
    math.max(syminfo.mintick, _result)

// -- Signal block helpers (replace repeated code in all 8 signal entry blocks) --
fAS(_w, _t) =>
    _t > 0 ? str.tostring(_w) + "/" + str.tostring(_t) + " won (" + str.tostring(math.round(_w / _t * 100)) + "%)" : "No trades yet"

fLL(_dr, _lots, _cap = false) =>
    _dr > 0 ? "auto (" + str.tostring(_lots, "#.####") + " lots)" : _cap ? "risk-sized (" + str.tostring(_lots, "#.####") + " lots)" : "user-defined (" + str.tostring(_lots, "#.##") + " lots)"

fPTS(_pnl) =>
    _pnl >= 0.01 ? "💰 This strategy brought in: $" + str.tostring(_pnl, "#.##") + " in profits today" : _pnl <= -0.01 ? "📉 This strategy is down $" + str.tostring(math.abs(_pnl), "#.##") + " today" : "No completed trades yet today"

fTS() =>
    _t = barstate.isrealtime ? timenow : time
    _h = hour(_t, "UTC+3")
    _m = minute(_t, "UTC+3")
    _s = second(_t, "UTC+3")
    str.tostring(_h) + ":" + (_m < 10 ? "0" : "") + str.tostring(_m) + ":" + (_s < 10 ? "0" : "") + str.tostring(_s) + " Moscow"

// Round TP to pip boundary so Pine monitors exact same price MT5 places
fTP(_e, _t) => _e + math.sign(_t - _e) * math.round(math.abs(_t - _e) / pPip) * pPip

// Condition bitmask — 16-bit string appended to alert comment for post-trade diagnostics
// Bit  0: direction        (0=buy,  1=sell)
// Bit  1: IOE mode         (0=bar-close,  1=IOE)
// Bit  2: reserved
// Bit  3: reserved
// Bit  4: strict trend on  (_eStU / _eStE — sTC+sTCx, zeroed by mTM)
// Bit  5: strict trend ok  (hb+bTP / hbr+beTP passed when bit4=1)
// Bit  6: sweep req        (UHV: _erUS enabled)
// Bit  7: sweep confirmed  (UHV: _uLSw bull / _uHSw bear)
// Bit  8: pre-offset on    (uPBD > 0)
// Bit  9: co-exist path    (1=fired at actual breakout level, not pre-offset — uPBCo fallback used)
// Bit 10: trend direction  (0=downtrend,  1=uptrend)
// Bit 11: in-session       (1=within allowed session window)
// Bit 12: vol filter on
// Bit 13: vol filter ok    (volume condition was met)
// Bit 14: reserved
// Bit 15: reserved
fBits(bool b0, bool b1, bool b2, bool b3, bool b4, bool b5, bool b6, bool b7, bool b8, bool b9, bool b10, bool b11, bool b12, bool b13, bool b14, bool b15) =>
    (b0?"1":"0")+(b1?"1":"0")+(b2?"1":"0")+(b3?"1":"0")+(b4?"1":"0")+(b5?"1":"0")+(b6?"1":"0")+(b7?"1":"0")+(b8?"1":"0")+(b9?"1":"0")+(b10?"1":"0")+(b11?"1":"0")+(b12?"1":"0")+(b13?"1":"0")+(b14?"1":"0")+(b15?"1":"0")

// Alert comment tag: strategy name + exact price at alert fire + UTC time + trade number + 16-bit condition bitmask
// Format: "UHV@5115.4_1:09_#42#0110100001100000"
fCT(_strat, _num, _bits, float _en = na) =>
    _h = hour(timenow, "UTC")
    _m = minute(timenow, "UTC")
    _strat + "@" + str.tostring(na(_en) ? close : _en, "#.##") + "_" + str.tostring(_h) + ":" + (_m < 10 ? "0" : "") + str.tostring(_m) + "_#" + str.tostring(_num) + "#" + _bits

// PineConnector alert message builder — respects pcSL / pcTP / pcOT settings
// _isBull: true = buy, false = sell | _lots: effective lot size | _entry/_sl/_tp: computed prices | _bits: 16-bit condition bitmask
fPC(_isBull, _lots, _entry, _sl, _tp, _strat, _num, _bits) =>
    _dir     = _isBull ? "buy" : "sell"
    _slPart  = pcSL == "Price" ? ",sl_price=" + str.tostring(_isBull ? _entry - _sl * pPip : _entry + _sl * pPip, "#.####") : ",sl_pips=" + str.tostring(math.round(_sl * pPip / pcBrkPip), "0")
    _tpPart  = pcTP == "Price" ? ",tp_price=" + str.tostring(_isBull ? _entry + _tp * pPip : _entry - _tp * pPip, "#.####") : ",tp_pips=" + str.tostring(math.round(_tp * pPip / pcBrkPip), "0")
    _otPart  = pcOT == "Limit" ? ",ordertype=limit,price=" + str.tostring(_entry, "#.####") : ""
    _spPart  = pcSpread > 0 ? ",spread=" + str.tostring(pcSpread) : ""
    _beTrig  = uBEon ? math.round(_tp * (uBEPct / 100.0) * pPip / pcBrkPip) : pcBETrig
    _beOff   = uBELkTP ? _beTrig : pcBEOff
    _bePart  = _beTrig > 0 ? ",betrigger=" + str.tostring(_beTrig) + (_beOff > 0 ? ",beoffset=" + str.tostring(_beOff) : "") : ""
    _trPart  = pcTDist > 0 ? ",traildist=" + str.tostring(pcTDist) + (pcTTrig > 0 ? ",trailtrig=" + str.tostring(pcTTrig) : "") + ",trailstep=" + str.tostring(pcTStep) : ""
    _slVal   = pcSL == "Price" ? str.tostring(_isBull ? _entry - _sl * pPip : _entry + _sl * pPip, "#.##") : str.tostring(math.round(_sl * pPip / pcBrkPip), "0")
    _tpVal   = pcTP == "Price" ? str.tostring(_isBull ? _entry + _tp * pPip : _entry - _tp * pPip, "#.##") : str.tostring(math.round(_tp * pPip / pcBrkPip), "0")
    _cmt     = str.tostring(_lots, "0.00") + "#sl=" + _slVal + "#tp=" + _tpVal + (pcSpread > 0 ? "#sd=" + str.tostring(pcSpread) : "") + (_beTrig > 0 ? "#bt=" + str.tostring(_beTrig) + (_beOff > 0 ? "#bo=" + str.tostring(_beOff) : "") : "") + (pcTDist > 0 ? "#td=" + str.tostring(pcTDist) + (pcTTrig > 0 ? "#tt=" + str.tostring(pcTTrig) : "") + "#ts=" + str.tostring(pcTStep) : "")
    _base = pLid + "," + _dir + "," + pSym + _otPart + ",vol_lots=" + str.tostring(_lots, "0.00") + _slPart + _tpPart + _spPart + _bePart + _trPart
    _base + ",comment=" + _cmt

// Developer mode: decode 16-bit condition bitmask + append full alert string to label
fDevLabel(string _bits, string _alertMsg, float _clsAtFire) =>
    string _d = "\n─── DEV ───"
    _d += "\nDir:" + (str.substring(_bits, 0, 1) == "1" ? "SELL" : "BUY")
    _d += " Close@fire:" + str.tostring(_clsAtFire, "#.###")
    _d += " Mode:" + (str.substring(_bits, 1, 2) == "1" ? "IOE" : "Close")
    _stB = str.substring(_bits, 2, 3) + str.substring(_bits, 3, 4)
    _d += " Strat:UHV"
    _d += "\nTrend:" + (str.substring(_bits, 4, 5) == "1" ? (str.substring(_bits, 5, 6) == "1" ? "ON✓" : "ON✗") : "OFF")
    _d += " Sweep:" + (str.substring(_bits, 6, 7) == "1" ? (str.substring(_bits, 7, 8) == "1" ? "req✓" : "req✗") : "off")
    _d += " PreOff:" + (str.substring(_bits, 8, 9) == "1" ? (str.substring(_bits, 9, 10) == "1" ? "co-exist" : "ON") : "OFF")
    _d += "\nTDir:" + (str.substring(_bits, 10, 11) == "1" ? "↑" : "↓")
    _d += " Sess:" + (str.substring(_bits, 11, 12) == "1" ? "✓" : "✗")
    _d += " Vol:" + (str.substring(_bits, 12, 13) == "1" ? (str.substring(_bits, 13, 14) == "1" ? "ON✓" : "ON✗") : "off")
    _d += " OC:" + (str.substring(_bits, 14, 15) == "1" ? (str.substring(_bits, 15, 16) == "1" ? "ON✓" : "ON✗") : "off")
    _alertFmt = str.replace_all(_alertMsg, ",vol_lots=", "\nvol_lots=")
    _alertFmt := str.replace_all(_alertFmt, ",spread=", "\nspread=")
    _alertFmt := str.replace_all(_alertFmt, ",traildist=", "\ntraildist=")
    _alertFmt := str.replace_all(_alertFmt, ",comment=", "\ncomment=")
    _d += "\n" + _alertFmt
    _d

fSU(int b, float sl, float a, color c) =>
    // Pseudo-random ink noise seeded by bar + price — 5 independent sine waves
    _p  = float(b) * 7.391 + sl * 0.031
    _q  = float(b) * 13.71 + sl * 0.053
    _r  = float(b) * 5.13  + sl * 0.019
    _t  = float(b) * 3.77  + sl * 0.041
    _u  = float(b) * 11.23 + sl * 0.027
    _n1 = math.sin(_p + 1.17)
    _n2 = math.sin(_q + 2.33)
    _n3 = math.sin(_r + 0.71)
    _n4 = math.sin(_t + 3.14)
    _n5 = math.cos(_u + 0.53)
    _jt = a * 0.009
    _ph = a * (0.032 + 0.024 * math.abs(_n1))
    // Main wobbly stroke — 6 pts with mixed noise per point, fades right (width 2)
    polyline.new(array.from(chart.point.from_index(b-2,sl+(_n2+_n4*0.4)*_jt*1.4),chart.point.from_index(b-1,sl+_ph*0.52+(_n3+_n5*0.3)*_jt),chart.point.from_index(b,sl+_ph+_n1*_jt*0.6),chart.point.from_index(b+1,sl+_ph*0.44+(_n4+_n2*0.35)*_jt),chart.point.from_index(b+2,sl+(_n5+_n3*0.4)*_jt*1.2),chart.point.from_index(b+3,sl-a*0.007+_n2*_jt*0.6)),curved=true,line_color=c,line_width=2)
    // Thick ink pressure blob at peak — semi-transparent, slightly above arc (3 pts, width 5)
    polyline.new(array.from(chart.point.from_index(b-1,sl+_ph*0.70+_n3*_jt*0.7),chart.point.from_index(b,sl+_ph*1.07+_n2*_jt*0.35),chart.point.from_index(b+1,sl+_ph*0.58+_n4*_jt*0.55)),curved=true,line_color=color.new(c,28),line_width=5)
    // Ink splatter: main dot, near satellite, far stray — opacity falls off
    label.new(b+4,    sl-a*0.011+_n4*a*0.020,"•",style=label.style_none,textcolor=c,size=size.small)
    label.new(b+4+b%2,sl+_n2*a*0.025,        "•",style=label.style_none,textcolor=color.new(c,40),size=size.tiny)
    label.new(b+3+b%3,sl+_ph*0.18+_n3*a*0.033,"•",style=label.style_none,textcolor=color.new(c,65),size=size.tiny)

fSU2(int b, float sl, float tp, float en, float a) =>
    fSU(b, sl, a, color.red)
    fSU(b, tp, a, color.lime)
    fSU(b, en, a, color.black)

// Hand-drawn tick (✓) in pink — used at TP hit candle
fTick(int b, float pr, float a) =>
    _p  = float(b)*7.391+pr*0.031
    _q  = float(b)*13.71+pr*0.053
    _r  = float(b)*5.13 +pr*0.019
    _t  = float(b)*3.77 +pr*0.041
    _n1 = math.sin(_p+1.17)
    _n2 = math.sin(_q+2.33)
    _n3 = math.sin(_r+0.71)
    _n4 = math.sin(_t+3.14)
    _jt  = a*0.008
    _dip = a*0.038
    _ris = a*0.068
    _c   = color.new(#FF69B4,0)
    polyline.new(array.from(chart.point.from_index(b-2,pr+_n1*_jt*1.2),chart.point.from_index(b-1,pr-_dip+(_n2+_n3*0.3)*_jt*0.7),chart.point.from_index(b+1,pr+_ris*0.55+(_n4+_n1*0.25)*_jt),chart.point.from_index(b+2,pr+_ris+_n3*_jt*0.9)),curved=true,line_color=_c,line_width=3)
    polyline.new(array.from(chart.point.from_index(b-1,pr-_dip*0.62+_n2*_jt*0.8),chart.point.from_index(b,pr-_dip*1.1+_n1*_jt*0.3),chart.point.from_index(b+1,pr-_dip*0.48+_n3*_jt*0.7)),curved=true,line_color=color.new(_c,30),line_width=4)
    label.new(b+3,    pr+_ris*0.85+_n4*a*0.018,"•",style=label.style_none,textcolor=_c,size=size.small)
    label.new(b+3+b%2,pr+_n2*a*0.022,          "•",style=label.style_none,textcolor=color.new(_c,45),size=size.tiny)
    label.new(b+2+b%3,pr-_dip*0.3+_n1*a*0.015, "•",style=label.style_none,textcolor=color.new(_c,65),size=size.tiny)

// Hand-drawn cross (✗) in blood red — used at SL hit candle
fCross(int b, float pr, float a) =>
    _p  = float(b)*7.391+pr*0.031
    _q  = float(b)*13.71+pr*0.053
    _r  = float(b)*5.13 +pr*0.019
    _t  = float(b)*3.77 +pr*0.041
    _n1 = math.sin(_p+1.17)
    _n2 = math.sin(_q+2.33)
    _n3 = math.sin(_r+0.71)
    _n4 = math.sin(_t+3.14)
    _jt  = a*0.008
    _arm = a*0.042
    _c   = color.new(#8B0000,0)
    polyline.new(array.from(chart.point.from_index(b-2,pr+_arm+(_n1+_n3*0.3)*_jt),chart.point.from_index(b,pr+(_n2+_n4*0.25)*_jt*0.5),chart.point.from_index(b+2,pr-_arm+(_n3+_n1*0.3)*_jt*0.8)),curved=true,line_color=_c,line_width=2)
    polyline.new(array.from(chart.point.from_index(b-2,pr-_arm+(_n2+_n4*0.3)*_jt*0.9),chart.point.from_index(b,pr+(_n1+_n3*0.25)*_jt*0.4),chart.point.from_index(b+2,pr+_arm+(_n4+_n2*0.3)*_jt*0.7)),curved=true,line_color=_c,line_width=2)
    label.new(b+3,    pr-_arm*0.4+_n1*a*0.018,"•",style=label.style_none,textcolor=_c,size=size.small)
    label.new(b+3+b%2,pr+_n3*a*0.022,         "•",style=label.style_none,textcolor=color.new(_c,45),size=size.tiny)
    label.new(b+2+b%3,pr+_arm*0.5+_n2*a*0.016,"•",style=label.style_none,textcolor=color.new(_c,65),size=size.tiny)

// -- Independent Bar detection (Block A) --
// Use trend engine direction (_ib/_ibr) — NOT _lb — so the IB
// fires based on current momentum, not the lagging FVG zone direction.
// This fixes the case where the big initial drop happens before _lb has flipped.
//
// Bull IB: trend is up, green candle closes above previous bar HIGH, bear seen since last IB
_bFA = not rPOI or (pHL or pSup) or (_hFvg and (not _fU or (not na(_hZIB) and _hZIB)))
// Allow bull IB to cancel an active bear retracement (and vice versa) so we get
// a fresh setup immediately instead of waiting for the old one to fully expire.
_bIB = _ib and _bFA and (not _iR or (_iR and not _rwb)) and _iGr and not na(high[1]) and close > high[1]

// Bear IB: trend is down, red candle closes below previous bar LOW, green seen since last IB
// Allow even if _fU=true (from old bull trade) as long as bear HTF zone exists
// Allow bear IB to cancel an active bull retracement so we don't miss bear setups.
_beFA = not rPOI or (pHL or pSup) or (_hFvg and (not _fU or (not na(_hZIB) and not _hZIB)))
_beIB = _ibr and _beFA and (not _iR or (_iR and _rwb)) and _iRd and not na(low[1]) and close < low[1]

// Count IBs blocked only by opposing-candle requirement

if _bIB and not _ibT
    // Cancel any active opposite (bear) retracement before starting bull IB phase
    if _iR and not _rwb
        _iR := false
        _fR := false
        _uVol := 0.0
        _uHi := na
        _uLo := na
        _uBar := na
        _uLSw := false
        _uHSw := false
        _rceLo := na
        _rceHi := na
        _bL := na
        _bT := false
        _uF := false
        if not na(_pnHL)
            line.delete(_pnHL)
        if not na(_pnSp)
            line.delete(_pnSp)
        _pnHL := na
        _pnSp := na
        _plHL := na
        _plSp := na
    _rceLo  := na
    _rceHi  := na
    _ibT       := true
    _rwb   := true
    _rCeil   := high
    _sbIB  := false
    _lb       := true
    // FVG zone refresh (only when FVG POI is enabled)
    if pFvg
        _bullZoneFound = false
        _bSize2 = array.size(_hFBx)
        if _bSize2 > 0
            float _bestTop2 = na
            float _bestBot2 = na
            _bestDist2 = 1e10
            for _bzi2 = 0 to _bSize2 - 1
                if array.get(_hFBl, _bzi2)
                    _zt2 = array.get(_hFTp, _bzi2)
                    _zb2 = array.get(_hFBt, _bzi2)
                    if _zt2 < close
                        _dist2 = close - _zt2
                        if _dist2 < _bestDist2
                            _bestDist2 := _dist2
                            _bestTop2  := _zt2
                            _bestBot2  := _zb2
                            _bullZoneFound := true
            if _bullZoneFound
                _fZT := _bestTop2
                _fZB := _bestBot2
                _fU    := false
                _hFvg     := true
        if not _bullZoneFound and not na(_hZIB) and _hZIB and not na(_hZT) and not na(_hZB)
            _fZT := _hZT
            _fZB := _hZB
            _fU    := false
            _hFvg     := true
    // Higher Low POI line
    if pHL
        if not na(_pnHL)
            line.delete(_pnHL)
        _plHL := fHL(pLb)
        if not na(_plHL)
            _pnHL := line.new(bar_index, _plHL, bar_index + 50, _plHL, extend = extend.right, style = line.style_dashed, color = color.new(color.yellow, 20), width = 2)
    // Support flip POI line
    if pSup
        if not na(_pnSp)
            line.delete(_pnSp)
        _plSp := fSup(pLb)
        if not na(_plSp)
            _pnSp := line.new(bar_index, _plSp, bar_index + 50, _plSp, extend = extend.right, style = line.style_dashed, color = color.new(color.orange, 20), width = 2)
    if sDb
        label.new(bar_index, low, "IB↑", style = label.style_label_up, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

if _beIB and not _ibT
    // Cancel any active opposite (bull) retracement before starting bear IB phase
    if _iR and _rwb
        _iR := false
        _fR := false
        _uVol := 0.0
        _uHi := na
        _uLo := na
        _uBar := na
        _uLSw := false
        _uHSw := false
        _rceLo := na
        _rceHi := na
        _bL := na
        _bT := false
        _uF := false
        if not na(_pnHL)
            line.delete(_pnHL)
        if not na(_pnSp)
            line.delete(_pnSp)
        _pnHL := na
        _pnSp := na
        _plHL := na
        _plSp := na
    _rceLo  := na
    _rceHi  := na
    _ibT       := true
    _rwb   := false
    _rFlr     := low
    _sgIB := false
    _lb       := false
    // FVG zone refresh (only when FVG POI is enabled)
    if pFvg
        _bearZoneFound = false
        _bSize = array.size(_hFBx)
        if _bSize > 0
            float _bestTop = na
            float _bestBot = na
            _bestDist = 1e10
            for _bzi = 0 to _bSize - 1
                if not array.get(_hFBl, _bzi)
                    _zt = array.get(_hFTp, _bzi)
                    _zb = array.get(_hFBt, _bzi)
                    if _zb > close
                        _dist = _zb - close
                        if _dist < _bestDist
                            _bestDist := _dist
                            _bestTop  := _zt
                            _bestBot  := _zb
                            _bearZoneFound := true
            if _bearZoneFound
                _fZT := _bestTop
                _fZB := _bestBot
                _fU    := false
                _hFvg     := true
        if not _bearZoneFound and not na(_hZIB) and not _hZIB and not na(_hZT) and not na(_hZB)
            _fZT := _hZT
            _fZB := _hZB
            _fU    := false
            _hFvg     := true
    // Lower High POI line
    if pHL
        if not na(_pnHL)
            line.delete(_pnHL)
        _plHL := fLH(pLb)
        if not na(_plHL)
            _pnHL := line.new(bar_index, _plHL, bar_index + 50, _plHL, extend = extend.right, style = line.style_dashed, color = color.new(color.yellow, 20), width = 2)
    // Resistance flip POI line
    if pSup
        if not na(_pnSp)
            line.delete(_pnSp)
        _plSp := fRes(pLb)
        if not na(_plSp)
            _pnSp := line.new(bar_index, _plSp, bar_index + 50, _plSp, extend = extend.right, style = line.style_dashed, color = color.new(color.orange, 20), width = 2)
    if sDb
        label.new(bar_index, high, "IB↓", style = label.style_label_down, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

// Reset IB tracking if trend flips opposite, or no FVG zone (FVG mode only)
if _ibT and not _hFvg and pFvg
    _ibT := false
if _ibT and _rwb and _ibr
    _ibT := false
if _ibT and not _rwb and _ib
    _ibT := false

int _euCd = uCd

// -- Retracement trigger (Block A): close breaks prior bar's extreme --
// Bull retrace: while tracking IB, a bear candle closes below previous bar's LOW
// Bear retrace: while tracking IB, a bull candle closes above previous bar's HIGH
_bRet = _ibT and _rwb and _iRd and not na(low[1]) and close < low[1]
_beRet = _ibT and not _rwb and _iGr and not na(high[1]) and close > high[1]

if _bRet
    _ibT      := false
    _iR   := true
    _rwb  := true
    _rSB := bar_index
    _uVol   := volume
    _uHi    := high
    _uSl    := low
    _uLo    := na
    _uLSw   := false
    _uHSw   := false
    _uBar   := bar_index
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    _rceLo    := math.min(low, nz(_rceLo, low))
    _rceHi   := math.max(high, nz(_rceHi, high))
    _bL     := high
    _bT          := false
    _uF     := false
    _uWB         := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr  := _tS

if _beRet
    _ibT      := false
    _iR   := true
    _rwb  := false
    _rSB := bar_index
    _uVol    := volume
    _uBar       := bar_index
    _uLo       := low
    _uSl        := high
    _uHSw := false
    _uLSw  := false
    _uHi      := na
    _rceLo   := math.min(low, nz(_rceLo, low))
    _rceHi  := math.max(high, nz(_rceHi, high))
    _bL     := low
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bT          := false
    _uF     := false
    _uWB         := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr   := _tS

// BYPASS RETRACEMENT — fires when bRW is ON, skipping IB phase + trend check
// Bull: red candle closes below prior green candle's low
if bRW and not _iR and not _ibT and _iRd and close[1] > open[1] and (bRWW ? low < low[1] : close < low[1])
    _iR     := true
    _rwb    := true
    _lb     := true
    _rCeil  := high[1]
    _fR     := false
    _rSB    := bar_index
    _uVol   := volume
    _uHi    := high
    _uSl    := low
    _uLo    := na
    _uLSw   := false
    _uHSw   := false
    _uBar   := bar_index
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    _rceLo  := low
    _rceHi  := high
    _bL     := high
    _bT     := false
    _uF     := false
    _uWB    := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr   := _tS

// Bear: green candle closes above prior red candle's high
if bRW and not _iR and not _ibT and _iGr and close[1] < open[1] and (bRWW ? high > high[1] : close > high[1])
    _iR     := true
    _rwb    := false
    _lb     := false
    _rFlr   := low[1]
    _fR     := false
    _rSB    := bar_index
    _uVol   := volume
    _uBar   := bar_index
    _uLo    := low
    _uSl    := high
    _uHSw   := false
    _uLSw   := false
    _uHi    := na
    _rceLo  := low
    _rceHi  := high
    _bL     := low
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bT     := false
    _uF     := false
    _uWB    := false
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _uReBnc := false
    _sStr   := _tS

// STEP 3: Retracement touches any enabled Point of Interest
// _fR = true when ANY one of the enabled POI types is touched
if (_iR or _ibT) and not _fR
    // FVG zone touch
    if pFvg and not na(_fZT) and not na(_fZB)
        if low <= _fZT and high >= _fZB
            _fR := true
            if sDb
                if _lb
                    label.new(bar_index, _fZT, "📍 FVG", style = label.style_label_down, color = color.new(#787b86, 10), textcolor = color.white, size = size.tiny)
                else
                    label.new(bar_index, _fZB, "📍 FVG", style = label.style_label_up, color = color.new(#787b86, 10), textcolor = color.white, size = size.tiny)
    // Higher Low / Lower High touch
    if pHL and not na(_plHL) and not _fR
        if _lb ? low <= _plHL : high >= _plHL
            _fR := true
            if sDb
                label.new(bar_index, _plHL, "📍 HL", style = label.style_label_down, color = color.new(color.yellow, 10), textcolor = color.black, size = size.tiny)
    // Support / Resistance flip touch
    if pSup and not na(_plSp) and not _fR
        if _lb ? low <= _plSp : high >= _plSp
            _fR := true
            if sDb
                label.new(bar_index, _plSp, "📍 S/R", style = label.style_label_down, color = color.new(color.orange, 10), textcolor = color.white, size = size.tiny)

// TREND PERSISTENCE (needed by both _tFlp and breakout checks)
_bPC = 0
_bePC = 0
for _pi = 0 to tPB - 1
    _bPC += _ib[_pi] ? 1 : 0
    _bePC += _ibr[_pi] ? 1 : 0
_bTP = _bPC >= math.round(tPB * 0.6)
_beTP = _bePC >= math.round(tPB * 0.6)

// Structural trend via confirmed swing pivots (HH+HL = uptrend, LH+LL = downtrend)
_swPH = ta.pivothigh(high, 5, 5)
_swPL = ta.pivotlow(low,  5, 5)
if not na(_swPH)
    _sH2 := _sH1
    _sH1 := _swPH
if not na(_swPL)
    _sL2 := _sL1
    _sL1 := _swPL
_strUp = not rSwT or (not na(_sH1) and not na(_sH2) and not na(_sL1) and not na(_sL2) and _sH1 > _sH2 and _sL1 > _sL2)
_strDn = not rSwT or (not na(_sH1) and not na(_sH2) and not na(_sL1) and not na(_sL2) and _sH1 < _sH2 and _sL1 < _sL2)

// Trend shifting: strength has dropped by threshold or more since this setup began
// Per-strategy so each can be toggled independently
_tsA = _iR and not na(_sStr) and (_sStr - _tS >= tSTh)
_tsU    = aTS and aTSU and _tsA

// STEP 3b: TREND FLIP CANCELLATION + RETRACEMENT EXPIRY
if _iR
    _tmo         = not na(_rSB) and (bar_index - _rSB) > 100
    _retExp   = _tmo
    // Per-strategy early bounce-back: fires when price returns to IB level before touching any POI
    _eBncCond = _lb ? (not na(_rCeil) and close >= _rCeil and not _fR) : (not na(_rFlr) and close <= _rFlr and not _fR)
    if _eBncCond
        if uREU
            _uReBnc := true
            _uWB    := true  // mark UHV as serviced so setup can end via _aSFrd

    // Only cancel retracement if trend has persistently flipped (not just one candle flicker)
    // Use _bePC / _bPC so short 1m noise doesn't kill the setup
    _tkB = _lb  and _bePC >= math.round(tPB * 0.8)
    _tkBr = not _lb and _bPC >= math.round(tPB * 0.8)
    _tFlp = _tkB or _tkBr

    // NEW: if price bounces back above IB ceiling (bull) or below IB floor (bear)
    // AFTER already touching FVG, cancel so a fresh IB+retrace can start
    // This is what allows the second and third drops in the same zone to each get a Retrace label
    _boB = _fR and _lb  and not na(_rCeil) and close > _rCeil
    _boBr = _fR and not _lb and not na(_rFlr)   and close < _rFlr
    _uBeF = _iRd and not na(_bL) and not na(_uBar) and close < _bL and not _uF
    _uBF = _iGr and not na(_bL) and not na(_uBar) and close > _bL and not _uF
    _aSF  = _uBeF or _uBF
    _uDOB = _uF or _uWB
    _nYF    = not _uDOB
    _bnC     = (_boB or _boBr) and not _aSF and _nYF

    if _tFlp or _retExp or _bnC
        _iR := false
        _ibT    := false
        _fR    := false
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLSw   := false
        _uHSw  := false
        _rceLo    := na
        _rceHi   := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        if not na(_pnHL)
            line.delete(_pnHL)
        if not na(_pnSp)
            line.delete(_pnSp)
        _pnHL          := na
        _pnSp         := na
        _plHL         := na
        _plSp        := na
        _uReBnc := false
        if sDb and _bnC
            _lbl = _lb ? _rCeil : _rFlr
            label.new(bar_index, _lbl, "↺ Reset", style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)

// Update structural low/high throughout the retracement (NOT during _ibT — that phase
// includes rising candles before the pullback, which would push _rceLo too low)
if _iR
    if _lb and (na(_rceLo) or low < _rceLo)
        _rceLo  := low
    if not _lb and (na(_rceHi) or high > _rceHi)
        _rceHi := high
    // Keep POI lines extended to current bar so they always reach the right edge
    if not na(_pnHL) and not na(_plHL)
        line.set_x2(_pnHL, bar_index + 20)
    if not na(_pnSp) and not na(_plSp)
        line.set_x2(_pnSp, bar_index + 20)

// STEP 4: UHV — Highest Volume Candle During Retracement
// Compare volume WITHIN the retracement only (not vs prior impulse bars)
// _uVol starts at 0.0 when retracement begins, so first red/green candle always qualifies
// UHV = highest volume candle during retracement (any color — fast 1m pullbacks often have no clean red candle)
if _iR and _lb and _iRd and not _uF and volume > _uVol and (not uVTOn or ta.percentrank(volume, uVLB) >= uVT)
    _uVol   := volume
    _uHi     := high
    _uSl       := low
    _uLSw := false
    _uBar      := bar_index
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    _bL := high

if _iR and not _lb and _iGr and not _uF and volume > _uVol and (not uVTOn or ta.percentrank(volume, uVLB) >= uVT)
    _uVol    := volume
    _uLo       := low
    _uSl        := high
    _uHSw := false
    _uBar       := bar_index
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bL := low

// STEP 4b: TRACK UHV LOW SWEEP
// Bull: UHV red low must be swept (wick or close below) before breakout fires
// Bear: no sweep requirement — red candle just needs to close below UHV green low
if _iR and _lb and not na(_uSl) and not _uLSw
    if low < _uSl or close < _uSl
        _uLSw := true

if _iR and not _lb and not na(_uSl) and not _uHSw
    if high > _uSl or close > _uSl
        _uHSw := true

// Per-strategy direction filters
_uBDir  = uDir != "Bear only"
_uBeDir  = uDir != "Bull only"

bool   _erUS  = rUS
bool   _erULV = rULV
string _euST  = uST
float  _euTD  = uTD
bool   _euBD  = _uBDir
bool   _euBeD = _uBeDir

// -- Max Trades Mode — override all optional filters and cooldowns --
bool _eStU = not mTM and (sTC and sTCU)
int  _eMS    = mTM ? 0 : mTS
bool _eTsU     = not mTM and _tsU
if mTM
    _euCd     := 0
    _erUS     := false


// Per-strategy FVG width + touch checks
_a144   = nz(ta.atr(144))
_fW        = nz(_fZT, 0.0) - nz(_fZB, 0.0)
_uFW  = uFTH == 0 or _fW >= _a144 * uFTH
_uFC = mTM ? true : rFT ? (_fR and _uFW) : true
bool _cUB  = cLP and _uBT  >= 10 and _uBP  < 0.0
bool _cUBe = cLP and _uBeT >= 10 and _uBeP < 0.0

// STEP 5: BREAKOUT — Absorption Signal
_uHTFB = request.security(syminfo.tickerid, uHTD == "Off" ? timeframe.period : uHTD, close >= open)
_uMomBOk  = (not uMomB or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (close[1]-open[1])/_cRng[1] >= uMomBR/100.0) : (_cRng > 0 and (close-open)/_cRng >= uMomBR/100.0))) and (not uMomW or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (high[1]-close[1])/_cRng[1] <= uMomWk/100.0 and (open[1]-low[1])/_cRng[1] <= uMomWk/100.0) : (_cRng > 0 and (high-close)/_cRng <= uMomWk/100.0 and (open-low)/_cRng <= uMomWk/100.0)))
_uMomBeOk = (not uMomB or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (open[1]-close[1])/_cRng[1] >= uMomBR/100.0) : (_cRng > 0 and (open-close)/_cRng >= uMomBR/100.0))) and (not uMomW or (uOE == "Instant at Breakout" ? (_cRng[1] > 0 and (high[1]-open[1])/_cRng[1] <= uMomWk/100.0 and (close[1]-low[1])/_cRng[1] <= uMomWk/100.0) : (_cRng > 0 and (high-open)/_cRng <= uMomWk/100.0 and (close-low)/_cRng <= uMomWk/100.0)))
_uBVOk    = not uBrkVROn or volume <= _uVol * (1.0 - uBrkVR/100.0)
_uPBMok   = uPBD <= 0.0 or uOE == "Instant at Breakout" or close > close[1]   // pre-breakout momentum guard: bull — price must be rising bar-over-bar (skipped for IOE: bar hasn't closed yet)
_uPBMbok  = uPBD <= 0.0 or uOE == "Instant at Breakout" or close < close[1]   // pre-breakout momentum guard: bear — price must be falling bar-over-bar (skipped for IOE: bar hasn't closed yet)
bool _uIOE = uOE == "Instant at Breakout"
float _bTrigEff  = uPBCo and uPBD > 0 and not (low  <= _bL + uPBsD - uPBD) ? _bL + uPBsD : _bL + uPBsD - uPBD
float _beTrigEff = uPBCo and uPBD > 0 and not (high >= _bL - uPBsD + uPBD) ? _bL - uPBsD : _bL - uPBsD + uPBD
bool  _bBrkPO    = low  <= _bTrigEff  and (_uIOE ? (uBrkBody ? close > _bTrigEff  : high > _bTrigEff)  : close > _bTrigEff)
bool  _beBrkPO   = high >= _beTrigEff and (_uIOE ? (uBrkBody ? close < _beTrigEff : low  < _beTrigEff) : close < _beTrigEff)
if bar_index != _uAlBi
    _uAlF  := false
    _uAlBi := bar_index
_bBrk = _euBD and eUHV and _iR and _lb and _rwb and not _uReBnc and (_eStU ? (_hb and _bTP) : not _beTP) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and (_erUS ? _uLSw : true) and (_erULV ? volume < _uVol : true) and not _eTsU and _iGr and _bBrkPO and (bar_index - _luSB) >= _euCd and not _cUB and _strUp and _uMomBOk and _uBVOk and _uPBMok and (uHTD == "Off" or _uHTFB) and not _isRng and not _ntBlock and (_uIOE or barstate.isconfirmed)

// -- Blocked-signal detection (for recommendation engine) --
// UHV bull: would have fired without sweep requirement
_uBBase = _euBD and eUHV and _iR and _lb and _rwb and ((sTC and sTCU) ? (_hb and _bTP) : not _beTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iGr and low <= _bL and close > _bL
if _uBBase and _erUS and not _uLSw and _tS >= mTS
    _bSwp += 1
    _uWB := true
// UHV bull: would have fired without volume requirement
if _uBBase and (_erUS ? _uLSw : true) and _erULV and volume >= _uVol and _tS >= mTS and (bar_index - _luSB) >= _euCd and not _tsU
    _bUV += 1
    _uWB := true
// Blocked by trend strength (sweep ok, everything else ok, only strength fails)
if _uBBase and (_erUS ? _uLSw : true) and _tS < mTS and (bar_index - _luSB) >= _euCd
    _bStr += 1
// Blocked by cooldown (everything ok except cooldown)
if _uBBase and (_erUS ? _uLSw : true) and _tS >= mTS and (bar_index - _luSB) < _euCd
    _bCd += 1
    _uWB := true
// Blocked by trend shift — mark serviced
if _uBBase and (_erUS ? _uLSw : true) and (bar_index - _luSB) >= _euCd and _tsU
    _uWB := true
// Blocked by strict trend check — relaxed mode would pass (not _beTP) but _hb+persistence fails
if eUHV and _iR and _lb and _rwb and not _beTP and (sTC and sTCU) and not (_hb and _bTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iGr and low <= _bL and close > _bL and (_erUS ? _uLSw : true) and (bar_index - _luSB) >= _euCd
    _uWB := true

int _nU = math.max(1, _uTr > 19 ? _uWn * 50 / _uTr - 44 : 0)
float _lOp = 0.
if array.size(_tEn) > 0
    for i = 0 to array.size(_tEn) - 1
        if not array.get(_tSH, i) and not array.get(_tTH, i)
            _lOp += math.abs(array.get(_tEn, i) - array.get(_tSl, i)) * array.get(_tEL, i) * cM

if _bBrk
    _entry    = _uIOE ? _bTrigEff : close
    _sl       = uSLPips > 0 ? _entry - uSLPips * pPip : fSL(true, _entry, _euST == "Prev Candle" ? low[1] : _euST == "UHV" ? nz(_uSl, nz(_rceLo, low)) : nz(_rceLo, nz(_uSl, low)), high, _euST, uSBf, uSAm, uSSw, uSMn + uSpread, uDR, uLS, uSDo, float(na))
    _slDist   = math.max(_entry - _sl, uSMn)
    _effLots  = (uDR > 0 ? math.max(uDR / (_slDist * cM), mLot) : uRp > 0 ? math.max(iMon * uRp / 100.0 / math.max(_slDist * cM, syminfo.mintick), mLot) : uLS) * lA
    float _tp1 = uTPPips > 0 ? _entry + uTPPips * pPip : fTP(_entry, uTM == "Structural High/Low" ? nz(_rCeil, _entry + _slDist * uT1) - uSHLOff : uTM == "Dollar Amount" ? _entry + _euTD : _entry + _slDist * uT1)
    if _tp1 <= _entry  // TP at or below entry for buy → structural ceiling below entry; force dollar fallback
        _tp1 := fTP(_entry, _entry + _euTD)
    if _uIOE and pcOT != "Limit" and uIOEGrd > 0 and _tp1 <= close + uSpread * uIOEGrd  // IOE guard: recalc TP from current close if too close — applies regardless of alert format
        _tp1 := fTP(close, uTPPips > 0 ? close + uTPPips * pPip : (uTM == "Dollar Amount" ? close + _euTD : close + _slDist * uT1))
    bool _safe = _inSess and _lOp + _slDist * _effLots * cM <= iMon * 0.5
    if not _uAlF  // once-per-bar gate: varip prevents all side-effects from re-firing on every IOE tick
        _uAlF := true
        if _safe
            _uF := true
            _luSB := bar_index
            string _bits = fBits(false, _uIOE, false, false, _eStU, _eStU and _hb and _bTP, _erUS, _erUS and _uLSw, uPBD > 0, uPBCo and uPBD > 0 and not (low <= _bL + uPBsD - uPBD), true, _inSess, false, false, false, false)
            float _aSlB = pATon and _atValid and _uIOE ? _atSlipB : 0.
            _uPndEn   := _entry
            _uPndSL   := math.max(math.round(math.abs(_entry - (_sl + _aSlB)) / pPip), int(uSMn / pPip))
            _uPndTP   := math.round(math.abs((_tp1 + _aSlB) - _entry) / pPip)
            _uPndLt   := math.round(_effLots, 2)
            _uPndTS   := _tS
            _uPndN    := dayofmonth * 10000 + hour * 100 + minute
            _uPndBits := _bits
            _sigChkW  := _uPndEn + _uPndSL + _uPndTP + _uPndLt
            _lastAlertMsg := fPC(true, _uPndLt, _uPndEn, useInvalidation ? float(iExHSL) : _uPndSL, _uPndTP, "UHV", _uPndN, _uPndBits)
            _uPndMsg  := _lastAlertMsg
            bool _gateOkU = uAlGt < 0.0 or close < (_uPndEn + _uPndTP * pPip) - math.max(uAlGt, 0.0)
            if _gateOkU
                _sigT += 1
                _alT += 1
                alert(pE ? _lastAlertMsg : "🟢 BUY Signal — UHV Breakout | Entry: " + str.tostring(_uPndEn, "#.###") + " | " + syminfo.ticker, alert.freq_all)
                _lastSigTxt := "BUY NOW  #" + str.tostring(_uPndN) + "\n(UHV Breakout)  ⏰ " + fTS() + "\nEntry: " + str.tostring(_uPndEn, "#.###") + "\nSL:    " + str.tostring(_uPndEn - _uPndSL * pPip, "#.###") + "  -$" + str.tostring(math.round(_uPndSL * pPip * _uPndLt * cM * 100) / 100, "#.##") + "  [" + _euST + ", risk: " + str.tostring(_uPndSL * pPip * _uPndLt * cM / iMon * 100, "#.##") + "%]" + "\nLots:  " + fLL(uDR, _uPndLt, uRp > 0) + "\nTP:    " + str.tostring(_uPndEn + _uPndTP * pPip, "#.###") + "  +$" + str.tostring(math.round(_uPndTP * pPip * _uPndLt * cM * 100) / 100, "#.##") + "\n" + fAS(_uWn, _uTr) + "\n" + fPTS(_uPT) + (uDev and str.length(_uPndBits) > 0 ? fDevLabel(_uPndBits, _uPndMsg, _uPndEn) : "")
                _uPendBull := true
        else
            label.new(bar_index, high, "⚠️ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)

// UHV bear: base condition (without sweep/vol/strength/cooldown) for blocked-counter tracking
_uBeBase = _euBeD and eUHV and _iR and not _lb and not _rwb and ((sTC and sTCU) ? (_hbr and _beTP) : not _bTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iRd and close < _bL
if _uBeBase and _erUS and not _uHSw and _tS >= mTS
    _bSwp += 1
    _uWB := true
// UHV bear: would have fired without volume requirement
if _uBeBase and (_erUS ? _uHSw : true) and _erULV and volume >= _uVol and _tS >= mTS and (bar_index - _luSB) >= _euCd and not _tsU
    _bUV += 1
    _uWB := true
// Blocked by trend strength
if _uBeBase and (_erUS ? _uHSw : true) and _tS < mTS and (bar_index - _luSB) >= _euCd
    _bStr += 1
// Blocked by cooldown
if _uBeBase and (_erUS ? _uHSw : true) and _tS >= mTS and (bar_index - _luSB) < _euCd
    _bCd += 1
    _uWB := true
// Blocked by trend shift — mark serviced
if _uBeBase and (_erUS ? _uHSw : true) and (bar_index - _luSB) >= _euCd and _tsU
    _uWB := true
// Blocked by strict trend check — relaxed mode would pass (not _bTP) but _hbr+persistence fails
if eUHV and _iR and not _lb and not _rwb and not _bTP and (sTC and sTCU) and not (_hbr and _beTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iRd and close < _bL and (_erUS ? _uHSw : true) and (bar_index - _luSB) >= _euCd
    _uWB := true

_beBrk = _euBeD and eUHV and _iR and not _lb and not _rwb and not _uReBnc and (_eStU ? (_hbr and _beTP) : not _bTP) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and (_erUS ? _uHSw : true) and (_erULV ? volume < _uVol : true) and not _eTsU and _iRd and _beBrkPO and (bar_index - _luSB) >= _euCd and not _cUBe and _strDn and _uMomBeOk and _uBVOk and _uPBMbok and (uHTD == "Off" or not _uHTFB) and not _isRng and not _ntBlock and (_uIOE or barstate.isconfirmed)

if _beBrk
    _entry      = _uIOE ? _beTrigEff : close
    _sl         = uSLPips > 0 ? _entry + uSLPips * pPip : fSL(false, _entry, low, _euST == "Prev Candle" ? high[1] : _euST == "UHV" ? nz(_uSl, nz(_rceHi, high)) : nz(_rceHi, nz(_uSl, high)), _euST, uSBf, uSAm, uSSw, uSMn + uSpread, uDR, uLS, uSDo, float(na), float(na))
    _slDist     = math.max(_sl - _entry, uSMn)
    _effLots    = (uDR > 0 ? math.max(uDR / (_slDist * cM), mLot) : uRp > 0 ? math.max(iMon * uRp / 100.0 / math.max(_slDist * cM, syminfo.mintick), mLot) : uLS) * lA
    float _tp1 = uTPPips > 0 ? _entry - uTPPips * pPip : fTP(_entry, uTM == "Structural High/Low" ? nz(_rFlr, _entry - _slDist * uT1) + uSHLOff : uTM == "Dollar Amount" ? _entry - _euTD : _entry - _slDist * uT1)
    if _tp1 >= _entry  // TP at or above entry for sell → structural floor above entry; force dollar fallback
        _tp1 := fTP(_entry, _entry - _euTD)
    if _uIOE and pcOT != "Limit" and uIOEGrd > 0 and _tp1 >= close - uSpread * uIOEGrd  // IOE guard: recalc TP from current close if too close — applies regardless of alert format
        _tp1 := fTP(close, uTPPips > 0 ? close - uTPPips * pPip : (uTM == "Dollar Amount" ? close - _euTD : close - _slDist * uT1))
    bool _safe = _inSess and _lOp + _slDist * _effLots * cM <= iMon * 0.5
    if not _uAlF
        _uAlF := true
        if _safe
            _uF := true
            _luSB := bar_index
            string _bits = fBits(true, _uIOE, false, false, _eStU, _eStU and _hbr and _beTP, _erUS, _erUS and _uHSw, uPBD > 0, uPBCo and uPBD > 0 and not (high >= _bL - uPBsD + uPBD), false, _inSess, false, false, false, false)
            float _aSlBe = pATon and _atValid and _uIOE ? _atSlipS : 0.
            _uPndEn   := _entry
            _uPndSL   := math.max(math.round(math.abs((_sl + _aSlBe) - _entry) / pPip), int(uSMn / pPip))
            _uPndTP   := math.round(math.abs(_entry - (_tp1 + _aSlBe)) / pPip)
            _uPndLt   := math.round(_effLots, 2)
            _uPndTS   := _tS
            _uPndN    := dayofmonth * 10000 + hour * 100 + minute
            _uPndBits := _bits
            _sigChkW  := _uPndEn + _uPndSL + _uPndTP + _uPndLt
            _lastAlertMsg := fPC(false, _uPndLt, _uPndEn, useInvalidation ? float(iExHSL) : _uPndSL, _uPndTP, "UHV", _uPndN, _uPndBits)
            _uPndMsg  := _lastAlertMsg
            bool _gateOkUe = uAlGt < 0.0 or close > (_uPndEn - _uPndTP * pPip) + math.max(uAlGt, 0.0)
            if _gateOkUe
                _sigT += 1
                _alT += 1
                alert(pE ? _lastAlertMsg : "🔴 SELL Signal — UHV Breakout | Entry: " + str.tostring(_uPndEn, "#.###") + " | " + syminfo.ticker, alert.freq_all)
                _lastSigTxt := "SELL NOW  #" + str.tostring(_uPndN) + "\n(UHV Breakout)  ⏰ " + fTS() + "\nEntry: " + str.tostring(_uPndEn, "#.###") + "\nSL:    " + str.tostring(_uPndEn + _uPndSL * pPip, "#.###") + "  -$" + str.tostring(math.round(_uPndSL * pPip * _uPndLt * cM * 100) / 100, "#.##") + "  [" + _euST + ", risk: " + str.tostring(_uPndSL * pPip * _uPndLt * cM / iMon * 100, "#.##") + "%]" + "\nLots:  " + fLL(uDR, _uPndLt, uRp > 0) + "\nTP:    " + str.tostring(_uPndEn - _uPndTP * pPip, "#.###") + "  +$" + str.tostring(math.round(_uPndTP * pPip * _uPndLt * cM * 100) / 100, "#.##") + "\n" + fAS(_uWn, _uTr) + "\n" + fPTS(_uPT) + (uDev and str.length(_uPndBits) > 0 ? fDevLabel(_uPndBits, _uPndMsg, _uPndEn) : "")
                _uPendBear := true
        else
            label.new(bar_index, low, "⚠️ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)

// Deferred UHV label+array creation — runs at bar close (barstate.isconfirmed only; realtime objects are ephemeral)
if (_uPendBull or _uPendBear) and barstate.isconfirmed
    bool _dIsBull = _uPendBull
    _sigChkR  := _uPndEn + _uPndSL + _uPndTP + _uPndLt  // read signal before any use — must equal _sigChkW
    _sigLbl = label(na)
    float _slPrice    = _dIsBull ? _uPndEn - _uPndSL * pPip : _uPndEn + _uPndSL * pPip
    float _tpPrice    = _dIsBull ? _uPndEn + _uPndTP * pPip : _uPndEn - _uPndTP * pPip
    float _uPndSlDist = _uPndSL * pPip
    string _uDevNote = uDev and str.length(_uPndBits) > 0 ? fDevLabel(_uPndBits, _uPndMsg, _uPndEn) : ""
    string _lblTxt = (_dIsBull ? "BUY NOW" : "SELL NOW") + "  #" + str.tostring(_uPndN) + "\n(UHV Breakout)  ⏰ " + fTS() +
         "\nEntry: " + str.tostring(_uPndEn, "#.###") +
         "\nSL:    " + str.tostring(_slPrice, "#.###") + "  -$" + str.tostring(math.round(_uPndSlDist * _uPndLt * cM * 100) / 100, "#.##") + "  [" + _euST + ", risk: " + str.tostring(_uPndSlDist * _uPndLt * cM / iMon * 100, "#.##") + "%]" +
         "\nLots:  " + fLL(uDR, _uPndLt, uRp > 0) +
         "\nTP:    " + str.tostring(_tpPrice, "#.###") + "  +$" + str.tostring(math.round(_uPndTP * pPip * _uPndLt * cM * 100) / 100, "#.##") +
         "\n" + fAS(_uWn, _uTr) + "\n" + fPTS(_uPT) + _uDevNote
    _lastSigTxt := _lblTxt
    if sL
        if _dIsBull
            _sigLbl := label.new(bar_index, high, _lblTxt, style = label.style_label_down, color = color.new(#089981, 0), textcolor = color.white, size = size.normal)
        else
            _sigLbl := label.new(bar_index, low,  _lblTxt, style = label.style_label_up,   color = color.new(#f23645, 0), textcolor = color.white, size = size.normal)
    array.push(_tEn,  _uPndEn)
    array.push(_tSl,  _slPrice)
    array.push(_tTP,  _tpPrice)
    array.push(_tBl,  _dIsBull)
    array.push(_tTH,  false)
    array.push(_tSH,  false)
    array.push(_tBE,  false)
    array.push(_tEL,  _uPndLt)
    array.push(_tTy,  "uhv")
    array.push(_tN,   _uPndN)
    array.push(_tTS,  _uPndTS)
    array.push(_tW,   false)
    array.push(_tLbl, _sigLbl)
    array.push(_tEB,  bar_index)
    array.push(_tIL,  _bL)
    array.push(_tFT,  timenow)
    array.push(_sBT,  bar_index)
    array.push(_sABT, bar_index)
    _bT  := true
    _fU  := true
    if _dIsBull
        _pvHi := _rnHi
        _rnHi := high
        _lgL  := low
        _lgC  := close
        _lrH  := na
        _lrC  := na
        if sCH
            box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.lime, 0), 2, bgcolor=color.new(color.lime, 90))
            box.new(_uBar - 1, _uHi, _uBar + 1, _uSl, color.new(color.yellow, 0), 2, bgcolor=color.new(color.yellow, 90))
        if sL
            float _ahU  = ta.atr(14) * 1.2
            int   _gU   = bar_index - _uBar
            float _pkU  = math.max(_uHi, high) + _ahU
            polyline.new(array.from(chart.point.from_index(_uBar, _uHi), chart.point.from_index(_uBar + _gU / 2, _pkU), chart.point.from_index(bar_index, high)), curved = true, line_color = color.new(#00ff88, 0), line_width = 3)
            label.new(bar_index, high, "", style = label.style_arrowdown, color = color.new(#00ff88, 0), size = size.small)
            fSU2(bar_index, _slPrice, _tpPrice, _uPndEn, _a14)
    else
        _pvLo := _rnLo
        _rnLo := low
        _lrH  := high
        _lrC  := close
        _lgL  := na
        _lgC  := na
        if sCH
            box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.red, 0), 2, bgcolor=color.new(color.red, 90))
            box.new(_uBar - 1, _uSl, _uBar + 1, _uLo, color.new(color.yellow, 0), 2, bgcolor=color.new(color.yellow, 90))
        if sL
            float _ahUe = ta.atr(14) * 2.5
            int   _gUe  = bar_index - _uBar
            float _pkUe = math.min(_uLo, low) - _ahUe
            polyline.new(array.from(chart.point.from_index(_uBar, _uLo), chart.point.from_index(_uBar + _gUe / 2, _pkUe), chart.point.from_index(bar_index, low)), curved = true, line_color = color.new(#ff4444, 0), line_width = 3)
            label.new(bar_index, low, "", style = label.style_arrowup, color = color.new(#ff4444, 0), size = size.small)
            fSU2(bar_index, _slPrice, _tpPrice, _uPndEn, _a14)
    _uPendBull := false
    _uPendBear := false

// End setup when all enabled strategies have fired from this setup
if _iR
    _aSFrd = not eUHV or _uF or _uWB
    if _aSFrd
        _iR := false
        _ibT    := false
        _fR    := false
        if not na(_pnHL)
            line.delete(_pnHL)
        if not na(_pnSp)
            line.delete(_pnSp)
        _pnHL   := na
        _pnSp  := na
        _plHL  := na
        _plSp := na
        _rceLo  := na
        _rceHi  := na

// DAILY RESET
_today = dayofmonth(time)
if _today != _ltd
    _tSAD  += _sigT
    _tAAD  += _alT
    _tDS        += 1
    _sigT         := 0
    _alT          := 0
    _pT             := 0.0
    _uPT          := 0.0
    _tLSt      := 0
    _mLST   := 0
    _ltd         := _today

// TRADE MONITORING
if array.size(_tEn) > 0
    for _ti = array.size(_tEn) - 1 to 0
        _done  = array.get(_tSH, _ti) or array.get(_tTH, _ti)
        if not _done
            _bull  = array.get(_tBl,  _ti)
            _sl    = array.get(_tSl,    _ti)
            _tp1   = array.get(_tTP,   _ti)
            _t1hit = array.get(_tTH, _ti)
            _slhit = array.get(_tSH,  _ti)
            _tNum  = array.get(_tN, _ti)

            _entryBar = array.get(_tEB, _ti)
            _trType = array.get(_tTy, _ti)
            _isIOE = _trType == "uhv" and _uIOE

            // INVALIDATION EXIT — bar-close logic: exit when candle closes back inside UHV range (not triggered once BE has fired)
            bool _invExited = false
            if useInvalidation and barstate.isconfirmed and not array.get(_tBE, _ti) and bar_index > _entryBar and array.size(_tIL) > _ti
                float _iLvl = array.get(_tIL, _ti)
                bool  _iHit = _bull ? close < _iLvl - iExOff : close > _iLvl + iExOff
                if _iHit
                    _invExited := true
                    array.set(_tSH, _ti, true)
                    float _iEn   = array.get(_tEn, _ti)
                    float _iLots = array.get(_tEL, _ti)
                    float _iPnl  = (_bull ? (close - _iEn) : (_iEn - close)) * _iLots * cM
                    bool  _iWin  = _iPnl > 0
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs, time)
                    array.push(_tPA,  _iPnl)
                    _cTr += 1
                    _pT  += _iPnl
                    if _iWin
                        _wC   += 1
                        _tLSt := 0
                    else
                        _tLSt += 1
                        if _tLSt > _mLST
                            _mLST := _tLSt
                    array.push(_tDB, bar_index - _entryBar)
                    _uPnL += _iPnl
                    _uPT  += _iPnl
                    _uTr  += 1
                    if _iWin
                        _uWn += 1
                        array.set(_tW, _ti, true)
                    if _bull
                        _uBP += _iPnl
                        _uBT += 1
                    else
                        _uBeP += _iPnl
                        _uBeT += 1
                    label _iOrigLbl = array.get(_tLbl, _ti)
                    string _iExt = (_iWin ? "✅" : "⚡") + " #" + str.tostring(_tNum) + " Invalidation Exit — " + (_iWin ? "+$" : "-$") + str.tostring(math.abs(_iPnl), "#.##")
                    if not na(_iOrigLbl)
                        label.set_text(_iOrigLbl, label.get_text(_iOrigLbl) + "\n━━━━━━━━━━━━━━━━\n" + _iExt)
                    label.new(bar_index, _bull ? low : high, _iExt, style = _bull ? label.style_label_up : label.style_label_down, color = _iWin ? color.new(color.green, 10) : color.new(color.orange, 10), textcolor = color.white, size = size.small)
                    if pE
                        alert(pLid + "," + (_bull ? "closelong" : "closeshort") + "," + pSym, alert.freq_all)

            if not _slhit and not _invExited and (bar_index > _entryBar or _isIOE)
                _slTriggered = _bull ? low <= _sl : high >= _sl
                if _slTriggered
                    array.set(_tSH, _ti, true)
                    if not _t1hit
                        _pnl = (_bull ? (_sl - array.get(_tEn, _ti)) : (array.get(_tEn, _ti) - _sl)) * array.get(_tEL, _ti) * cM
                        bool _isBEWin = _pnl > 0
                        array.push(_tCTi, bar_index)
                        array.push(_tCTs,   time)
                        array.push(_tPA, _pnl)
                        _cTr += 1
                        _pT             += _pnl
                        if _isBEWin
                            _wC += 1
                            _tLSt := 0
                        else
                            _tLSt += 1
                            if _tLSt > _mLST
                                _mLST := _tLSt
                        array.push(_tDB, bar_index - _entryBar)
                        _stype = array.get(_tTy, _ti)
                        _sbull = array.get(_tBl, _ti)
                        if _stype == "uhv"
                            _uPnL += _pnl
                            _uPT += _pnl
                            _uTr += 1
                            if _isBEWin
                                _uWn += 1
                                array.set(_tW, _ti, true)
                            if _sbull
                                _uBP += _pnl
                                _uBT += 1
                            else
                                _uBeP += _pnl
                                _uBeT += 1
                        _origLbl = array.get(_tLbl, _ti)
                        _dPnlSL  = pATon and _atValid ? (_bull ? (_sl - (array.get(_tEn, _ti) + _atSlipB)) : ((array.get(_tEn, _ti) + _atSlipS) - _sl)) * array.get(_tEL, _ti) * cM : _pnl
                        if not na(_origLbl)
                            _origTxt = label.get_text(_origLbl)
                            label.set_text(_origLbl, _origTxt + "\n━━━━━━━━━━━━━━━━\n" + (_isBEWin ? "✅ #" + str.tostring(_tNum) + " BE Close — +$" + str.tostring(_pnl, "#.##") + " Profit" : "🛑 #" + str.tostring(_tNum) + " SL Hit — -$" + str.tostring(math.abs(_dPnlSL), "#.##") + " Loss"))
                        label.new(bar_index, _bull ? low : high, _isBEWin ? "✅ #" + str.tostring(_tNum) + " BE Close — +$" + str.tostring(_pnl, "#.##") + " Profit" : "⭕ #" + str.tostring(_tNum) + " SL Hit — -$" + str.tostring(math.abs(_dPnlSL), "#.##") + " Loss", style = _bull ? label.style_label_up : label.style_label_down, color = _isBEWin ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
                        fCross(bar_index, _sl, _a14)

            if uBEon and not array.get(_tBE, _ti) and not array.get(_tSH, _ti) and not _t1hit and (bar_index > _entryBar or _isIOE)
                _en   = array.get(_tEn, _ti)
                _be50 = _en + (_tp1 - _en) * (uBEPct / 100.0)
                if (_bull ? high >= _be50 : low <= _be50)
                    array.set(_tBE, _ti, true)
                    array.set(_tSl, _ti, uBELkTP ? _be50 : (_bull ? _en - uSpread : _en + uSpread))

            if not _t1hit and not array.get(_tSH, _ti) and (bar_index > _entryBar or _isIOE)
                _fireTime = array.size(_tFT) > _ti ? array.get(_tFT, _ti) : int(na)
                _postFill = not barstate.isrealtime or na(_fireTime) or timenow >= _fireTime + int(_avgLat)
                _tp1Triggered = _postFill and (bar_index == _entryBar ? (_bull ? close >= _tp1 : close <= _tp1) : (_bull ? high >= _tp1 : low <= _tp1))
                if _tp1Triggered
                    array.set(_tTH, _ti, true)
                    _wC += 1
                    _lots = array.get(_tEL, _ti)
                    _pnl  = (_bull ? (_tp1 - array.get(_tEn, _ti)) : (array.get(_tEn, _ti) - _tp1)) * _lots * cM
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs,   time)
                    array.push(_tPA, _pnl)
                    _cTr += 1
                    _pT             += _pnl
                    _tLSt := 0
                    array.push(_tDB, bar_index - _entryBar)
                    _stype = array.get(_tTy, _ti)
                    _sbull = array.size(_tBl) > _ti ? array.get(_tBl, _ti) : true
                    array.set(_tW, _ti, true)
                    if _stype == "uhv"
                        _uPnL += _pnl
                        _uPT += _pnl
                        _uTr += 1
                        _uWn += 1
                        if _sbull
                            _uBP += _pnl
                            _uBT += 1
                        else
                            _uBeP += _pnl
                            _uBeT += 1
                    _origLbl = array.get(_tLbl, _ti)
                    _dPnlTP  = pATon and _atValid ? (_bull ? (_tp1 - (array.get(_tEn, _ti) + _atSlipB)) : ((array.get(_tEn, _ti) + _atSlipS) - _tp1)) * _lots * cM : _pnl
                    if not na(_origLbl)
                        _origTxt = label.get_text(_origLbl)
                        label.set_text(_origLbl, _origTxt + "\n━━━━━━━━━━━━━━━━\n✅ #" + str.tostring(_tNum) + " TP Hit — +$" + str.tostring(_dPnlTP, "#.##") + " Profit")
                    label.new(bar_index, _bull ? high : low, "✅ #" + str.tostring(_tNum) + " TP Hit — +$" + str.tostring(_dPnlTP, "#.##") + " Profit", style = _bull ? label.style_label_down : label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = size.small)
                    fTick(bar_index, _tp1, _a14)



// Risk classification helper: dollar risk as % of account
f_rTag(float d) =>
    p = d > 0.0 and iMon > 0 ? d / iMon * 100.0 : 0.0
    p == 0.0 ? "" : p <= 0.5 ? " (risk-free)" : p <= 2.0 ? " (safe)" : p <= 5.0 ? " (moderate)" : p <= 10.0 ? " (high risk)" : " (risk-max)"
f_mxL(float m, simple string slT) => m > 0 ? "  Avg. max drawdown: -$" + str.tostring(m, "#.##") : slT == "SwingLow" ? "  Avg. max drawdown: unknown (swing SL — consider $ Risk mode)" : ""

// SETTINGS EXPORT STRING — built at global scope (not inside fDP) to avoid exceeding
// Pine's 254 external-element limit per function. Inputs are referenced here once;
// fDP() receives the finished string as a single parameter.
// Format T1: Account|POI|UHV|Trend|HTF|PC  (pipe-delimited, fixed order)
// Account:  iMon|cM|lA|uSpread|uLev
// POI:      rPOI|rFT|pFvg|pHL|pSup|pLb
// UHV:      eUHV|uDir|rUS|rULV|uHTD|uVTOn|uVT|uVLB|uSB|uOE|uPBD|uPBsD|uPBCo|uDR|uRp|uLS|uTM|uT1|uTD|uST|uSBf|uSMn|uSAm|uSDo|uSSw|uSLPips|uTPPips|uREU|uMomB|uMomBR|uMomW|uMomWk|uBrkVROn|uBrkVR|uBrkBody|uCd|uAlGt|uIOEGrd
// Trend:    mTS|tPB|sFilt|cLP|aTS|aTSU|tSTh|sTC|sTCU|tSMA|rSwT|avoidRng|rngTh|bRW
// HTF:      uHF|hFC|fTH|uFTH
// PC:       pE|pSym|mLot|pPip|pcSL|pcTP|pcOT|mTM|pcBrkPip|pcSpread|pcBETrig|pcBEOff|pcTDist|pcTTrig|pcTStep
// Enums — uDir: 0=Both 1=BullOnly 2=BearOnly | uHTD/hFC: 0=Off/Auto 1=1 2=5 3=15 4=60 5=240
//         uOE: 0=Close 1=IOE | uTM: 0=RR 1=Struct 2=Dollar
//         uST: 0=UHV 1=ATR 2=Wick 3=Swing 4=Dollar 5=RetracMinMax 6=PrevCandle
//         pcSL/pcTP: 0=Pips 1=Price | pcOT: 0=Market 1=Limit
string _gSAc  = "T1|" + str.tostring(iMon) + "|" + str.tostring(cM) + "|" + str.tostring(lA) + "|" + str.tostring(uSpread) + "|" + str.tostring(uLev)
string _gSPoi = "|" + (rPOI?"1":"0") + "|" + (rFT?"1":"0") + "|" + (pFvg?"1":"0") + "|" + (pHL?"1":"0") + "|" + (pSup?"1":"0") + "|" + str.tostring(pLb)
string _gSUhv = "|" + (eUHV?"1":"0") + "|" + (uDir=="Both"?"0":uDir=="Bull only"?"1":"2") + "|" + (rUS?"1":"0") + "|" + (rULV?"1":"0") + "|" + (uHTD=="Off"?"0":uHTD=="1"?"1":uHTD=="5"?"2":uHTD=="15"?"3":uHTD=="60"?"4":"5") + "|" + (uVTOn?"1":"0") + "|" + str.tostring(uVT) + "|" + str.tostring(uVLB) + "|" + str.tostring(uSB) + "|" + (uOE=="Candle Close"?"0":"1") + "|" + str.tostring(uPBD) + "|" + str.tostring(uPBsD) + "|" + (uPBCo?"1":"0") + "|" + str.tostring(uDR) + "|" + str.tostring(uRp) + "|" + str.tostring(uLS) + "|" + (uTM=="R:R Ratio"?"0":uTM=="Structural High/Low"?"1":"2") + "|" + str.tostring(uT1) + "|" + str.tostring(uTD) + "|" + (uST=="UHV"?"0":uST=="ATR"?"1":uST=="Breakout Wick"?"2":uST=="SwingLow"?"3":uST=="Dollar"?"4":uST=="Retracement's Min/Max"?"5":"6") + "|" + str.tostring(uSBf) + "|" + str.tostring(uSMn) + "|" + str.tostring(uSAm) + "|" + str.tostring(uSDo) + "|" + str.tostring(uSSw) + "|" + str.tostring(uSLPips) + "|" + str.tostring(uTPPips) + "|" + (uREU?"1":"0") + "|" + (uMomB?"1":"0") + "|" + str.tostring(uMomBR) + "|" + (uMomW?"1":"0") + "|" + str.tostring(uMomWk) + "|" + (uBrkVROn?"1":"0") + "|" + str.tostring(uBrkVR) + "|" + (uBrkBody?"1":"0") + "|" + str.tostring(uCd) + "|" + str.tostring(uAlGt) + "|" + str.tostring(uIOEGrd) + "|" + str.tostring(uSHLOff)
string _gSTr  = "|" + str.tostring(mTS) + "|" + str.tostring(tPB) + "|" + (sFilt?"1":"0") + "|" + (cLP?"1":"0") + "|" + (aTS?"1":"0") + "|" + (aTSU?"1":"0") + "|" + str.tostring(tSTh) + "|" + (sTC?"1":"0") + "|" + (sTCU?"1":"0") + "|" + (tSMA?"1":"0") + "|" + (rSwT?"1":"0") + "|" + (avoidRng?"1":"0") + "|" + str.tostring(rngTh) + "|" + (bRW?"1":"0") + "|" + (bRWW?"1":"0")
string _gSHtf = "|" + (uHF?"1":"0") + "|" + (hFC=="Auto"?"0":hFC=="1"?"1":hFC=="5"?"2":hFC=="15"?"3":hFC=="60"?"4":"5") + "|" + str.tostring(fTH) + "|" + str.tostring(uFTH)
string _gSPc  = "|" + (pE?"1":"0") + "|" + pSym + "|" + str.tostring(mLot) + "|" + str.tostring(pPip) + "|" + (pcSL=="Pips"?"0":"1") + "|" + (pcTP=="Pips"?"0":"1") + "|" + (pcOT=="Market"?"0":"1") + "|" + (mTM?"1":"0") + "|" + str.tostring(pcBrkPip) + "|" + str.tostring(pcSpread) + "|" + str.tostring(pcBETrig) + "|" + str.tostring(pcBEOff) + "|" + str.tostring(pcTDist) + "|" + str.tostring(pcTTrig) + "|" + str.tostring(pcTStep)
string _settingsExport = _gSAc + _gSPoi + _gSUhv + _gSTr + _gSHtf + _gSPc

// STATS PANEL (top-right table)
fDP(string _settingsExport) =>
    // -- Core stats --
    _totalPnL    = 0.0
    _avgDollarRisk = uDR
    _avgTp1Mult   = uT1
    // Compute actual avg win and avg loss from closed trade history
    _totalWinAmt = 0.0
    _totalLossAmt = 0.0
    _winTradesCount = 0
    _lossTradesCount = 0
    _pnlSz = math.min(array.size(_tPA), array.size(_tCTs))
    if _pnlSz > 0
        for _pi = 0 to _pnlSz - 1
            if array.get(_tCTs, _pi) >= _sRD
                _p = array.get(_tPA, _pi)
                _totalPnL += _p
                if _p > 0
                    _totalWinAmt += _p
                    _winTradesCount += 1
                else if _p < 0
                    _totalLossAmt += math.abs(_p)
                    _lossTradesCount += 1
    _filteredTrades = _winTradesCount + _lossTradesCount
    _acc         = _filteredTrades > 0 ? float(_winTradesCount) / _filteredTrades : 0.0
    _accPct      = math.round(_acc * 100)
    _avgPnL      = _filteredTrades > 0 ? _totalPnL / _filteredTrades : 0.0
    _winAmt  = _winTradesCount  > 0 ? _totalWinAmt  / _winTradesCount  : _avgDollarRisk * _avgTp1Mult
    _lossAmt = _lossTradesCount > 0 ? _totalLossAmt / _lossTradesCount : _avgDollarRisk
    _ev      = _acc * _winAmt - (1.0 - _acc) * _lossAmt

    // -- Doubling / target time --
    _tradesToDouble = _avgPnL > 0 ? math.ceil(iMon / _avgPnL) : 0
    _avgMinsPerSignal = 30.0
    if array.size(_sBT) > 1
        _totalGap = 0
        for _si = 1 to array.size(_sBT) - 1
            _totalGap += array.get(_sBT, _si) - array.get(_sBT, _si - 1)
        _avgMinsPerSignal := (_totalGap / (array.size(_sBT) - 1)) * tFm
    _hoursToDouble = _tradesToDouble > 0 and _avgMinsPerSignal > 0 ? math.round(_tradesToDouble * _avgMinsPerSignal / 60.0 * 10) / 10 : 0

    // -- Signals per day (avg across all days) --
    _allDaySignals  = _tSAD + _sigT
    _avgSigPerDay   = _tDS > 0 ? math.round(_allDaySignals / _tDS) : _sigT

    // -- Washout --
    // Use actual observed avg loss (not the input setting) — avoids showing 0 when fixed-lot mode is on
    _washout = math.floor(iMon / (_lossAmt > 0 ? _lossAmt : (_avgDollarRisk > 0 ? _avgDollarRisk : 1.0)))

    // -- Last hour P&L --
    _hourPnL = 0.0
    if array.size(_tCTi) > 0
        for _hi = 0 to array.size(_tCTi) - 1
            if bar_index - array.get(_tCTi, _hi) <= bPH
                _hourPnL += array.get(_tPA, _hi)

    // -- Avg time to next signal --
    _minsToNextSignal = math.round(_avgMinsPerSignal)

    // -- Session detection (UTC hour) --
    _session = _utcH >= 22 or _utcH < 7  ? "🌏 Sydney Session" :
               _utcH < 9                ? "🌸 Tokyo Session"  :
               _utcH < 13              ? "🏦 London Session" :
               _utcH < 22              ? "🗽 New York Session" : "📊 Market"
    // overlap labels
    _session := (_utcH >= 8 and _utcH < 9)   ? "🏦🌸 London/Tokyo Overlap"   : _session
    _session := (_utcH >= 13 and _utcH < 17)  ? "🗽🏦 New York/London Overlap" : _session

    // -- Pre-panel: today completed wins/trades --
    _winsToday            = 0
    _tradesCompletedToday = 0
    _todayStartMs         = timenow - (timenow % 86400000)
    if array.size(_tCTs) > 0
        for _ict = 0 to array.size(_tCTs) - 1
            if array.get(_tCTs, _ict) >= _todayStartMs and array.get(_tCTs, _ict) >= _sRD
                _tradesCompletedToday += 1
                if array.get(_tPA, _ict) > 0
                    _winsToday += 1

    // -- Pre-panel: trades closed in last hour --
    _hourTrades = 0
    if array.size(_tCTi) > 0
        for _iht = 0 to array.size(_tCTi) - 1
            if bar_index - array.get(_tCTi, _iht) <= bPH
                _hourTrades += 1

    // -- Pre-panel: current win/loss streak --
    _currentStreak = 0
    _streakSz = array.size(_tPA)
    if _streakSz > 0
        // find last filtered trade
        _lastIdx = -1
        for _ics0 = _streakSz - 1 to 0
            if array.get(_tCTs, _ics0) >= _sRD
                _lastIdx := _ics0
                break
        if _lastIdx >= 0
            _lastIsWin = array.get(_tPA, _lastIdx) > 0
            for _ics = _lastIdx to 0
                if array.get(_tCTs, _ics) < _sRD
                    break
                _cp = array.get(_tPA, _ics)
                if (_lastIsWin and _cp > 0) or (not _lastIsWin and _cp <= 0)
                    _currentStreak += 1
                else
                    break
            _currentStreak := _lastIsWin ? _currentStreak : -_currentStreak

    // -- Pre-panel: yesterday P&L (moved here for early use) --
    _ydayStart  = _todayStartMs - 86400000
    _pnlYday    = 0.0
    if array.size(_tCTs) > 0
        for _iyd = 0 to array.size(_tCTs) - 1
            _ts = array.get(_tCTs, _iyd)
            if _ts >= _ydayStart and _ts < _todayStartMs and _ts >= _sRD
                _pnlYday += array.get(_tPA, _iyd)

    // -- Per-strategy avg win and avg loss amounts --
    _uhvWinSum = 0.0
    _uhvWinN2  = 0
    _uhvLossSum = 0.0
    _uhvLossN2 = 0
    _uhvMaxLoss = 0.0
    _uhvPnLCalc    = 0.0
    _uhvTradesCalc = 0
    _uhvWinsCalc   = 0
    _stratSize2 = array.size(_tPA)
    if _stratSize2 > 0
        for _ist = 0 to _stratSize2 - 1
            if array.get(_tCTs, _ist) < _sRD
                continue
            _sp  = array.get(_tPA,  _ist)
            _uhvPnLCalc    += _sp
            _uhvTradesCalc += 1
            if _sp > 0
                _uhvWinSum  += _sp
                _uhvWinN2   += 1
                _uhvWinsCalc += 1
            else
                _uhvLossSum += math.abs(_sp)
                _uhvLossN2  += 1
                _uhvMaxLoss := math.max(_uhvMaxLoss, math.abs(_sp))
    _uhvAvgWin  = _uhvWinN2  > 0 ? _uhvWinSum  / _uhvWinN2  : 0.0
    _uhvAvgLoss = _uhvLossN2 > 0 ? _uhvLossSum / _uhvLossN2 : 0.0

    // -- Signals (labels) fired in last hour --
    _sigLastHour = 0
    if array.size(_sBT) > 0
        for _isb = 0 to array.size(_sBT) - 1
            if bar_index - array.get(_sBT, _isb) <= bPH
                _sigLastHour += 1
    // -- Alerts actually sent in last hour --
    _alLastHour = 0
    if array.size(_sABT) > 0
        for _iab = 0 to array.size(_sABT) - 1
            if bar_index - array.get(_sABT, _iab) <= bPH
                _alLastHour += 1
    // -- Alerts/hr pace (same priority logic as labels) --
    _avgMinsPerAlert = 30.0
    if array.size(_sABT) > 1
        _alGapTotal = 0
        for _ai = 1 to array.size(_sABT) - 1
            _alGapTotal += array.get(_sABT, _ai) - array.get(_sABT, _ai - 1)
        _avgMinsPerAlert := (_alGapTotal / (array.size(_sABT) - 1)) * tFm
    _trueAlHrSigs = _avgMinsPerAlert > 0 ? 60.0 / _avgMinsPerAlert : 0.0
    _alBasisLbl = "all-time avg"
    if _alLastHour > 0
        _trueAlHrSigs := float(_alLastHour)
        _alBasisLbl := "last hr"
    else if _alT >= 2
        _alHrsElapsed = (bar_index - array.get(_sABT, array.size(_sABT) - _alT)) * tFm / 60.0
        if _alHrsElapsed > 0
            _trueAlHrSigs := math.round(_alT / _alHrsElapsed * 10) / 10
            _alBasisLbl := "today"
    // -- Build panel (18 rows) --
    table statsPanel = table.new(position.bottom_right, 1, 16,
         bgcolor = color.new(color.black, 15),
         border_color = color.new(color.gray, 70),
         border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)

    // -- Shared colors --
    _bgDark    = color.new(color.black,   25)
    _bgDeep    = color.new(color.navy,    40)
    _txtDim    = color.new(color.silver,  10)
    _txtGreen  = color.new(color.lime,    10)
    _txtRed    = color.new(color.red,      0)
    _txtOrange = color.new(color.orange,   0)
    _txtAqua   = color.new(color.aqua,    10)
    _txtYellow = color.new(color.yellow,  10)

    // -- Pre-compute display vars --
    _uhvAcc  = _uhvTradesCalc > 0 ? math.round(_uhvWinsCalc / _uhvTradesCalc * 100) : 0
    _ydayGrowthPct = iMon > 0 ? math.round(_pnlYday / iMon * 100 * 10) / 10 : 0.0
    // Next-hour projection (priority: last hour ? today's pace ? all-time avg)
    _trueNextHrSigs = _avgMinsPerSignal > 0 ? 60.0 / _avgMinsPerSignal : 0.0
    _basisLbl = "all-time avg"
    if _sigLastHour > 0
        _trueNextHrSigs := float(_sigLastHour)
        _basisLbl := "last hour pace"
    else if _sigT >= 2
        _hrsElapsed = (bar_index - array.get(_sBT, array.size(_sBT) - _sigT)) * tFm / 60.0
        if _hrsElapsed > 0
            _trueNextHrSigs := math.round(_sigT / _hrsElapsed * 10) / 10
            _basisLbl := "today's pace"
    _projNextHrPnLEV = math.round(_trueNextHrSigs * _ev * 100) / 100
    // ROW 0 — HEADER
    string _integrityStr = _sigChkW == 0. ? "" : (_sigChkW == _sigChkR ? "  |  Signal integrity is preserved." : "  |  Signal integrity compromised")
    table.cell(statsPanel, 0, 0,
         "TURTLE TRADER DESK  |  " + syminfo.ticker + "  |  " + str.tostring(tFm) + "m  |  " + _session + "  |  Exness Std " + str.tostring(uLev) + ":1" + _integrityStr,
         text_color = color.white, text_size = size.small, bgcolor = color.new(#0a7a6a, 5))

    // ROW 1 — SIGNAL STATUS (largest text, highest priority)
    _sigStatus = _iR and _fR ? "POI REACHED — WATCHING FOR ENTRY" :
         _iR ? "SETUP IN PROGRESS — AWAITING POI" :
         _bT  ? "SIGNAL FIRED — MONITORING" : "STANDING BY"
    _sigBg = _iR and _fR ? color.new(color.green,  30) :
         _iR ? color.new(color.blue,   40) :
         _bT  ? color.new(color.orange, 30) : color.new(color.gray, 50)
    _sigFg = _iR and _fR ? color.new(color.lime,   0) :
         _iR ? color.new(color.aqua,   0) :
         _bT  ? color.new(color.orange, 0) : color.new(color.silver, 10)
    table.cell(statsPanel, 0, 1, _sigStatus,
         text_color = _sigFg, text_size = size.normal, bgcolor = _sigBg)

    // ROW 2 — TREND + STRENGTH + NEXT SIGNAL ETA
    _tDir       = _lb ? "BULLISH" : "BEARISH"
    _tColor     = _lb ? _txtGreen : _txtRed
    _tBar       = _tS >= 80 ? "||||" : _tS >= 60 ? "|||." : _tS >= 40 ? "||.." : _tS >= 20 ? "|..." : "...."
    _tStL       = _tS >= 70 ? "Strong" : _tS >= 40 ? "Moderate" : "Weak"
    _nextSigEta = _minsToNextSignal >= 60 ? str.tostring(math.round(_minsToNextSignal / 60.0 * 10) / 10) + " hrs" : str.tostring(_minsToNextSignal) + " min"
    table.cell(statsPanel, 0, 2,
         _tDir + "  |  " + _tBar + "  " + _tStL + " (" + str.tostring(_tS) + ")" +
         "\nNext signal: ~" + _nextSigEta,
         text_color = _tColor, text_size = size.small, bgcolor = _bgDark)

    // ROW 3 — TODAY DIVIDER
    table.cell(statsPanel, 0, 3, "TODAY",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 4 — TODAY P&L (large font — most visible number)
    _todayPnLDisp = math.round(_uPT * 100) / 100
    _todayBalDisp = iMon + _todayPnLDisp
    _todaySign    = _todayPnLDisp >= 0.01 ? "+" : ""
    _todayBg      = _todayPnLDisp >= 0.01 ? color.new(color.green, 55) : _todayPnLDisp <= -0.01 ? color.new(color.red, 55) : color.new(color.gray, 55)
    _todayFg      = _todayPnLDisp >= 0.01 ? _txtGreen : _todayPnLDisp <= -0.01 ? _txtRed : _txtDim
    table.cell(statsPanel, 0, 4,
         _todaySign + "$" + str.tostring(_todayPnLDisp, "#.##") + "  |  Balance: $" + str.tostring(_todayBalDisp, "#.##"),
         text_color = _todayFg, text_size = size.normal, bgcolor = _todayBg)

    // -- Avg trade duration --
    _avgDurMins = 0.0
    _durSz = array.size(_tDB)
    if _durSz > 0
        _durSum = 0
        for _di = 0 to _durSz - 1
            _durSum += array.get(_tDB, _di)
        _avgDurMins := math.round(_durSum / _durSz * tFm * 10) / 10
    _avgDurStr = _durSz == 0 ? "—" : _avgDurMins >= 60.0 ? str.tostring(math.round(_avgDurMins / 60.0 * 10) / 10) + " hr" : str.tostring(_avgDurMins) + " min"
    _maxTradeTxt = mTM ? "  [MAX TRADES ON]" : ""

    // ROW 5 — STRATEGY SUB-TOTALS + AVG DURATION (tiny, secondary detail under today P&L)
    table.cell(statsPanel, 0, 5,
         "UHV " + (_uPT >= 0 ? "+" : "") + "$" + str.tostring(math.round(_uPT * 100) / 100, "#.##") +
         "\nAvg trade duration: " + _avgDurStr + "  (" + str.tostring(_durSz) + " trades)" + _maxTradeTxt,
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // ROW 6 — TRADE COUNT + STREAK + ALERT GATE STATUS
    _gated = _sigT - _alT
    table.cell(statsPanel, 0, 6,
         str.tostring(_sigT) + " labels  |  " + str.tostring(_alT) + " alerts" + (_gated > 0 ? "  |  ⚠️ " + str.tostring(_gated) + " gated" : "") +
         "  |  " + str.tostring(_tradesCompletedToday) + " closed  |  " + str.tostring(_winsToday) + " won" +
         (_tradesCompletedToday > 0 ? "  (" + str.tostring(math.round(_winsToday / math.max(_tradesCompletedToday, 1) * 100)) + "%)" : "") +
         "\n" + (_currentStreak > 1 ? str.tostring(_currentStreak) + " wins in a row" : _currentStreak == 1 ? "Last: win" : _currentStreak < -1 ? str.tostring(math.abs(_currentStreak)) + " losses in a row" : "Last: loss"),
         text_color = _currentStreak >= 0 ? _txtGreen : _txtOrange, text_size = size.small, bgcolor = _bgDark)

    // ROW 7 — LAST HOUR RESULT + NEXT HOUR EV PROJECTION + ALERT RATE
    table.cell(statsPanel, 0, 7,
         "Last hr: " + (_hourPnL >= 0.01 ? "+$" + str.tostring(_hourPnL, "#.##") : _hourPnL <= -0.01 ? "-$" + str.tostring(math.abs(_hourPnL), "#.##") : "—") + "  (" + str.tostring(_hourTrades) + " trades)" +
         "\nNext hr EV: " + (_projNextHrPnLEV >= 0 ? "+" : "") + "$" + str.tostring(math.abs(_projNextHrPnLEV), "#.##") + "  (" + _basisLbl + ")" +
         "\nLabels/hr: " + str.tostring(math.round(_trueNextHrSigs * 10) / 10) + "  |  Alerts/hr: " + str.tostring(math.round(_trueAlHrSigs * 10) / 10) + "  (" + _alBasisLbl + ")" +
         "\nEV: $" + str.tostring(_ev, "#.##") + "/trade  |  " + str.tostring(_avgSigPerDay) + " signals/day avg",
         text_color = _txtAqua, text_size = size.small, bgcolor = _bgDark)

    // ROW 8 — STRATEGIES DIVIDER
    table.cell(statsPanel, 0, 8, "STRATEGIES",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 9 — UHV BREAKOUT (+ effective lot size when multiplier is active)
    // Find last lot size actually used per strategy (dollar-risk mode ? varies by SL distance)
    float _lastUhvLots = na
    _tySize = math.min(array.size(_tTy), array.size(_tEL))
    if _tySize > 0
        for _li = _tySize - 1 to 0
            _lt = array.get(_tTy, _li)
            _ll = array.get(_tEL, _li)
            if na(_lastUhvLots) and _lt == "uhv"
                _lastUhvLots := _ll
                break
    _uhvRiskTag = f_rTag(uDR > 0 ? uDR : _uhvAvgLoss)
    // Live dollar-at-risk: open trades (neither SL nor TP hit yet)
    float _uhvLR = na
    if _tySize > 0
        for _oi = 0 to _tySize - 1
            if not array.get(_tSH, _oi) and not array.get(_tTH, _oi)
                _oDR = math.abs(array.get(_tEn, _oi) - array.get(_tSl, _oi)) * array.get(_tEL, _oi) * cM
                _oTy2 = array.get(_tTy, _oi)
                if _oTy2 == "uhv"
                    _uhvLR := nz(_uhvLR, 0.0) + _oDR
    _uhvLS = not na(_uhvLR) ? "\n  [LIVE SL risk: -$" + str.tostring(math.round(_uhvLR * 100) / 100, "#.##") + "]" : ""
    _uhvWLStr = (_uhvAvgWin > 0 or _uhvAvgLoss > 0 ? "\navg +" + str.tostring(_uhvAvgWin, "#.##") + " / -" + str.tostring(_uhvAvgLoss, "#.##") : "") + f_mxL(_uhvMaxLoss, uST) + _uhvLS
    _uhvLotStr = "\n" + (not na(_lastUhvLots) ? str.tostring(_lastUhvLots, "0.####") : uDR > 0 ? "auto" : uRp > 0 ? str.tostring(uRp, "0.#") + "% cap" : str.tostring(uLS * lA, "0.####")) + " lots" + _uhvRiskTag + (not na(_lastUhvLots) and uLev > 0 ? " | margin ~$" + str.tostring(math.round(_lastUhvLots * cM * close / uLev * 100) / 100, "#.##") + " (" + str.tostring(uLev) + ":1)" : "")
    table.cell(statsPanel, 0, 9,
         "UHV  W/L: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " (" + str.tostring(_uhvAcc) + "%)" +
         "\nAll-time: " + (_uhvPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_uhvPnLCalc, "#.##") +
         "  |  Today: " + (_uPT >= 0 ? "+" : "") + "$" + str.tostring(_uPT, "#.##") +
         _uhvWLStr + _uhvLotStr + (_atValid ? "\nReal MT5: " + str.tostring(_atWins) + "/" + str.tostring(_atTotal) + " (" + str.tostring(math.round(_atWins / float(_atTotal) * 100)) + "%)  avg +" + str.tostring(_atAvgW, "#.##") + " / -" + str.tostring(math.abs(_atAvgL), "#.##") : ""),
         text_color = _uhvPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 10 — ALL-TIME DIVIDER
    table.cell(statsPanel, 0, 10, "ALL-TIME",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 11 — ALL-TIME P&L + ACCURACY + EV
    table.cell(statsPanel, 0, 11,
         "P&L: " + (_totalPnL >= 0 ? "+" : "") + "$" + str.tostring(_totalPnL, "#.##") +
         "  |  " + str.tostring(_winTradesCount) + "/" + str.tostring(_filteredTrades) + " won (" + str.tostring(_accPct) + "%)" +
         "\n" + (_ev >= 0.01 ? "Positive EV" : _ev <= -0.01 ? "Negative EV" : "Breakeven") + ": $" + str.tostring(_ev, "#.##") + "/trade" +
         "  |  avg win: +$" + str.tostring(_winAmt, "#.##") + "  /  -$" + str.tostring(_lossAmt, "#.##"),
         text_color = _ev >= 0 ? _txtGreen : _txtRed, text_size = size.small, bgcolor = _bgDark)

    // ROW 12 — MILESTONES + RISK + YESTERDAY (condensed, tiny)
    table.cell(statsPanel, 0, 12,
         "To double: " + (_avgPnL > 0 ? str.tostring(_tradesToDouble) + " trades (~" + (_hoursToDouble >= 24 ? str.tostring(math.round(_hoursToDouble / 24.0 * 10) / 10) + " days" : str.tostring(_hoursToDouble) + " hrs") + ")" : "—") +
         "  |  Washout: " + str.tostring(_washout) + " losses" +
         "\nYesterday: " + (_pnlYday >= 0 ? "+" : "") + "$" + str.tostring(math.round(_pnlYday * 100) / 100, "#.##") + "  (" + (_ydayGrowthPct >= 0 ? "+" : "") + str.tostring(_ydayGrowthPct) + "%)",
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // Recommendations / optimize calculations derived from trade statistics
    // Compute avg _tS for winners and losers across all trades
    _winTSsum    = 0.0
    _winTScount  = 0
    _loseTSsum   = 0.0
    _loseTScount = 0
    _tsSize = array.size(_tW)
    if _tsSize > 0
        for _ri = 0 to _tsSize - 1
            _rts   = array.get(_tTS, _ri)
            _rwon  = array.get(_tW,      _ri)
            if _rwon
                _winTSsum   += _rts
                _winTScount += 1
            else
                _loseTSsum   += _rts
                _loseTScount += 1
    _avgWinTS  = _winTScount  > 0 ? _winTSsum  / _winTScount  : na
    _avgLoseTS = _loseTScount > 0 ? _loseTSsum / _loseTScount : na

    // -- Estimate dollar gain from unlocking blocked signals (per day) --
    _avgPnLPerTrade = _cTr > 0 ? _totalPnL / _cTr : 0.0
    _daysBase = math.max(_tDS, 1)
    // Only use estimate when avg is positive (net profitable)
    _canEstimate = _avgPnLPerTrade > 0 and _cTr >= 5

    // RECOMMENDATIONS ENGINE — grouped by priority
    _overallWinRate = _cTr > 0 ? _wC / _cTr : 0.0

    // -- Realized R:R from actual dollar win vs dollar loss amounts --
    // Use observed avg win and avg loss dollars — works correctly for all SL types
    _avgRealizedRR = (_lossAmt > 0 and _winAmt > 0) ? _winAmt / _lossAmt : _avgTp1Mult
    // Break-even win rate for the actual R:R being used
    _beWinRate = _avgRealizedRR > 0 ? 1.0 / (1.0 + _avgRealizedRR) : 0.5

    // -- Per-strategy EV --
    _uhvEV = _uhvTradesCalc >= 5 ? (_uhvWinsCalc / _uhvTradesCalc) * _uhvAvgWin - (1.0 - _uhvWinsCalc / _uhvTradesCalc) * _uhvAvgLoss : na

    _totalSlHits = _cTr - _wC
    _slHitRate   = _cTr > 0 ? float(_totalSlHits) / _cTr : 0.0

    // BUILD RECOMMENDATION STRINGS — ordered by priority
    _recs = array.new_string()
    // 🚨 CRITICAL
    if iMon > 0 and _pT < -(iMon * 0.10)
        array.push(_recs, "🚨 Down " + str.tostring(math.round(math.abs(_pT) / iMon * 100)) + "% today (-$" + str.tostring(math.abs(_pT), "#.##") + ")\nconsider stopping for the day to protect your capital")
    if not na(_uhvEV) and _uhvEV < -0.05
        array.push(_recs, "🚨 UHV Breakout has negative EV: -$" + str.tostring(math.abs(_uhvEV), "#.##") + "/trade avg (" + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won, avg win $" + str.tostring(_uhvAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_uhvAvgLoss, "#.##") + ")\ndisable or adjust settings")
    // ⚠️ WARNING
    if _uhvTradesCalc >= 5 and _uhvWinsCalc / _uhvTradesCalc < 0.40 and _uhvEV >= -0.05
        array.push(_recs, "⚠️ UHV Breakout: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won (" + str.tostring(math.round(_uhvWinsCalc / _uhvTradesCalc * 100)) + "%)\nbelow break-even. Try: raise Min Trend Strength, enable Require UHV Sweep, or disable this strategy")
    if _totalSlHits >= 5 and _slHitRate > 0.60 and _cTr >= 8
        array.push(_recs, "⚠️ " + str.tostring(math.round(_slHitRate * 100)) + "% of trades are hitting SL (" + str.tostring(_totalSlHits) + "/" + str.tostring(_cTr) + ")\nentries may be too early. Try: increase SL Buffer, switch to ATR stop, or raise Min Trend Strength")
    // 💡 OPTIMIZE
    if not na(_avgWinTS) and not na(_avgLoseTS) and _winTScount >= 3 and _loseTScount >= 3
        _tsDiff = _avgWinTS - _avgLoseTS
        if _tsDiff > 8
            array.push(_recs, "💡 Winners fire at avg trend strength " + str.tostring(math.round(_avgWinTS)) + " vs losers at " + str.tostring(math.round(_avgLoseTS)) + "\nraise 'Min Trend Strength' to ~" + str.tostring(math.round(_avgWinTS * 0.85)) + " to pre-filter weak setups (setting is in the Trend Engine group)")
        else if _tsDiff < -8
            array.push(_recs, "💡 Wins happen at lower trend strength (" + str.tostring(math.round(_avgWinTS)) + ") than losses (" + str.tostring(math.round(_avgLoseTS)) + ")\nlower 'Min Trend Strength' to catch more quality setups")
    if _cTr >= 10
        if _overallWinRate > _beWinRate + 0.10 and _avgTp1Mult < 2.2
            array.push(_recs, "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% beats break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nraise TP R:R to ~" + str.tostring(math.round(_avgRealizedRR * 1.3 * 10) / 10) + "R to earn more per winner (note: higher TP will reduce win rate — test first)")
        else if _overallWinRate < _beWinRate - 0.08 and _avgTp1Mult > 1.2
            array.push(_recs, "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% is below break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nlower TP R:R to ~" + str.tostring(math.round(_avgRealizedRR * 0.75 * 10) / 10) + "R so TP is easier to reach")
    // 🔓 UNLOCK — only suggest when win rate is close to break-even (filter may be over-filtering)
    // If win rate is well above break-even, the filter is earning its keep; dollar estimate
    // assumes blocked signals have same quality as passing ones, which is unlikely when win rate is high
    bool _ftOK = _overallWinRate < _beWinRate + 0.25
    if rUS and _bSwp >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 UHV Sweep filter blocked " + str.tostring(_bSwp) + " signals (" + str.tostring(math.round(_bSwp / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must any candle sweep UHV low before entry' may add ~$" + str.tostring(math.round(_bSwp / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    else if rULV and _bUV >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 UHV Volume filter blocked " + str.tostring(_bUV) + " signals (" + str.tostring(math.round(_bUV / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must breakout candle have lower volume' may add ~$" + str.tostring(math.round(_bUV / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if _bCd >= 5 and _canEstimate and _ftOK
        array.push(_recs, "🔓 Cooldown blocked " + str.tostring(_bCd) + " signals (" + str.tostring(math.round(_bCd / _daysBase * 10) / 10) + "/day avg)\nlower 'Signal Cooldown (bars)' may add ~$" + str.tostring(math.round(_bCd / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if _bStr >= 4 and _canEstimate and _ftOK
        array.push(_recs, "🔓 Min Trend Strength blocked " + str.tostring(_bStr) + " signals (" + str.tostring(math.round(_bStr / _daysBase * 10) / 10) + "/day avg)\nlower 'Min Trend Strength' may add ~$" + str.tostring(math.round(_bStr / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (only if trend stays strong)")
    // ROW 13 — OPTIMIZER & TOOLS DIVIDER + smiley
    _r15AP  = _cTr > 0 ? _uPnL / _cTr : 0.
    _r15Rel = _r15AP / math.max(uTD, 1.0)
    _r15Sm  = _cTr == 0 ? "⌛ Waiting..." : _r15Rel > 0.35 ? "😄  Loving it!" : _r15Rel > 0.05 ? "🙂  Profitable" : _r15Rel >= -0.05 ? "😐  Breaking even" : "😟  Try different values"
    table.cell(statsPanel, 0, 13, "OPTIMIZER & TOOLS  |  " + _r15Sm + "  ($" + str.tostring(math.round(_r15AP * 100) / 100, "#.##") + "/trade avg)",
         text_color = _r15AP >= 0. ? color.new(color.lime, 30) : color.new(color.red, 20), text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 14 — TOP RECOMMENDATIONS (surfacing computed _recs array)
    _recsSize = array.size(_recs)
    table.cell(statsPanel, 0, 14, (_recsSize > 0 ? array.get(_recs, 0) : "No recommendations yet — need more trade data") + (_recsSize > 1 ? "\n" + array.get(_recs, 1) : ""),
         text_color = _txtYellow, text_size = size.tiny, bgcolor = color.new(#1a2a1a, 10))

    // ROW 15 — SETTINGS EXPORT (string built at global scope to stay under 254-element limit)
    // Split across 3 lines by section so no single line is too wide
    table.cell(statsPanel, 0, 15,
         "SETTINGS EXPORT — copy all 3 lines, paste to Claude to restore:\n" +
         _gSAc + _gSPoi + "\n" +
         _gSUhv + "\n" +
         _gSTr + _gSHtf + _gSPc,
         text_color = color.white, text_size = size.tiny, bgcolor = color.new(#0a0a0a, 10))


if barstate.islast and sSP
    fDP(_settingsExport)

// -- Last Signal Panel (bottom-left) — always shows most recent signal label text --
if barstate.islast
    _lsP = table.new(position.bottom_left, 1, 2, bgcolor = color.new(color.black, 10), border_color = color.new(color.gray, 40), border_width = 1)
    table.cell(_lsP, 0, 0, "LAST SIGNAL", text_color = color.new(color.aqua, 0), text_size = size.small, bgcolor = color.new(#001830, 5))
    table.cell(_lsP, 0, 1, _lastSigTxt == "" ? "No signal yet" : _lastSigTxt, text_color = color.new(color.white, 0), text_size = size.normal, bgcolor = color.new(#0a0a14, 8))

// ALERT CONDITIONS
// Create alerts via: right-click chart ? Add Alert ? Condition ? FVG Absorption
alertcondition(_bBrk, title = '🟢 BUY Signal', message = '🟢 BUY Signal — FVG Absorption fired on {{ticker}} at {{close}}')
alertcondition(_beBrk, title = '🔴 SELL Signal', message = '🔴 SELL Signal — FVG Absorption fired on {{ticker}} at {{close}}')

// TREND LINE PLOTS (EMA 34, colored by trend strength)
plot(tSMA ? _fEma : na, 'Trend (base)',  color = color.new(color.gray, 85),   linewidth = 1)
plot(tSMA ? _w1      : na, 'Trend w1',      color = _tLCol,                linewidth = 6,  style = plot.style_linebr)
plot(tSMA ? _w2      : na, 'Trend w2',      color = _tLCol,                linewidth = 8,  style = plot.style_linebr)
plot(tSMA ? _w3      : na, 'Trend w3',      color = _tLCol,                linewidth = 10, style = plot.style_linebr)
plot(tSMA ? _w4      : na, 'Trend w4',      color = _tLCol,                linewidth = 12, style = plot.style_linebr)
plot(tSMA ? _w5      : na, 'Trend w5',      color = _tLCol,                linewidth = 14, style = plot.style_linebr)
