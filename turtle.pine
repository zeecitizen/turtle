//@version=5

indicator("Turtle Trader Desk v1.0, by M. Zeeshan MIT Alumni", "Turtle Trader Desk", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)
max_bars_back(low, 300)
max_bars_back(high, 300)

// SETTINGS

// ─── 0. Account ──────────────────────────
grpAccount = "💼 My Account"
initialMoney = input.float(30.0, 'My Starting Capital ($)', minval = 1.0, step = 10.0, group = grpAccount, display = display.none)
cMult        = input.float(100.0,  'Contract size ($/point/lot)', minval = 0.001, step = 1.0, group = grpAccount, display = display.none)
lotAmp       = input.float(1.0,   'Position Size Multiplier  ＋ / − to scale all lot sizes (1.0 = optimizer sizing, 2.0 = double lots/profit, etc.)', minval = 0.1, maxval = 50.0, step = 0.5, group = grpAccount, display = display.none)
_resetNow = input.bool(false, '🔄 Reset Stats', group = grpAccount, display = display.none)
var int _resetCapture = 0
if not _resetNow
    _resetCapture := 0
else if _resetCapture == 0
    _resetCapture := timenow + 3600000
statsResetDate = _resetCapture

// ─── 1. Points of Interest ───────────────
grpPOI = "🎯 Points of Interest"
requireFvgTouch = input.bool(true, 'Require POI Touch Before Signal', group = grpPOI, display = display.none)
poiFVG      = input.bool(true,  'Higher Time Frame Fair Value Gap (imbalance zone)', group = grpPOI, display = display.none)
poiHL       = input.bool(true,  'Previous Higher Low (above the deeper low)', group = grpPOI, display = display.none)
poiSup      = input.bool(true,  'Broken High / Low (now flipped to S or R)', group = grpPOI, display = display.none)
poiLookback = input.int(50, 'POI Lookback (bars)', minval = 10, maxval = 300, step = 5, group = grpPOI, display = display.none)

// ─── 2. Strategy: UHV Breakout ───────────
grpUHV = "📊 Strategy: Ultra High Volume Breakout"
enableUHV             = input.bool(true,  'Use this strategy?', group = grpUHV, display = display.none)
uhvDirection          = input.string("Bull only", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = grpUHV, display = display.none)
uhvStatsInfo          = input.bool(false, '📊 Wins / Trades: see Stats Panel → Strategy Breakdown', group = grpUHV, display = display.none)
requireUHVSweep       = input.bool(false, 'Must entry candle first wick through the UHV candle?', group = grpUHV, display = display.none)
requireUHVLowerVol    = input.bool(true,  'Must the breakout candle have lower volume than the previous candle?', group = grpUHV, display = display.none)
uhvLookback           = input.int(4,      'How many bars back to check for Ultra High Volume?', minval = 3, maxval = 50, group = grpUHV, display = display.none)
uhvSettleBars         = input.int(0,      'How many bars must pass after the UHV candle before entry?', minval = 0, maxval = 20, group = grpUHV, display = display.none)
uhvDollarRisk = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', minval = 0.0, step = 0.5, group = grpUHV, display = display.none)
uhvLotSize    = input.float(0.01, '──── Risk: Fixed lot size? (when $Risk = 0)', minval = 0.01, maxval = 100.0, step = 0.01, group = grpUHV, display = display.none)
uhvTpMethod   = input.string("Dollar Amount", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = grpUHV, display = display.none)
uhvTp1Mult    = input.float(7.0,  '──── Take Profit: R:R Ratio (R:R method only)', minval = 0.5, maxval = 10.0, step = 0.5, group = grpUHV, display = display.none)
uhvTpDollar   = input.float(9.0,  '──── Take Profit: Fixed $ target (Dollar method only)', minval = 0.1, maxval = 500.0, step = 0.5, group = grpUHV, display = display.none)
uhvSlType    = input.string("SwingLow", '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "CandleWick", "SwingLow", "Dollar"], group = grpUHV, display = display.none)
uhvSlBuffer  = input.float(0.4,    '──── Stop Loss: How much extra room past the structure? ($)', minval = 0.0, maxval = 20.0, step = 0.2, group = grpUHV, display = display.none)
uhvSlMinDist = input.float(1.4,    '──── Stop Loss: Closest it can ever be to entry? ($)', minval = 0.1, maxval = 50.0, step = 0.1, group = grpUHV, display = display.none)
uhvSlAtrMult = input.float(0.5,    '──── Stop Loss: Volatility width? (ATR method only)', minval = 0.5, maxval = 5.0, step = 0.25, group = grpUHV, display = display.none)
uhvSlDollar  = input.float(2.7,    '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', minval = 0.1, maxval = 500.0, step = 0.1, group = grpUHV, display = display.none)
uhvSlSwingLb = input.int(19,      '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', minval = 3, maxval = 50, group = grpUHV, display = display.none)

// ─── 3. Strategy: Two Bar Reversal ───────
grpTBR = "📊 Strategy: Two Bar Reversal"
enableTBR          = input.bool(true,  'Use this strategy?', group = grpTBR, display = display.none)
tbrDirection       = input.string("Bull only", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = grpTBR, display = display.none)
tbrStatsInfo       = input.bool(false, '📊 Wins / Trades: see Stats Panel → Strategy Breakdown', group = grpTBR, display = display.none)
show2BR            = input.bool(true, 'Show signals on the chart?', group = grpTBR, display = display.none)
require2BRLowerVol = input.bool(true, 'Must the engulfing candle have lower volume than the one it engulfs?', group = grpTBR, display = display.none)
tbrDollarRisk = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', minval = 0.0, step = 0.5, group = grpTBR, display = display.none)
tbrLotSize    = input.float(0.01, '──── Risk: Fixed lot size? (when $Risk = 0)', minval = 0.01, maxval = 100.0, step = 0.01, group = grpTBR, display = display.none)
tbrTpMethod   = input.string("Dollar Amount", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = grpTBR, display = display.none)
tbrTp1Mult    = input.float(3.5,  '──── Take Profit: R:R Ratio (R:R method only)', minval = 0.5, maxval = 10.0, step = 0.5, group = grpTBR, display = display.none)
tbrTpDollar   = input.float(3.5,  '──── Take Profit: Fixed $ target (Dollar method only)', minval = 0.1, maxval = 500.0, step = 0.5, group = grpTBR, display = display.none)
tbrSlType    = input.string("SwingLow", '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "CandleWick", "SwingLow", "Dollar"], group = grpTBR, display = display.none)
tbrSlBuffer  = input.float(0.0,    '──── Stop Loss: How much extra room past the structure? ($)', minval = 0.0, maxval = 20.0, step = 0.2, group = grpTBR, display = display.none)
tbrSlMinDist = input.float(0.5,    '──── Stop Loss: Closest it can ever be to entry? ($)', minval = 0.1, maxval = 50.0, step = 0.1, group = grpTBR, display = display.none)
tbrSlAtrMult = input.float(2.25,    '──── Stop Loss: Volatility width? (ATR method only)', minval = 0.5, maxval = 5.0, step = 0.25, group = grpTBR, display = display.none)
tbrSlDollar  = input.float(0.6,    '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', minval = 0.1, maxval = 500.0, step = 0.1, group = grpTBR, display = display.none)
tbrSlSwingLb = input.int(10,       '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', minval = 3, maxval = 50, group = grpTBR, display = display.none)

// ─── 4. Strategy: Effort vs Result ───────
grpEVR = "📊 Strategy: Effort vs Result"
enableEVR           = input.bool(true,  'Use this strategy?', group = grpEVR, display = display.none)
evrDirection        = input.string("Bull only", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = grpEVR, display = display.none)
evrStatsInfo        = input.bool(false, '📊 Wins / Trades: see Stats Panel → Strategy Breakdown', group = grpEVR, display = display.none)
showVSA             = input.bool(true,  'Show signals on the chart?', group = grpEVR, display = display.none)
requireEVRHigherVol  = input.bool(false, 'Must the sweep candle have higher volume than the candle it sweeps?', group = grpEVR, display = display.none)
requireEVRLowerVol   = input.bool(false, 'Must the sweep candle have lower volume than the previous candle?', group = grpEVR, display = display.none)
avoidEVRTrendWick    = input.bool(false, 'If sweep candle has rejection wick, wait for next candle to confirm?', group = grpEVR, display = display.none)
evrUseStrongestCandle = input.bool(false, 'Track highest-volume candle (not most recent)?', group = grpEVR, display = display.none)
evrDollarRisk = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', minval = 0.0, step = 0.5, group = grpEVR, display = display.none)
evrLotSize    = input.float(0.01, '──── Risk: Fixed lot size? (when $Risk = 0)', minval = 0.01, maxval = 100.0, step = 0.01, group = grpEVR, display = display.none)
evrTpMethod   = input.string("Dollar Amount", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = grpEVR, display = display.none)
evrTp1Mult    = input.float(1.0,  '──── Take Profit: R:R Ratio (R:R method only)', minval = 0.5, maxval = 10.0, step = 0.5, group = grpEVR, display = display.none)
evrTpDollar   = input.float(28.0,  '──── Take Profit: Fixed $ target (Dollar method only)', minval = 0.1, maxval = 500.0, step = 0.5, group = grpEVR, display = display.none)
evrSlType    = input.string("SwingLow",  '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "CandleWick", "SwingLow", "Dollar"], group = grpEVR, display = display.none)
evrSlBuffer  = input.float(0.4,    '──── Stop Loss: How much extra room past the structure? ($)', minval = 0.0, maxval = 20.0, step = 0.2, group = grpEVR, display = display.none)
evrSlMinDist = input.float(0.5,    '──── Stop Loss: Closest it can ever be to entry? ($)', minval = 0.1, maxval = 50.0, step = 0.1, group = grpEVR, display = display.none)
evrSlAtrMult = input.float(5.0,    '──── Stop Loss: Volatility width? (ATR method only)', minval = 0.5, maxval = 5.0, step = 0.25, group = grpEVR, display = display.none)
evrSlDollar  = input.float(2.0,   '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', minval = 0.1, maxval = 500.0, step = 0.1, group = grpEVR, display = display.none)
evrSlSwingLb = input.int(11,       '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', minval = 3, maxval = 50, group = grpEVR, display = display.none)

// ─── 7. Trend & Filters ───────────────────
grpTrend = "📈 Trend & Filters"
// Per-strategy cooldowns (replacing old shared signalCooldown)
uhvCooldown    = input.int(45,  '──── Cooldown: Bars after a signal before another can fire?', minval = 0, maxval = 200, group = grpUHV, display = display.none)
tbrCooldown    = input.int(8,  '──── Cooldown: Bars after a signal before another can fire?', minval = 0, maxval = 200, group = grpTBR, display = display.none)
evrCooldown    = input.int(50,  '──── Cooldown: Bars after a signal before another can fire?', minval = 0, maxval = 200, group = grpEVR, display = display.none)
minTrendStrength  = input.int(15, 'Min Trend Strength at Signal', minval = 0, maxval = 100, group = grpTrend, display = display.none)
trendPersistBars  = input.int(8, 'Trend Persistence Lookback (bars)', minval = 1, maxval = 20, group = grpTrend, display = display.none)
avoidTrendShift      = input.bool(true,  'Avoid trading when trend is shifting?', group = grpTrend, display = display.none)
avoidTrendShiftUHV   = input.bool(false, '──── Apply to UHV Breakout?', group = grpTrend, display = display.none)
avoidTrendShiftTBR   = input.bool(true,  '──── Apply to Two Bar Reversal?', group = grpTrend, display = display.none)
avoidTrendShiftEVR   = input.bool(false, '──── Apply to Effort vs Result?', group = grpTrend, display = display.none)
trendShiftThreshold  = input.int(15, '──── Shift Threshold (strength drop to trigger)', minval = 1, maxval = 50, group = grpTrend, display = display.none)
strictTrendCheck     = input.bool(true,  'Require Full Trend Confirmation at Entry?',  group = grpTrend, display = display.none)
strictTrendCheckUHV  = input.bool(false, '──── Apply to UHV Breakout?',               group = grpTrend, display = display.none)
strictTrendCheckTBR  = input.bool(false,  '──── Apply to Two Bar Reversal?',            group = grpTrend, display = display.none)
strictTrendCheckEVR  = input.bool(true, '──── Apply to Effort vs Result?',            group = grpTrend, display = display.none)
useRetraceExpiry  = input.bool(true, 'Cancel Setup on Early Bounce-Back', group = grpTrend, display = display.none)
trendShowMA       = input.bool(true, 'Show Trend MA Line on Chart', group = grpTrend, display = display.none)
requireOpposingCandle = input.bool(false,  'Must there be an opposing candle before the entry bar?', group = grpTBR, display = display.none)

// ─── 8. HTF Fair Value Gap ────────────────
grpHTF = "🔭 Higher Time Frame Fair Value Gap"
useHtfFvg      = input.bool(true, 'Use Higher Time Frame FVG for Signals', group = grpHTF, display = display.none)
htfFvgTfChoice = input.string("Auto", 'Higher Time Frame', options = ["Auto", "1", "5", "15", "60", "240"], group = grpHTF, display = display.none)
htfAutoTf      = timeframe.period  // AUTO = same as the chart's current timeframe
htfFvgTf       = htfFvgTfChoice == "Auto" ? htfAutoTf : htfFvgTfChoice
htfFvgColor    = input.color(color.new(#f5a623, 60), 'Higher Time Frame FVG Zone Color', group = grpHTF, display = display.none)
fvgTH          = input.float(0.3, 'FVG Width Filter (ATR multiple)', minval = 0, step = .1, group = grpHTF, display = display.none)
uhvFvgTH       = input.float(0.3, '──── UHV Breakout: FVG Width Filter (ATR multiple)', minval = 0, step = .1, group = grpHTF, display = display.none)
tbrFvgTH       = input.float(0.3, '──── Two Bar Reversal: FVG Width Filter (ATR multiple)', minval = 0, step = .1, group = grpHTF, display = display.none)
evrFvgTH       = input.float(0.2, '──── Effort vs Result: FVG Width Filter (ATR multiple)', minval = 0, step = .1, group = grpHTF, display = display.none)
fvgPR          = input.bool(true, 'Show Mitigation %', group = grpHTF, display = display.none)
fvgVF          = input.bool(true, 'Show Historical FVGs', inline = 'FL', group = grpHTF, display = display.none)
fvgBC          = input.color(color.new(#089981, 55), 'Bullish  Imbalance', inline = 'VA', group = grpHTF, display = display.none)
fvgAC          = input.color(color.new(#787b86, 77), 'Mitigated', inline = 'VA', group = grpHTF, display = display.none)
fvgSC          = input.color(color.new(#f23645, 55), 'Bearish  Imbalance', inline = 'VD', group = grpHTF, display = display.none)
fvgFC          = input.color(color.new(#787b86, 77), 'Mitigated', inline = 'VD', group = grpHTF, display = display.none)

// ─── 9. Display ───────────────────────────
grpDisplay = "🖥️ Display"
showLabels     = input.bool(true,  'Show Signal Labels', group = grpDisplay, display = display.none)
showDebug      = input.bool(true, 'Show Debug Labels', group = grpDisplay, display = display.none)
showStatsPanel = input.bool(true,  'Show Stats Panel', group = grpDisplay, display = display.none)

// ─── 10. PineConnector Automation ─────────
grpPC = "🤖 PineConnector Automation"
pcEnable    = input.bool(true,   'Send signals to PineConnector (MT5)?', group = grpPC, display = display.none)
pcLicenseId = input.string("8778286989525", 'PineConnector License ID', group = grpPC, display = display.none)
pcSymbol    = input.string("XAUUSD",         'MT5 Symbol Name', group = grpPC, display = display.none)

// ─── 11. Optimize ────────
grpOpt  = "⚡ Optimize"
optSmart = input.bool(false, '⚡ OPTIMIZE  —  click to auto-apply best settings', group = grpOpt, display = display.none)
optLevel        = input.int(1,    '⚡ Optimization level — raise by 1 for each new batch of changes (1 = filter removals → 5 = max loss cap)', minval = 1, maxval = 10, group = grpOpt, display = display.none)
reduceLoss      = input.bool(false, '🎯 Reduce Max Loss Per Trade  —  cap SL to limit dollar loss', group = grpOpt, display = display.none)
reduceLossMode  = input.string("Auto (avg win per strategy)", '──── Cap Mode', options = ["Auto (avg win per strategy)", "Fixed $ for all strategies"], group = grpOpt, display = display.none)
reduceLossFixed = input.float(50.0, '──── Fixed cap ($) — used when mode is Fixed', minval = 1.0, maxval = 500.0, step = 5.0, group = grpOpt, display = display.none)
_optToolHdr  = input.bool(false, '🧭 Optimizer Tool — How to use: select strategy → enable → check Apply Setting #1-5 → run 10+ trades → enter best # in Round Best Setting below → repeat 6 rounds per strategy', group = grpOpt, display = display.none)
optGuideStrategy = input.string("UHV Breakout", '   Step 1: Select 1 Strategy to Optimize:', options = ["UHV Breakout", "Two Bar Reversal", "Effort vs Result"], group = grpOpt, display = display.none)
optGuideEnable  = input.bool(false, '   Step 2: Enable Guided Optimizer', group = grpOpt, display = display.none)
optGuideTry1    = input.bool(false, '   ☐ Apply Setting #1 — if best, enter 1 in Round Best Setting below', group = grpOpt, display = display.none)
optGuideTry2    = input.bool(false, '   ☐ Apply Setting #2 — if best, enter 2 in Round Best Setting below', group = grpOpt, display = display.none)
optGuideTry3    = input.bool(false, '   ☐ Apply Setting #3 — if best, enter 3 in Round Best Setting below', group = grpOpt, display = display.none)
optGuideTry4    = input.bool(false, '   ☐ Apply Setting #4 — if best, enter 4 in Round Best Setting below', group = grpOpt, display = display.none)
optGuideTry5    = input.bool(false, '   ☐ Apply Setting #5 — if best, enter 5 in Round Best Setting below', group = grpOpt, display = display.none)
optGuideNoneAbove = input.bool(false, '   ☐ None of the above settings improves profits — Proceed to next round (enter 3 in Round Best Setting below)', group = grpOpt, display = display.none)
_optStep3Hdr = input.bool(false, 'Step 3: After trying the 5 settings above, select the best setting number below for each round (Rounds are shown in the bottom-left Optimizer panel on the chart):', group = grpOpt, display = display.none)
optUhvW1 = input.int(0, '   UHV Strategy Round 1 Best Setting (0 = not done yet)', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optUhvW2 = input.int(0, '   UHV Strategy Round 2 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optUhvW3 = input.int(0, '   UHV Strategy Round 3 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optUhvW4 = input.int(0, '   UHV Strategy Round 4 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optUhvW5 = input.int(0, '   UHV Strategy Round 5 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optUhvW6 = input.int(0, '   UHV Strategy Round 6 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optTbrW1 = input.int(0, '   2BR Strategy Round 1 Best Setting (0 = not done yet)', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optTbrW2 = input.int(0, '   2BR Strategy Round 2 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optTbrW3 = input.int(0, '   2BR Strategy Round 3 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optTbrW4 = input.int(0, '   2BR Strategy Round 4 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optTbrW5 = input.int(0, '   2BR Strategy Round 5 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optTbrW6 = input.int(0, '   2BR Strategy Round 6 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optEvrW1 = input.int(0, '   EVR Strategy Round 1 Best Setting (0 = not done yet)', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optEvrW2 = input.int(0, '   EVR Strategy Round 2 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optEvrW3 = input.int(0, '   EVR Strategy Round 3 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optEvrW4 = input.int(0, '   EVR Strategy Round 4 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optEvrW5 = input.int(0, '   EVR Strategy Round 5 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optEvrW6 = input.int(0, '   EVR Strategy Round 6 Best Setting', minval = 0, maxval = 5, group = grpOpt, display = display.none)
optGuideReset   = input.bool(false, 'Reset Optimizer → Start New Optimization Rounds (check or uncheck — both clear all round history and restart from Round 1)', group = grpOpt, display = display.none)

// Pre-computed timeframe constants — derived from timeframe.period string (global scope safe)
tfMinutes   = timeframe.period == "D" ? 1440.0 : timeframe.period == "W" ? 10080.0 : str.tonumber(timeframe.period)
tfSeconds   = tfMinutes * 60.0
barsPerHour = math.max(1, math.round(60.0 / tfMinutes))

// TYPES
type bar
    float h = high
    float l = low
    float c = close
    int   i = bar_index

// VARS
bar b = bar.new()

// ── Multi-FVG visual arrays ──
var box  [] aUFVG = array.new<box>(0)
var box  [] aMFVG = array.new<box>(0)
var box  [] aTFVG = array.new<box>(0)
var line [] aLFVG = array.new<line>(0)
var bool [] aDIR  = array.new<bool>(0)

// ── Signal-tracking FVG ──
// Initialize as false instead of na to avoid type error on some Pine versions
var bool  lastIsBull    = false
var float fvgZoneTop    = na
var float fvgZoneBot    = na
var float poiLevelHL    = na   // Higher Low / Lower High POI level
var float poiLevelSup   = na   // Support / Resistance flip POI level
var line  poiLineHL     = na   // chart line for Higher Low POI
var line  poiLineSup    = na   // chart line for Support POI
var int   fvgCreatedBar = na
var bool  hadFVG        = false
var bool  fvgUsed       = false

// UHV tracking
var float uhvVolume     = 0.0
var float uhvHigh       = na
var float uhvLow        = na
var float uhvSL         = na
var label uhvLabel      = na
var int   uhvBar        = na
var bool  uhvLowSwept   = false  // bull: UHV low must be swept (wick below OR body close below) before breakout
var bool  uhvHighSwept  = false  // bear: UHV high must be swept (wick above OR body close above) before breakout
var float retraceLow    = na     // bull: lowest low during retracement — used as structural SL
var float retraceHigh   = na     // bear: highest high during retracement — used as structural SL

// Accuracy tracking
var int   totalSignals  = 0
var int   winCount      = 0

// Dollar P&L per trade
var float[] dollarPnLHistory = array.new_float()
var int     completedTrades  = 0

// Active trade tracking
var float[] tradeEntry  = array.new_float()
var float[] tradeSL     = array.new_float()
var float[] tradeTP1    = array.new_float()
var bool [] tradeBull   = array.new_bool()
var bool [] tradeTP1Hit = array.new_bool()
var bool  [] tradeSLHit    = array.new_bool()
var float [] tradeEffLots  = array.new_float()
var int   [] tradeEntryBar = array.new_int()
var label [] tradeLabel    = array.new<label>()  // signal label ref for post-trade update
var string[] tradeType     = array.new_string()   // "uhv", "tbr", "evr"
var int   [] tradeNum      = array.new_int()       // sequential trade number (#1, #2, ...)
var float [] tradeTrendStr = array.new_float()    // trendStrength at entry
var bool  [] tradeWon      = array.new_bool()     // true = TP hit, false = SL hit (set on close)
var float [] tradeSlDist   = array.new_float()    // SL distance in price at entry
var int   [] tradeSlBars   = array.new_int()      // bar_index when SL was hit (-1 = not yet)

// Breakout line
var float brkLevel      = na
var bool  brkTriggered  = false
var bool  uhvFiredThisSetup = false  // UHV has fired from the current setup
var bool  uhvWasBlocked     = false  // UHV would have fired but lower-vol filter blocked it
var bool  tbrFiredThisSetup = false  // TBR has fired from the current setup
var bool  evrFiredThisSetup = false  // EVR has fired from the current setup

// ── Stats tracking ──
var int   signalsToday      = 0       // signals fired today
var float pnlToday          = 0.0     // P&L closed today
var float pnlLastHour       = 0.0     // P&L closed in last 60 min
var int   todayLossStreak   = 0       // current consecutive losses today
var int   maxLossStreakToday = 0       // max consecutive losses today
var int   lastTradeDay      = -1      // dayofmonth of last reset
var int[] tradeCloseTime    = array.new_int()   // bar_index when trade closed
var int[] tradeCloseTS      = array.new_int()   // actual unix timestamp when trade closed (for date/hour filtering)
var float[] tradePnLArr     = array.new_float() // P&L parallel to tradeCloseTime
var string[] tradePnLType   = array.new_string() // strategy type at CLOSE time, parallel to tradePnLArr (tradeType is at OPEN time and may be misaligned)
var int[] signalBarTimes    = array.new_int()   // bar_index of each signal (for signals/day)
var int   totalDaysSeen       = 1
var int   totalSignalsAllDays = 0
// Per-strategy P&L and trade tracking
var float uhvPnL      = 0.0
var int   uhvTrades   = 0
var int   uhvWins     = 0
var float uhvPnLToday = 0.0
var float tbrPnL      = 0.0
var int   tbrTrades   = 0
var int   tbrWins     = 0
var float tbrPnLToday = 0.0
var float evrPnL      = 0.0
var int   evrTrades   = 0
var int   evrWins     = 0
var float evrPnLToday = 0.0
// Blocked-signal counters — for recommendation engine
var int blockedBySwept    = 0   // UHV blocked only by no-sweep
var int blockedUHVVol     = 0   // UHV blocked only by volume check
var int blockedByOpposing = 0   // IB blocked only by no opposing candle
var int blocked2BRVol     = 0   // 2BR blocked only by volume check
var int blockedEVRVol      = 0   // EVR blocked only by higher-vol check
var int blockedEVRLowerVol = 0   // EVR blocked only by lower-vol-than-prev-candle check
var int blockedByCooldown = 0   // any signal blocked only by cooldown
var int blockedByStrength = 0   // any signal blocked only by trend strength

// ── Smart optimizer accumulators (updated at trade close, used for proof computation) ──
// Per-strategy win/loss sums — allow computing avg win, avg loss, and EV per strategy
var float uhvWinSum  = 0.0   // sum of all winning UHV trade P&L
var float uhvLossSum = 0.0   // sum of |P&L| for losing UHV trades
var float tbrWinSum  = 0.0
var float tbrLossSum = 0.0
var float evrWinSum  = 0.0
var float evrLossSum = 0.0
// Per-strategy per-direction P&L — for direction optimization proof
var float uhvBullPnL = 0.0
var int   uhvBullT   = 0
var int   uhvBullW   = 0
var float uhvBearPnL = 0.0
var int   uhvBearT   = 0
var int   uhvBearW   = 0
var float tbrBullPnL = 0.0
var int   tbrBullT   = 0
var int   tbrBullW   = 0
var float tbrBearPnL = 0.0
var int   tbrBearT   = 0
var int   tbrBearW   = 0
var float evrBullPnL = 0.0
var int   evrBullT   = 0
var int   evrBullW   = 0
var float evrBearPnL = 0.0
var int   evrBearT   = 0
var int   evrBearW   = 0
// TP+1 proof: track wins where price continued past TP+$1 on the same bar (same-bar confirmation)
var int   tp1SameBarWins   = 0   // TP wins where high (bull) / low (bear) ALSO hit TP+$1 on that bar
var int   tp1SameBarChecks = 0   // total TP wins checked (denominator)
// Yesterday stats computed from tradeCloseTS in panel block

// ── Bullish tracking ──
var float runningHigh    = na
var float prevHigh       = na
var float lastGreenLow   = na
var float lastGreenClose = na

// ── Bearish tracking ──
var float runningLow     = na
var float prevLow        = na
var float lastRedHigh    = na
var float lastRedClose   = na

// Retracement state
var bool  inRetracement  = false
var bool  fvgReached     = false
var bool  retraceWasBull = false
var float retraceCeiling  = na
var float retraceFloor    = na
var int   retraceStartBar = na

// ── Block A improved IB + retracement logic ──
// IB = Independent Bar: close breaks ABOVE prev candle high (bull) / BELOW prev candle low (bear)
// seenBear/GreenSinceIB guards prevent consecutive IBs without a real pullback between them
var bool ibTracking        = false   // true from IB detection until retracement fires
var bool seenBearSinceIB      = true    // start true so first IB can fire immediately
var bool seenGreenSinceIB     = true    // bear side equivalent
var bool seenBearSinceRetrace  = false  // red candle seen during current bull retracement (for 2BR opposing candle filter)
var bool seenGreenSinceRetrace = false  // green candle seen during current bear retracement (for 2BR opposing candle filter)
var bool  _2brSeenThisSetup       = false  // structural 2BR candle appeared this setup (regardless of vol filter) — keeps bounceCancel suppressed
var bool  _evrSeenThisSetup       = false  // structural EVR sweep candle appeared this setup (regardless of vol filter) — keeps bounceCancel suppressed
var float _setupStartStrength     = na     // trendStrength at the moment this retracement began (for trend-shift threshold)

// Cooldown tracking
var int   lastUHVSignalBar = -999   // last bar UHV fired (for per-strategy cooldown)
var int   lastTBRSignalBar = -999   // last bar 2BR fired
var int   lastEVRSignalBar = -999   // last bar EVR fired

// VSA (Effort vs Result) tracking — independent of UHV breakout system
// Tracks the highest-volume RED candle seen during bull retracement
// and highest-volume GREEN candle during bear retracement
var float vsaRedLow  = na   // low of most recent red candle during bull retracement
var float vsaRedVol  = 0.0  // volume of that candle
var float vsaGrnHigh = na   // high of most recent green candle during bear retracement
var float vsaGrnVol  = 0.0  // volume of that candle

// EVR wick-confirmation pending state
// When avoidEVRTrendWick is ON and the sweep candle has a rejection wick,
// we don't fire immediately — we wait for the NEXT candle to break the wick candle's high/low
var bool  evrBullWickPending = false  // bull: waiting for next candle to confirm above wick high
var float evrWickCandleHigh  = na     // high of the bull wick candle to break above
var bool  evrBearWickPending = false  // bear: waiting for next candle to confirm below wick low
var float evrWickCandleLow   = na     // low of the bear wick candle to break below

// BASE FVG CALCULATIONS
bullG = b.l > b.h[1]
bearG = b.h < b.l[1]
atr   = nz(ta.atr(144)) * fvgTH
bull  = (b.l - b.h[2]) > atr and b.l > b.h[2] and b.c[1] > b.h[2] and not (bullG or bullG[1])
bear  = (b.l[2] - b.h) > atr and b.h < b.l[2] and b.c[1] < b.l[2] and not (bearG or bearG[1])

// STEP 1: TREND DETECTION
isGreen = close > open
isRed   = close < open
bodySize    = math.abs(close - open)
candleRange = high - low

if not inRetracement
    if isGreen
        if high > nz(runningHigh, high - 1)
            prevHigh    := runningHigh
            runningHigh := high
        lastGreenLow   := low
        lastGreenClose := close
    if isRed
        if low < nz(runningLow, low + 1)
            prevLow    := runningLow
            runningLow := low
        lastRedHigh    := high
        lastRedClose   := close

inUptrend   = not na(prevHigh) and not na(runningHigh) and runningHigh > prevHigh
inDowntrend = not na(prevLow)  and not na(runningLow)  and runningLow  < prevLow

// TREND ENGINE (EMA 34 / 89 multi-factor)
_fast        = 34
_slow        = 89
_swingLen    = 20
_atrLen      = 14
_volLen      = 20
_rangeFactor = 0.45
_htf_tf      = "240"
_breakoutPct = 0.001

te_fastEma   = ta.ema(close, _fast)
te_slowEma   = ta.ema(close, _slow)
te_atr       = ta.atr(_atrLen)
te_atrMa     = ta.sma(te_atr, _atrLen)
te_volMa     = ta.sma(volume, _volLen)
te_slopeAbs  = math.abs(te_fastEma - te_fastEma[1])

te_emaBull   = te_fastEma > te_slowEma
te_emaBear   = te_fastEma < te_slowEma
te_slopeBull = te_fastEma > te_fastEma[1]
te_slopeBear = te_fastEma < te_fastEma[1]
te_flatSlope = te_slopeAbs < te_atr * 0.1

te_recentHigh = ta.highest(high, _swingLen)
te_recentLow  = ta.lowest(low,  _swingLen)
te_structBull = close > te_recentLow
te_structBear = close < te_recentHigh
te_noStruct   = not te_structBull and not te_structBear

te_htfFast   = request.security(syminfo.tickerid, _htf_tf, ta.ema(close, _fast))
te_htfSlow   = request.security(syminfo.tickerid, _htf_tf, ta.ema(close, _slow))
te_htfBull   = te_htfFast > te_htfSlow
te_htfBear   = te_htfFast < te_htfSlow

te_volExp    = volume > te_volMa
te_atrExp    = te_atr > te_atrMa
te_atrComp   = te_atr < te_atrMa * _rangeFactor
te_isRanging = te_atrComp and te_flatSlope and te_noStruct

te_brkUp     = close > te_recentHigh * (1 + _breakoutPct)
te_brkDn     = close < te_recentLow  * (1 - _breakoutPct)

te_rawBull   = (te_emaBull and te_slopeBull and te_structBull and not te_isRanging) or te_brkUp
te_rawBear   = (te_emaBear and te_slopeBear and te_structBear and not te_isRanging) or te_brkDn

te_relaxed   = (te_volExp or te_atrExp)
te_bullConf  = (te_rawBull and te_relaxed) or te_brkUp
te_bearConf  = (te_rawBear and te_relaxed) or te_brkDn

te_bullStart = te_bullConf or te_rawBull
te_bearStart = te_bearConf or te_rawBear

te_strength  = 0.0
te_strength += te_bullConf or te_bearConf ? 30.0 : 0.0
te_strength += te_volExp and te_atrExp    ? 25.0 : 0.0
te_strength += te_htfBull or te_htfBear  ? 10.0 : 0.0
te_strength += te_slopeAbs > te_atr * 0.2 ? 15.0 : 0.0
te_strength += not te_isRanging           ? 10.0 : 0.0
trendStrength = math.round(math.min(100.0, math.max(0.0, te_strength)))

isBull = (te_bullStart and not te_bearStart) or (te_bullStart and te_bearStart and trendStrength >= 50)
isBear = (te_bearStart and not te_bullStart) or (te_bullStart and te_bearStart and trendStrength < 50)

htfBull = isBull
htfBear = isBear

te_transpLevel = trendStrength > 75 ? 0 : trendStrength > 50 ? 20 : trendStrength > 25 ? 40 : trendStrength > 10 ? 60 : 80
te_lineColor   = isBull ? color.new(color.green, te_transpLevel) : isBear ? color.new(color.red, te_transpLevel) : color.new(color.gray, 80)

te_w1 = trendStrength <= 10                              ? te_fastEma : na
te_w2 = trendStrength > 10 and trendStrength <= 25       ? te_fastEma : na
te_w3 = trendStrength > 25 and trendStrength <= 50       ? te_fastEma : na
te_w4 = trendStrength > 50 and trendStrength <= 75       ? te_fastEma : na
te_w5 = trendStrength > 75                               ? te_fastEma : na

// ── ATR for SL calculations ──
_atr14 = ta.atr(14)

// HTF FVG DETECTION
// Detection runs INSIDE request.security so [2] means 2 HTF bars ago
// This is the only correct way — [2] on current TF would be 2 current bars
f_htfFvg(_th) =>
    _atr  = nz(ta.atr(144)) * _th
    _bull = (low - high[2]) > _atr and low > high[2] and close[1] > high[2]
    _bear = (low[2] - high) > _atr and high < low[2] and close[1] < low[2]
    // Persist the most recent zone levels across HTF bars
    var float _zTop    = na
    var float _zBot    = na
    var bool  _zIsBull = na
    if _bull
        _zTop    := low
        _zBot    := high[2]
        _zIsBull := true
    if _bear
        _zTop    := low[2]
        _zBot    := high
        _zIsBull := false
    [_bull, _bear, _zTop, _zBot, _zIsBull]

// Fetch all 5 values from HTF — [2] inside runs on HTF bars, not current TF bars
[htf_rawBull, htf_rawBear, htf_zTop, htf_zBot, htf_zIsBull] =
     request.security(syminfo.tickerid, htfFvgTf, f_htfFvg(fvgTH), barmerge.gaps_off, barmerge.lookahead_on)

// Detect rising edge on current TF (htf_rawBull stays true for all lower-TF bars in that HTF candle)
var bool _prevRawBull = false
var bool _prevRawBear = false
htf_newBull = htf_rawBull and not _prevRawBull
htf_newBear = htf_rawBear and not _prevRawBear
_prevRawBull := htf_rawBull
_prevRawBear := htf_rawBear

// Draw ALL HTF FVG zones as boxes — one per FVG, auto-removed when filled
var box[]   htfFvgBoxes      = array.new<box>()
var float[] htfFvgTops       = array.new_float()
var float[] htfFvgBots       = array.new_float()
var bool[]  htfFvgBull       = array.new_bool()
var int[]   htfFvgTouchCount = array.new_int()    // 0=untouched, 1=first touch, 2=retested
var bool[]  htfFvgInZone     = array.new_bool()   // true when price is currently inside zone
var int[]   htfFvgRetestBar  = array.new_int()    // bar_index when retest began (-1 = not yet)

if useHtfFvg
    if htf_newBull
        _top = htf_zTop
        _bot = htf_zBot
        _b   = box.new(bar_index, _top, bar_index + 1, _bot,
             border_color = color.new(htfFvgColor, 10), border_width = 1,
             bgcolor = color.new(htfFvgColor, 80))
        array.push(htfFvgBoxes,      _b)
        array.push(htfFvgTops,       _top)
        array.push(htfFvgBots,       _bot)
        array.push(htfFvgBull,       true)
        array.push(htfFvgTouchCount, 0)
        array.push(htfFvgInZone,     false)
        array.push(htfFvgRetestBar,  -1)

    if htf_newBear
        _top = htf_zTop
        _bot = htf_zBot
        _b   = box.new(bar_index, _top, bar_index + 1, _bot,
             border_color = color.new(color.red, 10), border_width = 1,
             bgcolor = color.new(color.red, 80))
        array.push(htfFvgBoxes,      _b)
        array.push(htfFvgTops,       _top)
        array.push(htfFvgBots,       _bot)
        array.push(htfFvgBull,       false)
        array.push(htfFvgTouchCount, 0)
        array.push(htfFvgInZone,     false)
        array.push(htfFvgRetestBar,  -1)

    // Extend boxes, track touches, freeze box 3 bars after retest
    _htfSize = array.size(htfFvgBoxes)
    if _htfSize > 0
        for _hfi = _htfSize - 1 to 0
            // Guard: array may have shrunk due to mid-loop removals
            if _hfi < array.size(htfFvgBoxes)
                _hb         = array.get(htfFvgBoxes,      _hfi)
                _ht         = array.get(htfFvgTops,        _hfi)
                _hbo        = array.get(htfFvgBots,        _hfi)
                _hbull      = array.get(htfFvgBull,        _hfi)
                _touches    = array.get(htfFvgTouchCount,  _hfi)
                _wasInZone  = array.get(htfFvgInZone,      _hfi)
                _retestBar  = array.get(htfFvgRetestBar,   _hfi)

                // Is price currently inside the zone?
                _inZoneNow  = low <= _ht and high >= _hbo

                // Detect entry into zone (new touch)
                if _inZoneNow and not _wasInZone
                    _touches += 1
                    array.set(htfFvgTouchCount, _hfi, _touches)
                    if _touches == 2
                        array.set(htfFvgRetestBar, _hfi, bar_index)

                array.set(htfFvgInZone, _hfi, _inZoneNow)

                // Full invalidation: price closed well beyond zone
                _invalidated = _hbull ? close < _hbo - (_ht - _hbo) : close > _ht + (_ht - _hbo)
                // Retest done: 3 bars have passed since second touch
                _retestDone  = _retestBar >= 0 and (bar_index - _retestBar) >= 3

                if _invalidated
                    box.delete(_hb)
                    array.remove(htfFvgBoxes,     _hfi)
                    array.remove(htfFvgTops,      _hfi)
                    array.remove(htfFvgBots,      _hfi)
                    array.remove(htfFvgBull,      _hfi)
                    array.remove(htfFvgTouchCount,_hfi)
                    array.remove(htfFvgInZone,    _hfi)
                    array.remove(htfFvgRetestBar, _hfi)
                else if _retestDone
                    // Freeze box: fade colors, stop extending
                    _fadedBg     = _hbull ? color.new(htfFvgColor, 92) : color.new(color.red, 92)
                    _fadedBorder = _hbull ? color.new(htfFvgColor, 60) : color.new(color.red, 60)
                    box.set_bgcolor(_hb, _fadedBg)
                    box.set_border_color(_hb, _fadedBorder)
                    array.remove(htfFvgBoxes,     _hfi)
                    array.remove(htfFvgTops,      _hfi)
                    array.remove(htfFvgBots,      _hfi)
                    array.remove(htfFvgBull,      _hfi)
                    array.remove(htfFvgTouchCount,_hfi)
                    array.remove(htfFvgInZone,    _hfi)
                    array.remove(htfFvgRetestBar, _hfi)
                else
                    box.set_right(_hb, bar_index + 1)

// FVG BOX CREATION
if bull
    // Only draw current-TF FVG boxes when HTF mode is OFF
    if not useHtfFvg
        aUFVG.unshift(box.new(b.i - 1, b.l,    b.i, b.h[2], border_color = na, bgcolor = fvgBC))
        aMFVG.unshift(box.new(b.i - 1, b.l,    b.i, b.l,    border_color = na, bgcolor = fvgAC))
        aTFVG.unshift(box.new(b.i - 1, b.l,    b.i, b.h[2], border_color = na, bgcolor = color(na), text_color = chart.fg_color, text_size = size.small))
        aLFVG.unshift(line.new(b.i - 1, b.h[2], b.i, b.h[2], color = fvgBC, width = 2))
        aDIR.unshift(true)
    // Signal-tracking: only update from current-TF FVG when HTF mode is OFF
    if not useHtfFvg and not inRetracement
        fvgZoneTop    := b.l
        fvgZoneBot    := b.h[2]
        fvgCreatedBar := b.i
        hadFVG        := true
        lastIsBull    := true
        fvgUsed       := false
        uhvVolume     := 0.0
        uhvHigh       := na
        uhvLow        := na
        uhvBar        := na
        uhvLabel      := na
        brkLevel      := na
        brkTriggered  := false
        inRetracement := false
        ibTracking    := false
        fvgReached    := false

if bear
    // Only draw current-TF FVG boxes when HTF mode is OFF
    if not useHtfFvg
        aUFVG.unshift(box.new(b.i - 1, b.l[2], b.i, b.h,    border_color = na, bgcolor = fvgSC))
        aMFVG.unshift(box.new(b.i - 1, b.h,    b.i, b.h,    border_color = na, bgcolor = fvgFC))
        aTFVG.unshift(box.new(b.i - 1, b.l[2], b.i, b.h,    border_color = na, bgcolor = color(na), text_color = chart.fg_color, text_size = size.small))
        aLFVG.unshift(line.new(b.i - 1, b.l[2], b.i, b.l[2], color = fvgSC, width = 2))
        aDIR.unshift(false)
    // Signal-tracking: only update from current-TF FVG when HTF mode is OFF
    if not useHtfFvg and not inRetracement
        fvgZoneTop    := b.l[2]
        fvgZoneBot    := b.h
        fvgCreatedBar := b.i
        hadFVG        := true
        lastIsBull    := false
        fvgUsed       := false
        uhvVolume     := 0.0
        uhvHigh       := na
        uhvLow        := na
        uhvBar        := na
        uhvLabel      := na
        brkLevel      := na
        brkTriggered  := false
        inRetracement := false
        ibTracking    := false
        fvgReached    := false

// ── HTF FVG signal-tracking update ──
// When HTF mode is ON: signal-tracking zone is driven by the HTF FVG
// On every bar: ensure hadFVG=true whenever a valid HTF zone exists
// This fixes 1m (and other lower-TF) charts where htf_newBull/Bear only fires once
// historically and hadFVG would otherwise stay false indefinitely
if useHtfFvg and not na(htf_zTop) and not na(htf_zBot) and not na(htf_zIsBull)
    // Always keep zone synced — even if the FVG formed long ago
    if not hadFVG or (fvgZoneTop != htf_zTop and fvgZoneBot != htf_zBot and not inRetracement)
        fvgZoneTop := htf_zTop
        fvgZoneBot := htf_zBot
        lastIsBull := htf_zIsBull
        hadFVG     := true
    // On a brand-new HTF FVG: full reset of retracement state
    if (htf_newBull or htf_newBear) and not inRetracement
        fvgZoneTop    := htf_zTop
        fvgZoneBot    := htf_zBot
        fvgCreatedBar := b.i
        hadFVG        := true
        lastIsBull    := htf_zIsBull
        fvgUsed       := false
        uhvVolume     := 0.0
        uhvHigh       := na
        uhvLow        := na
        uhvBar        := na
        uhvLabel      := na
        brkLevel      := na
        brkTriggered  := false
        inRetracement := false
        ibTracking    := false
        fvgReached    := false

// UPDATE ALL FVGs
if aUFVG.size() > 0
    int _sz = aUFVG.size()
    for _k = _sz - 1 to 0
        cUB = aUFVG.get(_k)
        tUB = cUB.get_top()
        bUB = cUB.get_bottom()
        cMB = aMFVG.get(_k)
        tMB = cMB.get_top()
        bMB = cMB.get_bottom()
        cTB = aTFVG.get(_k)
        cL  = aLFVG.get(_k)
        _p  = aDIR.get(_k)
        bool _remove = false

        if b.h > bUB and b.l < tUB
            if _p
                if b.l > bUB
                    cMB.set_bottom(math.min(b.l, bMB))
                    cUB.set_top(math.min(b.l, bMB))
                    if fvgPR
                        cTB.set_text(str.tostring((tMB - math.min(b.l, bMB)) / (tMB - bUB), '#.#%'))
                else
                    cMB.set_bottom(bUB)
                    cUB.set_top(bUB)
                    cTB.set_text('')
                    _remove := true
            else
                if b.h < tUB
                    cMB.set_top(math.max(b.h, tMB))
                    cUB.set_bottom(math.max(b.h, tMB))
                    if fvgPR
                        cTB.set_text(str.tostring((math.max(b.h, tMB) - bMB) / (tUB - bMB), '#.#%'))
                else
                    cMB.set_top(tUB)
                    cUB.set_bottom(tUB)
                    cTB.set_text('')
                    _remove := true

        if _remove
            if not fvgVF
                cUB.delete()
                cMB.delete()
                cTB.delete()
                cL.delete()
            aUFVG.remove(_k)
            aMFVG.remove(_k)
            aTFVG.remove(_k)
            aLFVG.remove(_k)
            aDIR.remove(_k)
        else
            cUB.set_right(b.i)
            cMB.set_right(b.i)
            cTB.set_right(b.i)
            cL.set_x2(b.i)

// POST-SIGNAL AUTO-RESET
if fvgUsed and not inRetracement
    if lastIsBull and hadFVG and high > nz(runningHigh, high - 1)
        fvgUsed := false
    if not lastIsBull and hadFVG and low < nz(runningLow, low + 1)
        fvgUsed := false

// STEP 2: RETRACEMENT START  (Block A improved logic)
// cooldown is now per-strategy: uhvCooldown / tbrCooldown / evrCooldown

// ── Update seen-bear/green trackers ──
// Once an IB fires we reset the flag; it flips back when the opposite candle appears
if not inRetracement
    if isRed
        seenBearSinceIB  := true
    if isGreen
        seenGreenSinceIB := true

// ── POI helper functions: find Higher Low / Support level for zone touch mode ──
f_findHigherLow(_lb) =>
    float _sw1 = na
    float _sw2 = na
    float _result = na
    for _i = 2 to _lb - 1
        if low[_i] < low[_i - 1] and low[_i] < low[_i + 1]
            if na(_sw1)
                _sw1 := low[_i]
            else
                _sw2 := low[_i]
                break
    if not na(_sw1) and not na(_sw2) and _sw1 > _sw2
        _result := _sw1
    _result

f_findLowerHigh(_lb) =>
    float _sh1 = na
    float _sh2 = na
    float _result = na
    for _i = 2 to _lb - 1
        if high[_i] > high[_i - 1] and high[_i] > high[_i + 1]
            if na(_sh1)
                _sh1 := high[_i]
            else
                _sh2 := high[_i]
                break
    if not na(_sh1) and not na(_sh2) and _sh1 < _sh2
        _result := _sh1
    _result

f_findSupLevel(_lb) =>
    float _result = na
    for _i = 2 to _lb - 1
        if high[_i] > high[_i - 1] and high[_i] > high[_i + 1] and high[_i] < close
            _result := high[_i]
            break
    _result

f_findResLevel(_lb) =>
    float _result = na
    for _i = 2 to _lb - 1
        if low[_i] < low[_i - 1] and low[_i] < low[_i + 1] and low[_i] > close
            _result := low[_i]
            break
    _result

// ── SL calculation helper: all SL params passed per-strategy ──
f_calcSL(_isBull, _entryPrice, _structLow, _structHigh, _slType, _slBuffer, _slAtrMult, _slSwingLb, _slMinDist, _dollarRisk, _lotSize, _slDollar = 2.0) =>
    _atrSL     = _isBull ? _entryPrice - _atr14 * _slAtrMult : _entryPrice + _atr14 * _slAtrMult
    _wickSL    = _isBull ? low  - _slBuffer : high + _slBuffer
    _swingLow  = nz(ta.lowest(low,  _slSwingLb), _structLow)
    _swingHigh = nz(ta.highest(high, _slSwingLb), _structHigh)
    _swingSL   = _isBull ? _swingLow  - _slBuffer : _swingHigh + _slBuffer
    _structSLv = _isBull ? _structLow - _slBuffer  : _structHigh + _slBuffer
    _dollarDist = _dollarRisk > 0 ? _dollarRisk / (_lotSize * cMult) : _lotSize * 1.0
    _dollarSLv  = _isBull ? _entryPrice - _slDollar : _entryPrice + _slDollar
    _raw = _slType == "ATR"        ? _atrSL :
           _slType == "CandleWick" ? _wickSL :
           _slType == "SwingLow"   ? _swingSL :
           _slType == "Dollar"     ? _dollarSLv : _structSLv
    // Enforce minimum distance (skip for Dollar — user sets distance explicitly)
    // Also guard against negative SL price (can happen on very early historical bars at tiny prices)
    _result = _slType == "Dollar" ? _raw : (_isBull ? math.min(_entryPrice - _slMinDist, _raw) : math.max(_entryPrice + _slMinDist, _raw))
    math.max(syminfo.mintick, _result)

// ── Signal block helpers (replace repeated code in all 8 signal entry blocks) ──
f_totalPnL() =>
    float _s = 0.0
    int _sz = math.min(array.size(tradePnLArr), array.size(tradeCloseTS))
    if _sz > 0
        for _i = 0 to _sz - 1
            if array.get(tradeCloseTS, _i) >= statsResetDate
                _s += array.get(tradePnLArr, _i)
    _s

f_hourPnL() =>
    float _s = 0.0
    int _hSz = math.min(array.size(tradeCloseTime), math.min(array.size(tradePnLArr), array.size(tradeCloseTS)))
    if _hSz > 0
        for _i = 0 to _hSz - 1
            if bar_index - array.get(tradeCloseTime, _i) <= barsPerHour and array.get(tradeCloseTS, _i) >= statsResetDate
                _s += array.get(tradePnLArr, _i)
    _s


f_accStr(_w, _t) =>
    _t > 0 ? str.tostring(_w) + "/" + str.tostring(_t) + " won (" + str.tostring(math.round(_w / _t * 100)) + "%)" : "No trades yet"

f_lotLabel(_dr, _lots) =>
    _dr > 0 ? "auto (" + str.tostring(_lots, "#.####") + " lots)" : "user-defined (" + str.tostring(_lots, "#.##") + " lots)"

f_pnlTodayStr(_pnl) =>
    _pnl >= 0.01 ? "\U0001f4b0 This strategy brought in: $" + str.tostring(_pnl, "#.##") + " in profits today" : _pnl <= -0.01 ? "\U0001f4c9 This strategy is down $" + str.tostring(math.abs(_pnl), "#.##") + " today" : "No completed trades yet today"




// ── Independent Bar detection (Block A) ──
// Use trend engine direction (isBull/isBear) — NOT lastIsBull — so the IB
// fires based on current momentum, not the lagging FVG zone direction.
// This fixes the case where the big initial drop happens before lastIsBull has flipped.
//
// Bull IB: trend is up, green candle closes above previous bar HIGH, bear seen since last IB
_bullFvgAvail = (poiHL or poiSup) or (hadFVG and (not fvgUsed or (not na(htf_zIsBull) and htf_zIsBull)))
_bullIB = isBull and _bullFvgAvail and not inRetracement and isGreen and not na(high[1]) and close > high[1]

// Bear IB: trend is down, red candle closes below previous bar LOW, green seen since last IB
// Allow even if fvgUsed=true (from old bull trade) as long as bear HTF zone exists
_bearFvgAvail = (poiHL or poiSup) or (hadFVG and (not fvgUsed or (not na(htf_zIsBull) and not htf_zIsBull)))
_bearIB = isBear and _bearFvgAvail and not inRetracement and isRed and not na(low[1]) and close < low[1]

// Count IBs blocked only by opposing-candle requirement

if _bullIB and not ibTracking
    ibTracking       := true
    retraceWasBull   := true
    retraceCeiling   := high
    seenBearSinceIB  := false
    lastIsBull       := true
    // FVG zone refresh (only when FVG POI is enabled)
    if poiFVG
        _bullZoneFound = false
        _bSize2 = array.size(htfFvgBoxes)
        if _bSize2 > 0
            float _bestTop2 = na
            float _bestBot2 = na
            _bestDist2 = 1e10
            for _bzi2 = 0 to _bSize2 - 1
                if array.get(htfFvgBull, _bzi2)
                    _zt2 = array.get(htfFvgTops, _bzi2)
                    _zb2 = array.get(htfFvgBots, _bzi2)
                    if _zt2 < close
                        _dist2 = close - _zt2
                        if _dist2 < _bestDist2
                            _bestDist2 := _dist2
                            _bestTop2  := _zt2
                            _bestBot2  := _zb2
                            _bullZoneFound := true
            if _bullZoneFound
                fvgZoneTop := _bestTop2
                fvgZoneBot := _bestBot2
                fvgUsed    := false
                hadFVG     := true
        if not _bullZoneFound and not na(htf_zIsBull) and htf_zIsBull and not na(htf_zTop) and not na(htf_zBot)
            fvgZoneTop := htf_zTop
            fvgZoneBot := htf_zBot
            fvgUsed    := false
            hadFVG     := true
    // Higher Low POI line
    if poiHL
        if not na(poiLineHL)
            line.delete(poiLineHL)
        poiLevelHL := f_findHigherLow(poiLookback)
        if not na(poiLevelHL)
            poiLineHL := line.new(bar_index, poiLevelHL, bar_index + 50, poiLevelHL, extend = extend.right, style = line.style_dashed, color = color.new(color.yellow, 20), width = 2)
    // Support flip POI line
    if poiSup
        if not na(poiLineSup)
            line.delete(poiLineSup)
        poiLevelSup := f_findSupLevel(poiLookback)
        if not na(poiLevelSup)
            poiLineSup := line.new(bar_index, poiLevelSup, bar_index + 50, poiLevelSup, extend = extend.right, style = line.style_dashed, color = color.new(color.orange, 20), width = 2)
    if showDebug
        label.new(bar_index, low, "IB↑", style = label.style_label_up, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

if _bearIB and not ibTracking
    ibTracking       := true
    retraceWasBull   := false
    retraceFloor     := low
    seenGreenSinceIB := false
    lastIsBull       := false
    // FVG zone refresh (only when FVG POI is enabled)
    if poiFVG
        _bearZoneFound = false
        _bSize = array.size(htfFvgBoxes)
        if _bSize > 0
            float _bestTop = na
            float _bestBot = na
            _bestDist = 1e10
            for _bzi = 0 to _bSize - 1
                if not array.get(htfFvgBull, _bzi)
                    _zt = array.get(htfFvgTops, _bzi)
                    _zb = array.get(htfFvgBots, _bzi)
                    if _zb > close
                        _dist = _zb - close
                        if _dist < _bestDist
                            _bestDist := _dist
                            _bestTop  := _zt
                            _bestBot  := _zb
                            _bearZoneFound := true
            if _bearZoneFound
                fvgZoneTop := _bestTop
                fvgZoneBot := _bestBot
                fvgUsed    := false
                hadFVG     := true
        if not _bearZoneFound and not na(htf_zIsBull) and not htf_zIsBull and not na(htf_zTop) and not na(htf_zBot)
            fvgZoneTop := htf_zTop
            fvgZoneBot := htf_zBot
            fvgUsed    := false
            hadFVG     := true
    // Lower High POI line
    if poiHL
        if not na(poiLineHL)
            line.delete(poiLineHL)
        poiLevelHL := f_findLowerHigh(poiLookback)
        if not na(poiLevelHL)
            poiLineHL := line.new(bar_index, poiLevelHL, bar_index + 50, poiLevelHL, extend = extend.right, style = line.style_dashed, color = color.new(color.yellow, 20), width = 2)
    // Resistance flip POI line
    if poiSup
        if not na(poiLineSup)
            line.delete(poiLineSup)
        poiLevelSup := f_findResLevel(poiLookback)
        if not na(poiLevelSup)
            poiLineSup := line.new(bar_index, poiLevelSup, bar_index + 50, poiLevelSup, extend = extend.right, style = line.style_dashed, color = color.new(color.orange, 20), width = 2)
    if showDebug
        label.new(bar_index, high, "IB↓", style = label.style_label_down, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

// Reset IB tracking if trend flips opposite, or no FVG zone (FVG mode only)
if ibTracking and not hadFVG and poiFVG
    ibTracking := false
if ibTracking and retraceWasBull and isBear
    ibTracking := false
if ibTracking and not retraceWasBull and isBull
    ibTracking := false

// ── Smart Optimizer — proof-based effective settings ──
// Computed from var accumulators (all previously-closed trades). Applied only when optSmart=true.
// Key guarantee: only removes a filter / raises TP / halves cooldown if historical data PROVES
// the change increases all-time profit. If EV ≤ 0 for a strategy, the optimizer stays hands-off.

// Step 1: Per-strategy Expected Value (EV) from actual closed trades
float _g_uhvAvgWin  = uhvWins > 0 ? uhvWinSum / uhvWins : 0.0
float _g_uhvAvgLoss = (uhvTrades - uhvWins) > 0 ? uhvLossSum / math.max(uhvTrades - uhvWins, 1) : 0.0
float _g_uhvEV      = uhvTrades >= 5 ? float(uhvWins) / uhvTrades * _g_uhvAvgWin - float(uhvTrades - uhvWins) / uhvTrades * _g_uhvAvgLoss : na

float _g_tbrAvgWin  = tbrWins > 0 ? tbrWinSum / tbrWins : 0.0
float _g_tbrAvgLoss = (tbrTrades - tbrWins) > 0 ? tbrLossSum / math.max(tbrTrades - tbrWins, 1) : 0.0
float _g_tbrEV      = tbrTrades >= 5 ? float(tbrWins) / tbrTrades * _g_tbrAvgWin - float(tbrTrades - tbrWins) / tbrTrades * _g_tbrAvgLoss : na

float _g_evrAvgWin  = evrWins > 0 ? evrWinSum / evrWins : 0.0
float _g_evrAvgLoss = (evrTrades - evrWins) > 0 ? evrLossSum / math.max(evrTrades - evrWins, 1) : 0.0
float _g_evrEV      = evrTrades >= 5 ? float(evrWins) / evrTrades * _g_evrAvgWin - float(evrTrades - evrWins) / evrTrades * _g_evrAvgLoss : na

// Weighted EV across all strategies (used for cooldown and cross-strategy decisions)
int   _g_allT = math.max(uhvTrades + tbrTrades + evrTrades, 1)
float _g_wEV  = (not na(_g_uhvEV) or not na(_g_tbrEV) or not na(_g_evrEV)) ?
     (nz(_g_uhvEV) * uhvTrades + nz(_g_tbrEV) * tbrTrades + nz(_g_evrEV) * evrTrades) / _g_allT : na

// Step 2: Proof for each filter removal
// Proof = blocked_count × strategy_EV (= expected total profit from unlocked signals)
// Negative or zero EV → proof is zero → optimizer does NOT remove that filter
float _proof_noUHVSwp = blockedBySwept     >= 3 and not na(_g_uhvEV) and _g_uhvEV > 0 ? blockedBySwept    * _g_uhvEV : 0.0
float _proof_noUHVVol = blockedUHVVol      >= 3 and not na(_g_uhvEV) and _g_uhvEV > 0 ? blockedUHVVol     * _g_uhvEV : 0.0
float _proof_no2BRVol = blocked2BRVol      >= 3 and not na(_g_tbrEV) and _g_tbrEV > 0 ? blocked2BRVol     * _g_tbrEV : 0.0
float _proof_noOppCdl = blockedByOpposing  >= 3 and not na(_g_tbrEV) and _g_tbrEV > 0 ? blockedByOpposing * _g_tbrEV : 0.0
float _proof_noEVRVol = blockedEVRVol      >= 3 and not na(_g_evrEV) and _g_evrEV > 0 ? blockedEVRVol     * _g_evrEV : 0.0
float _proof_halveCd  = blockedByCooldown  >= 3 and not na(_g_wEV)   and _g_wEV   > 0 ? blockedByCooldown * _g_wEV   : 0.0

// Step 3: TP+1 proof — % of winning trades where price continued $1 past TP on the SAME BAR
// Conservative: only counts same-bar continuation (immediate momentum, safest proof)
float _tp1HitRate    = tp1SameBarChecks >= 5 ? float(tp1SameBarWins) / tp1SameBarChecks : 0.0
float _proof_raiseTP = tp1SameBarChecks >= 5 and not na(_g_wEV) and _g_wEV > 0 ? winCount * _tp1HitRate * 1.0 : 0.0

// Step 4: Per-strategy direction proof — remove direction only if its EV is provably negative
// Requires 5+ trades in each direction for both to be considered reliable
bool _smart_uhvBullOff = optSmart and uhvBullT >= 5 and uhvBearT >= 5 and uhvBullPnL / uhvBullT < 0.0
bool _smart_uhvBearOff = optSmart and uhvBullT >= 5 and uhvBearT >= 5 and uhvBearPnL / uhvBearT < 0.0
bool _smart_tbrBullOff = optSmart and tbrBullT >= 5 and tbrBearT >= 5 and tbrBullPnL / tbrBullT < 0.0
bool _smart_tbrBearOff = optSmart and tbrBullT >= 5 and tbrBearT >= 5 and tbrBearPnL / tbrBearT < 0.0
bool _smart_evrBullOff = optSmart and evrBullT >= 5 and evrBearT >= 5 and evrBullPnL / evrBullT < 0.0
bool _smart_evrBearOff = optSmart and evrBullT >= 5 and evrBearT >= 5 and evrBearPnL / evrBearT < 0.0

// Effective cooldown — halved only if cooldown-blocked signals × weighted EV shows positive proof (level 4+)
int _effUhvCooldown = (optSmart and optLevel >= 4 and _proof_halveCd > 0) ? math.max(0, uhvCooldown / 2) : uhvCooldown
int _effTbrCooldown = (optSmart and optLevel >= 4 and _proof_halveCd > 0) ? math.max(0, tbrCooldown / 2) : tbrCooldown
int _effEvrCooldown = (optSmart and optLevel >= 4 and _proof_halveCd > 0) ? math.max(0, evrCooldown / 2) : evrCooldown

// ── Retracement trigger (Block A): close breaks prior bar's extreme ──
// Bull retrace: while tracking IB, a bear candle closes below previous bar's LOW
// Bear retrace: while tracking IB, a bull candle closes above previous bar's HIGH
bullRetrace = ibTracking and retraceWasBull and isRed and not na(low[1]) and close < low[1]
bearRetrace = ibTracking and not retraceWasBull and isGreen and not na(high[1]) and close > high[1]

if bullRetrace
    ibTracking      := false
    inRetracement   := true
    retraceWasBull  := true
    vsaRedLow       := na
    vsaRedVol       := 0.0
    retraceCeiling  := retraceCeiling   // keep IB high as ceiling
    retraceStartBar := bar_index
    fvgReached      := fvgReached
    uhvVolume     := 0.0
    uhvHigh       := na
    uhvLow        := na
    uhvBar        := na
    uhvLabel      := na
    uhvLowSwept   := false
    uhvHighSwept  := false
    retraceLow    := low
    retraceHigh   := high
    brkLevel     := na
    brkTriggered          := false
    uhvFiredThisSetup     := false
    uhvWasBlocked         := false
    // If UHV is already on cooldown when this setup starts, immediately mark as "serviced"
    // so _allStratsFired doesn't wait for UHV and EVR/TBR aren't held up indefinitely
    if (bar_index - lastUHVSignalBar) < _effUhvCooldown
        uhvWasBlocked := true
    tbrFiredThisSetup    := false
    evrFiredThisSetup    := false
    seenBearSinceRetrace := false
    _2brSeenThisSetup    := false
    _evrSeenThisSetup    := false
    _setupStartStrength  := trendStrength  // snapshot strength at setup start for trend-shift check
    if showDebug
        label.new(bar_index, high, "↘ Retrace", style = label.style_label_down, color = color.new(#f23645, 10), textcolor = color.white, size = size.tiny)

if bearRetrace
    ibTracking      := false
    inRetracement   := true
    retraceWasBull  := false
    vsaGrnHigh      := na
    vsaGrnVol       := 0.0
    retraceFloor    := retraceFloor     // keep IB low as floor
    retraceStartBar := bar_index
    // If price already touched the FVG zone during the prior bull cycle, carry fvgReached forward
    // This covers: IB↑ → Retrace → FVG Touch → UHV Green → IB↓ → bearRetrace (already at FVG)
    fvgReached      := fvgReached
    // brkLevel is set from uhvLow (prior UHV green low) as the breakout target
    // Seed UHV from this retrace candle itself (it's green and often the highest volume)
    uhvVolume    := volume
    uhvBar       := bar_index
    uhvLow       := low
    uhvSL        := high
    uhvHighSwept := false
    uhvLowSwept  := false
    uhvHigh      := na
    retraceLow   := low
    retraceHigh  := high
    brkLevel     := low
    if not na(uhvLabel)
        label.delete(uhvLabel)
    if showLabels or showDebug
        uhvLabel := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    brkTriggered          := false
    uhvFiredThisSetup     := false
    uhvWasBlocked         := false
    // If UHV is already on cooldown when this setup starts, immediately mark as "serviced"
    // so _allStratsFired doesn't wait for UHV and EVR/TBR aren't held up indefinitely
    if (bar_index - lastUHVSignalBar) < _effUhvCooldown
        uhvWasBlocked := true
    tbrFiredThisSetup     := false
    evrFiredThisSetup     := false
    seenGreenSinceRetrace := false
    _2brSeenThisSetup     := false
    _evrSeenThisSetup     := false
    _setupStartStrength   := trendStrength  // snapshot strength at setup start for trend-shift check
    if showDebug
        label.new(bar_index, low, "↗ Retrace", style = label.style_label_up, color = color.new(#089981, 10), textcolor = color.white, size = size.tiny)

// STEP 3: Retracement touches any enabled Point of Interest
// fvgReached = true when ANY one of the enabled POI types is touched
if (inRetracement or ibTracking) and not fvgReached
    // FVG zone touch
    if poiFVG and not na(fvgZoneTop) and not na(fvgZoneBot)
        if low <= fvgZoneTop and high >= fvgZoneBot
            fvgReached := true
            if showDebug
                if lastIsBull
                    label.new(bar_index, fvgZoneTop, "📍 FVG", style = label.style_label_down, color = color.new(#787b86, 10), textcolor = color.white, size = size.tiny)
                else
                    label.new(bar_index, fvgZoneBot, "📍 FVG", style = label.style_label_up, color = color.new(#787b86, 10), textcolor = color.white, size = size.tiny)
    // Higher Low / Lower High touch
    if poiHL and not na(poiLevelHL) and not fvgReached
        if lastIsBull ? low <= poiLevelHL : high >= poiLevelHL
            fvgReached := true
            if showDebug
                label.new(bar_index, poiLevelHL, "📍 HL", style = label.style_label_down, color = color.new(color.yellow, 10), textcolor = color.black, size = size.tiny)
    // Support / Resistance flip touch
    if poiSup and not na(poiLevelSup) and not fvgReached
        if lastIsBull ? low <= poiLevelSup : high >= poiLevelSup
            fvgReached := true
            if showDebug
                label.new(bar_index, poiLevelSup, "📍 S/R", style = label.style_label_down, color = color.new(color.orange, 10), textcolor = color.white, size = size.tiny)

// TREND PERSISTENCE (needed by both trendFlipped and breakout checks)
bullPersistCount = 0
bearPersistCount = 0
for _pi = 0 to trendPersistBars - 1
    bullPersistCount += isBull[_pi] ? 1 : 0
    bearPersistCount += isBear[_pi] ? 1 : 0
bullTrendPersists = bullPersistCount >= math.round(trendPersistBars * 0.6)
bearTrendPersists = bearPersistCount >= math.round(trendPersistBars * 0.6)
// Trend shifting: strength has dropped by threshold or more since this setup began
// Per-strategy so each can be toggled independently
_trendShiftActive = inRetracement and not na(_setupStartStrength) and (_setupStartStrength - trendStrength >= trendShiftThreshold)
_trendShiftUHV    = avoidTrendShift and avoidTrendShiftUHV and _trendShiftActive
_trendShiftTBR    = avoidTrendShift and avoidTrendShiftTBR and _trendShiftActive
_trendShiftEVR    = avoidTrendShift and avoidTrendShiftEVR and _trendShiftActive

// STEP 3b: TREND FLIP CANCELLATION + RETRACEMENT EXPIRY
if inRetracement
    _intraBounceBull = useRetraceExpiry and lastIsBull  and not na(retraceCeiling) and close >= retraceCeiling and not fvgReached
    _intraBounceBear = useRetraceExpiry and not lastIsBull and not na(retraceFloor)   and close <= retraceFloor  and not fvgReached
    _timeout         = not na(retraceStartBar) and (bar_index - retraceStartBar) > 100
    retraceExpired   = _intraBounceBull or _intraBounceBear or _timeout

    // Only cancel retracement if trend has persistently flipped (not just one candle flicker)
    // Use bearPersistCount / bullPersistCount so short 1m noise doesn't kill the setup
    _trendKillBull = lastIsBull  and bearPersistCount >= math.round(trendPersistBars * 0.8)
    _trendKillBear = not lastIsBull and bullPersistCount >= math.round(trendPersistBars * 0.8)
    trendFlipped = _trendKillBull or _trendKillBear

    // NEW: if price bounces back above IB ceiling (bull) or below IB floor (bear)
    // AFTER already touching FVG, cancel so a fresh IB+retrace can start
    // This is what allows the second and third drops in the same zone to each get a Retrace label
    _bouncedOutBull = fvgReached and lastIsBull  and not na(retraceCeiling) and close > retraceCeiling
    _bouncedOutBear = fvgReached and not lastIsBull and not na(retraceFloor)   and close < retraceFloor
    // Suppress bounceCancel if a 2BR or VSA signal would fire this bar — the engulfing
    // green candle naturally closes above the ceiling but that is the signal, not a reset
    // Suppress bounceCancel if any signal type would fire this bar
    _2brBullFire = isGreen and open <= math.min(open[1], close[1]) and close >= math.max(open[1], close[1])
    _2brBearFire = isRed  and open >= math.max(open[1], close[1]) and close <= math.min(open[1], close[1])
    // Persist 2BR structural appearance so bounceCancel stays suppressed on bars AFTER the 2BR candle
    // Without this, when require2BRLowerVol=ON blocks TBR, tbrFiredThisSetup stays false and bounceCancel
    // can fire on the very next bar (when _anySignalFires reverts to false), wiping UHV/EVR setups
    if enableTBR and (_2brBullFire or _2brBearFire)
        _2brSeenThisSetup := true
    _vsaBullFire = isGreen and not na(vsaRedLow)  and low  < vsaRedLow  and close > vsaRedLow  and volume > vsaRedVol
    _vsaBearFire = isRed   and not na(vsaGrnHigh) and high > vsaGrnHigh and close < vsaGrnHigh and volume > vsaGrnVol
    _uhvBearFire = isRed and not na(brkLevel) and not na(uhvBar) and close < brkLevel and not uhvFiredThisSetup
    _uhvBullFire = isGreen and not na(brkLevel) and not na(uhvBar) and close > brkLevel and not uhvFiredThisSetup
    _anySignalFires  = _2brBullFire or _2brBearFire or _vsaBullFire or _vsaBearFire or _uhvBearFire or _uhvBullFire
    _uhvDoneOrBlocked = uhvFiredThisSetup or uhvWasBlocked
    _noneYetFired    = not _uhvDoneOrBlocked and not tbrFiredThisSetup and not evrFiredThisSetup and not _2brSeenThisSetup and not _evrSeenThisSetup
    bounceCancel     = (_bouncedOutBull or _bouncedOutBear) and not _anySignalFires and _noneYetFired

    if trendFlipped or retraceExpired or bounceCancel
        inRetracement := false
        ibTracking    := false
        fvgReached    := false
        fvgUsed       := false
        ibTracking    := false
        uhvVolume     := 0.0
        uhvHigh       := na
        uhvLow        := na
        uhvBar        := na
        uhvLowSwept   := false
        uhvHighSwept  := false
        retraceLow    := na
        retraceHigh   := na
        uhvLabel      := na
        brkLevel      := na
        brkTriggered  := false
        if not na(poiLineHL)
            line.delete(poiLineHL)
        if not na(poiLineSup)
            line.delete(poiLineSup)
        poiLineHL          := na
        poiLineSup         := na
        poiLevelHL         := na
        poiLevelSup        := na
        evrBullWickPending := false
        evrBearWickPending := false
        evrWickCandleHigh  := na
        evrWickCandleLow   := na
        if showDebug and bounceCancel
            _lbl = lastIsBull ? retraceCeiling : retraceFloor
            label.new(bar_index, _lbl, "↺ Reset", style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)

// Update structural low/high throughout the retracement
if inRetracement
    if lastIsBull and (na(retraceLow) or low < retraceLow)
        retraceLow  := low
    if not lastIsBull and (na(retraceHigh) or high > retraceHigh)
        retraceHigh := high
    // Track opposing candles during retracement for TBR opposing candle filter
    if isRed
        seenBearSinceRetrace  := true
    if isGreen
        seenGreenSinceRetrace := true
    // Keep POI lines extended to current bar so they always reach the right edge
    if not na(poiLineHL) and not na(poiLevelHL)
        line.set_x2(poiLineHL, bar_index + 20)
    if not na(poiLineSup) and not na(poiLevelSup)
        line.set_x2(poiLineSup, bar_index + 20)

// STEP 4: UHV — Highest Volume Candle During Retracement
// Compare volume WITHIN the retracement only (not vs prior impulse bars)
// uhvVolume starts at 0.0 when retracement begins, so first red/green candle always qualifies
// UHV = highest volume candle during retracement (any color — fast 1m pullbacks often have no clean red candle)
if inRetracement and lastIsBull and isRed and not uhvFiredThisSetup and volume > uhvVolume and volume > ta.highest(volume[1], uhvLookback)
    uhvVolume   := volume
    uhvHigh     := high
    uhvSL       := low
    uhvLowSwept := false
    uhvBar      := bar_index
    if not na(uhvLabel)
        label.delete(uhvLabel)
    if showLabels or showDebug
        uhvLabel := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    brkLevel := high

if inRetracement and not lastIsBull and isGreen and not uhvFiredThisSetup and volume > uhvVolume and volume > ta.highest(volume[1], uhvLookback)
    uhvVolume    := volume
    uhvLow       := low
    uhvSL        := high
    uhvHighSwept := false
    uhvBar       := bar_index
    if not na(uhvLabel)
        label.delete(uhvLabel)
    if showLabels or showDebug
        uhvLabel := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    brkLevel := low

// STEP 4a: VSA TRACKER — biggest red/green candle during retracement (independent of UHV)
if inRetracement and lastIsBull and isRed
    if not evrUseStrongestCandle or volume > vsaRedVol
        vsaRedVol := volume
        vsaRedLow := low

if inRetracement and not lastIsBull and isGreen
    if not evrUseStrongestCandle or volume > vsaGrnVol
        vsaGrnVol  := volume
        vsaGrnHigh := high

// STEP 4b: TRACK UHV LOW SWEEP
// Bull: UHV red low must be swept (wick or close below) before breakout fires
// Bear: no sweep requirement — red candle just needs to close below UHV green low
if inRetracement and lastIsBull and not na(uhvSL) and not uhvLowSwept
    if low < uhvSL or close < uhvSL
        uhvLowSwept := true

if inRetracement and not lastIsBull and not na(uhvSL) and not uhvHighSwept
    if high > uhvSL or close > uhvSL
        uhvHighSwept := true

// Per-strategy direction filters
_uhvBullDir  = uhvDirection != "Bear only"
_uhvBearDir  = uhvDirection != "Bull only"
_tbrBullDir  = tbrDirection != "Bear only"
_tbrBearDir  = tbrDirection != "Bull only"
_evrBullDir  = evrDirection != "Bear only"
_evrBearDir  = evrDirection != "Bull only"

// ── Optimize overrides — effective values used in all signal conditions ──
// Smart optimizer: each change is applied only when optSmart=true AND proof (above) is positive.
// Proof = blocked_count × strategy_EV. If EV ≤ 0, removing a filter would ADD losing trades → skip.
//
// optLevel controls how many categories of optimization are applied (1 = filter removal only, 9 = all):
//   Level 1–3 : filter removals, ordered by proof rank (threshold shrinks each level)
//   Level 4   : also halve cooldowns
//   Level 5   : also raise TP +$1
//   Level 6–8 : also auto-cap max loss (2× / 1.5× / 1× avg win)
//   Level 9   : also drop losing directions
//   Level 10  : maximum — panel shows "Cannot be further optimized"
//
// Proof floor for filter removal — level 1 = very conservative, level 3+ = any positive proof
float  _optProofFloor  = optSmart ? (
     optLevel >= 3 ? 0.0 :
     optLevel == 2 ? math.max(0.01, nz(_g_wEV, 0.5) * 2.0) :
                     math.max(0.01, nz(_g_wEV, 0.5) * 4.0)) : 1e10

bool   _effReqUHVSweep     = requireUHVSweep     and not (optSmart and _proof_noUHVSwp > _optProofFloor)
bool   _effReqUHVLowerVol  = requireUHVLowerVol  and not (optSmart and _proof_noUHVVol > _optProofFloor)
bool   _effReq2BRLowerVol  = require2BRLowerVol  and not (optSmart and _proof_no2BRVol > _optProofFloor)
bool   _effReqOpposing     = requireOpposingCandle and not (optSmart and _proof_noOppCdl > _optProofFloor)
bool   _effReqEVRHigherVol = requireEVRHigherVol and not (optSmart and _proof_noEVRVol > _optProofFloor)
// _effUhvCooldown / _effTbrCooldown / _effEvrCooldown declared earlier (before retracement blocks)
// SL type: smart optimizer does not change SL — user's configured method is always used
string _effUhvSlType       = uhvSlType
string _effTbrSlType       = tbrSlType
string _effEvrSlType       = evrSlType
// TP: raise $1 only if same-bar TP+1 hit-rate × win count proves positive all-time impact (level 5+)
float  _effUhvTpDollar     = uhvTpMethod == "Dollar Amount" ? (optSmart and optLevel >= 5 and _proof_raiseTP > 0 ? uhvTpDollar + 1.0 : uhvTpDollar) : uhvTpDollar
float  _effTbrTpDollar     = tbrTpMethod == "Dollar Amount" ? (optSmart and optLevel >= 5 and _proof_raiseTP > 0 ? tbrTpDollar + 1.0 : tbrTpDollar) : tbrTpDollar
float  _effEvrTpDollar     = evrTpMethod == "Dollar Amount" ? (optSmart and optLevel >= 5 and _proof_raiseTP > 0 ? evrTpDollar + 1.0 : evrTpDollar) : evrTpDollar
// Direction: remove per-strategy direction only if its per-trade P&L is provably negative (level 9+)
bool   _smartDirActive     = optSmart and optLevel >= 9
bool   _effUhvBullDir      = _uhvBullDir and not (_smartDirActive and _smart_uhvBullOff)
bool   _effUhvBearDir      = _uhvBearDir and not (_smartDirActive and _smart_uhvBearOff)
bool   _effTbrBullDir      = _tbrBullDir and not (_smartDirActive and _smart_tbrBullOff)
bool   _effTbrBearDir      = _tbrBearDir and not (_smartDirActive and _smart_tbrBearOff)
bool   _effEvrBullDir      = _evrBullDir and not (_smartDirActive and _smart_evrBullOff)
bool   _effEvrBearDir      = _evrBearDir and not (_smartDirActive and _smart_evrBearOff)

// ── Reduce Max Loss — per-strategy SL dollar cap ──
// Auto mode: cap = historical avg win amount per strategy (requires 3+ wins).
// Fixed mode: cap = user-defined amount for all strategies.
// optLevel 6 = 2× avg win, level 7 = 1.5×, level 8 = 1× (progressively tighter).
float _uhvAutoWin  = uhvWins >= 3 ? uhvWinSum / uhvWins : reduceLossFixed
float _tbrAutoWin  = tbrWins >= 3 ? tbrWinSum / tbrWins : reduceLossFixed
float _evrAutoWin  = evrWins >= 3 ? evrWinSum / evrWins : reduceLossFixed
float _levelMult   = (optSmart and optLevel >= 8) ? 1.0 : (optSmart and optLevel >= 7) ? 1.5 : 2.0
bool  _autoCapOn   = optSmart and optLevel >= 6

// ── Guided Optimizer — per-strategy focused rounds ──
// Workflow: select strategy, try choices, declare winner, append to that strategy's history.
// Round # is auto-derived from history length. Completed strategies stay optimized automatically.
bool _gAny     = optGuideEnable and (optGuideTry1 or optGuideTry2 or optGuideTry3 or optGuideTry4 or optGuideTry5 or optGuideNoneAbove)
int  _gChoice  = _gAny ? (optGuideTry1 ? 1 : optGuideTry2 ? 2 : optGuideTry3 ? 3 : optGuideTry4 ? 4 : optGuideTry5 ? 5 : 3) : 0
int  _gCIdx    = math.max(0, _gChoice - 1)
// Strategy selector
bool _gIsUhv = optGuideStrategy == "UHV Breakout"
bool _gIsTbr = optGuideStrategy == "Two Bar Reversal"
bool _gIsEvr = not _gIsUhv and not _gIsTbr
// Per-strategy round winners — integer inputs (0=not done, 1-5=winning choice)
// History length = count of sequential non-zero entries starting from R1
int _gHLu = optGuideReset ? 0 : optUhvW1 > 0 ? optUhvW2 > 0 ? optUhvW3 > 0 ? optUhvW4 > 0 ? optUhvW5 > 0 ? optUhvW6 > 0 ? 6 : 5 : 4 : 3 : 2 : 1 : 0
int _gHLb = optGuideReset ? 0 : optTbrW1 > 0 ? optTbrW2 > 0 ? optTbrW3 > 0 ? optTbrW4 > 0 ? optTbrW5 > 0 ? optTbrW6 > 0 ? 6 : 5 : 4 : 3 : 2 : 1 : 0
int _gHLe = optGuideReset ? 0 : optEvrW1 > 0 ? optEvrW2 > 0 ? optEvrW3 > 0 ? optEvrW4 > 0 ? optEvrW5 > 0 ? optEvrW6 > 0 ? 6 : 5 : 4 : 3 : 2 : 1 : 0
int _gHL    = _gIsUhv ? _gHLu : _gIsTbr ? _gHLb : _gHLe   // Active strategy history length
int _gRound = _gHL + 1                                       // Auto-derived round number
string _gRndLabel = _gRound == 1 ? "Round 1: Global Style" :
     _gRound == 2 ? "Round 2: Take-Profit" :
     _gRound == 3 ? "Round 3: Cooldowns" :
     _gRound == 4 ? "Round 4: Loss Cap" :
     "Round " + str.tostring(_gRound) + ": Fine-Tune All"
// Round-1 presets per strategy: ch1=Conservative … ch5=Aggressive
float[] _gPtpU = array.from(14.0, 11.0,  9.0,  7.0,  5.0)
float[] _gPtpB = array.from( 6.0,  4.5,  3.5,  2.5,  1.5)
float[] _gPtpE = array.from(45.0, 35.0, 28.0, 20.0, 12.0)
float[] _gPcdU = array.from(60.0, 40.0, 25.0, 15.0,  8.0)
float[] _gPcdB = array.from(15.0, 10.0,  8.0,  5.0,  3.0)
float[] _gPcdE = array.from(65.0, 50.0, 35.0, 22.0, 12.0)
float[] _gPrl  = array.from(25.0, 35.0, 50.0, 65.0, 80.0)
// Variation multipliers
float[] _gTpM  = array.from(0.50, 0.75, 1.00, 1.33, 1.75)
float[] _gCdM  = array.from(0.40, 0.70, 1.00, 1.40, 2.00)
float[] _gRlM  = array.from(0.50, 0.75, 1.00, 1.33, 1.75)
float[] _gAllM = array.from(0.85, 0.93, 1.00, 1.07, 1.15)
// Converged center for UHV (from UHV winner integers)
int   _gUBi  = optUhvW1 >= 1 ? optUhvW1 - 1 : 2
float _gCtpU = array.get(_gPtpU, _gUBi)
float _gCcdU = array.get(_gPcdU, _gUBi)
float _gCrlU = array.get(_gPrl, _gUBi)
if optUhvW2 >= 1
    _gCtpU := math.round(_gCtpU * array.get(_gTpM, optUhvW2 - 1) * 2) / 2.0
if optUhvW3 >= 1
    _gCcdU := math.round(_gCcdU * array.get(_gCdM, optUhvW3 - 1))
if optUhvW4 >= 1
    _gCrlU := math.round(_gCrlU * array.get(_gRlM, optUhvW4 - 1))
if optUhvW5 >= 1
    float _mRu = array.get(_gAllM, optUhvW5 - 1)
    _gCtpU := math.round(_gCtpU * _mRu * 2) / 2.0
    _gCcdU := math.round(_gCcdU * _mRu)
    _gCrlU := math.round(_gCrlU * _mRu)
if optUhvW6 >= 1
    float _mRu6 = array.get(_gAllM, optUhvW6 - 1)
    _gCtpU := math.round(_gCtpU * _mRu6 * 2) / 2.0
    _gCcdU := math.round(_gCcdU * _mRu6)
    _gCrlU := math.round(_gCrlU * _mRu6)
// Converged center for 2BR (from 2BR winner integers)
int   _gBBi  = optTbrW1 >= 1 ? optTbrW1 - 1 : 2
float _gCtpB = array.get(_gPtpB, _gBBi)
float _gCcdB = array.get(_gPcdB, _gBBi)
float _gCrlB = array.get(_gPrl, _gBBi)
if optTbrW2 >= 1
    _gCtpB := math.round(_gCtpB * array.get(_gTpM, optTbrW2 - 1) * 2) / 2.0
if optTbrW3 >= 1
    _gCcdB := math.round(_gCcdB * array.get(_gCdM, optTbrW3 - 1))
if optTbrW4 >= 1
    _gCrlB := math.round(_gCrlB * array.get(_gRlM, optTbrW4 - 1))
if optTbrW5 >= 1
    float _mRb = array.get(_gAllM, optTbrW5 - 1)
    _gCtpB := math.round(_gCtpB * _mRb * 2) / 2.0
    _gCcdB := math.round(_gCcdB * _mRb)
    _gCrlB := math.round(_gCrlB * _mRb)
if optTbrW6 >= 1
    float _mRb6 = array.get(_gAllM, optTbrW6 - 1)
    _gCtpB := math.round(_gCtpB * _mRb6 * 2) / 2.0
    _gCcdB := math.round(_gCcdB * _mRb6)
    _gCrlB := math.round(_gCrlB * _mRb6)
// Converged center for EVR (from EVR winner integers)
int   _gEBi  = optEvrW1 >= 1 ? optEvrW1 - 1 : 2
float _gCtpE = array.get(_gPtpE, _gEBi)
float _gCcdE = array.get(_gPcdE, _gEBi)
float _gCrlE = array.get(_gPrl, _gEBi)
if optEvrW2 >= 1
    _gCtpE := math.round(_gCtpE * array.get(_gTpM, optEvrW2 - 1) * 2) / 2.0
if optEvrW3 >= 1
    _gCcdE := math.round(_gCcdE * array.get(_gCdM, optEvrW3 - 1))
if optEvrW4 >= 1
    _gCrlE := math.round(_gCrlE * array.get(_gRlM, optEvrW4 - 1))
if optEvrW5 >= 1
    float _mRe = array.get(_gAllM, optEvrW5 - 1)
    _gCtpE := math.round(_gCtpE * _mRe * 2) / 2.0
    _gCcdE := math.round(_gCcdE * _mRe)
    _gCrlE := math.round(_gCrlE * _mRe)
if optEvrW6 >= 1
    float _mRe6 = array.get(_gAllM, optEvrW6 - 1)
    _gCtpE := math.round(_gCtpE * _mRe6 * 2) / 2.0
    _gCcdE := math.round(_gCcdE * _mRe6)
    _gCrlE := math.round(_gCrlE * _mRe6)
// Active strategy center (for choice table generation)
float _gCtp = _gIsUhv ? _gCtpU : _gIsTbr ? _gCtpB : _gCtpE
float _gCcd = _gIsUhv ? _gCcdU : _gIsTbr ? _gCcdB : _gCcdE
float _gCrl = _gIsUhv ? _gCrlU : _gIsTbr ? _gCrlB : _gCrlE
// Generate 5 choices for selected strategy (round-specific)
float[] _g5tp = array.new_float(5, _gCtp)
float[] _g5cd = array.new_float(5, _gCcd)
float[] _g5rl = array.new_float(5, _gCrl)
if _gRound == 1
    for _ci = 0 to 4
        array.set(_g5tp, _ci, _gIsUhv ? array.get(_gPtpU, _ci) : _gIsTbr ? array.get(_gPtpB, _ci) : array.get(_gPtpE, _ci))
        array.set(_g5cd, _ci, _gIsUhv ? array.get(_gPcdU, _ci) : _gIsTbr ? array.get(_gPcdB, _ci) : array.get(_gPcdE, _ci))
        array.set(_g5rl, _ci, array.get(_gPrl, _ci))
else if _gRound == 2
    for _ci = 0 to 4
        array.set(_g5tp, _ci, math.round(_gCtp * array.get(_gTpM, _ci) * 2) / 2.0)
else if _gRound == 3
    for _ci = 0 to 4
        array.set(_g5cd, _ci, math.round(_gCcd * array.get(_gCdM, _ci)))
else if _gRound == 4
    for _ci = 0 to 4
        array.set(_g5rl, _ci, math.round(_gCrl * array.get(_gRlM, _ci)))
else
    for _ci = 0 to 4
        float _m = array.get(_gAllM, _ci)
        array.set(_g5tp, _ci, math.round(_gCtp * _m * 2) / 2.0)
        array.set(_g5cd, _ci, math.round(_gCcd * _m))
        array.set(_g5rl, _ci, math.round(_gCrl * _m))
// Resolved values for active choice
float _gTpVal = array.get(_g5tp, _gCIdx)
int   _gCdVal = int(array.get(_g5cd, _gCIdx))
float _gRlVal = array.get(_g5rl, _gCIdx)
bool  _gActive = _gAny  // Tune removed — converged centers auto-apply from history
// RL cap per strategy: testing → use choice RL; history exists → converged RL; else → no cap (preserve user settings)
float _guideRlFixedUhv = _gActive and _gIsUhv ? _gRlVal : _gHLu >= 1 ? _gCrlU : 1e10
float _guideRlFixedTbr = _gActive and _gIsTbr ? _gRlVal : _gHLb >= 1 ? _gCrlB : 1e10
float _guideRlFixedEvr = _gActive and _gIsEvr ? _gRlVal : _gHLe >= 1 ? _gCrlE : 1e10

// Effective loss cap per strategy: reduceLoss button OR optLevel 6+ auto-cap OR guide (whichever applies)
float _uhvLossCap = reduceLoss ? (reduceLossMode == "Auto (avg win per strategy)" ? _uhvAutoWin : _guideRlFixedUhv) : (_autoCapOn ? _uhvAutoWin * _levelMult : (optGuideEnable ? _guideRlFixedUhv : 1e10))
float _tbrLossCap = reduceLoss ? (reduceLossMode == "Auto (avg win per strategy)" ? _tbrAutoWin : _guideRlFixedTbr) : (_autoCapOn ? _tbrAutoWin * _levelMult : (optGuideEnable ? _guideRlFixedTbr : 1e10))
float _evrLossCap = reduceLoss ? (reduceLossMode == "Auto (avg win per strategy)" ? _evrAutoWin : _guideRlFixedEvr) : (_autoCapOn ? _evrAutoWin * _levelMult : (optGuideEnable ? _guideRlFixedEvr : 1e10))
// Guide overrides: per-strategy independent — converged values persist even when optimizing another strategy
if optGuideEnable
    // UHV: test choice if selected+active, else apply converged center if history exists
    if _gIsUhv and _gAny
        _effUhvTpDollar := _gTpVal
        _effUhvCooldown := _gCdVal
    else if _gHLu >= 1
        _effUhvTpDollar := _gCtpU
        _effUhvCooldown := int(_gCcdU)
    // 2BR: test choice if selected+active, else apply converged center if history exists
    if _gIsTbr and _gAny
        _effTbrTpDollar := _gTpVal
        _effTbrCooldown := _gCdVal
    else if _gHLb >= 1
        _effTbrTpDollar := _gCtpB
        _effTbrCooldown := int(_gCcdB)
    // EVR: test choice if selected+active, else apply converged center if history exists
    if _gIsEvr and _gAny
        _effEvrTpDollar := _gTpVal
        _effEvrCooldown := _gCdVal
    else if _gHLe >= 1
        _effEvrTpDollar := _gCtpE
        _effEvrCooldown := int(_gCcdE)

// Per-strategy FVG width + touch checks
_atr144Sig   = nz(ta.atr(144))
_fvgW        = nz(fvgZoneTop, 0.0) - nz(fvgZoneBot, 0.0)
_uhvFvgWide  = uhvFvgTH == 0 or _fvgW >= _atr144Sig * uhvFvgTH
_tbrFvgWide  = tbrFvgTH == 0 or _fvgW >= _atr144Sig * tbrFvgTH
_evrFvgWide  = evrFvgTH == 0 or _fvgW >= _atr144Sig * evrFvgTH
_uhvFvgCheck = requireFvgTouch ? (fvgReached and _uhvFvgWide) : true
_tbrFvgCheck = requireFvgTouch ? (fvgReached and _tbrFvgWide) : true
_evrFvgCheck = requireFvgTouch ? (fvgReached and _evrFvgWide) : true

// STEP 5: BREAKOUT — Absorption Signal
bullBreakout = _effUhvBullDir and enableUHV and inRetracement and lastIsBull and retraceWasBull and ((strictTrendCheck and strictTrendCheckUHV) ? (htfBull and bullTrendPersists) : not bearTrendPersists) and trendStrength >= minTrendStrength and _uhvFvgCheck and not na(brkLevel) and not uhvFiredThisSetup and not na(uhvBar) and (bar_index - uhvBar) >= uhvSettleBars and (_effReqUHVSweep ? uhvLowSwept : true) and (_effReqUHVLowerVol ? volume < volume[1] : true) and not _trendShiftUHV and isGreen and low <= brkLevel and close > brkLevel and (bar_index - lastUHVSignalBar) >= _effUhvCooldown and barstate.isconfirmed

// ── Blocked-signal detection (for recommendation engine) ──
// UHV bull: would have fired without sweep requirement
_uhvBullBase = _effUhvBullDir and enableUHV and inRetracement and lastIsBull and retraceWasBull and ((strictTrendCheck and strictTrendCheckUHV) ? (htfBull and bullTrendPersists) : not bearTrendPersists) and _uhvFvgCheck and not na(brkLevel) and not uhvFiredThisSetup and not na(uhvBar) and (bar_index - uhvBar) >= uhvSettleBars and isGreen and low <= brkLevel and close > brkLevel
if _uhvBullBase and _effReqUHVSweep and not uhvLowSwept and trendStrength >= minTrendStrength
    blockedBySwept += 1
