//@version=5

indicator("Turtle Trader Desk v1.0, by M. Zeeshan MIT Alumni", "Turtle Trader Desk", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_polylines_count = 100)
max_bars_back(low, 300)
max_bars_back(high, 300)

// SETTINGS

// ─── 0. Account ──────────────────────────
gAc = "💼 My Account"
iMon = input.float(262.0, 'My Starting Capital ($)', minval = 1.0, group = gAc)
cM        = input.float(100.0,  'Contract size ($/point/lot)', minval = 0.001, group = gAc)
lA       = input.float(1.0,   'Position Size Multiplier  ＋ / − to scale all lot sizes (1.0 = optimizer sizing, 2.0 = double lots/profit, etc.)', minval = 0.1, group = gAc)
_rN = input.bool(false, '🔄 Reset Stats', group = gAc)
var _rC = 0
if not _rN
    _rC := 0
else if _rC == 0
    _rC := timenow + 3600000
_sRD = _rC

// ─── 1. Points of Interest ───────────────
gPi = "🎯 Points of Interest"
rFT = input.bool(true, 'Require POI Touch Before Signal', group = gPi)
pFvg      = input.bool(true,  'Higher Time Frame Fair Value Gap (imbalance zone)', group = gPi)
pHL       = input.bool(true,  'Previous Higher Low (above the deeper low)', group = gPi)
pSup      = input.bool(true,  'Broken High / Low (now flipped to S or R)', group = gPi)
pLb = input.int(50, 'POI Lookback (bars)', group = gPi)

// ─── 2. Strategy: UHV Breakout ───────────
gU = "📊 Strategy: Ultra High Volume Breakout"
eUHV             = input.bool(true,  'Use this strategy?', group = gU)
uDir          = input.string("Both", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = gU)
rUS       = input.bool(true, 'Must any candle wick through or break the UHV low before the entry candle breaks its high?', group = gU)
rULV    = input.bool(false,  'Must the breakout candle have lower volume than the previous candle?', group = gU)
uLb           = input.int(8,      'How many bars back to check for Ultra High Volume?', group = gU)
uVT        = input.int(71,    '──── UHV Detection: Min volume percentile (1=any volume qualifies | 50=above-average | 80=top 20% | 100=must beat all last 20 bars)', minval = 1, maxval = 100, group = gU)
uSB         = input.int(0,      'How many bars must pass after the UHV candle before entry?', group = gU)
uDR = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', group = gU)
uLS    = input.float(0.03, '──── Risk: Fixed lot size? (when $Risk = 0)', group = gU)
uTM   = input.string("R:R Ratio", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = gU)
uT1    = input.float(0.325,  '──── Take Profit: R:R Ratio (R:R method only)', group = gU)
uTD   = input.float(8.0,  '──── Take Profit: Fixed $ target (Dollar method only)', group = gU)
uST    = input.string("ATR", '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "Breakout Wick", "SwingLow", "Dollar", "Retracement's End"], group = gU)
uSBf  = input.float(3.1,    '──── Stop Loss: Distance $ below SL level? [UHV=below UHV candle low | Breakout Wick=below entry candle wick | SwingLow=below swing | Retracement\'s End=below lowest candle between UHV and entry | not used for ATR or Dollar]', group = gU)
uSMn = input.float(-2.5,    '──── Stop Loss: Closest it can ever be to entry? ($)', group = gU)
uSAm = input.float(1.92,    '──── Stop Loss: Volatility width? (ATR method only)', group = gU)
uSDo  = input.float(1.0,    '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', group = gU)
uSSw = input.int(11,      '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', group = gU)
uREU = input.bool(true, '──── Cancel this strategy on early bounce-back (price returns to IB level before touching POI)?', group = gU)
uRHL = input.bool(false, '──── Require price to wick through the Higher Low / S&R level before entry?', group = gU)

// ─── 3. Strategy: Two Bar Reversal ───────
gT = "📊 Strategy: Two Bar Reversal"
eTBR          = input.bool(true,  'Use this strategy?', group = gT)
tDir       = input.string("Both", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = gT)
s2            = input.bool(true, 'Show signals on the chart?', group = gT)
r2LV = input.bool(true, 'Must the engulfing candle have lower volume than the one it engulfs?', group = gT)
tDR = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', group = gT)
tLS    = input.float(0.026, '──── Risk: Fixed lot size? (when $Risk = 0)', group = gT)
tTM   = input.string("R:R Ratio", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = gT)
tT1    = input.float(0.12,  '──── Take Profit: R:R Ratio (R:R method only)', group = gT)
tTD   = input.float(3.5,  '──── Take Profit: Fixed $ target (Dollar method only)', group = gT)
tST    = input.string("ATR", '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "Breakout Wick", "SwingLow", "Dollar"], group = gT)
tSBf  = input.float(-4.0,    '──── Stop Loss: Distance $ below SL level? [UHV=below UHV candle low | Breakout Wick=below entry candle wick | SwingLow=below swing | not used for ATR or Dollar]', group = gT)
tSMn = input.float(0.5,    '──── Stop Loss: Closest it can ever be to entry? ($)', group = gT)
tSAm = input.float(1.69,    '──── Stop Loss: Volatility width? (ATR method only)', group = gT)
tSDo  = input.float(0.6,    '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', group = gT)
tSSw = input.int(10,       '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', group = gT)
uRET = input.bool(false, '──── Cancel this strategy on early bounce-back (price returns to IB level before touching POI)?', group = gT)
tRHL = input.bool(false, '──── Require price to wick through the Higher Low / S&R level before entry?', group = gT)

// ─── 4. Strategy: Effort vs Result ───────
gE = "📊 Strategy: Effort vs Result"
eEVR           = input.bool(true,  'Use this strategy?', group = gE)
eDir        = input.string("Both", 'Trade direction?', options = ["Both", "Bull only", "Bear only"], group = gE)
sVsa             = input.bool(true,  'Show signals on the chart?', group = gE)
rEHV  = input.bool(true, 'Must the sweep candle have higher volume than the candle it sweeps?', group = gE)
aETW    = input.bool(true, 'If sweep candle has rejection wick, wait for next candle to confirm?', group = gE)
eDR = input.float(0.0,  '──── Risk: Dollar risk per trade? ($)', group = gE)
eLS    = input.float(0.011, '──── Risk: Fixed lot size? (when $Risk = 0)', group = gE)
eTM   = input.string("R:R Ratio", '──── Take Profit: Which method?', options = ["R:R Ratio", "Structural High/Low", "Dollar Amount"], group = gE)
eT1    = input.float(0.2,  '──── Take Profit: R:R Ratio (R:R method only)', group = gE)
eTD   = input.float(28.0,  '──── Take Profit: Fixed $ target (Dollar method only)', group = gE)
eST    = input.string("UHV",  '──── Stop Loss: Where to place it?', options = ["UHV", "ATR", "Breakout Wick", "SwingLow", "Dollar", "Below High Vol. Candle Wick"], group = gE)
eSBf  = input.float(16.27,    '──── Stop Loss: Distance $ below SL level? [UHV=below UHV candle low | Breakout Wick=below entry candle wick | SwingLow=below swing | not used for ATR or Dollar]', group = gE)
eSMn = input.float(0.6,    '──── Stop Loss: Closest it can ever be to entry? ($)', group = gE)
eSAm = input.float(4.0,    '──── Stop Loss: Volatility width? (ATR method only)', group = gE)
eSDo  = input.float(2.0,   '──── Stop Loss: Fixed $ distance from entry? (Dollar method only)', group = gE)
eSSw = input.int(11,       '──── Stop Loss: How many bars back to find the swing? (SwingLow method only)', group = gE)
uREE = input.bool(false, '──── Cancel this strategy on early bounce-back (price returns to IB level before touching POI)?', group = gE)
eRHL = input.bool(false, '──── Require price to wick through the Higher Low / S&R level before entry?', group = gE)

// ─── 7. Trend & Filters ───────────────────
gTr = "📈 Trend & Filters"
// Per-strategy cooldowns (replacing old shared signalCooldown)
uCd    = input.int(14,  '──── Cooldown: Bars after a signal before another can fire?', group = gU)
tCd    = input.int(14,  '──── Cooldown: Bars after a signal before another can fire?', group = gT)
eCd    = input.int(22,  '──── Cooldown: Bars after a signal before another can fire?', group = gE)
mTS  = input.int(15, 'Min Trend Strength at Signal', group = gTr)
tPB  = input.int(8, 'Trend Persistence Lookback (bars)', group = gTr)
sFilt = input.bool(false, 'Only trade London + NY sessions? (8–12 GMT and 13–17 GMT)', group = gTr)
cLP   = input.bool(true, 'Cut Low Probability Trades — suppress directions with ≥10 trades and negative all-time P&L', group = gTr)
aTS      = input.bool(true,  'Avoid trading when trend is shifting?', group = gTr)
aTSU   = input.bool(false, '──── Apply to UHV Breakout?', group = gTr)
aTST   = input.bool(true,  '──── Apply to Two Bar Reversal?', group = gTr)
aTSE   = input.bool(true, '──── Apply to Effort vs Result?', group = gTr)
tSTh  = input.int(53, '──── Shift Threshold (strength drop to trigger)', group = gTr)
sTC     = input.bool(true,  'Require Full Trend Confirmation at Entry?',  group = gTr)
sTCU  = input.bool(true, '──── Apply to UHV Breakout?',               group = gTr)
sTCT  = input.bool(false,  '──── Apply to Two Bar Reversal?',            group = gTr)
sTCE  = input.bool(false, '──── Apply to Effort vs Result?',            group = gTr)
tSMA       = input.bool(true, 'Show Trend MA Line on Chart', group = gTr)
rOC = input.bool(false,  'Must there be an opposing candle before the entry bar?', group = gT)

// ─── 8. HTF Fair Value Gap ────────────────
gH = "🔭 Higher Time Frame Fair Value Gap"
uHF      = input.bool(true, 'Use Higher Time Frame FVG for Signals', group = gH)
hFC = input.string("60", 'Higher Time Frame', options = ["Auto", "1", "5", "15", "60", "240"], group = gH)
hAT      = timeframe.period  // AUTO = same as the chart's current timeframe
hFT       = hFC == "Auto" ? hAT : hFC
hFCol    = input.color(color.new(#f5a623, 60), 'Higher Time Frame FVG Zone Color', group = gH)
fTH          = input.float(0.3, 'FVG Width Filter (ATR multiple)', group = gH)
uFTH       = input.float(0.3, '──── UHV Breakout: FVG Width Filter (ATR multiple)', group = gH)
tFTH       = input.float(0.3, '──── Two Bar Reversal: FVG Width Filter (ATR multiple)', group = gH)
eFTH       = input.float(0.3, '──── Effort vs Result: FVG Width Filter (ATR multiple)', group = gH)
fPR          = input.bool(true, 'Show Mitigation %', group = gH)
fVF          = input.bool(true, 'Show Historical FVGs', inline = 'FL', group = gH)
fBC          = input.color(color.new(#089981, 55), 'Bullish  Imbalance', inline = 'VA', group = gH)
fAC          = input.color(color.new(#787b86, 77), 'Mitigated', inline = 'VA', group = gH)
fSC          = input.color(color.new(#f23645, 55), 'Bearish  Imbalance', inline = 'VD', group = gH)
fFC          = input.color(color.new(#787b86, 77), 'Mitigated', inline = 'VD', group = gH)

// ─── 9. Display ───────────────────────────
gDi = "🖥️ Display"
sL     = input.bool(true,  'Show Signal Labels', group = gDi)
sDb      = input.bool(true, 'Show Debug Labels', group = gDi)
sSP = input.bool(true,  'Show Stats Panel', group = gDi)
sCH = input.bool(true,  'Highlight signal candles (outline which candles were studied)', group = gDi)

// ─── 10. PineConnector Automation ─────────
gPc = "🤖 PineConnector Automation"
pE    = input.bool(true,   'Send signals to PineConnector (MT5)?', group = gPc)
pLid = input.string("8778286989525", 'PineConnector License ID', group = gPc)
pSym    = input.string("XAUUSD",         'MT5 Symbol Name', group = gPc)
mLot  = input.float(0.01, 'Minimum lot size allowed by your broker', group = gPc)

// ─── 11. Optimize ────────
gO  = "⚡ Optimize"
oSm = input.bool(false, '⚡ OPTIMIZE  —  click to auto-apply best settings', group = gO)
oLv        = input.int(0,    '⚡ Optimization level — raise by 1 for each new batch of changes (1 = filter removals → 5 = max loss cap)', group = gO)
rL      = input.bool(false, '🎯 Reduce Max Loss Per Trade  —  cap SL to limit dollar loss', group = gO)
rLM  = input.string("Fixed $ for all strategies", '──── Cap Mode', options = ["Auto (avg win per strategy)", "Fixed $ for all strategies"], group = gO)
rLF = input.float(2.0, '──── Fixed cap ($) — used when mode is Fixed', group = gO)
oUTP = input.int(0,   'UHV  Take-Profit Offset ($) — try ±1 steps; 0 = no change',   step=1, minval=-15, maxval=20,  group=gO)
oTTP = input.int(0,   '2BR  Take-Profit Offset ($) — try ±1 steps; 0 = no change',   step=1, minval=-10, maxval=15,  group=gO)
oETP = input.int(0,   'EVR  Take-Profit Offset ($) — try ±5 steps; 0 = no change',   step=5, minval=-20, maxval=40,  group=gO)
oCDo = input.int(0,   'Cooldown Offset (bars, all strategies) — negative = more trades, positive = fewer', step=5, minval=-50, maxval=60, group=gO)
oTSo = input.int(0,   'Min Trend Strength Offset — positive = stricter filter, negative = more signals', step=5, minval=-30, maxval=30, group=gO)
oRLo = input.int(0,   'Loss Cap Override ($) — 0 = off; set positive to hard-cap max loss per trade', step=5, minval=0, maxval=200, group=gO)
mTM   = input.bool(false, 'Maximize Trades — remove all cooldowns and optional filters to fire on every valid setup (uses trade history analysis to unlock blocked signals)', group = gO)

// ─── 12. Trade Inspector ─────────────────
gIn = "🔍 Trade Inspector"
i_tInN = input.int(1, "Trade # to inspect", minval=1, group=gIn)
i_tInG = input.bool(false, "→ Get Trade Data", group=gIn)

// Pre-computed timeframe constants — derived from timeframe.period string (global scope safe)
tFm   = timeframe.period == "D" ? 1440.0 : timeframe.period == "W" ? 10080.0 : str.tonumber(timeframe.period)
bPH = math.max(1, math.round(60.0 / tFm))
_utcH = hour(time, "UTC")
_inSess = not sFilt or (_utcH >= 8 and _utcH < 12) or (_utcH >= 13 and _utcH < 17)

// TYPES
type bar
    float h = high
    float l = low
    float c = close
    int   i = bar_index

// VARS
bar b = bar.new()

// ── Multi-FVG visual arrays ──
var box  [] _aUF = array.new<box>(0)
var box  [] _aMF = array.new<box>(0)
var box  [] _aTF = array.new<box>(0)
var line [] _aLF = array.new<line>(0)
var bool [] _aD  = array.new<bool>(0)

// ── Signal-tracking FVG ──
// Initialize as false instead of na to avoid type error on some Pine versions
var _lb    = false
var float _fZT    = na
var float _fZB    = na
var float _plHL    = na   // Higher Low / Lower High POI level
var float _plSp   = na   // Support / Resistance flip POI level
var line  _pnHL     = na   // chart line for Higher Low POI
var line  _pnSp    = na   // chart line for Support POI
var int   _fCB = na
var _hFvg        = false
var _fU       = false

// UHV tracking
var _uVol     = 0.0
var float _uHi       = na
var float _uLo        = na
var float _uSl         = na
var label _uLbl      = na
var int   _uBar        = na
var _uLSw   = false  // bull: UHV low must be swept (wick below OR body close below) before breakout
var _uHSw  = false  // bear: UHV high must be swept (wick above OR body close above) before breakout
var float _rceLo    = na     // bull: lowest low during retracement — used as structural SL
var float _rceHi   = na     // bear: highest high during retracement — used as structural SL

// Accuracy tracking
var _totS  = 0
var _wC      = 0

// Dollar P&L per trade
var _dPH = array.new_float()
var _cTr  = 0

// Active trade tracking
var _tEn  = array.new_float()
var _tSl     = array.new_float()
var _tTP    = array.new_float()
var bool [] _tBl   = array.new_bool()
var bool [] _tTH = array.new_bool()
var bool  [] _tSH    = array.new_bool()
var float [] _tEL  = array.new_float()
var int   [] _tEB = array.new_int()
var label [] _tLbl    = array.new<label>()  // signal label ref for post-trade update
var _tTy     = array.new_string()   // "uhv", "tbr", "evr"
var int   [] _tN      = array.new_int()       // sequential trade number (#1, #2, ...)
var float [] _tTS = array.new_float()    // _tS at entry
var bool  [] _tW      = array.new_bool()     // true = TP hit, false = SL hit (set on close)
var bool  [] _xCp = array.new_bool()    // was SL capped by loss limit?
var float [] _xCa = array.new_float()   // cap dollar amount (0 if not capped)
var bool  [] _xFv = array.new_bool()    // was POI/FVG touched at signal?

// Breakout line
var float _bL      = na
var _bT  = false
var _uF = false  // UHV has fired from the current setup
var _uWB     = false  // UHV would have fired but lower-vol filter blocked it
var _tF = false  // TBR has fired from the current setup
var _eF = false  // EVR has fired from the current setup

// ── Stats tracking ──
var _sigT      = 0       // signals fired today
var _pT          = 0.0     // P&L closed today
var _pLH       = 0.0     // P&L closed in last 60 min
var _tLSt   = 0       // current consecutive losses today
var _mLST = 0       // max consecutive losses today
var _ltd      = -1      // dayofmonth of last reset
var _tCTi    = array.new_int()   // bar_index when trade closed
var _tCTs      = array.new_int()   // actual unix timestamp when trade closed (for date/hour filtering)
var _tPA     = array.new_float() // P&L parallel to _tCTi
var _tPTy   = array.new_string() // strategy type at CLOSE time, parallel to _tPA (_tTy is at OPEN time and may be misaligned)
var int  [] _tDB = array.new_int()   // trade duration in bars (pushed at SL+TP close)
var _sBT    = array.new_int()   // bar_index of each signal (for signals/day)
var _tDS       = 1
var _tSAD = 0
// Per-strategy P&L and trade tracking
var _uPnL      = 0.0
var _uTr   = 0
var _uWn     = 0
var _uPT = 0.0
var _bPnL      = 0.0
var _bTr   = 0
var _bWn     = 0
var _bPT = 0.0
var _ePnL      = 0.0
var _eTr   = 0
var _eWn     = 0
var _ePT = 0.0
// Blocked-signal counters — for recommendation engine
var _bSwp    = 0   // UHV blocked only by no-sweep
var _bUV     = 0   // UHV blocked only by volume check
var _bOpp = 0   // IB blocked only by no opposing candle
var _b2V     = 0   // 2BR blocked only by volume check
var _bEV      = 0   // EVR blocked only by higher-vol check
var _bCd = 0   // any signal blocked only by cooldown
var _bStr = 0   // any signal blocked only by trend strength

// ── Smart optimizer accumulators (updated at trade close, used for proof computation) ──
// Per-strategy win/loss sums — allow computing avg win, avg loss, and EV per strategy
var _uWS  = 0.0   // sum of all winning UHV trade P&L
var _uLS = 0.0   // sum of |P&L| for losing UHV trades
var _bWS  = 0.0
var _bLS = 0.0
var _eWS  = 0.0
var _eLS = 0.0
// Per-strategy per-direction P&L — for direction optimization proof
var _uBP = 0.0
var _uBT   = 0
var _uBeP = 0.0
var _uBeT   = 0
var _bBP = 0.0
var _bBT   = 0
var _bBeP = 0.0
var _bBeT   = 0
var _eBP = 0.0
var _eBT   = 0
var _eBeP = 0.0
var _eBeT   = 0
// Yesterday stats computed from _tCTs in panel block

// ── Bullish tracking ──
var float _rnHi    = na
var float _pvHi       = na
var float _lgL   = na
var float _lgC = na

// ── Bearish tracking ──
var float _rnLo     = na
var float _pvLo        = na
var float _lrH    = na
var float _lrC   = na

// Retracement state
var _iR  = false
var _fR     = false
var _rwb = false
var float _rCeil  = na
var float _rFlr    = na
var int   _rSB = na

// ── Block A improved IB + retracement logic ──
// IB = Independent Bar: close breaks ABOVE prev candle high (bull) / BELOW prev candle low (bear)
// seenBear/GreenSinceIB guards prevent consecutive IBs without a real pullback between them
var _ibT        = false   // true from IB detection until retracement fires
var _sbIB      = true    // start true so first IB can fire immediately
var _sgIB     = true    // bear side equivalent
var _sbR  = false  // red candle seen during current bull retracement (for 2BR opposing candle filter)
var _sgR = false  // green candle seen during current bear retracement (for 2BR opposing candle filter)
var _2bS       = false  // structural 2BR candle appeared this setup (regardless of vol filter) — keeps _bnC suppressed
var _eS       = false  // structural EVR sweep candle appeared this setup (regardless of vol filter) — keeps _bnC suppressed
var bool _uReBnc = false  // UHV blocked by per-strategy early bounce-back
var bool _tReBnc = false  // 2BR blocked by per-strategy early bounce-back
var bool _eReBnc = false  // EVR blocked by per-strategy early bounce-back
var bool _hlWick = false  // price wicked through HL/SR level during this retracement
var float _sStr     = na     // _tS at the moment this retracement began (for trend-shift threshold)

// Cooldown tracking
var _luSB = -999   // last bar UHV fired (for per-strategy cooldown)
var _ltSB = -999   // last bar 2BR fired
var _leSB = -999   // last bar EVR fired

// VSA (Effort vs Result) tracking — independent of UHV breakout system
// Tracks the highest-volume RED candle seen during bull retracement
// and highest-volume GREEN candle during bear retracement
var float _vRL  = na   // low of most recent red candle during bull retracement
var _vRV  = 0.0  // volume of that candle
var float _vGH = na   // high of most recent green candle during bear retracement
var _vGV  = 0.0  // volume of that candle

// EVR wick-confirmation pending state
// When aETW is ON and the sweep candle has a rejection wick,
// we don't fire immediately — we wait for the NEXT candle to break the wick candle's high/low
var _eBWP = false  // bull: waiting for next candle to confirm above wick high
var float _eWCH  = na     // high of the bull wick candle to break above
var float _eWCSL = na     // low of the bull sweep candle (for Below HV Candle Wick SL)
var _eBrWP = false  // bear: waiting for next candle to confirm below wick low
var float _eWCL   = na     // low of the bear wick candle to break below
var float _eWCSH = na     // high of the bear sweep candle (for Below HV Candle Wick SL)
var int   _vRBar   = na
var int   _vGBar   = na
var float _vRHi    = na
var float _vGLo    = na
var int   _eBWBar  = na
var int   _eBrWBar = na
var float _eBWH    = na
var float _eBWL    = na
var float _eBrWH   = na
var float _eBrWL   = na

// BASE FVG CALCULATIONS
_bG = b.l > b.h[1]
_beG = b.h < b.l[1]
atr   = nz(ta.atr(144)) * fTH
bull  = (b.l - b.h[2]) > atr and b.l > b.h[2] and b.c[1] > b.h[2] and not (_bG or _bG[1])
bear  = (b.l[2] - b.h) > atr and b.h < b.l[2] and b.c[1] < b.l[2] and not (_beG or _beG[1])

// STEP 1: TREND DETECTION
_iGr = close > open
_iRd   = close < open
_bSz    = math.abs(close - open)
_cRng = high - low

if not _iR
    if _iGr
        if high > nz(_rnHi, high - 1)
            _pvHi    := _rnHi
            _rnHi := high
        _lgL   := low
        _lgC := close
    if _iRd
        if low < nz(_rnLo, low + 1)
            _pvLo    := _rnLo
            _rnLo := low
        _lrH    := high
        _lrC   := close

_inUp   = not na(_pvHi) and not na(_rnHi) and _rnHi > _pvHi
_inDn = not na(_pvLo)  and not na(_rnLo)  and _rnLo  < _pvLo

// TREND ENGINE (EMA 34 / 89 multi-factor)
_fe        = 34
_se        = 89
_swL    = 20
_aL      = 14
_vL      = 20
_rF = 0.45
_hTF      = "240"
_bPct = 0.001

_fEma   = ta.ema(close, _fe)
_sEma   = ta.ema(close, _se)
_tAt       = ta.atr(_aL)
_tAtM     = ta.sma(_tAt, _aL)
_tVm     = ta.sma(volume, _vL)
_tSlA  = math.abs(_fEma - _fEma[1])

_tEmB   = _fEma > _sEma
_tEmBr   = _fEma < _sEma
_tSlB = _fEma > _fEma[1]
_tSlBr = _fEma < _fEma[1]
_tFS = _tSlA < _tAt * 0.1

_tRH = ta.highest(high, _swL)
_tRL  = ta.lowest(low,  _swL)
_tStB = close > _tRL
_tStBr = close < _tRH
_tNS   = not _tStB and not _tStBr

_tHF   = request.security(syminfo.tickerid, _hTF, ta.ema(close, _fe))
_tHS   = request.security(syminfo.tickerid, _hTF, ta.ema(close, _se))
_tHB   = _tHF > _tHS
_tHBr   = _tHF < _tHS

_tVE    = volume > _tVm
_tAE    = _tAt > _tAtM
_tAC   = _tAt < _tAtM * _rF
_tIR = _tAC and _tFS and _tNS

_tBU     = close > _tRH * (1 + _bPct)
_tBD     = close < _tRL  * (1 - _bPct)

_tRwB   = (_tEmB and _tSlB and _tStB and not _tIR) or _tBU
_tRwBr   = (_tEmBr and _tSlBr and _tStBr and not _tIR) or _tBD

_tRlx   = (_tVE or _tAE)
_tBC  = (_tRwB and _tRlx) or _tBU
_tBCr  = (_tRwBr and _tRlx) or _tBD

_tBS = _tBC or _tRwB
_tBSr = _tBCr or _tRwBr

_tStr  = 0.0
_tStr += _tBC or _tBCr ? 30.0 : 0.0
_tStr += _tVE and _tAE    ? 25.0 : 0.0
_tStr += _tHB or _tHBr  ? 10.0 : 0.0
_tStr += _tSlA > _tAt * 0.2 ? 15.0 : 0.0
_tStr += not _tIR           ? 10.0 : 0.0
_tS = math.round(math.min(100.0, math.max(0.0, _tStr)))

_ib = (_tBS and not _tBSr) or (_tBS and _tBSr and _tS >= 50)
_ibr = (_tBSr and not _tBS) or (_tBS and _tBSr and _tS < 50)

_hb = _ib
_hbr = _ibr

_tTL = _tS > 75 ? 0 : _tS > 50 ? 20 : _tS > 25 ? 40 : _tS > 10 ? 60 : 80
_tLCol = _ib ? color.new(color.green, _tTL) : _ibr ? color.new(color.red, _tTL) : color.new(color.gray, 80)

_w1 = _tS <= 10                              ? _fEma : na
_w2 = _tS > 10 and _tS <= 25       ? _fEma : na
_w3 = _tS > 25 and _tS <= 50       ? _fEma : na
_w4 = _tS > 50 and _tS <= 75       ? _fEma : na
_w5 = _tS > 75                               ? _fEma : na

// ── ATR for SL calculations ──
_a14 = ta.atr(14)

// HTF FVG DETECTION
// Detection runs INSIDE request.security so [2] means 2 HTF bars ago
// This is the only correct way — [2] on current TF would be 2 current bars
fHF(_th) =>
    _atr  = nz(ta.atr(144)) * _th
    _bull = (low - high[2]) > _atr and low > high[2] and close[1] > high[2]
    _bear = (low[2] - high) > _atr and high < low[2] and close[1] < low[2]
    // Persist the most recent zone levels across HTF bars
    var float _zTop    = na
    var float _zBot    = na
    var bool  _zIsBull = na
    if _bull
        _zTop    := low
        _zBot    := high[2]
        _zIsBull := true
    if _bear
        _zTop    := low[2]
        _zBot    := high
        _zIsBull := false
    [_bull, _bear, _zTop, _zBot, _zIsBull]

// Fetch all 5 values from HTF — [2] inside runs on HTF bars, not current TF bars
[_hRB, _hRBr, _hZT, _hZB, _hZIB] =
     request.security(syminfo.tickerid, hFT, fHF(fTH), barmerge.gaps_off, barmerge.lookahead_on)

// Detect rising edge on current TF (_hRB stays true for all lower-TF bars in that HTF candle)
var _pRB = false
var _pRBr = false
_hNB = _hRB and not _pRB
_hNBr = _hRBr and not _pRBr
_pRB := _hRB
_pRBr := _hRBr

// Draw ALL HTF FVG zones as boxes — one per FVG, auto-removed when filled
var box[]   _hFBx      = array.new<box>()
var _hFTp       = array.new_float()
var _hFBt       = array.new_float()
var _hFBl       = array.new_bool()
var _hFTC = array.new_int()    // 0=untouched, 1=first touch, 2=retested
var _hFIZ     = array.new_bool()   // true when price is currently inside zone
var _hFRB  = array.new_int()    // bar_index when retest began (-1 = not yet)

if uHF
    if _hNB
        _top = _hZT
        _bot = _hZB
        _b   = box.new(bar_index, _top, bar_index + 1, _bot,
             border_color = color.new(hFCol, 10), border_width = 1,
             bgcolor = color.new(hFCol, 80))
        array.push(_hFBx,      _b)
        array.push(_hFTp,       _top)
        array.push(_hFBt,       _bot)
        array.push(_hFBl,       true)
        array.push(_hFTC, 0)
        array.push(_hFIZ,     false)
        array.push(_hFRB,  -1)

    if _hNBr
        _top = _hZT
        _bot = _hZB
        _b   = box.new(bar_index, _top, bar_index + 1, _bot,
             border_color = color.new(color.red, 10), border_width = 1,
             bgcolor = color.new(color.red, 80))
        array.push(_hFBx,      _b)
        array.push(_hFTp,       _top)
        array.push(_hFBt,       _bot)
        array.push(_hFBl,       false)
        array.push(_hFTC, 0)
        array.push(_hFIZ,     false)
        array.push(_hFRB,  -1)

    // Extend boxes, track touches, freeze box 3 bars after retest
    _htfSize = array.size(_hFBx)
    if _htfSize > 0
        for _hfi = _htfSize - 1 to 0
            // Guard: array may have shrunk due to mid-loop removals
            if _hfi < array.size(_hFBx)
                _hBx        = array.get(_hFBx,      _hfi)
                _ht         = array.get(_hFTp,        _hfi)
                _hbo        = array.get(_hFBt,        _hfi)
                _hbull      = array.get(_hFBl,        _hfi)
                _touches    = array.get(_hFTC,  _hfi)
                _wasInZone  = array.get(_hFIZ,      _hfi)
                _retestBar  = array.get(_hFRB,   _hfi)

                // Is price currently inside the zone?
                _inZoneNow  = low <= _ht and high >= _hbo

                // Detect entry into zone (new touch)
                if _inZoneNow and not _wasInZone
                    _touches += 1
                    array.set(_hFTC, _hfi, _touches)
                    if _touches == 2
                        array.set(_hFRB, _hfi, bar_index)

                array.set(_hFIZ, _hfi, _inZoneNow)

                // Full invalidation: price closed well beyond zone
                _invalidated = _hbull ? close < _hbo - (_ht - _hbo) : close > _ht + (_ht - _hbo)
                // Retest done: 3 bars have passed since second touch
                _retestDone  = _retestBar >= 0 and (bar_index - _retestBar) >= 3

                if _invalidated
                    box.delete(_hBx)
                    array.remove(_hFBx,     _hfi)
                    array.remove(_hFTp,      _hfi)
                    array.remove(_hFBt,      _hfi)
                    array.remove(_hFBl,      _hfi)
                    array.remove(_hFTC,_hfi)
                    array.remove(_hFIZ,    _hfi)
                    array.remove(_hFRB, _hfi)
                else if _retestDone
                    // Freeze box: fade colors, stop extending
                    _fadedBg     = _hbull ? color.new(hFCol, 92) : color.new(color.red, 92)
                    _fadedBorder = _hbull ? color.new(hFCol, 60) : color.new(color.red, 60)
                    box.set_bgcolor(_hBx, _fadedBg)
                    box.set_border_color(_hBx, _fadedBorder)
                    array.remove(_hFBx,     _hfi)
                    array.remove(_hFTp,      _hfi)
                    array.remove(_hFBt,      _hfi)
                    array.remove(_hFBl,      _hfi)
                    array.remove(_hFTC,_hfi)
                    array.remove(_hFIZ,    _hfi)
                    array.remove(_hFRB, _hfi)
                else
                    box.set_right(_hBx, bar_index + 1)

// FVG BOX CREATION
if bull
    // Only draw current-TF FVG boxes when HTF mode is OFF
    if not uHF
        _aUF.unshift(box.new(b.i - 1, b.l,    b.i, b.h[2], border_color = na, bgcolor = fBC))
        _aMF.unshift(box.new(b.i - 1, b.l,    b.i, b.l,    border_color = na, bgcolor = fAC))
        _aTF.unshift(box.new(b.i - 1, b.l,    b.i, b.h[2], border_color = na, bgcolor = color(na), text_color = chart.fg_color, text_size = size.small))
        _aLF.unshift(line.new(b.i - 1, b.h[2], b.i, b.h[2], color = fBC, width = 2))
        _aD.unshift(true)
    // Signal-tracking: only update from current-TF FVG when HTF mode is OFF
    if not uHF and not _iR
        _fZT    := b.l
        _fZB    := b.h[2]
        _fCB := b.i
        _hFvg        := true
        _lb    := true
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        _iR := false
        _ibT    := false
        _fR    := false

if bear
    // Only draw current-TF FVG boxes when HTF mode is OFF
    if not uHF
        _aUF.unshift(box.new(b.i - 1, b.l[2], b.i, b.h,    border_color = na, bgcolor = fSC))
        _aMF.unshift(box.new(b.i - 1, b.h,    b.i, b.h,    border_color = na, bgcolor = fFC))
        _aTF.unshift(box.new(b.i - 1, b.l[2], b.i, b.h,    border_color = na, bgcolor = color(na), text_color = chart.fg_color, text_size = size.small))
        _aLF.unshift(line.new(b.i - 1, b.l[2], b.i, b.l[2], color = fSC, width = 2))
        _aD.unshift(false)
    // Signal-tracking: only update from current-TF FVG when HTF mode is OFF
    if not uHF and not _iR
        _fZT    := b.l[2]
        _fZB    := b.h
        _fCB := b.i
        _hFvg        := true
        _lb    := false
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        _iR := false
        _ibT    := false
        _fR    := false

// ── HTF FVG signal-tracking update ──
// When HTF mode is ON: signal-tracking zone is driven by the HTF FVG
// On every bar: ensure _hFvg=true whenever a valid HTF zone exists
// This fixes 1m (and other lower-TF) charts where _hNB/Bear only fires once
// historically and _hFvg would otherwise stay false indefinitely
if uHF and not na(_hZT) and not na(_hZB) and not na(_hZIB)
    // Always keep zone synced — even if the FVG formed long ago
    if not _hFvg or (_fZT != _hZT and _fZB != _hZB and not _iR)
        _fZT := _hZT
        _fZB := _hZB
        _lb := _hZIB
        _hFvg     := true
    // On a brand-new HTF FVG: full reset of retracement state
    if (_hNB or _hNBr) and not _iR
        _fZT    := _hZT
        _fZB    := _hZB
        _fCB := b.i
        _hFvg        := true
        _lb    := _hZIB
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        _iR := false
        _ibT    := false
        _fR    := false

// UPDATE ALL FVGs
if _aUF.size() > 0
    _sz = _aUF.size()
    for _k = _sz - 1 to 0
        cUB = _aUF.get(_k)
        tUB = cUB.get_top()
        bUB = cUB.get_bottom()
        cMB = _aMF.get(_k)
        tMB = cMB.get_top()
        bMB = cMB.get_bottom()
        cTB = _aTF.get(_k)
        cL  = _aLF.get(_k)
        _p  = _aD.get(_k)
        _remove = false

        if b.h > bUB and b.l < tUB
            if _p
                if b.l > bUB
                    cMB.set_bottom(math.min(b.l, bMB))
                    cUB.set_top(math.min(b.l, bMB))
                    if fPR
                        cTB.set_text(str.tostring((tMB - math.min(b.l, bMB)) / (tMB - bUB), '#.#%'))
                else
                    cMB.set_bottom(bUB)
                    cUB.set_top(bUB)
                    cTB.set_text('')
                    _remove := true
            else
                if b.h < tUB
                    cMB.set_top(math.max(b.h, tMB))
                    cUB.set_bottom(math.max(b.h, tMB))
                    if fPR
                        cTB.set_text(str.tostring((math.max(b.h, tMB) - bMB) / (tUB - bMB), '#.#%'))
                else
                    cMB.set_top(tUB)
                    cUB.set_bottom(tUB)
                    cTB.set_text('')
                    _remove := true

        if _remove
            if not fVF
                cUB.delete()
                cMB.delete()
                cTB.delete()
                cL.delete()
            _aUF.remove(_k)
            _aMF.remove(_k)
            _aTF.remove(_k)
            _aLF.remove(_k)
            _aD.remove(_k)
        else
            cUB.set_right(b.i)
            cMB.set_right(b.i)
            cTB.set_right(b.i)
            cL.set_x2(b.i)

// POST-SIGNAL AUTO-RESET
if _fU and not _iR
    if _lb and _hFvg and high > nz(_rnHi, high - 1)
        _fU := false
    if not _lb and _hFvg and low < nz(_rnLo, low + 1)
        _fU := false

// STEP 2: RETRACEMENT START  (Block A improved logic)
// cooldown is now per-strategy: uCd / tCd / eCd

// ── Update seen-bear/green trackers ──
// Once an IB fires we reset the flag; it flips back when the opposite candle appears
if not _iR
    if _iRd
        _sbIB  := true
    if _iGr
        _sgIB := true

// ── POI helper functions: find Higher Low / Support level for zone touch mode ──
fHL(_lb) =>
    float _sw1 = na
    float _sw2 = na
    float _result = na
    for _i = 2 to _lb - 1
        if low[_i] < low[_i - 1] and low[_i] < low[_i + 1]
            if na(_sw1)
                _sw1 := low[_i]
            else
                _sw2 := low[_i]
                break
    if not na(_sw1) and not na(_sw2) and _sw1 > _sw2
        _result := _sw1
    _result

fLH(_lb) =>
    float _sh1 = na
    float _sh2 = na
    float _result = na
    for _i = 2 to _lb - 1
        if high[_i] > high[_i - 1] and high[_i] > high[_i + 1]
            if na(_sh1)
                _sh1 := high[_i]
            else
                _sh2 := high[_i]
                break
    if not na(_sh1) and not na(_sh2) and _sh1 < _sh2
        _result := _sh1
    _result

fSup(_lb) =>
    float _result = na
    for _i = 2 to _lb - 1
        if high[_i] > high[_i - 1] and high[_i] > high[_i + 1] and high[_i] < close
            _result := high[_i]
            break
    _result

fRes(_lb) =>
    float _result = na
    for _i = 2 to _lb - 1
        if low[_i] < low[_i - 1] and low[_i] < low[_i + 1] and low[_i] > close
            _result := low[_i]
            break
    _result

// ── SL calculation helper: all SL params passed per-strategy ──
fSL(_isBull, _entryPrice, _structLow, _structHigh, _slType, _slBuffer, _slAtrMult, _slSwingLb, _slMinDist, _dollarRisk, _lotSize, _slDollar = 2.0) =>
    _atrSL     = _isBull ? _entryPrice - _a14 * _slAtrMult : _entryPrice + _a14 * _slAtrMult
    _wickSL    = _isBull ? low  - _slBuffer : high + _slBuffer
    _swingLow  = nz(ta.lowest(low,  _slSwingLb), _structLow)
    _swingHigh = nz(ta.highest(high, _slSwingLb), _structHigh)
    _swingSL   = _isBull ? _swingLow  - _slBuffer : _swingHigh + _slBuffer
    _structSLv = _isBull ? _structLow - _slBuffer  : _structHigh + _slBuffer
    _dollarDist = _dollarRisk > 0 ? _dollarRisk / (_lotSize * cM) : _lotSize * 1.0
    _dollarSLv  = _isBull ? _entryPrice - _slDollar : _entryPrice + _slDollar
    _raw = _slType == "ATR"        ? _atrSL :
           _slType == "Breakout Wick" or _slType == "Below High Vol. Candle Wick" ? _wickSL :
           _slType == "SwingLow"   ? _swingSL :
           _slType == "Dollar"     ? _dollarSLv : _structSLv
    // Enforce minimum distance (skip for Dollar — user sets distance explicitly)
    // Also guard against negative SL price (can happen on very early historical bars at tiny prices)
    _result = _slType == "Dollar" ? _raw : (_isBull ? math.min(_entryPrice - _slMinDist, _raw) : math.max(_entryPrice + _slMinDist, _raw))
    math.max(syminfo.mintick, _result)

// ── Signal block helpers (replace repeated code in all 8 signal entry blocks) ──
fAS(_w, _t) =>
    _t > 0 ? str.tostring(_w) + "/" + str.tostring(_t) + " won (" + str.tostring(math.round(_w / _t * 100)) + "%)" : "No trades yet"

fLL(_dr, _lots) =>
    _dr > 0 ? "auto (" + str.tostring(_lots, "#.####") + " lots)" : "user-defined (" + str.tostring(_lots, "#.##") + " lots)"

fPTS(_pnl) =>
    _pnl >= 0.01 ? "\U0001f4b0 This strategy brought in: $" + str.tostring(_pnl, "#.##") + " in profits today" : _pnl <= -0.01 ? "\U0001f4c9 This strategy is down $" + str.tostring(math.abs(_pnl), "#.##") + " today" : "No completed trades yet today"

fSU(int b, float sl, float a, color c) =>
    polyline.new(array.from(chart.point.from_index(b-1,sl),chart.point.from_index(b+2,sl+a*0.06),chart.point.from_index(b+5,sl-a*0.02)),curved=true,line_color=c,line_width=2)
    polyline.new(array.from(chart.point.from_index(b,sl+a*0.02),chart.point.from_index(b+2,sl+a*0.06),chart.point.from_index(b+4,sl+a*0.01)),curved=true,line_color=c,line_width=5)
    label.new(b+6,sl-a*0.02,"●",style=label.style_none,textcolor=c,size=size.small)
    label.new(b+6+(1+b%2),sl-a*0.02+math.sin(float(b)*1.7)*a*0.035,"●",style=label.style_none,textcolor=c,size=size.tiny)



// ── Independent Bar detection (Block A) ──
// Use trend engine direction (_ib/_ibr) — NOT _lb — so the IB
// fires based on current momentum, not the lagging FVG zone direction.
// This fixes the case where the big initial drop happens before _lb has flipped.
//
// Bull IB: trend is up, green candle closes above previous bar HIGH, bear seen since last IB
_bFA = (pHL or pSup) or (_hFvg and (not _fU or (not na(_hZIB) and _hZIB)))
_bIB = _ib and _bFA and not _iR and _iGr and not na(high[1]) and close > high[1]

// Bear IB: trend is down, red candle closes below previous bar LOW, green seen since last IB
// Allow even if _fU=true (from old bull trade) as long as bear HTF zone exists
_beFA = (pHL or pSup) or (_hFvg and (not _fU or (not na(_hZIB) and not _hZIB)))
_beIB = _ibr and _beFA and not _iR and _iRd and not na(low[1]) and close < low[1]

// Count IBs blocked only by opposing-candle requirement

if _bIB and not _ibT
    _ibT       := true
    _rwb   := true
    _rCeil   := high
    _sbIB  := false
    _lb       := true
    // FVG zone refresh (only when FVG POI is enabled)
    if pFvg
        _bullZoneFound = false
        _bSize2 = array.size(_hFBx)
        if _bSize2 > 0
            float _bestTop2 = na
            float _bestBot2 = na
            _bestDist2 = 1e10
            for _bzi2 = 0 to _bSize2 - 1
                if array.get(_hFBl, _bzi2)
                    _zt2 = array.get(_hFTp, _bzi2)
                    _zb2 = array.get(_hFBt, _bzi2)
                    if _zt2 < close
                        _dist2 = close - _zt2
                        if _dist2 < _bestDist2
                            _bestDist2 := _dist2
                            _bestTop2  := _zt2
                            _bestBot2  := _zb2
                            _bullZoneFound := true
            if _bullZoneFound
                _fZT := _bestTop2
                _fZB := _bestBot2
                _fU    := false
                _hFvg     := true
        if not _bullZoneFound and not na(_hZIB) and _hZIB and not na(_hZT) and not na(_hZB)
            _fZT := _hZT
            _fZB := _hZB
            _fU    := false
            _hFvg     := true
    // Higher Low POI line
    if pHL
        if not na(_pnHL)
            line.delete(_pnHL)
        _plHL := fHL(pLb)
        if not na(_plHL)
            _pnHL := line.new(bar_index, _plHL, bar_index + 50, _plHL, extend = extend.right, style = line.style_dashed, color = color.new(color.yellow, 20), width = 2)
    // Support flip POI line
    if pSup
        if not na(_pnSp)
            line.delete(_pnSp)
        _plSp := fSup(pLb)
        if not na(_plSp)
            _pnSp := line.new(bar_index, _plSp, bar_index + 50, _plSp, extend = extend.right, style = line.style_dashed, color = color.new(color.orange, 20), width = 2)
    if sDb
        label.new(bar_index, low, "IB↑", style = label.style_label_up, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

if _beIB and not _ibT
    _ibT       := true
    _rwb   := false
    _rFlr     := low
    _sgIB := false
    _lb       := false
    // FVG zone refresh (only when FVG POI is enabled)
    if pFvg
        _bearZoneFound = false
        _bSize = array.size(_hFBx)
        if _bSize > 0
            float _bestTop = na
            float _bestBot = na
            _bestDist = 1e10
            for _bzi = 0 to _bSize - 1
                if not array.get(_hFBl, _bzi)
                    _zt = array.get(_hFTp, _bzi)
                    _zb = array.get(_hFBt, _bzi)
                    if _zb > close
                        _dist = _zb - close
                        if _dist < _bestDist
                            _bestDist := _dist
                            _bestTop  := _zt
                            _bestBot  := _zb
                            _bearZoneFound := true
            if _bearZoneFound
                _fZT := _bestTop
                _fZB := _bestBot
                _fU    := false
                _hFvg     := true
        if not _bearZoneFound and not na(_hZIB) and not _hZIB and not na(_hZT) and not na(_hZB)
            _fZT := _hZT
            _fZB := _hZB
            _fU    := false
            _hFvg     := true
    // Lower High POI line
    if pHL
        if not na(_pnHL)
            line.delete(_pnHL)
        _plHL := fLH(pLb)
        if not na(_plHL)
            _pnHL := line.new(bar_index, _plHL, bar_index + 50, _plHL, extend = extend.right, style = line.style_dashed, color = color.new(color.yellow, 20), width = 2)
    // Resistance flip POI line
    if pSup
        if not na(_pnSp)
            line.delete(_pnSp)
        _plSp := fRes(pLb)
        if not na(_plSp)
            _pnSp := line.new(bar_index, _plSp, bar_index + 50, _plSp, extend = extend.right, style = line.style_dashed, color = color.new(color.orange, 20), width = 2)
    if sDb
        label.new(bar_index, high, "IB↓", style = label.style_label_down, color = color.new(color.blue, 10), textcolor = color.white, size = size.tiny)

// Reset IB tracking if trend flips opposite, or no FVG zone (FVG mode only)
if _ibT and not _hFvg and pFvg
    _ibT := false
if _ibT and _rwb and _ibr
    _ibT := false
if _ibT and not _rwb and _ib
    _ibT := false

// ── Smart Optimizer — proof-based effective settings ──
// Computed from var accumulators (all previously-closed trades). Applied only when oSm=true.
// Key guarantee: only removes a filter / raises TP / halves cooldown if historical data PROVES
// the change increases all-time profit. If EV ≤ 0 for a strategy, the optimizer stays hands-off.

// Step 1: Per-strategy Expected Value (EV) from actual closed trades
float _gUAW  = _uWn > 0 ? _uWS / _uWn : 0.0
float _gUAL = (_uTr - _uWn) > 0 ? _uLS / math.max(_uTr - _uWn, 1) : 0.0
float _gUEV      = _uTr >= 5 ? float(_uWn) / _uTr * _gUAW - float(_uTr - _uWn) / _uTr * _gUAL : na

float _gTAW  = _bWn > 0 ? _bWS / _bWn : 0.0
float _gTAL = (_bTr - _bWn) > 0 ? _bLS / math.max(_bTr - _bWn, 1) : 0.0
float _gTEV      = _bTr >= 5 ? float(_bWn) / _bTr * _gTAW - float(_bTr - _bWn) / _bTr * _gTAL : na

float _gEAW  = _eWn > 0 ? _eWS / _eWn : 0.0
float _gEAL = (_eTr - _eWn) > 0 ? _eLS / math.max(_eTr - _eWn, 1) : 0.0
float _gEEV      = _eTr >= 5 ? float(_eWn) / _eTr * _gEAW - float(_eTr - _eWn) / _eTr * _gEAL : na

// Weighted EV across all strategies (used for cooldown and cross-strategy decisions)
int   _gAT = math.max(_uTr + _bTr + _eTr, 1)
float _gWEV  = (not na(_gUEV) or not na(_gTEV) or not na(_gEEV)) ?
     (nz(_gUEV) * _uTr + nz(_gTEV) * _bTr + nz(_gEEV) * _eTr) / _gAT : na

// Step 2: Proof for each filter removal
// Proof = blocked_count × strategy_EV (= expected total profit from unlocked signals)
// Negative or zero EV → proof is zero → optimizer does NOT remove that filter
float _pUS = _bSwp     >= 3 and not na(_gUEV) and _gUEV > 0 ? _bSwp    * _gUEV : 0.0
float _pUV = _bUV      >= 3 and not na(_gUEV) and _gUEV > 0 ? _bUV     * _gUEV : 0.0
float _p2V = _b2V      >= 3 and not na(_gTEV) and _gTEV > 0 ? _b2V     * _gTEV : 0.0
float _pOC = _bOpp  >= 3 and not na(_gTEV) and _gTEV > 0 ? _bOpp * _gTEV : 0.0
float _pEV = _bEV      >= 3 and not na(_gEEV) and _gEEV > 0 ? _bEV     * _gEEV : 0.0
float _pHC  = _bCd  >= 3 and not na(_gWEV)   and _gWEV   > 0 ? _bCd * _gWEV   : 0.0

// Step 4: Per-strategy direction proof — remove direction only if its EV is provably negative
// Requires 5+ trades in each direction for both to be considered reliable
bool _sUBO = oSm and _uBT >= 5 and _uBeT >= 5 and _uBP / _uBT < 0.0
bool _sUBeO = oSm and _uBT >= 5 and _uBeT >= 5 and _uBeP / _uBeT < 0.0
bool _sTBO = oSm and _bBT >= 5 and _bBeT >= 5 and _bBP / _bBT < 0.0
bool _sTBeO = oSm and _bBT >= 5 and _bBeT >= 5 and _bBeP / _bBeT < 0.0
bool _sEBO = oSm and _eBT >= 5 and _eBeT >= 5 and _eBP / _eBT < 0.0
bool _sEBeO = oSm and _eBT >= 5 and _eBeT >= 5 and _eBeP / _eBeT < 0.0

// Effective cooldown — halved only if cooldown-blocked signals × weighted EV shows positive proof (level 4+)
int _euCd = (oSm and oLv >= 4 and _pHC > 0) ? math.max(0, uCd / 2) : uCd
int _etCd = (oSm and oLv >= 4 and _pHC > 0) ? math.max(0, tCd / 2) : tCd
int _eeCd = (oSm and oLv >= 4 and _pHC > 0) ? math.max(0, eCd / 2) : eCd

// ── Retracement trigger (Block A): close breaks prior bar's extreme ──
// Bull retrace: while tracking IB, a bear candle closes below previous bar's LOW
// Bear retrace: while tracking IB, a bull candle closes above previous bar's HIGH
_bRet = _ibT and _rwb and _iRd and not na(low[1]) and close < low[1]
_beRet = _ibT and not _rwb and _iGr and not na(high[1]) and close > high[1]

if _bRet
    _ibT      := false
    _iR   := true
    _rwb  := true
    _vRL := na
    _vRV := 0.0
    _vRBar := na
    _vRHi  := na
    _rSB := bar_index
    _uVol     := 0.0
    _uHi       := na
    _uLo        := na
    _uBar        := na
    _uLbl      := na
    _uLSw   := false
    _uHSw  := false
    _rceLo    := math.min(low, nz(_rceLo, low))
    _rceHi   := math.max(high, nz(_rceHi, high))
    _bL     := na
    _bT          := false
    _uF     := false
    _uWB         := false
    // If UHV is already on cooldown when this setup starts, immediately mark as "serviced"
    // so _aSFrd doesn't wait for UHV and EVR/TBR aren't held up indefinitely
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _tF    := false
    _eF    := false
    _sbR := false
    _2bS    := false
    _eS    := false
    _uReBnc := false
    _tReBnc := false
    _eReBnc := false
    _hlWick := false
    _sStr  := _tS  // snapshot strength at setup start for trend-shift check
    if sDb
        label.new(bar_index, high, "↘ Retrace", style = label.style_label_down, color = color.new(#f23645, 10), textcolor = color.white, size = size.tiny)

if _beRet
    _ibT      := false
    _iR   := true
    _rwb  := false
    _vGH  := na
    _vGV  := 0.0
    _vGBar := na
    _vGLo  := na
    _rSB := bar_index
    // If price already touched the FVG zone during the prior bull cycle, carry _fR forward
    // This covers: IB↑ → Retrace → FVG Touch → UHV Green → IB↓ → _beRet (already at FVG)
    // _bL is set from _uLo (prior UHV green low) as the breakout target
    // Seed UHV from this retrace candle itself (it's green and often the highest volume)
    _uVol    := volume
    _uBar       := bar_index
    _uLo       := low
    _uSl        := high
    _uHSw := false
    _uLSw  := false
    _uHi      := na
    _rceLo   := math.min(low, nz(_rceLo, low))
    _rceHi  := math.max(high, nz(_rceHi, high))
    _bL     := low
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bT          := false
    _uF     := false
    _uWB         := false
    // If UHV is already on cooldown when this setup starts, immediately mark as "serviced"
    // so _aSFrd doesn't wait for UHV and EVR/TBR aren't held up indefinitely
    if (bar_index - _luSB) < _euCd
        _uWB := true
    _tF     := false
    _eF     := false
    _sgR := false
    _2bS     := false
    _eS     := false
    _uReBnc := false
    _tReBnc := false
    _eReBnc := false
    _hlWick := false
    _sStr   := _tS  // snapshot strength at setup start for trend-shift check
    if sDb
        label.new(bar_index, low, "↗ Retrace", style = label.style_label_up, color = color.new(#089981, 10), textcolor = color.white, size = size.tiny)

// STEP 3: Retracement touches any enabled Point of Interest
// _fR = true when ANY one of the enabled POI types is touched
if (_iR or _ibT) and not _fR
    // FVG zone touch
    if pFvg and not na(_fZT) and not na(_fZB)
        if low <= _fZT and high >= _fZB
            _fR := true
            if sDb
                if _lb
                    label.new(bar_index, _fZT, "📍 FVG", style = label.style_label_down, color = color.new(#787b86, 10), textcolor = color.white, size = size.tiny)
                else
                    label.new(bar_index, _fZB, "📍 FVG", style = label.style_label_up, color = color.new(#787b86, 10), textcolor = color.white, size = size.tiny)
    // Higher Low / Lower High touch
    if pHL and not na(_plHL) and not _fR
        if _lb ? low <= _plHL : high >= _plHL
            _fR := true
            if sDb
                label.new(bar_index, _plHL, "📍 HL", style = label.style_label_down, color = color.new(color.yellow, 10), textcolor = color.black, size = size.tiny)
    // Support / Resistance flip touch
    if pSup and not na(_plSp) and not _fR
        if _lb ? low <= _plSp : high >= _plSp
            _fR := true
            if sDb
                label.new(bar_index, _plSp, "📍 S/R", style = label.style_label_down, color = color.new(color.orange, 10), textcolor = color.white, size = size.tiny)

// TREND PERSISTENCE (needed by both _tFlp and breakout checks)
_bPC = 0
_bePC = 0
for _pi = 0 to tPB - 1
    _bPC += _ib[_pi] ? 1 : 0
    _bePC += _ibr[_pi] ? 1 : 0
_bTP = _bPC >= math.round(tPB * 0.6)
_beTP = _bePC >= math.round(tPB * 0.6)
// Trend shifting: strength has dropped by threshold or more since this setup began
// Per-strategy so each can be toggled independently
_tsA = _iR and not na(_sStr) and (_sStr - _tS >= tSTh)
_tsU    = aTS and aTSU and _tsA
_tsT    = aTS and aTST and _tsA
_tsE    = aTS and aTSE and _tsA

// STEP 3b: TREND FLIP CANCELLATION + RETRACEMENT EXPIRY
if _iR
    _tmo         = not na(_rSB) and (bar_index - _rSB) > 100
    _retExp   = _tmo
    // Per-strategy early bounce-back: fires when price returns to IB level before touching any POI
    _eBncCond = _lb ? (not na(_rCeil) and close >= _rCeil and not _fR) : (not na(_rFlr) and close <= _rFlr and not _fR)
    if _eBncCond
        if uREU
            _uReBnc := true
            _uWB    := true  // mark UHV as serviced so setup can end via _aSFrd
        if uRET
            _tReBnc := true
        if uREE
            _eReBnc := true

    // Only cancel retracement if trend has persistently flipped (not just one candle flicker)
    // Use _bePC / _bPC so short 1m noise doesn't kill the setup
    _tkB = _lb  and _bePC >= math.round(tPB * 0.8)
    _tkBr = not _lb and _bPC >= math.round(tPB * 0.8)
    _tFlp = _tkB or _tkBr

    // NEW: if price bounces back above IB ceiling (bull) or below IB floor (bear)
    // AFTER already touching FVG, cancel so a fresh IB+retrace can start
    // This is what allows the second and third drops in the same zone to each get a Retrace label
    _boB = _fR and _lb  and not na(_rCeil) and close > _rCeil
    _boBr = _fR and not _lb and not na(_rFlr)   and close < _rFlr
    // Suppress _bnC if a 2BR or VSA signal would fire this bar — the engulfing
    // green candle naturally closes above the ceiling but that is the signal, not a reset
    // Suppress _bnC if any signal type would fire this bar
    _2bBF = _iGr and open <= math.min(open[1], close[1]) and close >= math.max(open[1], close[1])
    _2bBeF = _iRd  and open >= math.max(open[1], close[1]) and close <= math.min(open[1], close[1])
    // Persist 2BR structural appearance so _bnC stays suppressed on bars AFTER the 2BR candle
    // Without this, when r2LV=ON blocks TBR, _tF stays false and _bnC
    // can fire on the very next bar (when _aSF reverts to false), wiping UHV/EVR setups
    if eTBR and (_2bBF or _2bBeF)
        _2bS := true
    _vBF = _iGr and not na(_vRL)  and low  < _vRL  and close > _vRL  and volume > _vRV
    _vBeF = _iRd   and not na(_vGH) and high > _vGH and close < _vGH and volume > _vGV
    _uBeF = _iRd and not na(_bL) and not na(_uBar) and close < _bL and not _uF
    _uBF = _iGr and not na(_bL) and not na(_uBar) and close > _bL and not _uF
    _aSF  = _2bBF or _2bBeF or _vBF or _vBeF or _uBeF or _uBF
    _uDOB = _uF or _uWB
    _nYF    = not _uDOB and not _tF and not _eF and not _2bS and not _eS
    _bnC     = (_boB or _boBr) and not _aSF and _nYF

    if _tFlp or _retExp or _bnC
        _iR := false
        _ibT    := false
        _fR    := false
        _fU       := false
        _uVol     := 0.0
        _uHi       := na
        _uLo        := na
        _uBar        := na
        _uLSw   := false
        _uHSw  := false
        _rceLo    := na
        _rceHi   := na
        _uLbl      := na
        _bL      := na
        _bT  := false
        if not na(_pnHL)
            line.delete(_pnHL)
        if not na(_pnSp)
            line.delete(_pnSp)
        _pnHL          := na
        _pnSp         := na
        _plHL         := na
        _plSp        := na
        _eBWP  := false
        _eBrWP := false
        _eWCH  := na
        _eWCSL := na
        _eWCL  := na
        _eWCSH := na
        _uReBnc := false
        _tReBnc := false
        _eReBnc := false
        _hlWick := false
        if sDb and _bnC
            _lbl = _lb ? _rCeil : _rFlr
            label.new(bar_index, _lbl, "↺ Reset", style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)

// Update structural low/high throughout the retracement
if _iR or _ibT
    if _lb and (na(_rceLo) or low < _rceLo)
        _rceLo  := low
    if not _lb and (na(_rceHi) or high > _rceHi)
        _rceHi := high
    // Track opposing candles during retracement for TBR opposing candle filter
    if _iRd
        _sbR  := true
    if _iGr
        _sgR := true
    // Keep POI lines extended to current bar so they always reach the right edge
    if not na(_pnHL) and not na(_plHL)
        line.set_x2(_pnHL, bar_index + 20)
    if not na(_pnSp) and not na(_plSp)
        line.set_x2(_pnSp, bar_index + 20)
    // Track HL/SR wick-through for per-strategy filter
    if _iR and not _hlWick
        if _lb ? ((not na(_plHL) and low < _plHL) or (not na(_plSp) and low < _plSp)) : ((not na(_plHL) and high > _plHL) or (not na(_plSp) and high > _plSp))
            _hlWick := true

// STEP 4: UHV — Highest Volume Candle During Retracement
// Compare volume WITHIN the retracement only (not vs prior impulse bars)
// _uVol starts at 0.0 when retracement begins, so first red/green candle always qualifies
// UHV = highest volume candle during retracement (any color — fast 1m pullbacks often have no clean red candle)
if _iR and _lb and _iRd and not _uF and volume > _uVol and ta.percentrank(volume, 20) >= uVT
    _uVol   := volume
    _uHi     := high
    _uSl       := low
    _uLSw := false
    _uBar      := bar_index
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, high, "⚡ UHV Red", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    _bL := high

if _iR and not _lb and _iGr and not _uF and volume > _uVol and ta.percentrank(volume, 20) >= uVT
    _uVol    := volume
    _uLo       := low
    _uSl        := high
    _uHSw := false
    _uBar       := bar_index
    if not na(_uLbl)
        label.delete(_uLbl)
    if sL or sDb
        _uLbl := label.new(bar_index, low, "⚡ UHV Green", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    _bL := low

// STEP 4a: VSA TRACKER — biggest red/green candle during retracement (independent of UHV)
if _iR and _lb and _iRd
    _vRV   := volume
    _vRL   := low
    _vRBar := bar_index
    _vRHi  := high

if _iR and not _lb and _iGr
    _vGV   := volume
    _vGH   := high
    _vGBar := bar_index
    _vGLo  := low

// STEP 4b: TRACK UHV LOW SWEEP
// Bull: UHV red low must be swept (wick or close below) before breakout fires
// Bear: no sweep requirement — red candle just needs to close below UHV green low
if _iR and _lb and not na(_uSl) and not _uLSw
    if low < _uSl or close < _uSl
        _uLSw := true

if _iR and not _lb and not na(_uSl) and not _uHSw
    if high > _uSl or close > _uSl
        _uHSw := true

// Per-strategy direction filters
_uBDir  = uDir != "Bear only"
_uBeDir  = uDir != "Bull only"
_tBDir  = tDir != "Bear only"
_tBeDir  = tDir != "Bull only"
_eBDir  = eDir != "Bear only"
_eBeDir  = eDir != "Bull only"

// ── Optimize overrides — effective values used in all signal conditions ──
// Smart optimizer: each change is applied only when oSm=true AND proof (above) is positive.
// Proof = blocked_count × strategy_EV. If EV ≤ 0, removing a filter would ADD losing trades → skip.
//
// oLv controls how many categories of optimization are applied (1 = filter removal only, 9 = all):
//   Level 1–3 : filter removals, ordered by proof rank (threshold shrinks each level)
//   Level 4   : also halve cooldowns
//   Level 5   : also raise TP +$1
//   Level 6–8 : also auto-cap max loss (2× / 1.5× / 1× avg win)
//   Level 9   : also drop losing directions
//   Level 10  : maximum — panel shows "Cannot be further optimized"
//
// Proof floor for filter removal — level 1 = very conservative, level 3+ = any positive proof
float  _oPF  = oSm ? (
     oLv >= 3 ? 0.0 :
     oLv == 2 ? math.max(0.01, nz(_gWEV, 0.5) * 2.0) :
                     math.max(0.01, nz(_gWEV, 0.5) * 4.0)) : 1e10

bool   _erUS     = rUS     and not (oSm and _pUS > _oPF)
bool   _erULV  = rULV  and not (oSm and _pUV > _oPF)
bool   _er2LV  = r2LV  and not (oSm and _p2V > _oPF)
bool   _erOC     = rOC and not (oSm and _pOC > _oPF)
bool   _erEHV = rEHV and not (oSm and _pEV > _oPF)
// _euCd / _etCd / _eeCd declared earlier (before retracement blocks)
// SL type: smart optimizer does not change SL — user's configured method is always used
string _euST       = uST
string _etST       = tST
string _eeST       = eST
float  _euTD     = uTD
float  _etTD     = tTD
float  _eeTD     = eTD
// Direction: remove per-strategy direction only if its per-trade P&L is provably negative (level 9+)
bool   _sDA     = oSm and oLv >= 9
bool   _euBD      = _uBDir and not (_sDA and _sUBO)
bool   _euBeD      = _uBeDir and not (_sDA and _sUBeO)
bool   _etBD      = _tBDir and not (_sDA and _sTBO)
bool   _etBeD      = _tBeDir and not (_sDA and _sTBeO)
bool   _eeBD      = _eBDir and not (_sDA and _sEBO)
bool   _eeBeD      = _eBeDir and not (_sDA and _sEBeO)

// ── Max Trades Mode — override all optional filters and cooldowns ──
bool _eStU = not mTM and (sTC and sTCU)
bool _eStT = not mTM and (sTC and sTCT)
bool _eStE = not mTM and (sTC and sTCE)
int  _eMS    = mTM ? 0 : mTS
bool _eTsU     = not mTM and _tsU
bool _eTsT     = not mTM and _tsT
bool _eTsE     = not mTM and _tsE
if mTM
    _euCd     := 0
    _etCd     := 0
    _eeCd     := 0
    _erUS     := false
    _erULV  := false
    _er2LV  := false
    _erOC     := false
    _erEHV := false

// ── Reduce Max Loss — per-strategy SL dollar cap ──
// Auto mode: cap = historical avg win amount per strategy (requires 3+ wins).
// Fixed mode: cap = user-defined amount for all strategies.
// oLv 6 = 2× avg win, level 7 = 1.5×, level 8 = 1× (progressively tighter).
float _uAW  = _uWn >= 3 ? _uWS / _uWn : rLF
float _tAW  = _bWn >= 3 ? _bWS / _bWn : rLF
float _eAW  = _eWn >= 3 ? _eWS / _eWn : rLF
float _lMlt   = (oSm and oLv >= 8) ? 1.0 : (oSm and oLv >= 7) ? 1.5 : 2.0
bool  _aCO   = oSm and oLv >= 6

// Effective loss cap per strategy: rL button OR oLv 6+ auto-cap (whichever applies)
float _uLC = rL ? (rLM == "Auto (avg win per strategy)" ? _uAW : rLF) : (_aCO ? _uAW * _lMlt : 1e10)
float _tLC = rL ? (rLM == "Auto (avg win per strategy)" ? _tAW : rLF) : (_aCO ? _tAW * _lMlt : 1e10)
float _eLC = rL ? (rLM == "Auto (avg win per strategy)" ? _eAW : rLF) : (_aCO ? _eAW * _lMlt : 1e10)
// Optimizer offsets: applied on top of effective values (0 = no change)
if oUTP != 0
    _euTD := _euTD + oUTP
if oTTP != 0
    _etTD := _etTD + oTTP
if oETP != 0
    _eeTD := _eeTD + oETP
if oCDo != 0 and not mTM
    _euCd := math.max(0, _euCd + oCDo)
    _etCd := math.max(0, _etCd + oCDo)
    _eeCd := math.max(0, _eeCd + oCDo)
if oTSo != 0 and not mTM
    _eMS := math.max(0, mTS + oTSo)
if oRLo > 0
    _uLC := math.min(_uLC, float(oRLo))
    _tLC := math.min(_tLC, float(oRLo))
    _eLC := math.min(_eLC, float(oRLo))

// Per-strategy FVG width + touch checks
_a144   = nz(ta.atr(144))
_fW        = nz(_fZT, 0.0) - nz(_fZB, 0.0)
_uFW  = uFTH == 0 or _fW >= _a144 * uFTH
_tFW  = tFTH == 0 or _fW >= _a144 * tFTH
_eFW  = eFTH == 0 or _fW >= _a144 * eFTH
_uFC = mTM ? true : rFT ? (_fR and _uFW) : true
_tFC = mTM ? true : rFT ? (_fR and _tFW) : true
_eFC = mTM ? true : rFT ? (_fR and _eFW) : true
bool _cUB  = cLP and _uBT  >= 10 and _uBP  < 0.0
bool _cUBe = cLP and _uBeT >= 10 and _uBeP < 0.0
bool _cTB  = cLP and _bBT  >= 10 and _bBP  < 0.0
bool _cTBe = cLP and _bBeT >= 10 and _bBeP < 0.0
bool _cEB  = cLP and _eBT  >= 10 and _eBP  < 0.0
bool _cEBe = cLP and _eBeT >= 10 and _eBeP < 0.0

// STEP 5: BREAKOUT — Absorption Signal
_bBrk = _euBD and eUHV and _iR and _lb and _rwb and not _uReBnc and (_eStU ? (_hb and _bTP) : not _beTP) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and (_erUS ? _uLSw : true) and (_erULV ? volume < volume[1] : true) and not _eTsU and _iGr and low <= _bL and close > _bL and (bar_index - _luSB) >= _euCd and (uRHL ? _hlWick : true) and not _cUB and barstate.isconfirmed

// ── Blocked-signal detection (for recommendation engine) ──
// UHV bull: would have fired without sweep requirement
_uBBase = _euBD and eUHV and _iR and _lb and _rwb and ((sTC and sTCU) ? (_hb and _bTP) : not _beTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iGr and low <= _bL and close > _bL
if _uBBase and _erUS and not _uLSw and _tS >= mTS
    _bSwp += 1
    _uWB := true  // sweep-wait is UHV's internal concern — don't hold up TBR/EVR
// UHV bull: would have fired without volume requirement
if _uBBase and (_erUS ? _uLSw : true) and _erULV and volume >= volume[1] and _tS >= mTS and (bar_index - _luSB) >= _euCd and not _tsU
    _bUV += 1
    _uWB := true
// Blocked by trend strength (sweep ok, everything else ok, only strength fails)
if _uBBase and (_erUS ? _uLSw : true) and _tS < mTS and (bar_index - _luSB) >= _euCd
    _bStr += 1
// Blocked by cooldown (everything ok except cooldown)
if _uBBase and (_erUS ? _uLSw : true) and _tS >= mTS and (bar_index - _luSB) < _euCd
    _bCd += 1
    _uWB := true  // treat cooldown-blocked as "serviced" so setup ends on time and EVR/TBR aren't held up
// Blocked by trend shift — mark serviced so TBR/EVR don't get extra bars from extended retracement
if _uBBase and (_erUS ? _uLSw : true) and (bar_index - _luSB) >= _euCd and _tsU
    _uWB := true
// Blocked by strict trend check — relaxed mode would pass (not _beTP) but _hb+persistence fails
if eUHV and _iR and _lb and _rwb and not _beTP and (sTC and sTCU) and not (_hb and _bTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iGr and low <= _bL and close > _bL and (_erUS ? _uLSw : true) and (bar_index - _luSB) >= _euCd
    _uWB := true

int _nU = math.max(1, _uTr > 19 ? _uWn * 50 / _uTr - 44 : 0)
int _nB = math.max(1, _bTr > 19 ? _bWn * 50 / _bTr - 44 : 0)
int _nE = math.max(1, _eTr > 19 ? _eWn * 50 / _eTr - 44 : 0)
float _lOp = 0.
if array.size(_tEn) > 0
    for i = 0 to array.size(_tEn) - 1
        if not array.get(_tSH, i) and not array.get(_tTH, i)
            _lOp += math.abs(array.get(_tEn, i) - array.get(_tSl, i)) * array.get(_tEL, i) * cM

if _bBrk
    _entry    = close
    _sl       = fSL(true, close, _euST == "UHV" ? nz(_uSl, nz(_rceLo, low)) : nz(_rceLo, nz(_uSl, low)), high, _euST, uSBf, uSAm, uSSw, uSMn, uDR, uLS, uSDo)
    _slDist   = math.max(_entry - _sl, syminfo.mintick)
    _effLots  = (uDR > 0 ? math.max(uDR / (_slDist * cM), mLot) : uLS) * lA * _nU
    bool _wCp = _slDist * _effLots * cM > _uLC
    if _wCp
        _slDist := math.max(_uLC / math.max(_effLots * cM, syminfo.mintick), uSMn)
        _sl     := _entry - _slDist
    float _tp1 = uTM == "Structural High/Low" ? nz(_rCeil, _entry + _slDist * uT1) : uTM == "Dollar Amount" ? _entry + _euTD : _entry + _slDist * uT1
    bool _safe = _inSess and _lOp + _slDist * _effLots * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _uF := true
        _bT  := true
        _fU       := true
        _luSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",buy," + pSym + ",vol_lots=" + str.tostring(_effLots, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=UHV" : "🟢 BUY Signal — UHV Breakout | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLbl = label(na)
        if sL
            _sigLbl := label.new(bar_index, high, "🟢 BUY NOW  #" + str.tostring(_totS) + "\n(Ultra Highs Breakout)\n━━━━━━━━━━━━━━━━\nBuy:  " + str.tostring(_entry, "#.###") + "\nSL:   " + str.tostring(_sl, "#.###") + "  [" + _euST + ", risk: $" + str.tostring(math.round(_slDist * _effLots * cM * 100) / 100, "#.##") + "]\nLots: " + fLL(uDR, _effLots) + "\nTP:   " + str.tostring(_tp1, "#.###") + " (" + (uTM == "Structural High/Low" ? "Struct." : uTM == "Dollar Amount" ? "$fixed" : str.tostring(uT1, "#.#") + "R") + ")  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLots * cM * 100) / 100, "#.##") + "\n━━━━━━━━━━━━━━━━\n📊 " + fAS(_uWn, _uTr) + "\n" + fPTS(_uPT), style = label.style_label_down, color = color.new(#089981, 0), textcolor = color.white, size = size.normal)
        array.push(_tEn,  _entry)
        array.push(_tSl,     _sl)
        array.push(_tTP,    _tp1)
        array.push(_tBl,   true)
        array.push(_tTH, false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLots)
        array.push(_tTy,     "uhv")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLbl)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _uLC : 0.)
        array.push(_xFv, _fR)
        _pvHi       := _rnHi
        _rnHi    := high
        _lgL   := low
        _lgC := close
        _lrH    := na
        _lrC   := na
    else
        label.new(bar_index, high, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        box.new(_uBar - 1, _uHi, _uBar + 1, _uSl, color.new(color.yellow, 0), 2, bgcolor=color.new(color.yellow, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.lime, 0), 2, bgcolor=color.new(color.lime, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)
    if sL
        float _ahU = ta.atr(14) * 2.5
        int _gU = bar_index - _uBar
        float _pkU = math.max(_uHi, high) + _ahU
        polyline.new(array.from(chart.point.from_index(_uBar, _uHi), chart.point.from_index(_uBar + _gU / 2, _pkU), chart.point.from_index(bar_index, high)), curved = true, line_color = color.new(#00ff88, 0), line_width = 3)
        label.new(bar_index, high, "", style = label.style_arrowdown, color = color.new(#00ff88, 0), size = size.small)

// UHV bear: base condition (without sweep/vol/strength/cooldown) for blocked-counter tracking
_uBeBase = _euBeD and eUHV and _iR and not _lb and not _rwb and ((sTC and sTCU) ? (_hbr and _beTP) : not _bTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iRd and close < _bL
if _uBeBase and _erUS and not _uHSw and _tS >= mTS
    _bSwp += 1
    _uWB := true  // sweep-wait is UHV's internal concern — don't hold up TBR/EVR
// UHV bear: would have fired without volume requirement
if _uBeBase and (_erUS ? _uHSw : true) and _erULV and volume >= volume[1] and _tS >= mTS and (bar_index - _luSB) >= _euCd and not _tsU
    _bUV += 1
    _uWB := true
// Blocked by trend strength
if _uBeBase and (_erUS ? _uHSw : true) and _tS < mTS and (bar_index - _luSB) >= _euCd
    _bStr += 1
// Blocked by cooldown
if _uBeBase and (_erUS ? _uHSw : true) and _tS >= mTS and (bar_index - _luSB) < _euCd
    _bCd += 1
    _uWB := true  // treat cooldown-blocked as "serviced" so setup ends on time and EVR/TBR aren't held up
// Blocked by trend shift — mark serviced so TBR/EVR don't get extra bars from extended retracement
if _uBeBase and (_erUS ? _uHSw : true) and (bar_index - _luSB) >= _euCd and _tsU
    _uWB := true
// Blocked by strict trend check — relaxed mode would pass (not _bTP) but _hbr+persistence fails
if eUHV and _iR and not _lb and not _rwb and not _bTP and (sTC and sTCU) and not (_hbr and _beTP) and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and _iRd and close < _bL and (_erUS ? _uHSw : true) and (bar_index - _luSB) >= _euCd
    _uWB := true

_beBrk = _euBeD and eUHV and _iR and not _lb and not _rwb and not _uReBnc and (_eStU ? (_hbr and _beTP) : not _bTP) and _tS >= _eMS and _uFC and not na(_bL) and not _uF and not na(_uBar) and (bar_index - _uBar) >= uSB and (_erUS ? _uHSw : true) and (_erULV ? volume < volume[1] : true) and not _eTsU and _iRd and close < _bL and (bar_index - _luSB) >= _euCd and (uRHL ? _hlWick : true) and not _cUBe and barstate.isconfirmed

if _beBrk
    _entry      = close
    _sl         = fSL(false, close, low, _euST == "UHV" ? nz(_uSl, nz(_rceHi, high)) : nz(_rceHi, nz(_uSl, high)), _euST, uSBf, uSAm, uSSw, uSMn, uDR, uLS, uSDo)
    _slDist     = math.max(_sl - _entry, syminfo.mintick)
    _effLots    = (uDR > 0 ? math.max(uDR / (_slDist * cM), mLot) : uLS) * lA * _nU
    bool _wCp = _slDist * _effLots * cM > _uLC
    if _wCp
        _slDist := math.max(_uLC / math.max(_effLots * cM, syminfo.mintick), uSMn)
        _sl     := _entry + _slDist
    float _tp1 = uTM == "Structural High/Low" ? nz(_rFlr, _entry - _slDist * uT1) : uTM == "Dollar Amount" ? _entry - _euTD : _entry - _slDist * uT1
    bool _safe = _inSess and _lOp + _slDist * _effLots * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _uF := true
        _bT  := true
        _fU       := true
        _luSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",sell," + pSym + ",vol_lots=" + str.tostring(_effLots, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=UHV" : "🔴 SELL Signal — UHV Breakout | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLbl = label(na)
        if sL
            _sigLbl := label.new(bar_index, low, "🔴 SELL NOW  #" + str.tostring(_totS) + "\n(Ultra Highs Breakout)\n━━━━━━━━━━━━━━━━\nSell: " + str.tostring(_entry, "#.###") + "\nSL:   " + str.tostring(_sl, "#.###") + "  [" + _euST + ", risk: $" + str.tostring(math.round(_slDist * _effLots * cM * 100) / 100, "#.##") + "]\nLots: " + fLL(uDR, _effLots) + "\nTP:   " + str.tostring(_tp1, "#.###") + " (" + (uTM == "Structural High/Low" ? "Struct." : uTM == "Dollar Amount" ? "$fixed" : str.tostring(uT1, "#.#") + "R") + ")  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLots * cM * 100) / 100, "#.##") + "\n━━━━━━━━━━━━━━━━\n📊 " + fAS(_uWn, _uTr) + "\n" + fPTS(_uPT), style = label.style_label_up, color = color.new(#f23645, 0), textcolor = color.white, size = size.normal)
        array.push(_tEn,  _entry)
        array.push(_tSl,     _sl)
        array.push(_tTP,    _tp1)
        array.push(_tBl,   false)
        array.push(_tTH, false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLots)
        array.push(_tTy,     "uhv")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLbl)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _uLC : 0.)
        array.push(_xFv, _fR)
        _pvLo        := _rnLo
        _rnLo     := low
        _lrH    := high
        _lrC   := close
        _lgL   := na
        _lgC := na
    else
        label.new(bar_index, low, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        box.new(_uBar - 1, _uSl, _uBar + 1, _uLo, color.new(color.yellow, 0), 2, bgcolor=color.new(color.yellow, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.red, 0), 2, bgcolor=color.new(color.red, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)
    if sL
        float _ahUe = ta.atr(14) * 2.5
        int _gUe = bar_index - _uBar
        float _pkUe = math.min(_uLo, low) - _ahUe
        polyline.new(array.from(chart.point.from_index(_uBar, _uLo), chart.point.from_index(_uBar + _gUe / 2, _pkUe), chart.point.from_index(bar_index, low)), curved = true, line_color = color.new(#ff4444, 0), line_width = 3)
        label.new(bar_index, low, "", style = label.style_arrowup, color = color.new(#ff4444, 0), size = size.small)

// STEP 5b: TWO BAR REVERSAL (2BR) — Block B integration
// Fires during retracement when a candle engulfs the previous candle's BODY with LOWER volume
// Bull 2BR: bullish candle opens at/below prev body low, closes at/above prev body high, lower vol
// Bear 2BR: bearish candle opens at/above prev body high, closes at/below prev body low, lower vol
// Requires: _iR, _fR — same preconditions as UHV breakout
_pBH = math.max(open[1], close[1])
_pBL  = math.min(open[1], close[1])

_b2BR = _etBD and eTBR and s2 and _iR and _lb and _rwb and not _tReBnc and _tFC and not _tF and (_eStT ? (_hb and _bTP) : not _beTP) and _tS >= _eMS and not _eTsT and _iGr and open <= _pBL and close >= _pBH and (_er2LV ? volume < volume[1] : true) and (_erOC ? _sbR : true) and (bar_index - _ltSB) >= _etCd and (tRHL ? _hlWick : true) and not _cTB and barstate.isconfirmed

_be2BR = _etBeD and eTBR and s2 and _iR and not _lb and not _rwb and not _tReBnc and _tFC and not _tF and (_eStT ? (_hbr and _beTP) : not _bTP) and _tS >= _eMS and not _eTsT and _iRd and open >= _pBH and close <= _pBL and (_er2LV ? volume < volume[1] : true) and (_erOC ? _sgR : true) and (bar_index - _ltSB) >= _etCd and (tRHL ? _hlWick : true) and not _cTBe and barstate.isconfirmed

// 2BR blocked by volume check
_2bBNV = _etBD and eTBR and s2 and _iR and _lb and _rwb and _tFC and not _tF and ((sTC and sTCT) ? (_hb and _bTP) : not _beTP) and _tS >= mTS and _iGr and open <= _pBL and close >= _pBH
_2bBeNV = _etBeD and eTBR and s2 and _iR and not _lb and not _rwb and _tFC and not _tF and ((sTC and sTCT) ? (_hbr and _beTP) : not _bTP) and _tS >= mTS and _iRd and open >= _pBH and close <= _pBL
if _er2LV and (_2bBNV or _2bBeNV) and volume >= volume[1]
    _b2V += 1
if _erOC and (_2bBNV and not _sbR or _2bBeNV and not _sgR)
    _bOpp += 1

if _b2BR
    _entry    = close
    _sl       = fSL(true, close, math.min(low[1], low), math.max(high[1], high), _etST, tSBf, tSAm, tSSw, tSMn, tDR, tLS, tSDo)
    _slDist   = math.max(_entry - _sl, syminfo.mintick)
    _effLots = (tDR > 0 ? math.max(tDR / (_slDist * cM), mLot) : tLS) * lA * _nB
    bool _wCp = _slDist * _effLots * cM > _tLC
    if _wCp
        _slDist := math.max(_tLC / math.max(_effLots * cM, syminfo.mintick), tSMn)
        _sl     := _entry - _slDist
    float _tp1 = tTM == "Structural High/Low" ? nz(_rCeil, _entry + _slDist * tT1) : tTM == "Dollar Amount" ? _entry + _etTD : _entry + _slDist * tT1
    bool _safe = _inSess and _lOp + _slDist * _effLots * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _tF := true
        _bT  := true
        _fU       := true
        _ltSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",buy," + pSym + ",vol_lots=" + str.tostring(_effLots, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=2BR" : "🟢 BUY Signal — 2BR | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLbl = label(na)
        if sL
            _sigLbl := label.new(bar_index, high, "🟢 BUY NOW  #" + str.tostring(_totS) + "\n(Two Bar Reversal)\n━━━━━━━━━━━━━━━━\nBuy:  " + str.tostring(_entry, "#.###") + "\nSL:   " + str.tostring(_sl, "#.###") + "  [" + _etST + ", risk: $" + str.tostring(math.round(_slDist * _effLots * cM * 100) / 100, "#.##") + "]\nLots: " + fLL(tDR, _effLots) + "\nTP:   " + str.tostring(_tp1, "#.###") + " (" + (tTM == "Structural High/Low" ? "Struct." : tTM == "Dollar Amount" ? "$fixed" : str.tostring(tT1, "#.#") + "R") + ")  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLots * cM * 100) / 100, "#.##") + "\n━━━━━━━━━━━━━━━━\n📊 " + fAS(_bWn, _bTr) + "\n" + fPTS(_bPT), style = label.style_label_down, color = color.new(color.teal, 10), textcolor = color.white, size = size.normal)
        array.push(_tEn,    _entry)
        array.push(_tSl,       _sl)
        array.push(_tTP,      _tp1)
        array.push(_tBl,     true)
        array.push(_tTH,   false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLots)
        array.push(_tTy,     "tbr")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLbl)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _tLC : 0.)
        array.push(_xFv, _fR)
    else
        label.new(bar_index, high, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        box.new(bar_index-2, high[1], bar_index, low[1], color.new(color.orange, 0), 2, bgcolor=color.new(color.orange, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.lime, 0), 2, bgcolor=color.new(color.lime, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)

if _be2BR
    _entry      = close
    _sl         = fSL(false, close, math.min(low[1], low), math.max(high[1], high), _etST, tSBf, tSAm, tSSw, tSMn, tDR, tLS, tSDo)
    _slDist     = math.max(_sl - _entry, syminfo.mintick)
    _effLots2 = (tDR > 0 ? math.max(tDR / (_slDist * cM), mLot) : tLS) * lA * _nB
    bool _wCp = _slDist * _effLots2 * cM > _tLC
    if _wCp
        _slDist := math.max(_tLC / math.max(_effLots2 * cM, syminfo.mintick), tSMn)
        _sl     := _entry + _slDist
    float _tp1 = tTM == "Structural High/Low" ? nz(_rFlr, _entry - _slDist * tT1) : tTM == "Dollar Amount" ? _entry - _etTD : _entry - _slDist * tT1
    bool _safe = _inSess and _lOp + _slDist * _effLots2 * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _tF := true
        _bT  := true
        _fU       := true
        _ltSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",sell," + pSym + ",vol_lots=" + str.tostring(_effLots2, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=2BR" : "🔴 SELL Signal — 2BR | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLbl = label(na)
        if sL
            _sigLbl := label.new(bar_index, low, "🔴 SELL NOW  #" + str.tostring(_totS) + "\n(Two Bar Reversal)\n━━━━━━━━━━━━━━━━\nSell: " + str.tostring(_entry, "#.###") + "\nSL:   " + str.tostring(_sl, "#.###") + "  [" + _etST + ", risk: $" + str.tostring(math.round(_slDist * _effLots2 * cM * 100) / 100, "#.##") + "]\nLots: " + (tDR > 0 ? "auto (" + str.tostring(_effLots2, "#.####") + " lots)" : "user-defined (" + str.tostring(_effLots2, "#.##") + " lots)") + "\nTP:   " + str.tostring(_tp1, "#.###") + " (" + (tTM == "Structural High/Low" ? "Struct." : tTM == "Dollar Amount" ? "$fixed" : str.tostring(tT1, "#.#") + "R") + ")  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLots2 * cM * 100) / 100, "#.##") + "\n━━━━━━━━━━━━━━━━\n📊 " + fAS(_bWn, _bTr) + "\n" + fPTS(_bPT), style = label.style_label_up, color = color.new(color.orange, 10), textcolor = color.white, size = size.normal)
        array.push(_tEn,    _entry)
        array.push(_tSl,       _sl)
        array.push(_tTP,      _tp1)
        array.push(_tBl,     false)
        array.push(_tTH,   false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLots2)
        array.push(_tTy,     "tbr")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLbl)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _tLC : 0.)
        array.push(_xFv, _fR)
    else
        label.new(bar_index, low, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        box.new(bar_index-2, high[1], bar_index, low[1], color.new(color.orange, 0), 2, bgcolor=color.new(color.orange, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.red, 0), 2, bgcolor=color.new(color.red, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)

// STEP 5c: EFFORT VS RESULT (VSA) — Block C integration
// Entry fires when breakout candle:
//   1. Sweeps UHV candle low (low < _uSl)
//   2. Closes back above it  (close > _uSl)
//   3. Has HIGHER volume than the UHV candle (volume > _uVol)
// This is the pure VSA "effort vs result" signal — more buying effort than the biggest seller
// Bull EVR: two paths depending on aETW
// Path A — no wick filter OR wick is clean: fire immediately
// Path B — wick filter ON and wick > body: set pending, wait for next bar confirmation
_eBBase    = _eeBD and eEVR and sVsa and _iR and _lb and _rwb and not _eReBnc and _eFC and not _eF and not na(_vRL) and _vRV > 0 and (_eStE ? (_hb and _bTP) : not _beTP) and _tS >= _eMS and not _eTsE and _iGr and low < _vRL and close > _vRL and close <= _vRHi and (_erEHV ? volume > _vRV : true) and (bar_index - _leSB) >= _eeCd
_eBHW = (high - close) > (close - open)   // upper wick larger than body
_bVSA         = _eBBase and (aETW ? not _eBHW : true) and (eRHL ? _hlWick : true) and not _cEB and barstate.isconfirmed
// When wick detected and filter is ON: arm pending confirmation
if _eBBase and aETW and _eBHW and not _eBWP
    _eBWP   := true
    _eWCH   := high
    _eWCSL  := low
    _eBWBar := bar_index
    _eBWH   := high
    _eBWL   := low

// Bear EVR: same two-path logic
_eBeBase    = _eeBeD and eEVR and sVsa and _iR and not _lb and not _rwb and not _eReBnc and _eFC and not _eF and not na(_vGH) and _vGV > 0 and (_eStE ? (_hbr and _beTP) : not _bTP) and _tS >= _eMS and not _eTsE and _iRd and high > _vGH and close < _vGH and (_erEHV ? volume > _vGV : true) and (bar_index - _leSB) >= _eeCd
_eBrHW = (close - low) > (open - close)    // lower wick larger than body
_beVSA         = _eBeBase and (aETW ? not _eBrHW : true) and (eRHL ? _hlWick : true) and not _cEBe and barstate.isconfirmed
// When wick detected and filter is ON: arm pending confirmation
if _eBeBase and aETW and _eBrHW and not _eBrWP
    _eBrWP   := true
    _eWCL    := low
    _eWCSH   := high
    _eBrWBar := bar_index
    _eBrWH   := high
    _eBrWL   := low

// EVR blocked by volume check
_eBBNV = _eeBD and eEVR and sVsa and _iR and _lb and _rwb and _eFC and not _eF and not na(_vRL) and _vRV > 0 and ((sTC and sTCE) ? (_hb and _bTP) : not _beTP) and _tS >= mTS and _iGr and low < _vRL and close > _vRL and close <= _vRHi
_eBeBNV = _eeBeD and eEVR and sVsa and _iR and not _lb and not _rwb and _eFC and not _eF and not na(_vGH) and _vGV > 0 and ((sTC and sTCE) ? (_hbr and _beTP) : not _bTP) and _tS >= mTS and _iRd and high > _vGH and close < _vGH and close >= _vGLo
// Persist EVR structural appearance so _bnC stays suppressed on bars AFTER the sweep candle
// Without this, when rEHV=ON blocks EVR, _eF stays false and _bnC
// can fire on the very next bar, wiping UHV/TBR setups
if _eBBNV or _eBeBNV
    _eS := true
if _erEHV and (_eBBNV or _eBeBNV) and not (_eBBNV and volume > _vRV) and not (_eBeBNV and volume > _vGV)
    _bEV += 1

if _bVSA
    _entry    = close
    _sl       = fSL(true, close, nz(_rceLo, nz(_vRL, low)), high, _eeST, eSBf, eSAm, eSSw, eSMn, eDR, eLS, eSDo)
    _slDist   = math.max(_entry - _sl, syminfo.mintick)
    _effLotsV = (eDR > 0 ? math.max(eDR / (_slDist * cM), mLot) : eLS) * lA * _nE
    bool _wCp = _slDist * _effLotsV * cM > _eLC
    if _wCp
        _slDist := math.max(_eLC / math.max(_effLotsV * cM, syminfo.mintick), eSMn)
        _sl     := _entry - _slDist
    float _tp1 = eTM == "Structural High/Low" ? nz(_rCeil, _entry + _slDist * eT1) : eTM == "Dollar Amount" ? _entry + _eeTD : _entry + _slDist * eT1
    bool _safe = _inSess and _lOp + _slDist * _effLotsV * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _eF := true
        _bT  := true
        _fU       := true
        _leSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",buy," + pSym + ",vol_lots=" + str.tostring(_effLotsV, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR" : "🟢 BUY Signal — EVR | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLbl = label(na)
        if sL
            _sigLbl := label.new(bar_index, high, "BUY NOW  #" + str.tostring(_totS) + "\n(Effort vs Result)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _eeST + ", risk: $" + str.tostring(math.round(_slDist * _effLotsV * cM * 100) / 100, "#.##") + "]" + "\nLots:  " + fLL(eDR, _effLotsV) + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsV * cM * 100) / 100, "#.##") + "\n" + fAS(_eWn, _eTr) + "\n" + fPTS(_ePT), style = label.style_label_down, color = color.new(color.lime, 10), textcolor = color.black, size = size.normal)
        array.push(_tEn,    _entry)
        array.push(_tSl,       _sl)
        array.push(_tTP,      _tp1)
        array.push(_tBl,     true)
        array.push(_tTH,   false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLotsV)
        array.push(_tTy,     "evr")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLbl)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _eLC : 0.)
        array.push(_xFv, _fR)
    else
        label.new(bar_index, high, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        if not na(_vRBar)
            box.new(_vRBar - 1, _vRHi, _vRBar + 1, _vRL, color.new(color.orange, 0), 2, bgcolor=color.new(color.orange, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.lime, 0), 2, bgcolor=color.new(color.lime, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)

if _beVSA
    _entry      = close
    _sl         = fSL(false, close, low, nz(_rceHi, nz(_vGH, high)), _eeST, eSBf, eSAm, eSSw, eSMn, eDR, eLS, eSDo)
    _slDist     = math.max(_sl - _entry, syminfo.mintick)
    _effLotsV2 = (eDR > 0 ? math.max(eDR / (_slDist * cM), mLot) : eLS) * lA * _nE
    bool _wCp = _slDist * _effLotsV2 * cM > _eLC
    if _wCp
        _slDist := math.max(_eLC / math.max(_effLotsV2 * cM, syminfo.mintick), eSMn)
        _sl     := _entry + _slDist
    float _tp1 = eTM == "Structural High/Low" ? nz(_rFlr, _entry - _slDist * eT1) : eTM == "Dollar Amount" ? _entry - _eeTD : _entry - _slDist * eT1
    bool _safe = _inSess and _lOp + _slDist * _effLotsV2 * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _eF := true
        _bT  := true
        _fU       := true
        _leSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",sell," + pSym + ",vol_lots=" + str.tostring(_effLotsV2, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR" : "🔴 SELL Signal — EVR | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLbl = label(na)
        if sL
            _sigLbl := label.new(bar_index, low, "SELL NOW  #" + str.tostring(_totS) + "\n(Effort vs Result)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _eeST + ", risk: $" + str.tostring(math.round(_slDist * _effLotsV2 * cM * 100) / 100, "#.##") + "]" + "\nLots:  " + fLL(eDR, _effLotsV2) + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsV2 * cM * 100) / 100, "#.##") + "\n" + fAS(_eWn, _eTr) + "\n" + fPTS(_ePT), style = label.style_label_up, color = color.new(color.red, 10), textcolor = color.white, size = size.normal)
        array.push(_tEn,    _entry)
        array.push(_tSl,       _sl)
        array.push(_tTP,      _tp1)
        array.push(_tBl,     false)
        array.push(_tTH,   false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLotsV2)
        array.push(_tTy,     "evr")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLbl)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _eLC : 0.)
        array.push(_xFv, _fR)
    else
        label.new(bar_index, low, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        if not na(_vGBar)
            box.new(_vGBar - 1, _vGH, _vGBar + 1, _vGLo, color.new(color.orange, 0), 2, bgcolor=color.new(color.orange, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.red, 0), 2, bgcolor=color.new(color.red, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)

// EVR WICK CONFIRMATION — pending entries waiting for breakout of wick candle

// Cancel pending if retracement ends or trend flipped
if _eBWP and (not _iR or _eF or _beTP or not eEVR or not sVsa)
    _eBWP  := false
    _eWCH  := na
    _eWCSL := na
if _eBrWP and (not _iR or _eF or _bTP or not eEVR or not sVsa)
    _eBrWP := false
    _eWCL  := na
    _eWCSH := na

// Bull confirmation: next candle closes above the wick candle high
if _eBWP and not na(_eWCH) and not _eF and not _eReBnc and eEVR and sVsa and _iR and _lb and close > _eWCH and (eRHL ? _hlWick : true) and not _cEB and barstate.isconfirmed
    _eBWP := false
    _entry    = close
    _sl       = _eeST == "Below High Vol. Candle Wick" ? math.max(syminfo.mintick, nz(_eWCSL, low) - eSBf) : fSL(true, close, nz(_rceLo, nz(_vRL, low)), high, _eeST, eSBf, eSAm, eSSw, eSMn, eDR, eLS, eSDo)
    _slDist   = math.max(_entry - _sl, syminfo.mintick)
    _effLotsVW = (eDR > 0 ? math.max(eDR / (_slDist * cM), mLot) : eLS) * lA * _nE
    bool _wCp = _slDist * _effLotsVW * cM > _eLC
    if _wCp
        _slDist := math.max(_eLC / math.max(_effLotsVW * cM, syminfo.mintick), eSMn)
        _sl     := _entry - _slDist
    float _tp1 = eTM == "Structural High/Low" ? nz(_rCeil, _entry + _slDist * eT1) : eTM == "Dollar Amount" ? _entry + _eeTD : _entry + _slDist * eT1
    bool _safe = _inSess and _lOp + _slDist * _effLotsVW * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _eF := true
        _bT  := true
        _fU       := true
        _leSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",buy," + pSym + ",vol_lots=" + str.tostring(_effLotsVW, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR" : "🟢 BUY Signal — EVR Wick Confirmed | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLblW = label(na)
        if sL
            _sigLblW := label.new(bar_index, high, "BUY NOW  #" + str.tostring(_totS) + "\n(EVR — Wick Confirmed)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _eeST + ", risk: $" + str.tostring(math.round(_slDist * _effLotsVW * cM * 100) / 100, "#.##") + "]\nLots:  " + fLL(eDR, _effLotsVW) + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsVW * cM * 100) / 100, "#.##") + "\n" + fAS(_eWn, _eTr) + "\n" + fPTS(_ePT), style = label.style_label_down, color = color.new(color.lime, 10), textcolor = color.black, size = size.normal)
        array.push(_tEn,    _entry)
        array.push(_tSl,       _sl)
        array.push(_tTP,      _tp1)
        array.push(_tBl,     true)
        array.push(_tTH,   false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLotsVW)
        array.push(_tTy,     "evr")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLblW)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _eLC : 0.)
        array.push(_xFv, _fR)
        _eWCH  := na
        _eWCSL := na
    else
        label.new(bar_index, high, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        if not na(_vRBar)
            box.new(_vRBar - 1, _vRHi, _vRBar + 1, _vRL, color.new(color.orange, 0), 2, bgcolor=color.new(color.orange, 90))
        if not na(_eBWBar)
            box.new(_eBWBar - 1, _eBWH, _eBWBar + 1, _eBWL, color.new(#9B59B6, 0), 2, bgcolor=color.new(#9B59B6, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.lime, 0), 2, bgcolor=color.new(color.lime, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)

// Bear confirmation: next candle closes below the wick candle low
if _eBrWP and not na(_eWCL) and not _eF and not _eReBnc and eEVR and sVsa and _iR and not _lb and close < _eWCL and (eRHL ? _hlWick : true) and not _cEBe and barstate.isconfirmed
    _eBrWP := false
    _entry    = close
    _sl       = _eeST == "Below High Vol. Candle Wick" ? nz(_eWCSH, high) + eSBf : fSL(false, close, low, nz(_rceHi, nz(_vGH, high)), _eeST, eSBf, eSAm, eSSw, eSMn, eDR, eLS, eSDo)
    _slDist   = math.max(_sl - _entry, syminfo.mintick)
    _effLotsVW2 = (eDR > 0 ? math.max(eDR / (_slDist * cM), mLot) : eLS) * lA * _nE
    bool _wCp = _slDist * _effLotsVW2 * cM > _eLC
    if _wCp
        _slDist := math.max(_eLC / math.max(_effLotsVW2 * cM, syminfo.mintick), eSMn)
        _sl     := _entry + _slDist
    float _tp1 = eTM == "Structural High/Low" ? nz(_rFlr, _entry - _slDist * eT1) : eTM == "Dollar Amount" ? _entry - _eeTD : _entry - _slDist * eT1
    bool _safe = _inSess and _lOp + _slDist * _effLotsVW2 * cM <= iMon * 0.5
    if _safe
        _sigT += 1
        array.push(_sBT, bar_index)
        _eF := true
        _bT  := true
        _fU       := true
        _leSB := bar_index
        _totS  += 1
        alert(pE ? pLid + ",sell," + pSym + ",vol_lots=" + str.tostring(_effLotsVW2, "0.####") + ",sl_price=" + str.tostring(_sl, "#.##") + ",tp_price=" + str.tostring(_tp1, "#.##") + ",comment=EVR" : "🔴 SELL Signal — EVR Wick Confirmed | Entry: " + str.tostring(_entry, "#.###") + " | " + syminfo.ticker, alert.freq_once_per_bar)
        _sigLblW2 = label(na)
        if sL
            _sigLblW2 := label.new(bar_index, low, "SELL NOW  #" + str.tostring(_totS) + "\n(EVR — Wick Confirmed)\nEntry: " + str.tostring(_entry, "#.###") + "\nSL:    " + str.tostring(_sl, "#.###") + "  [" + _eeST + ", risk: $" + str.tostring(math.round(_slDist * _effLotsVW2 * cM * 100) / 100, "#.##") + "]\nLots:  " + fLL(eDR, _effLotsVW2) + "\nTP:    " + str.tostring(_tp1, "#.###") + "  +$" + str.tostring(math.round(math.abs(_tp1 - _entry) * _effLotsVW2 * cM * 100) / 100, "#.##") + "\n" + fAS(_eWn, _eTr) + "\n" + fPTS(_ePT), style = label.style_label_up, color = color.new(color.red, 10), textcolor = color.white, size = size.normal)
        array.push(_tEn,    _entry)
        array.push(_tSl,       _sl)
        array.push(_tTP,      _tp1)
        array.push(_tBl,     false)
        array.push(_tTH,   false)
        array.push(_tSH,    false)
        array.push(_tEL,  _effLotsVW2)
        array.push(_tTy,     "evr")
        array.push(_tN,      _totS)
        array.push(_tTS, _tS)
        array.push(_tW,      false)
        array.push(_tLbl,    _sigLblW2)
        array.push(_tEB, bar_index)
        array.push(_xCp, _wCp)
        array.push(_xCa, _wCp ? _eLC : 0.)
        array.push(_xFv, _fR)
    else
        label.new(bar_index, low, "⛔ Margin risk — raise capital/lower lots", color=color.red, textcolor=color.white)
    if sCH
        if not na(_vGBar)
            box.new(_vGBar - 1, _vGH, _vGBar + 1, _vGLo, color.new(color.orange, 0), 2, bgcolor=color.new(color.orange, 90))
        if not na(_eBrWBar)
            box.new(_eBrWBar - 1, _eBrWH, _eBrWBar + 1, _eBrWL, color.new(#9B59B6, 0), 2, bgcolor=color.new(#9B59B6, 90))
        box.new(bar_index - 1, high, bar_index + 1, low, color.new(color.red, 0), 2, bgcolor=color.new(color.red, 90))
        fSU(bar_index, _sl, _a14, color.red)
        fSU(bar_index, _tp1, _a14, color.lime)
    _eWCL  := na
    _eWCSH := na

// End setup when all enabled strategies have fired from this setup
if _iR
    // _2bS: a structural 2BR candle appeared this setup (regardless of vol filter)
    // When r2LV=ON blocks TBR on a high-vol bar, the setup must not keep running
    // indefinitely waiting for TBR — that would delay UHV/EVR from freeing up the next setup.
    // Treating a seen-but-blocked 2BR as "TBR serviced" makes setup duration identical to OFF case.
    _aSFrd = (not eUHV or _uF or _uWB) and (not eTBR or _tF or _2bS or _tReBnc) and (not eEVR or _eF or _eS or _eReBnc)
    if _aSFrd
        _iR := false
        _ibT    := false
        _fR    := false
        if not na(_pnHL)
            line.delete(_pnHL)
        if not na(_pnSp)
            line.delete(_pnSp)
        _pnHL   := na
        _pnSp  := na
        _plHL  := na
        _plSp := na

// DAILY RESET
_today = dayofmonth(time)
if _today != _ltd
    _tSAD  += _sigT
    _tDS        += 1
    _sigT         := 0
    _pT             := 0.0
    _uPT          := 0.0
    _bPT          := 0.0
    _ePT          := 0.0
    _tLSt      := 0
    _mLST   := 0
    _ltd         := _today

// TRADE MONITORING
if array.size(_tEn) > 0
    for _ti = array.size(_tEn) - 1 to 0
        _done  = array.get(_tSH, _ti) or array.get(_tTH, _ti)
        if not _done
            _bull  = array.get(_tBl,  _ti)
            _sl    = array.get(_tSl,    _ti)
            _tp1   = array.get(_tTP,   _ti)
            _t1hit = array.get(_tTH, _ti)
            _slhit = array.get(_tSH,  _ti)
            _tNum  = array.size(_tN) > _ti ? array.get(_tN, _ti) : 0

            _entryBar = array.get(_tEB, _ti)
            if not _slhit and bar_index > _entryBar
                _slTriggered = _bull ? low <= _sl : high >= _sl
                if _slTriggered
                    array.set(_tSH, _ti, true)
                    if not _t1hit
                        _pnl = (_bull ? (_sl - array.get(_tEn, _ti)) : (array.get(_tEn, _ti) - _sl)) * array.get(_tEL, _ti) * cM
                        array.push(_dPH, _pnl)
                        array.push(_tCTi, bar_index)
                        array.push(_tCTs,   time)
                        array.push(_tPA, _pnl)
                        array.push(_tPTy, array.size(_tTy) > _ti ? array.get(_tTy, _ti) : "uhv")
                        _cTr += 1
                        _pT             += _pnl
                        _tLSt += 1
                        if _tLSt > _mLST
                            _mLST := _tLSt
                        label.new(bar_index, _sl, "🛑 #" + str.tostring(_tNum) + " SL Hit @ " + str.tostring(_sl, "#.##") + "  -$" + str.tostring(math.abs(_pnl), "#.##") + " (" + str.tostring(array.get(_tEL,_ti),"#.####") + " lots)", style = _bull ? label.style_label_up : label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny)
                        array.push(_tDB, bar_index - _entryBar)
                        _stype = array.get(_tTy, _ti)
                        _sbull = array.size(_tBl) > _ti ? array.get(_tBl, _ti) : true
                        if _stype == "uhv"
                            _uPnL += _pnl
                            _uPT += _pnl
                            _uTr += 1
                            _uLS += math.abs(_pnl)
                            if _sbull
                                _uBP += _pnl
                                _uBT += 1
                            else
                                _uBeP += _pnl
                                _uBeT += 1
                        else if _stype == "tbr"
                            _bPnL += _pnl
                            _bPT += _pnl
                            _bTr += 1
                            _bLS += math.abs(_pnl)
                            if _sbull
                                _bBP += _pnl
                                _bBT += 1
                            else
                                _bBeP += _pnl
                                _bBeT += 1
                        else if _stype == "evr"
                            _ePnL += _pnl
                            _ePT += _pnl
                            _eTr += 1
                            _eLS += math.abs(_pnl)
                            if _sbull
                                _eBP += _pnl
                                _eBT += 1
                            else
                                _eBeP += _pnl
                                _eBeT += 1
                        _origLbl = array.get(_tLbl, _ti)
                        if not na(_origLbl)
                            _origTxt = label.get_text(_origLbl)
                            label.set_text(_origLbl, _origTxt + "\n━━━━━━━━━━━━━━━━\n🛑 #" + str.tostring(_tNum) + " SL Hit — -$" + str.tostring(math.abs(_pnl), "#.##") + " Loss")

            if not _t1hit and not array.get(_tSH, _ti) and bar_index > _entryBar
                _tp1Triggered = _bull ? high >= _tp1 : low <= _tp1
                if _tp1Triggered
                    array.set(_tTH, _ti, true)
                    _wC += 1
                    _lots = array.get(_tEL, _ti)
                    _pnl  = (_bull ? (_tp1 - array.get(_tEn, _ti)) : (array.get(_tEn, _ti) - _tp1)) * _lots * cM
                    array.push(_dPH, _pnl)
                    array.push(_tCTi, bar_index)
                    array.push(_tCTs,   time)
                    array.push(_tPA, _pnl)
                    array.push(_tPTy, array.size(_tTy) > _ti ? array.get(_tTy, _ti) : "uhv")
                    _cTr += 1
                    _pT             += _pnl
                    _tLSt := 0
                    array.push(_tDB, bar_index - _entryBar)
                    label.new(bar_index, _tp1, "✅ #" + str.tostring(_tNum) + " TP Hit  +$" + str.tostring(_pnl, "#.##") + " (" + str.tostring(array.get(_tEL,_ti),"#.####") + " lots)", style = _bull ? label.style_label_down : label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.tiny)
                    _stype = array.get(_tTy, _ti)
                    _sbull = array.size(_tBl) > _ti ? array.get(_tBl, _ti) : true
                    array.set(_tW, _ti, true)
                    if _stype == "uhv"
                        _uPnL += _pnl
                        _uPT += _pnl
                        _uTr += 1
                        _uWn += 1
                        _uWS += _pnl
                        if _sbull
                            _uBP += _pnl
                            _uBT += 1
                        else
                            _uBeP += _pnl
                            _uBeT += 1
                    else if _stype == "tbr"
                        _bPnL += _pnl
                        _bPT += _pnl
                        _bTr += 1
                        _bWn += 1
                        _bWS += _pnl
                        if _sbull
                            _bBP += _pnl
                            _bBT += 1
                        else
                            _bBeP += _pnl
                            _bBeT += 1
                    else if _stype == "evr"
                        _ePnL += _pnl
                        _ePT += _pnl
                        _eTr += 1
                        _eWn += 1
                        _eWS += _pnl
                        if _sbull
                            _eBP += _pnl
                            _eBT += 1
                        else
                            _eBeP += _pnl
                            _eBeT += 1
                    _origLbl = array.get(_tLbl, _ti)
                    if not na(_origLbl)
                        _origTxt = label.get_text(_origLbl)
                        label.set_text(_origLbl, _origTxt + "\n━━━━━━━━━━━━━━━━\n✅ #" + str.tostring(_tNum) + " TP Hit — +$" + str.tostring(_pnl, "#.##") + " Profit")


// Risk classification helper: dollar risk as % of account
f_rTag(float d) =>
    p = d > 0.0 and iMon > 0 ? d / iMon * 100.0 : 0.0
    p == 0.0 ? "" : p <= 0.5 ? " (risk-free)" : p <= 2.0 ? " (safe)" : p <= 5.0 ? " (moderate)" : p <= 10.0 ? " (high risk)" : " (risk-max)"
f_mxL(float m, simple string slT) => m > 0 ? "  Max exp. loss: -$" + str.tostring(m, "#.##") : slT == "SwingLow" ? "  Max exp. loss: unknown (swing SL — consider $ Risk mode)" : ""

// STATS PANEL (top-right table)
fDP() =>
    // ── Core stats ──
    _totalPnL    = 0.0
    _avgDollarRisk = (uDR + tDR + eDR) / 3.0
    _avgTp1Mult   = (uT1 + tT1 + eT1) / 3.0
    // Compute actual avg win and avg loss from closed trade history
    _totalWinAmt = 0.0
    _totalLossAmt = 0.0
    _winTradesCount = 0
    _lossTradesCount = 0
    _pnlSz = math.min(array.size(_tPA), array.size(_tCTs))
    if _pnlSz > 0
        for _pi = 0 to _pnlSz - 1
            if array.get(_tCTs, _pi) >= _sRD
                _p = array.get(_tPA, _pi)
                _totalPnL += _p
                if _p > 0
                    _totalWinAmt += _p
                    _winTradesCount += 1
                else if _p < 0
                    _totalLossAmt += math.abs(_p)
                    _lossTradesCount += 1
    _filteredTrades = _winTradesCount + _lossTradesCount
    _acc         = _filteredTrades > 0 ? float(_winTradesCount) / _filteredTrades : 0.0
    _accPct      = math.round(_acc * 100)
    _avgPnL      = _filteredTrades > 0 ? _totalPnL / _filteredTrades : 0.0
    _winAmt  = _winTradesCount  > 0 ? _totalWinAmt  / _winTradesCount  : _avgDollarRisk * _avgTp1Mult
    _lossAmt = _lossTradesCount > 0 ? _totalLossAmt / _lossTradesCount : _avgDollarRisk
    _ev      = _acc * _winAmt - (1.0 - _acc) * _lossAmt

    // ── Doubling / target time ──
    _tradesToDouble = _avgPnL > 0 ? math.ceil(iMon / _avgPnL) : 0
    _avgMinsPerSignal = 30.0
    if array.size(_sBT) > 1
        _totalGap = 0
        for _si = 1 to array.size(_sBT) - 1
            _totalGap += array.get(_sBT, _si) - array.get(_sBT, _si - 1)
        _avgMinsPerSignal := (_totalGap / (array.size(_sBT) - 1)) * tFm
    _hoursToDouble = _tradesToDouble > 0 and _avgMinsPerSignal > 0 ? math.round(_tradesToDouble * _avgMinsPerSignal / 60.0 * 10) / 10 : 0

    // ── Signals per day (avg across all days) ──
    _allDaySignals  = _tSAD + _sigT
    _avgSigPerDay   = _tDS > 0 ? math.round(_allDaySignals / _tDS) : _sigT

    // ── Washout ──
    // Use actual observed avg loss (not the input setting) — avoids showing 0 when fixed-lot mode is on
    _washout = math.floor(iMon / (_lossAmt > 0 ? _lossAmt : (_avgDollarRisk > 0 ? _avgDollarRisk : 1.0)))

    // ── Last hour P&L ──
    _hourPnL = 0.0
    if array.size(_tCTi) > 0
        for _hi = 0 to array.size(_tCTi) - 1
            if bar_index - array.get(_tCTi, _hi) <= bPH
                _hourPnL += array.get(_tPA, _hi)

    // ── Avg time to next signal ──
    _minsToNextSignal = math.round(_avgMinsPerSignal)

    // ── Session detection (UTC hour) ──
    _utcHour = hour(time, "UTC")
    _session = _utcHour >= 22 or _utcHour < 7  ? "🌏 Sydney Session" :
               _utcHour >= 0  and _utcHour < 9  ? "🌸 Tokyo Session"  :
               _utcHour >= 8  and _utcHour < 13 ? "🏦 London Session" :
               _utcHour >= 13 and _utcHour < 22 ? "🗽 New York Session" : "📊 Market"
    // overlap labels
    _session := (_utcHour >= 8 and _utcHour < 9)   ? "🏦🌸 London/Tokyo Overlap"   : _session
    _session := (_utcHour >= 13 and _utcHour < 17)  ? "🗽🏦 New York/London Overlap" : _session

    // ── Pre-panel: today completed wins/trades ──
    _winsToday            = 0
    _tradesCompletedToday = 0
    _todayStartMs         = timenow - (timenow % 86400000)
    if array.size(_tCTs) > 0
        for _ict = 0 to array.size(_tCTs) - 1
            if array.get(_tCTs, _ict) >= _todayStartMs and array.get(_tCTs, _ict) >= _sRD
                _tradesCompletedToday += 1
                if array.get(_tPA, _ict) > 0
                    _winsToday += 1

    // ── Pre-panel: trades closed in last hour ──
    _hourTrades = 0
    if array.size(_tCTi) > 0
        for _iht = 0 to array.size(_tCTi) - 1
            if bar_index - array.get(_tCTi, _iht) <= bPH
                _hourTrades += 1

    // ── Pre-panel: current win/loss streak ──
    _currentStreak = 0
    _streakSz = array.size(_tPA)
    if _streakSz > 0
        // find last filtered trade
        _lastIdx = -1
        for _ics0 = _streakSz - 1 to 0
            if array.get(_tCTs, _ics0) >= _sRD
                _lastIdx := _ics0
                break
        if _lastIdx >= 0
            _lastIsWin = array.get(_tPA, _lastIdx) > 0
            for _ics = _lastIdx to 0
                if array.get(_tCTs, _ics) < _sRD
                    break
                _cp = array.get(_tPA, _ics)
                if (_lastIsWin and _cp > 0) or (not _lastIsWin and _cp <= 0)
                    _currentStreak += 1
                else
                    break
            _currentStreak := _lastIsWin ? _currentStreak : -_currentStreak

    // ── Pre-panel: yesterday P&L (moved here for early use) ──
    _ydayStart  = _todayStartMs - 86400000
    _pnlYday    = 0.0
    if array.size(_tCTs) > 0
        for _iyd = 0 to array.size(_tCTs) - 1
            _ts = array.get(_tCTs, _iyd)
            if _ts >= _ydayStart and _ts < _todayStartMs and _ts >= _sRD
                _pnlYday += array.get(_tPA, _iyd)

    // ── Per-strategy avg win and avg loss amounts ──
    _uhvWinSum = 0.0
    _uhvWinN2  = 0
    _uhvLossSum = 0.0
    _uhvLossN2 = 0
    _tbrWinSum = 0.0
    _tbrWinN2  = 0
    _tbrLossSum = 0.0
    _tbrLossN2 = 0
    _evrWinSum = 0.0
    _evrWinN2  = 0
    _evrLossSum = 0.0
    _evrLossN2 = 0
    _uhvMaxLoss = 0.0
    _tbrMaxLoss = 0.0
    _evrMaxLoss = 0.0
    // ── Single source of truth: all per-strategy stats derived from close-time arrays ──
    // _tPA and _tPTy are always pushed together at trade close, so they
    // are always aligned and can never drift from each other.
    // We derive P&L totals, trade counts, win counts, AND avg win/loss from this same loop.
    // The running vars (_uPnL, _uTr, _uWn etc.) are kept for signal labels only.
    _uhvPnLCalc    = 0.0
    _tbrPnLCalc    = 0.0
    _evrPnLCalc    = 0.0
    _uhvTradesCalc = 0
    _tbrTradesCalc = 0
    _evrTradesCalc = 0
    _uhvWinsCalc   = 0
    _tbrWinsCalc   = 0
    _evrWinsCalc   = 0
    _stratSize2 = array.size(_tPA)
    if _stratSize2 > 0
        for _ist = 0 to _stratSize2 - 1
            if array.get(_tCTs, _ist) < _sRD
                continue
            _sp  = array.get(_tPA,  _ist)
            _st = array.get(_tPTy, _ist)
            if _st == "uhv"
                _uhvPnLCalc    += _sp
                _uhvTradesCalc += 1
                if _sp > 0
                    _uhvWinSum  += _sp
                    _uhvWinN2   += 1
                    _uhvWinsCalc += 1
                else
                    _uhvLossSum += math.abs(_sp)
                    _uhvLossN2  += 1
                    _uhvMaxLoss := math.max(_uhvMaxLoss, math.abs(_sp))
            else if _st == "tbr"
                _tbrPnLCalc    += _sp
                _tbrTradesCalc += 1
                if _sp > 0
                    _tbrWinSum  += _sp
                    _tbrWinN2   += 1
                    _tbrWinsCalc += 1
                else
                    _tbrLossSum += math.abs(_sp)
                    _tbrLossN2  += 1
                    _tbrMaxLoss := math.max(_tbrMaxLoss, math.abs(_sp))
            else
                _evrPnLCalc    += _sp
                _evrTradesCalc += 1
                if _sp > 0
                    _evrWinSum  += _sp
                    _evrWinN2   += 1
                    _evrWinsCalc += 1
                else
                    _evrLossSum += math.abs(_sp)
                    _evrLossN2  += 1
                    _evrMaxLoss := math.max(_evrMaxLoss, math.abs(_sp))
    _uhvAvgWin  = _uhvWinN2  > 0 ? _uhvWinSum  / _uhvWinN2  : 0.0
    _uhvAvgLoss = _uhvLossN2 > 0 ? _uhvLossSum / _uhvLossN2 : 0.0
    _tbrAvgWin  = _tbrWinN2  > 0 ? _tbrWinSum  / _tbrWinN2  : 0.0
    _tbrAvgLoss = _tbrLossN2 > 0 ? _tbrLossSum / _tbrLossN2 : 0.0
    _evrAvgWin  = _evrWinN2  > 0 ? _evrWinSum  / _evrWinN2  : 0.0
    _evrAvgLoss = _evrLossN2 > 0 ? _evrLossSum / _evrLossN2 : 0.0

    // ── Signals fired in last hour (for next-hour projection) ──
    _sigLastHour = 0
    if array.size(_sBT) > 0
        for _isb = 0 to array.size(_sBT) - 1
            if bar_index - array.get(_sBT, _isb) <= bPH
                _sigLastHour += 1
    // ── Build panel (17 rows) ──
    table statsPanel = table.new(position.bottom_right, 1, 17,
         bgcolor = color.new(color.black, 15),
         border_color = color.new(color.gray, 70),
         border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)

    // ── Shared colors ──
    _bgDark    = color.new(color.black,   25)
    _bgDeep    = color.new(color.navy,    40)
    _txtDim    = color.new(color.silver,  10)
    _txtGreen  = color.new(color.lime,    10)
    _txtRed    = color.new(color.red,      0)
    _txtOrange = color.new(color.orange,   0)
    _txtAqua   = color.new(color.aqua,    10)
    _txtYellow = color.new(color.yellow,  10)

    // ── Pre-compute display vars ──
    _uhvAcc  = _uhvTradesCalc > 0 ? math.round(_uhvWinsCalc / _uhvTradesCalc * 100) : 0
    _tbrAcc  = _tbrTradesCalc > 0 ? math.round(_tbrWinsCalc / _tbrTradesCalc * 100) : 0
    _evrAcc  = _evrTradesCalc > 0 ? math.round(_evrWinsCalc / _evrTradesCalc * 100) : 0
    _best    = _uhvPnLCalc >= _tbrPnLCalc and _uhvPnLCalc >= _evrPnLCalc ? "UHV" : _tbrPnLCalc >= _uhvPnLCalc and _tbrPnLCalc >= _evrPnLCalc ? "2BR" : "EVR"
    _ydayGrowthPct = iMon > 0 ? math.round(_pnlYday / iMon * 100 * 10) / 10 : 0.0
    // Next-hour projection (priority: last hour → today's pace → all-time avg)
    _trueNextHrSigs = _avgMinsPerSignal > 0 ? 60.0 / _avgMinsPerSignal : 0.0
    _basisLbl = "all-time avg"
    if _sigLastHour > 0
        _trueNextHrSigs := float(_sigLastHour)
        _basisLbl := "last hour pace"
    else if _sigT >= 2
        _hrsElapsed = (bar_index - array.get(_sBT, array.size(_sBT) - _sigT)) * tFm / 60.0
        if _hrsElapsed > 0
            _trueNextHrSigs := math.round(_sigT / _hrsElapsed * 10) / 10
            _basisLbl := "today's pace"
    _projNextHrPnLEV = math.round(_trueNextHrSigs * _ev * 100) / 100
    // ROW 0 — HEADER
    table.cell(statsPanel, 0, 0,
         "TURTLE TRADER DESK  |  " + syminfo.ticker + "  |  " + str.tostring(tFm) + "m  |  " + _session + "  |  Exness Std 2000:1",
         text_color = color.white, text_size = size.small, bgcolor = color.new(#0a7a6a, 5))

    // ROW 1 — SIGNAL STATUS (largest text, highest priority)
    _sigStatus = _iR and _fR ? "POI REACHED — WATCHING FOR ENTRY" :
         _iR ? "SETUP IN PROGRESS — AWAITING POI" :
         _bT  ? "SIGNAL FIRED — MONITORING" : "STANDING BY"
    _sigBg = _iR and _fR ? color.new(color.green,  30) :
         _iR ? color.new(color.blue,   40) :
         _bT  ? color.new(color.orange, 30) : color.new(color.gray, 50)
    _sigFg = _iR and _fR ? color.new(color.lime,   0) :
         _iR ? color.new(color.aqua,   0) :
         _bT  ? color.new(color.orange, 0) : color.new(color.silver, 10)
    table.cell(statsPanel, 0, 1, _sigStatus,
         text_color = _sigFg, text_size = size.normal, bgcolor = _sigBg)

    // ROW 2 — TREND + STRENGTH + NEXT SIGNAL ETA
    _tDir       = _lb ? "BULLISH" : "BEARISH"
    _tColor     = _lb ? _txtGreen : _txtRed
    _tBar       = _tS >= 80 ? "||||" : _tS >= 60 ? "|||." : _tS >= 40 ? "||.." : _tS >= 20 ? "|..." : "...."
    _tStL       = _tS >= 70 ? "Strong" : _tS >= 40 ? "Moderate" : "Weak"
    _nextSigEta = _minsToNextSignal >= 60 ? str.tostring(math.round(_minsToNextSignal / 60.0 * 10) / 10) + " hrs" : str.tostring(_minsToNextSignal) + " min"
    table.cell(statsPanel, 0, 2,
         _tDir + "  |  " + _tBar + "  " + _tStL + " (" + str.tostring(_tS) + ")" +
         "  |  Next signal: ~" + _nextSigEta,
         text_color = _tColor, text_size = size.small, bgcolor = _bgDark)

    // ROW 3 — TODAY DIVIDER
    table.cell(statsPanel, 0, 3, "TODAY",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 4 — TODAY P&L (large font — most visible number)
    _todayPnLDisp = math.round((_uPT + _bPT + _ePT) * 100) / 100
    _todayBalDisp = iMon + _todayPnLDisp
    _todaySign    = _todayPnLDisp >= 0.01 ? "+" : ""
    _todayBg      = _todayPnLDisp >= 0.01 ? color.new(color.green, 55) : _todayPnLDisp <= -0.01 ? color.new(color.red, 55) : color.new(color.gray, 55)
    _todayFg      = _todayPnLDisp >= 0.01 ? _txtGreen : _todayPnLDisp <= -0.01 ? _txtRed : _txtDim
    table.cell(statsPanel, 0, 4,
         _todaySign + "$" + str.tostring(_todayPnLDisp, "#.##") + "  |  Balance: $" + str.tostring(_todayBalDisp, "#.##"),
         text_color = _todayFg, text_size = size.normal, bgcolor = _todayBg)

    // ── Avg trade duration ──
    _avgDurMins = 0.0
    _durSz = array.size(_tDB)
    if _durSz > 0
        _durSum = 0
        for _di = 0 to _durSz - 1
            _durSum += array.get(_tDB, _di)
        _avgDurMins := math.round(_durSum / _durSz * tFm * 10) / 10
    _avgDurStr = _durSz == 0 ? "—" : _avgDurMins >= 60.0 ? str.tostring(math.round(_avgDurMins / 60.0 * 10) / 10) + " hr" : str.tostring(_avgDurMins) + " min"
    _maxTradeTxt = mTM ? "  [MAX TRADES ON]" : ""

    // ROW 5 — STRATEGY SUB-TOTALS + AVG DURATION (tiny, secondary detail under today P&L)
    table.cell(statsPanel, 0, 5,
         "UHV " + (_uPT >= 0 ? "+" : "") + "$" + str.tostring(math.round(_uPT * 100) / 100, "#.##") +
         "  |  2BR " + (_bPT >= 0 ? "+" : "") + "$" + str.tostring(math.round(_bPT * 100) / 100, "#.##") +
         "  |  EVR " + (_ePT >= 0 ? "+" : "") + "$" + str.tostring(math.round(_ePT * 100) / 100, "#.##") +
         "\nAvg trade duration: " + _avgDurStr + "  (" + str.tostring(_durSz) + " trades)" + _maxTradeTxt,
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // ROW 6 — TRADE COUNT + STREAK
    table.cell(statsPanel, 0, 6,
         str.tostring(_sigT) + " signals  |  " + str.tostring(_tradesCompletedToday) + " closed  |  " + str.tostring(_winsToday) + " won" +
         (_tradesCompletedToday > 0 ? "  (" + str.tostring(math.round(_winsToday / math.max(_tradesCompletedToday, 1) * 100)) + "%)" : "") +
         "  |  " + (_currentStreak > 1 ? str.tostring(_currentStreak) + " wins in a row" : _currentStreak == 1 ? "Last: win" : _currentStreak < -1 ? str.tostring(math.abs(_currentStreak)) + " losses in a row" : "Last: loss"),
         text_color = _currentStreak >= 0 ? _txtGreen : _txtOrange, text_size = size.small, bgcolor = _bgDark)

    // ROW 7 — LAST HOUR RESULT + NEXT HOUR EV PROJECTION
    table.cell(statsPanel, 0, 7,
         "Last hr: " + (_hourPnL >= 0.01 ? "+$" + str.tostring(_hourPnL, "#.##") : _hourPnL <= -0.01 ? "-$" + str.tostring(math.abs(_hourPnL), "#.##") : "—") + "  (" + str.tostring(_hourTrades) + " trades)  |  Next hr EV: " + (_projNextHrPnLEV >= 0 ? "+" : "") + "$" + str.tostring(math.abs(_projNextHrPnLEV), "#.##") + "  (" + _basisLbl + ")\nEV: $" + str.tostring(_ev, "#.##") + "/trade  |  " + str.tostring(_avgSigPerDay) + " signals/day avg",
         text_color = _txtAqua, text_size = size.small, bgcolor = _bgDark)

    // ROW 8 — STRATEGIES DIVIDER
    table.cell(statsPanel, 0, 8, "STRATEGIES",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 9 — UHV BREAKOUT (+ effective lot size when multiplier is active)
    // Find last lot size actually used per strategy (dollar-risk mode → varies by SL distance)
    float _lastUhvLots = na
    float _lastTbrLots = na
    float _lastEvrLots = na
    _tySize = math.min(array.size(_tTy), array.size(_tEL))
    if _tySize > 0
        for _li = _tySize - 1 to 0
            _lt = array.get(_tTy, _li)
            _ll = array.get(_tEL, _li)
            if na(_lastUhvLots) and _lt == "uhv"
                _lastUhvLots := _ll
            if na(_lastTbrLots) and _lt == "tbr"
                _lastTbrLots := _ll
            if na(_lastEvrLots) and _lt == "evr"
                _lastEvrLots := _ll
            if not na(_lastUhvLots) and not na(_lastTbrLots) and not na(_lastEvrLots)
                break
    _uhvRiskTag = f_rTag(uDR > 0 ? uDR : _uhvAvgLoss)
    _tbrRiskTag = f_rTag(tDR > 0 ? tDR : _tbrAvgLoss)
    _evrRiskTag = f_rTag(eDR > 0 ? eDR : _evrAvgLoss)
    // Live dollar-at-risk: open trades (neither SL nor TP hit yet)
    float _uhvLR = na
    float _tbrLR = na
    float _evrLR = na
    if _tySize > 0
        for _oi = 0 to _tySize - 1
            if not array.get(_tSH, _oi) and not array.get(_tTH, _oi)
                _oDR = math.abs(array.get(_tEn, _oi) - array.get(_tSl, _oi)) * array.get(_tEL, _oi) * cM
                _oTy2 = array.get(_tTy, _oi)
                if _oTy2 == "uhv"
                    _uhvLR := nz(_uhvLR, 0.0) + _oDR
                else if _oTy2 == "tbr"
                    _tbrLR := nz(_tbrLR, 0.0) + _oDR
                else
                    _evrLR := nz(_evrLR, 0.0) + _oDR
    _uhvLS = not na(_uhvLR) ? "\n  [LIVE SL risk: -$" + str.tostring(math.round(_uhvLR * 100) / 100, "#.##") + "]" : ""
    _tbrLS = not na(_tbrLR) ? "\n  [LIVE SL risk: -$" + str.tostring(math.round(_tbrLR * 100) / 100, "#.##") + "]" : ""
    _evrLS = not na(_evrLR) ? "\n  [LIVE SL risk: -$" + str.tostring(math.round(_evrLR * 100) / 100, "#.##") + "]" : ""
    _uhvWLStr = (_uhvAvgWin > 0 or _uhvAvgLoss > 0 ? "  avg +" + str.tostring(_uhvAvgWin, "#.##") + " / -" + str.tostring(_uhvAvgLoss, "#.##") : "") + f_mxL(_uhvMaxLoss, uST) + _uhvLS
    _uhvLotStr = "  |  " + (uDR > 0 ? (not na(_lastUhvLots) ? str.tostring(_lastUhvLots, "0.####") : "auto") : str.tostring(uLS * lA, "0.####")) + " lots" + _uhvRiskTag
    table.cell(statsPanel, 0, 9,
         "UHV  W/L: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " (" + str.tostring(_uhvAcc) + "%)" +
         "  All-time: " + (_uhvPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_uhvPnLCalc, "#.##") +
         "  Today: " + (_uPT >= 0 ? "+" : "") + "$" + str.tostring(_uPT, "#.##") +
         _uhvWLStr + (_best == "UHV" ? "  [BEST]" : "") + _uhvLotStr,
         text_color = _uhvPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 10 — TWO BAR REVERSAL
    _tbrWLStr = (_tbrAvgWin > 0 or _tbrAvgLoss > 0 ? "  avg +" + str.tostring(_tbrAvgWin, "#.##") + " / -" + str.tostring(_tbrAvgLoss, "#.##") : "") + f_mxL(_tbrMaxLoss, tST) + _tbrLS
    _tbrLotStr = "  |  " + (tDR > 0 ? (not na(_lastTbrLots) ? str.tostring(_lastTbrLots, "0.####") : "auto") : str.tostring(tLS * lA, "0.####")) + " lots" + _tbrRiskTag
    table.cell(statsPanel, 0, 10,
         "2BR  W/L: " + str.tostring(_tbrWinsCalc) + "/" + str.tostring(_tbrTradesCalc) + " (" + str.tostring(_tbrAcc) + "%)" +
         "  All-time: " + (_tbrPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_tbrPnLCalc, "#.##") +
         "  Today: " + (_bPT >= 0 ? "+" : "") + "$" + str.tostring(_bPT, "#.##") +
         _tbrWLStr + (_best == "2BR" ? "  [BEST]" : "") + _tbrLotStr,
         text_color = _tbrPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 11 — EFFORT VS RESULT
    _evrWLStr = (_evrAvgWin > 0 or _evrAvgLoss > 0 ? "  avg +" + str.tostring(_evrAvgWin, "#.##") + " / -" + str.tostring(_evrAvgLoss, "#.##") : "") + f_mxL(_evrMaxLoss, eST) + _evrLS
    _evrLotStr = "  |  " + (eDR > 0 ? (not na(_lastEvrLots) ? str.tostring(_lastEvrLots, "0.####") : "auto") : str.tostring(eLS * lA, "0.####")) + " lots" + _evrRiskTag
    table.cell(statsPanel, 0, 11,
         "EVR  W/L: " + str.tostring(_evrWinsCalc) + "/" + str.tostring(_evrTradesCalc) + " (" + str.tostring(_evrAcc) + "%)" +
         "  All-time: " + (_evrPnLCalc >= 0 ? "+" : "") + "$" + str.tostring(_evrPnLCalc, "#.##") +
         "  Today: " + (_ePT >= 0 ? "+" : "") + "$" + str.tostring(_ePT, "#.##") +
         _evrWLStr + (_best == "EVR" ? "  [BEST]" : "") + _evrLotStr,
         text_color = _evrPnLCalc >= 0 ? _txtGreen : _txtRed, text_size = size.normal, bgcolor = _bgDeep)

    // ROW 12 — ALL-TIME DIVIDER
    table.cell(statsPanel, 0, 12, "ALL-TIME",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 13 — ALL-TIME P&L + ACCURACY + EV
    table.cell(statsPanel, 0, 13,
         "P&L: " + (_totalPnL >= 0 ? "+" : "") + "$" + str.tostring(_totalPnL, "#.##") +
         "  |  " + str.tostring(_wC) + "/" + str.tostring(_cTr) + " won (" + str.tostring(_accPct) + "%)" +
         "  |  " + (_ev >= 0.01 ? "Positive EV" : _ev <= -0.01 ? "Negative EV" : "Breakeven") + ": $" + str.tostring(_ev, "#.##") + "/trade" +
         "\navg win: +$" + str.tostring(_winAmt, "#.##") + "  |  avg loss: -$" + str.tostring(_lossAmt, "#.##"),
         text_color = _ev >= 0 ? _txtGreen : _txtRed, text_size = size.small, bgcolor = _bgDark)

    // ROW 14 — MILESTONES + RISK + YESTERDAY (condensed, tiny)
    table.cell(statsPanel, 0, 14,
         "To double: " + (_avgPnL > 0 ? str.tostring(_tradesToDouble) + " trades (~" + (_hoursToDouble >= 24 ? str.tostring(math.round(_hoursToDouble / 24.0 * 10) / 10) + " days" : str.tostring(_hoursToDouble) + " hrs") + ")" : "—") +
         "  |  Washout: " + str.tostring(_washout) + " losses" +
         "  |  Yesterday: " + (_pnlYday >= 0 ? "+" : "") + "$" + str.tostring(math.round(_pnlYday * 100) / 100, "#.##") + "  (" + (_ydayGrowthPct >= 0 ? "+" : "") + str.tostring(_ydayGrowthPct) + "%)",
         text_color = _txtDim, text_size = size.tiny, bgcolor = _bgDark)

    // Recommendations / optimize calculations derived from trade statistics
    // Compute avg _tS for winners and losers across all trades
    _winTSsum    = 0.0
    _winTScount  = 0
    _loseTSsum   = 0.0
    _loseTScount = 0
    _tsSize = array.size(_tW)
    if _tsSize > 0
        for _ri = 0 to _tsSize - 1
            _rts   = array.get(_tTS, _ri)
            _rwon  = array.get(_tW,      _ri)
            if _rwon
                _winTSsum   += _rts
                _winTScount += 1
            else
                _loseTSsum   += _rts
                _loseTScount += 1
    _avgWinTS  = _winTScount  > 0 ? _winTSsum  / _winTScount  : na
    _avgLoseTS = _loseTScount > 0 ? _loseTSsum / _loseTScount : na

    // ── Estimate dollar gain from unlocking blocked signals (per day) ──
    _avgPnLPerTrade = _cTr > 0 ? _totalPnL / _cTr : 0.0
    _daysBase = math.max(_tDS, 1)
    // Only use estimate when avg is positive (net profitable)
    _canEstimate = _avgPnLPerTrade > 0 and _cTr >= 5

    // RECOMMENDATIONS ENGINE — grouped by priority
    _overallWinRate = _cTr > 0 ? _wC / _cTr : 0.0

    // ── Realized R:R from actual dollar win vs dollar loss amounts ──
    // Use observed avg win and avg loss dollars — works correctly for all SL types
    _avgRealizedRR = (_lossAmt > 0 and _winAmt > 0) ? _winAmt / _lossAmt : _avgTp1Mult
    // Break-even win rate for the actual R:R being used
    _beWinRate = _avgRealizedRR > 0 ? 1.0 / (1.0 + _avgRealizedRR) : 0.5

    // ── Per-strategy EV ──
    _uhvEV = _uhvTradesCalc >= 5 ? (_uhvWinsCalc / _uhvTradesCalc) * _uhvAvgWin - (1.0 - _uhvWinsCalc / _uhvTradesCalc) * _uhvAvgLoss : na
    _tbrEV = _tbrTradesCalc >= 5 ? (_tbrWinsCalc / _tbrTradesCalc) * _tbrAvgWin - (1.0 - _tbrWinsCalc / _tbrTradesCalc) * _tbrAvgLoss : na
    _evrEV = _evrTradesCalc >= 5 ? (_evrWinsCalc / _evrTradesCalc) * _evrAvgWin - (1.0 - _evrWinsCalc / _evrTradesCalc) * _evrAvgLoss : na

    _totalSlHits = _cTr - _wC
    _slHitRate   = _cTr > 0 ? float(_totalSlHits) / _cTr : 0.0

    // BUILD RECOMMENDATION STRINGS — ordered by priority
    _recs = array.new_string()
    // 🚨 CRITICAL
    if iMon > 0 and _pT < -(iMon * 0.10)
        array.push(_recs, "🚨 Down " + str.tostring(math.round(math.abs(_pT) / iMon * 100)) + "% today (-$" + str.tostring(math.abs(_pT), "#.##") + ")\nconsider stopping for the day to protect your capital")
    if not na(_uhvEV) and _uhvEV < -0.05
        array.push(_recs, "🚨 UHV Breakout has negative EV: -$" + str.tostring(math.abs(_uhvEV), "#.##") + "/trade avg (" + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won, avg win $" + str.tostring(_uhvAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_uhvAvgLoss, "#.##") + ")\ndisable or adjust settings")
    if not na(_tbrEV) and _tbrEV < -0.05
        array.push(_recs, "🚨 Two Bar Reversal has negative EV: -$" + str.tostring(math.abs(_tbrEV), "#.##") + "/trade avg (" + str.tostring(_tbrWinsCalc) + "/" + str.tostring(_tbrTradesCalc) + " won, avg win $" + str.tostring(_tbrAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_tbrAvgLoss, "#.##") + ")\ndisable or adjust settings")
    if not na(_evrEV) and _evrEV < -0.05
        array.push(_recs, "🚨 Effort vs Result has negative EV: -$" + str.tostring(math.abs(_evrEV), "#.##") + "/trade avg (" + str.tostring(_evrWinsCalc) + "/" + str.tostring(_evrTradesCalc) + " won, avg win $" + str.tostring(_evrAvgWin, "#.##") + " vs avg loss -$" + str.tostring(_evrAvgLoss, "#.##") + ")\ndisable or adjust settings")
    // ⚠️ WARNING
    if _uhvTradesCalc >= 5 and _uhvWinsCalc / _uhvTradesCalc < 0.40 and _uhvEV >= -0.05
        array.push(_recs, "⚠️ UHV Breakout: " + str.tostring(_uhvWinsCalc) + "/" + str.tostring(_uhvTradesCalc) + " won (" + str.tostring(math.round(_uhvWinsCalc / _uhvTradesCalc * 100)) + "%)\nbelow break-even. Try: raise Min Trend Strength, enable Require UHV Sweep, or disable this strategy")
    if _tbrTradesCalc >= 5 and _tbrWinsCalc / _tbrTradesCalc < 0.40 and _tbrEV >= -0.05
        array.push(_recs, "⚠️ Two Bar Reversal: " + str.tostring(_tbrWinsCalc) + "/" + str.tostring(_tbrTradesCalc) + " won (" + str.tostring(math.round(_tbrWinsCalc / _tbrTradesCalc * 100)) + "%)\nbelow break-even. Try: enable Lower Volume filter, tighten Min Trend Strength, or disable this strategy")
    if _evrTradesCalc >= 5 and _evrWinsCalc / _evrTradesCalc < 0.40 and _evrEV >= -0.05
        array.push(_recs, "⚠️ Effort vs Result: " + str.tostring(_evrWinsCalc) + "/" + str.tostring(_evrTradesCalc) + " won (" + str.tostring(math.round(_evrWinsCalc / _evrTradesCalc * 100)) + "%)\nbelow break-even. Try: enable Higher Volume filter, or disable this strategy")
    if _totalSlHits >= 5 and _slHitRate > 0.60 and _cTr >= 8
        array.push(_recs, "⚠️ " + str.tostring(math.round(_slHitRate * 100)) + "% of trades are hitting SL (" + str.tostring(_totalSlHits) + "/" + str.tostring(_cTr) + ")\nentries may be too early. Try: increase SL Buffer, switch to ATR stop, or raise Min Trend Strength")
    // 💡 OPTIMIZE
    if not na(_avgWinTS) and not na(_avgLoseTS) and _winTScount >= 3 and _loseTScount >= 3
        _tsDiff = _avgWinTS - _avgLoseTS
        if _tsDiff > 8
            array.push(_recs, "💡 Winners fire at avg trend strength " + str.tostring(math.round(_avgWinTS)) + " vs losers at " + str.tostring(math.round(_avgLoseTS)) + "\nraise 'Min Trend Strength' to ~" + str.tostring(math.round(_avgWinTS * 0.85)) + " to pre-filter weak setups (setting is in the Trend Engine group)")
        else if _tsDiff < -8
            array.push(_recs, "💡 Wins happen at lower trend strength (" + str.tostring(math.round(_avgWinTS)) + ") than losses (" + str.tostring(math.round(_avgLoseTS)) + ")\nlower 'Min Trend Strength' to catch more quality setups")
    if _cTr >= 10
        if _overallWinRate > _beWinRate + 0.10 and _avgTp1Mult < 2.2
            array.push(_recs, "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% beats break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nraise TP R:R to ~" + str.tostring(math.round(_avgRealizedRR * 1.3 * 10) / 10) + "R to earn more per winner (note: higher TP will reduce win rate — test first)")
        else if _overallWinRate < _beWinRate - 0.08 and _avgTp1Mult > 1.2
            array.push(_recs, "💡 Win rate " + str.tostring(math.round(_overallWinRate * 100)) + "% is below break-even (" + str.tostring(math.round(_beWinRate * 100)) + "% needed at " + str.tostring(math.round(_avgRealizedRR * 10) / 10) + "R)\nlower TP R:R to ~" + str.tostring(math.round(_avgRealizedRR * 0.75 * 10) / 10) + "R so TP is easier to reach")
    // 🔓 UNLOCK — only suggest when win rate is close to break-even (filter may be over-filtering)
    // If win rate is well above break-even, the filter is earning its keep; dollar estimate
    // assumes blocked signals have same quality as passing ones, which is unlikely when win rate is high
    bool _ftOK = _overallWinRate < _beWinRate + 0.25
    if rUS and _bSwp >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 UHV Sweep filter blocked " + str.tostring(_bSwp) + " signals (" + str.tostring(math.round(_bSwp / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must any candle sweep UHV low before entry' may add ~$" + str.tostring(math.round(_bSwp / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    else if rULV and _bUV >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 UHV Volume filter blocked " + str.tostring(_bUV) + " signals (" + str.tostring(math.round(_bUV / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must breakout candle have lower volume' may add ~$" + str.tostring(math.round(_bUV / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if rOC and _bOpp >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 Opposing candle filter blocked " + str.tostring(_bOpp) + " 2BR signals (" + str.tostring(math.round(_bOpp / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must there be an opposing candle' may add ~$" + str.tostring(math.round(_bOpp / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if r2LV and _b2V >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 2BR Volume filter blocked " + str.tostring(_b2V) + " signals (" + str.tostring(math.round(_b2V / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must engulfing candle have lower volume' may add ~$" + str.tostring(math.round(_b2V / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if rEHV and _bEV >= 3 and _canEstimate and _ftOK
        array.push(_recs, "🔓 EVR Volume filter blocked " + str.tostring(_bEV) + " signals (" + str.tostring(math.round(_bEV / _daysBase * 10) / 10) + "/day avg)\nturning OFF 'Must sweep candle have higher volume' may add ~$" + str.tostring(math.round(_bEV / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")

    if _bCd >= 5 and _canEstimate and _ftOK
        array.push(_recs, "🔓 Cooldown blocked " + str.tostring(_bCd) + " signals (" + str.tostring(math.round(_bCd / _daysBase * 10) / 10) + "/day avg)\nlower 'Signal Cooldown (bars)' may add ~$" + str.tostring(math.round(_bCd / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (test first)")
    if _bStr >= 4 and _canEstimate and _ftOK
        array.push(_recs, "🔓 Min Trend Strength blocked " + str.tostring(_bStr) + " signals (" + str.tostring(math.round(_bStr / _daysBase * 10) / 10) + "/day avg)\nlower 'Min Trend Strength' may add ~$" + str.tostring(math.round(_bStr / _daysBase * _avgPnLPerTrade * 100) / 100, "#.##") + "/day if quality holds (only if trend stays strong)")
    // ROW 15 — OPTIMIZER & TOOLS DIVIDER
    table.cell(statsPanel, 0, 15, "OPTIMIZER & TOOLS",
         text_color = _txtDim, text_size = size.tiny, bgcolor = color.new(color.black, 5))

    // ROW 16 — TOP RECOMMENDATIONS (surfacing computed _recs array)
    _recsSize = array.size(_recs)
    table.cell(statsPanel, 0, 16, (_recsSize > 0 ? array.get(_recs, 0) : "No recommendations yet — need more trade data") + (_recsSize > 1 ? "\n" + array.get(_recs, 1) : ""),
         text_color = _txtYellow, text_size = size.tiny, bgcolor = color.new(#1a2a1a, 10))


if barstate.islast and sSP
    fDP()

// ── Optimizer Status Panel (bottom-left) ──
if barstate.islast
    _opAP  = _cTr > 0 ? (_uPnL + _bPnL + _ePnL) / _cTr : 0.
    _baseRef = math.max((uTD + tTD + eTD) / 3.0, 1.0)
    _opRel = _opAP / _baseRef
    _smile = _cTr == 0 ? "⌛  Waiting for results..." : _opRel > 0.35 ? "😄  Loving it!" : _opRel > 0.05 ? "🙂  Profitable" : _opRel >= -0.05 ? "😐  Breaking even" : "😟  Try different values"
    _oStr  = (oUTP != 0 ? "UHV-TP" + (oUTP > 0 ? "+" : "") + str.tostring(oUTP) + "  " : "") + (oTTP != 0 ? "2BR-TP" + (oTTP > 0 ? "+" : "") + str.tostring(oTTP) + "  " : "") + (oETP != 0 ? "EVR-TP" + (oETP > 0 ? "+" : "") + str.tostring(oETP) + "  " : "") + (oCDo != 0 ? "CD" + (oCDo > 0 ? "+" : "") + str.tostring(oCDo) + "  " : "") + (oTSo != 0 ? "Trend" + (oTSo > 0 ? "+" : "") + str.tostring(oTSo) + "  " : "") + (oRLo > 0 ? "Cap$" + str.tostring(oRLo) : "")
    opPanel = table.new(position.bottom_left, 1, 3, bgcolor = color.new(color.black, 10), border_color = color.new(color.gray, 40), border_width = 1)
    table.cell(opPanel, 0, 0, "OPTIMIZER", text_color = color.new(color.aqua, 0), text_size = size.small, bgcolor = color.new(#001830, 5))
    table.cell(opPanel, 0, 1, _smile + "  ($" + str.tostring(math.round(_opAP * 100) / 100, "#.##") + "/trade avg)", text_color = _opAP >= 0. ? color.new(color.lime, 0) : color.red, text_size = size.huge, bgcolor = color.new(#0a0a14, 8))
    table.cell(opPanel, 0, 2, _oStr, text_color = color.silver, text_size = size.tiny, bgcolor = color.new(#0a0a14, 8))

// ── Trade Inspector Panel (top-right) ──
var table _iT = na
if barstate.islast
    if i_tInG
        _iIdx = -1
        for _i = 0 to array.size(_tN) - 1
            if array.get(_tN, _i) == i_tInN
                _iIdx := _i
                break
        if not na(_iT)
            table.delete(_iT)
        _iT := table.new(position.top_right, 1, 1,
             border_color = color.new(color.aqua, 30), border_width = 1)
        if _iIdx < 0
            table.cell(_iT, 0, 0, "Trade #" + str.tostring(i_tInN) + " not found.",
                 text_color = color.red, text_size = size.small)
        else
            _iEn = array.get(_tEn, _iIdx)
            _iSl = array.get(_tSl, _iIdx)
            _iTP = array.get(_tTP, _iIdx)
            _iLt = array.get(_tEL, _iIdx)
            _iSH = array.get(_tSH, _iIdx)
            _iTH = array.get(_tTH, _iIdx)
            _iCp = array.get(_xCp, _iIdx)
            _iCa = array.get(_xCa, _iIdx)
            _iFv = array.get(_xFv, _iIdx)
            _iTy = array.get(_tTy, _iIdx)
            _iBl = array.get(_tBl, _iIdx)
            _iSD = math.abs(_iEn - _iSl)
            _iRR = _iSD > 0 ? math.abs(_iTP - _iEn) / _iSD : 0.
            _iRk = _iSD * _iLt * cM
            _iSt = _iTy == "uhv" ? "UHV Breakout" : _iTy == "tbr" ? "Two Bar Reversal" : "Effort vs Result"
            _iRs = _iSH ? "❌ Loss (SL hit)" : _iTH ? "✅ Win (TP hit)" : "⏳ Still open"
            _iTx = "TRADE #" + str.tostring(i_tInN) + "  ·  " + _iSt + "  ·  " + (_iBl ? "LONG" : "SHORT") + "\n" + _iRs + "\n\nEntry $" + str.tostring(math.round(_iEn * 100) / 100, "#.##") + "   SL $" + str.tostring(math.round(_iSl * 100) / 100, "#.##") + "   TP $" + str.tostring(math.round(_iTP * 100) / 100, "#.##") + "\nLots " + str.tostring(math.round(_iLt * 100) / 100, "#.##") + "   Max risk $" + str.tostring(math.round(_iRk * 100) / 100, "#.##") + "   R:R " + str.tostring(math.round(_iRR * 10) / 10) + "\n\nWhy this trade was taken:\nThe system confirmed a " + _iSt + " setup" + (_iBl ? " in an uptrend." : " in a downtrend.") + " The stop loss was placed\nbeyond the recent swing " + (_iBl ? "low" : "high") + " to give the trade room to breathe.\n\nFVG/POI zone touched before entry: " + (_iFv ? "Yes — price revisited the imbalance zone first,\nconfirming that smart money was actively defending that level.\nThis is the strongest entry condition — institutional validation." : "No — the signal fired on pattern alone.\nThe imbalance zone had not been retested before entry.\nFVG confirmation would have added a layer of confidence.") + (_iCp ? "\n\n⚠️ Loss cap applied: your stop loss was tightened\nso the max loss equals your cap of $" + str.tostring(math.round(_iCa * 100) / 100, "#.##") + ". The raw swing-based\nSL distance would have risked more — the cap overrode it." : "")
            table.cell(_iT, 0, 0, _iTx,
                 text_color = color.white, text_size = size.small,
                 text_halign = text.align_left, bgcolor = color.new(color.black, 5))
    else if not na(_iT)
        table.delete(_iT)
        _iT := na

// ALERT CONDITIONS
// Create alerts via: right-click chart → Add Alert → Condition → FVG Absorption
alertcondition(_bBrk, title = '🟢 BUY Signal', message = '🟢 BUY Signal — FVG Absorption fired on {{ticker}} at {{close}}')
alertcondition(_beBrk, title = '🔴 SELL Signal', message = '🔴 SELL Signal — FVG Absorption fired on {{ticker}} at {{close}}')

// TREND LINE PLOTS (EMA 34, colored by trend strength)
plot(tSMA ? _fEma : na, 'Trend (base)',  color = color.new(color.gray, 85),   linewidth = 1)
plot(tSMA ? _w1      : na, 'Trend w1',      color = _tLCol,                linewidth = 6,  style = plot.style_linebr)
plot(tSMA ? _w2      : na, 'Trend w2',      color = _tLCol,                linewidth = 8,  style = plot.style_linebr)
plot(tSMA ? _w3      : na, 'Trend w3',      color = _tLCol,                linewidth = 10, style = plot.style_linebr)
plot(tSMA ? _w4      : na, 'Trend w4',      color = _tLCol,                linewidth = 12, style = plot.style_linebr)
plot(tSMA ? _w5      : na, 'Trend w5',      color = _tLCol,                linewidth = 14, style = plot.style_linebr)
