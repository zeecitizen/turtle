    _slDist   = math.max(_entry - _sl, syminfo.mintick)
    float _effLots  = (uhvDollarRisk > 0 ? math.max(uhvDollarRisk / (_slDist * cMult), 0.001) : uhvLotSize) * lotAmp
    if _slDist * _effLots * cMult > _uhvLossCap
